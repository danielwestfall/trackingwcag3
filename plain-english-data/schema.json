{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WCAG3ProvisionAnnotation",
  "type": "object",
  "required": [
    "slug",
    "authored",
    "translatedFrom",
    "plainEnglish"
  ],
  "properties": {
    "slug": { "type": "string" },
    "authored": {
      "type": "array",
      "items": { "type": "string" }
    },
    "translatedFrom": { "type": "string" },
    "plainEnglish": {
      "type": "object",
      "required": ["summary", "whyItMatters"],
      "properties": {
        "summary": { "type": "string" },
        "whyItMatters": { "type": "string" }
      }
    }
  }
}

