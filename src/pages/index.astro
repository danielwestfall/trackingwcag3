---
import PlainEnglishLayout from "@/layouts/PlainEnglishLayout.astro";
import fs from "fs";
import path from "path";

// Load catalogs for live metrics
const wcag3CatalogPath = path.join(process.cwd(), "public", "data", "wcag3-catalog.json");
const wcag22CatalogPath = path.join(process.cwd(), "public", "data", "wcag22-catalog.json");
const removalsCatalogPath = path.join(process.cwd(), "public", "data", "wcag3-removals.json");

let wcag3Count = 245;
let wcag22Count = 87;
let removalsCount = 4;

if (fs.existsSync(wcag3CatalogPath)) {
  try {
    const list = JSON.parse(fs.readFileSync(wcag3CatalogPath, "utf8"));
    wcag3Count = list.length;
  } catch (e) {}
}

if (fs.existsSync(wcag22CatalogPath)) {
  try {
    const list = JSON.parse(fs.readFileSync(wcag22CatalogPath, "utf8"));
    wcag22Count = list.length;
  } catch (e) {}
}

if (fs.existsSync(removalsCatalogPath)) {
  try {
    const list = JSON.parse(fs.readFileSync(removalsCatalogPath, "utf8"));
    removalsCount = list.length;
  } catch (e) {}
}

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (path: string) => `${base}${path.startsWith('/') ? path : '/' + path}`;

// ---- "This week at the W3C": written by scripts/fetch-provision-discussions.mjs
// (public/data/wcag3-recent-activity.json) plus optional hand-written notes.
const readJson = (file: string) => {
  const p = path.join(process.cwd(), "public", "data", file);
  try { return fs.existsSync(p) ? JSON.parse(fs.readFileSync(p, "utf8")) : null; } catch (e) { return null; }
};
const recent = readJson("wcag3-recent-activity.json");
const weeklyNotes = readJson("wcag3-weekly-notes.json");
const conformanceData = readJson("wcag3-conformance.json");
const catalogTitles = new Map<string, string>();
try {
  for (const p of JSON.parse(fs.readFileSync(wcag3CatalogPath, "utf8"))) catalogTitles.set(p.slug, p.title);
} catch (e) {}

const fmtDate = (iso: string, withYear = false) =>
  new Date(iso.length === 10 ? iso + "T12:00:00Z" : iso).toLocaleDateString("en-US", {
    month: "short", day: "numeric", ...(withYear ? { year: "numeric" } : {}), timeZone: "UTC",
  });
const windowLabel = recent ? `${fmtDate(recent.window.from)} – ${fmtDate(recent.window.to, true)}` : "";
const weekNote = recent && weeklyNotes?.notes
  ? weeklyNotes.notes.find((n: any) => n.date >= recent.window.from && n.date <= recent.window.to) ?? null
  : null;
const syncedOn = recent ? fmtDate(recent.generatedAt, true) : null;
const draftCommit = conformanceData?.draftState?.baselineCommit ?? null;
const draftDate = conformanceData?.draftState?.baselineDate ?? null;

const TOPIC_LABELS: Record<string, string> = {
  conformance: "Conformance", scope: "Scope", definitions: "Definitions",
  provision: "Provision", explainer: "Explainer", other: "General",
};
const PER_LIST = 6;
const ghLink = (n: number) => `${recent?.repo ?? "https://github.com/w3c/wcag3"}/issues/${n}`;
const activityLists = recent
  ? [
      {
        id: "adopted", title: "Merged into the editor's draft", items: recent.adopted,
        empty: "Nothing merged this week.", more: `${recent.repo}/pulls?q=is%3Apr+is%3Amerged`,
        hint: "Changes the editors accepted. Still a draft until W3C publishes a new Working Draft.",
      },
      {
        id: "proposals", title: "Open proposals", items: recent.proposals,
        empty: "No open pull requests moved this week.", more: `${recent.repo}/pulls`,
        hint: "Pull requests proposing new wording. Nothing here is in the draft yet.",
      },
      {
        id: "new-issues", title: "New issues raised", items: recent.newIssues,
        empty: "No new issues this week.", more: `${recent.repo}/issues?q=is%3Aissue+sort%3Acreated-desc`,
        hint: "Problems and questions filed against the draft.",
      },
    ]
  : [];
const alsoMoved = recent ? [...recent.closedIssues.map((i: any) => ({ ...i, why: "closed" })), ...recent.active.slice(0, 4).map((i: any) => ({ ...i, why: "active" }))] : [];
---

<PlainEnglishLayout title="Welcome to the WCAG 3 & 2.2 Plain English Reference Hub" activeTab="home">
  <!-- Hero Section -->
  <section class="portal-hero">
    <div class="hero-badge">
      <span class="badge-spark">✨</span>
      <span>Accessibility Knowledge Platform</span>
    </div>
    <h1 class="hero-headline">
      Demystifying Web Accessibility <span class="gradient-text">for Everyone</span>
    </h1>
    <p class="hero-subtext">
      Actionable, plain-English translations of W3C WCAG 3.0 draft provisions and WCAG 2.2 standards, tailored specifically for Designers, Developers, QA Specialists, and Product Managers.
    </p>

    <!-- Global Quick Jump Search -->
    <div class="hero-search-wrapper">
      <form action={link("/plain-english/")} method="GET" class="hero-search-form" id="portal-search-form">
        <span class="search-icon" aria-hidden="true">🔍</span>
        <input 
          type="text" 
          name="q" 
          id="portal-search-input" 
          placeholder={`Search ${wcag3Count} WCAG 3 provisions & ${wcag22Count} WCAG 2.2 criteria (e.g., color contrast, focus visible, forms)...`} 
          aria-label="Search WCAG provisions and criteria"
          autocomplete="off"
        />
        <button type="submit" class="search-submit-btn">Explore</button>
      </form>
      <div class="search-hints">
        <span>Popular:</span>
        <a href={link("/plain-english/provision/focus-indicator-contrast-sufficient/")}>Focus Indicator Contrast</a>
        <a href={link("/plain-english/wcag22/1-4-3/")}>Contrast Minimum</a>
        <a href={link("/plain-english/provision/image-alternatives-available/")}>Image Alternatives</a>
        <a href={link("/plain-english/removals/")}>Conforming Alternate Versions</a>
      </div>
    </div>
  </section>


  <!-- This week at the W3C (data: wcag3-recent-activity.json, wcag3-weekly-notes.json) -->
  {recent && (
    <section class="weekly-news" aria-labelledby="weekly-news-heading">
      <div class="weekly-news-header">
        <div>
          <p class="weekly-kicker">W3C activity · {windowLabel}</p>
          <h2 id="weekly-news-heading">This week at the W3C</h2>
        </div>
        <p class="weekly-sync">
          Checked {syncedOn}
          {draftCommit && <>{" · "}draft at <a href={`https://github.com/w3c/wcag3/commit/${draftCommit}`}><code>{draftCommit}</code></a>{draftDate && ` (${fmtDate(draftDate)})`}</>}
        </p>
      </div>

      {weekNote && (
        <div class="weekly-note">
          <h3>{weekNote.headline}</h3>
          <ul>
            {weekNote.points.map((pt: any) => (
              <li>
                {pt.text}{" "}
                {pt.refs?.length > 0 && (
                  <span class="weekly-refs">
                    ({pt.refs.map((n: number, idx: number) => (
                      <>{idx > 0 && ", "}<a href={ghLink(n)}>#{n}</a></>
                    ))})
                  </span>
                )}
              </li>
            ))}
          </ul>
        </div>
      )}

      <ul class="weekly-counts" aria-label="This week in numbers">
        <li><strong>{recent.counts.adopted}</strong> merged</li>
        <li><strong>{recent.counts.proposals}</strong> open proposals{recent.counts.newProposals > 0 && <> ({recent.counts.newProposals} new)</>}</li>
        <li><strong>{recent.counts.newIssues}</strong> new issues</li>
        <li><strong>{recent.counts.closedIssues}</strong> closed</li>
      </ul>

      <div class="weekly-grid">
        {activityLists.map((list: any) => (
          <div class="weekly-col" id={`weekly-${list.id}`}>
            <h3>{list.title} <span class="weekly-col-count">({list.items.length})</span></h3>
            <p class="weekly-hint">{list.hint}</p>
            {list.items.length === 0 ? (
              <p class="weekly-empty">{list.empty}</p>
            ) : (
              <ul class="weekly-items">
                {list.items.slice(0, PER_LIST).map((it: any) => (
                  <li class="weekly-item">
                    <a class="weekly-item-title" href={it.url}>
                      <span class="weekly-num">#{it.number}</span> {it.title}
                    </a>
                    <div class="weekly-meta">
                      <span class={`weekly-topic topic-${it.topic}`}>{TOPIC_LABELS[it.topic] ?? it.topic}</span>
                      {it.provisions.slice(0, 2).map((p: any) => (
                        catalogTitles.has(p.slug)
                          ? <a class="weekly-prov" href={link(`/plain-english/provision/${p.slug}/`)}>{catalogTitles.get(p.slug)}</a>
                          : <span class="weekly-prov">{p.title}</span>
                      ))}
                      {it.provisions.length > 2 && <span class="weekly-prov-more">+{it.provisions.length - 2} more</span>}
                      {it.comments > 0 && <span class="weekly-comments">{it.comments} {it.comments === 1 ? "comment" : "comments"}</span>}
                    </div>
                  </li>
                ))}
              </ul>
            )}
            {list.items.length > PER_LIST && (
              <p class="weekly-more"><a href={list.more}>{list.items.length - PER_LIST} more on GitHub</a></p>
            )}
          </div>
        ))}
      </div>

      {alsoMoved.length > 0 && (
        <div class="weekly-also">
          <h3>Also moved</h3>
          <ul>
            {alsoMoved.map((it: any) => (
              <li>
                <a href={it.url}>#{it.number} {it.title}</a>{" "}
                <span class="weekly-also-why">
                  {it.why === "closed" ? `closed ${fmtDate(it.closedAt)}` : `${it.weekComments} new ${it.weekComments === 1 ? "comment" : "comments"}`}
                </span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <p class="weekly-footnote">
        {recent.note} Pulled automatically from <a href={recent.repo}>w3c/wcag3</a> every Monday.
        See the <a href={link("/plain-english/discussions/")}>discussions tracker</a> for every provision's threads.
      </p>
    </section>
  )}

  <!-- 4 Flagship Portal Cards -->
  <section class="feature-portals-section">
    <div class="section-header">
      <h2>Explore Knowledge Hubs</h2>
      <p>Choose your entry point into current standards, next-generation drafts, and architectural shifts.</p>
    </div>

    <div class="portals-grid">
      <!-- Portal 1: WCAG 3 -->
      <a href={link("/plain-english/")} class="portal-card portal-wcag3">
        <div class="portal-card-glow"></div>
        <div class="portal-card-header">
          <div class="portal-icon-wrap icon-wcag3">✨</div>
          <span class="portal-tag tag-draft">W3C Draft Explorer</span>
        </div>
        <h3>WCAG 3 Plain English Explorer</h3>
        <p>Breakdown of all {wcag3Count} draft provisions across functional categories, upstream maturity status, and how the conformance model works in the current draft.</p>
        <div class="portal-metrics">
          <span class="metric-pill"><strong>{wcag3Count}</strong> Provisions</span>
          <span class="metric-pill">Reporting Tiers</span>
          <span class="metric-pill">Role Advice</span>
        </div>
        <span class="portal-cta">Launch WCAG 3 Explorer &rarr;</span>
      </a>

      <!-- Portal 2: WCAG 2.2 -->
      <a href={link("/plain-english/wcag22/")} class="portal-card portal-wcag22">
        <div class="portal-card-glow"></div>
        <div class="portal-card-header">
          <div class="portal-icon-wrap icon-wcag22">📘</div>
          <span class="portal-tag tag-standard">Current Official Standard</span>
        </div>
        <h3>WCAG 2.2 Reference Guide</h3>
        <p>All 86 WCAG 2.2 success criteria (plus the obsolete 4.1.1), each split into the normative floor, the usability gap and recommended best practice, with the criterion text quoted verbatim.</p>
        <div class="portal-metrics">
          <span class="metric-pill"><strong>{wcag22Count}</strong> Success Criteria</span>
          <span class="metric-pill">Level A / AA / AAA</span>
          <span class="metric-pill">Normative text verbatim</span>
        </div>
        <span class="portal-cta">Browse WCAG 2.2 Reference &rarr;</span>
      </a>

      <!-- Portal 3: WCAG 3 Score Calculator -->
      <a href={link("/plain-english/calculator/")} class="portal-card portal-calculator">
        <div class="portal-card-glow"></div>
        <div class="portal-card-header">
          <div class="portal-icon-wrap icon-calculator">🧮</div>
          <span class="portal-tag tag-interactive">Interactive Tool</span>
        </div>
        <h3>WCAG 3 Score Calculator</h3>
        <p>Interactive worksheet to evaluate draft provisions, check for core blockers, and estimate an illustrative Bronze, Silver or Gold reporting tier. The scoring is this site's own model, not W3C's.</p>
        <div class="portal-metrics">
          <span class="metric-pill">Bronze / Silver / Gold</span>
          <span class="metric-pill">9 site-defined categories</span>
          <span class="metric-pill">Export Report</span>
        </div>
        <span class="portal-cta">Launch Score Calculator &rarr;</span>
      </a>

      <!-- Portal 4: Conformance -->
      <a href={link("/plain-english/conformance/")} class="portal-card portal-removals">
        <div class="portal-card-glow"></div>
        <div class="portal-card-header">
          <div class="portal-icon-wrap icon-removals">⚖️</div>
          <span class="portal-tag tag-shift">Conformance Model</span>
        </div>
        <h3>Conformance: What Changed &amp; Readiness</h3>
        <p>WCAG 3 moved leveling off conformance and onto reporting. What that means against WCAG 2.2, and a checklist of what to start now versus what to wait on.</p>
        <div class="portal-metrics">
          <span class="metric-pill"><strong>6</strong> Reporting Tiers</span>
          <span class="metric-pill">One Conformance Bar</span>
          <span class="metric-pill">Readiness Checklist</span>
        </div>
        <span class="portal-cta">See What Changed &rarr;</span>
      </a>

      <!-- Portal 4: Removals & Shifts -->
      <a href={link("/plain-english/removals/")} class="portal-card portal-removals">
        <div class="portal-card-glow"></div>
        <div class="portal-card-header">
          <div class="portal-icon-wrap icon-removals">🔄</div>
          <span class="portal-tag tag-shift">2.2 vs 3 Evolution</span>
        </div>
        <h3>Removals & Architectural Shifts</h3>
        <p>How WCAG 2.2 concepts such as page-by-page pass/fail, A/AA/AAA levels and conforming alternate versions are being replaced, redesigned or left open in WCAG 3, with direct W3C debate links.</p>
        <div class="portal-metrics">
          <span class="metric-pill"><strong>{removalsCount}</strong> Major Shifts</span>
          <span class="metric-pill">Conformance Model</span>
          <span class="metric-pill">GitHub Debate Links</span>
        </div>
        <span class="portal-cta">Inspect Architectural Shifts &rarr;</span>
      </a>

      <!-- Portal 5: W3C Normative Specs -->
      <a href={link("/guidelines/")} class="portal-card portal-normative">
        <div class="portal-card-glow"></div>
        <div class="portal-card-header">
          <div class="portal-icon-wrap icon-normative">📜</div>
          <span class="portal-tag tag-normative">Upstream Standards View</span>
        </div>
        <h3>Official W3C Normative Specs</h3>
        <p>Read the raw, formal W3C working group specifications, informative guidelines, ACT test rules, and technical method documentation as drafted by W3C AGWG.</p>
        <div class="portal-metrics">
          <span class="metric-pill">Normative Guidelines</span>
          <span class="metric-pill">ACT Rules Catalog</span>
          <span class="metric-pill">Methods Registry</span>
        </div>
        <span class="portal-cta">View Raw W3C Specifications &rarr;</span>
      </a>
    </div>
  </section>

  <!-- Explore by Role Section -->
  <section class="role-launch-section">
    <div class="section-header">
      <h2>Explore Tailored Guidance by Role</h2>
      <p>Select your discipline to see how accessibility requirements directly impact your daily workflow.</p>
    </div>

    <div class="role-cards-grid">
      <!-- Designer -->
      <a href={link("/plain-english/comparison/")} class="role-card role-designer-card">
        <div class="role-header">
          <span class="role-icon">🎨</span>
          <h3>Designers</h3>
        </div>
        <p>Master color contrast ratios, focus indicator visibility, tap target dimensions, typography readability, dark mode tokens, and responsive layout reflow.</p>
        <div class="role-tag-list">
          <span>APCA Contrast</span>
          <span>Target Sizes (24x24 / 44x44)</span>
          <span>Motion Controls</span>
        </div>
        <span class="role-action-link">Explore Design Changes &rarr;</span>
      </a>

      <!-- Developer -->
      <a href={link("/plain-english/")} class="role-card role-developer-card">
        <div class="role-header">
          <span class="role-icon">💻</span>
          <h3>Developers</h3>
        </div>
        <p>Implement semantic HTML elements, manage ARIA live regions and attributes, avoid keyboard traps, ensure programmatic labels, and prevent focus obscuration.</p>
        <div class="role-tag-list">
          <span>Semantic HTML</span>
          <span>ARIA Patterns</span>
          <span>Keyboard Navigation</span>
        </div>
        <span class="role-action-link">Explore Developer Provisions &rarr;</span>
      </a>

      <!-- QA -->
      <a href={link("/plain-english/wcag22/")} class="role-card role-qa-card">
        <div class="role-header">
          <span class="role-icon">🧪</span>
          <h3>QA & Accessibility Testers</h3>
        </div>
        <p>Test against what each criterion's normative text actually requires, log usability gaps separately from WCAG failures, and use W3C's informative techniques for test procedures.</p>
        <div class="role-tag-list">
          <span>Automated Scans</span>
          <span>Screen Reader Audits</span>
          <span>Keyboard Traversal</span>
        </div>
        <span class="role-action-link">Start from the normative floor &rarr;</span>
      </a>

      <!-- PM -->
      <a href={link("/plain-english/conformance/")} class="role-card role-pm-card">
        <div class="role-header">
          <span class="role-icon">📋</span>
          <h3>Product Managers</h3>
        </div>
        <p>Understand legal compliance requirements (DOJ Title II, European Accessibility Act), follow how WCAG 3 conformance and reporting tiers are taking shape, and prioritize inclusive sprint backlogs.</p>
        <div class="role-tag-list">
          <span>Legal Compliance</span>
          <span>Reporting Tiers</span>
          <span>Readiness Checklist</span>
        </div>
        <span class="role-action-link">View Conformance Readiness &rarr;</span>
      </a>
    </div>
  </section>

  <!-- Live Status & Stats Bar -->
  <section class="live-metrics-bar">
    <div class="metric-item">
      <span class="metric-number">{wcag3Count}</span>
      <span class="metric-label">WCAG 3 Provisions</span>
    </div>
    <div class="metric-divider" aria-hidden="true"></div>
    <div class="metric-item">
      <span class="metric-number">{wcag22Count}</span>
      <span class="metric-label">WCAG 2.2 Criteria</span>
    </div>
    <div class="metric-divider" aria-hidden="true"></div>
    <div class="metric-item">
      <span class="metric-number">{removalsCount}</span>
      <span class="metric-label">Tracked Shifts</span>
    </div>
    <div class="metric-divider" aria-hidden="true"></div>
    <div class="metric-item">
      <span class="metric-number">4</span>
      <span class="metric-label">Tailored Roles</span>
    </div>
    <div class="metric-divider" aria-hidden="true"></div>
    <div class="metric-item">
      <span class="metric-number highlight-sync">{syncedOn ?? "Weekly"}</span>
      <span class="metric-label">Last W3C Sync</span>
    </div>
  </section>
</PlainEnglishLayout>

<style>

  /* This week at the W3C */
  .weekly-news {
    max-width: 1200px;
    margin: 0 auto 64px;
    padding: 28px 28px 24px;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
  }
  .weekly-news-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 8px 24px;
    margin-bottom: 18px;
  }
  .weekly-kicker {
    margin: 0 0 4px;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-accent);
  }
  .weekly-news h2 {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--text-pure);
  }
  .weekly-sync {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .weekly-news a { color: var(--text-accent); text-decoration: underline; text-underline-offset: 2px; }
  .weekly-news a:hover { text-decoration-thickness: 2px; }
  .weekly-news code { font-family: var(--font-mono); font-size: 0.85em; }
  .weekly-note {
    border-left: 4px solid var(--accent-blue);
    background: var(--surface-subtle);
    border-radius: var(--radius-md);
    padding: 16px 20px;
    margin-bottom: 18px;
  }
  .weekly-note h3 {
    margin: 0 0 10px;
    font-size: 1.15rem;
    color: var(--text-pure);
  }
  .weekly-note ul { margin: 0; padding-left: 1.2em; }
  .weekly-note li {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 6px;
  }
  .weekly-refs { white-space: normal; color: var(--text-muted); }
  .weekly-counts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: 0 0 20px;
  }
  .weekly-counts li {
    border: 1px solid var(--border-default);
    border-radius: var(--radius-full);
    padding: 4px 14px;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }
  .weekly-counts strong { color: var(--text-pure); }
  .weekly-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 20px;
  }
  .weekly-col {
    min-width: 0;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 16px 18px;
    background: var(--surface-base);
  }
  .weekly-col h3 {
    margin: 0 0 4px;
    font-size: 1.05rem;
    color: var(--text-pure);
  }
  .weekly-col-count { color: var(--text-muted); font-weight: 400; }
  .weekly-hint, .weekly-empty {
    margin: 0 0 12px;
    font-size: 0.86rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
  .weekly-items { list-style: none; margin: 0; padding: 0; }
  .weekly-item {
    padding: 10px 0;
    border-top: 1px solid var(--border-subtle);
  }
  .weekly-item-title {
    display: block;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }
  .weekly-num { font-family: var(--font-mono); font-size: 0.9em; }
  .weekly-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 6px;
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .weekly-topic, .weekly-prov, .weekly-prov-more {
    border: 1px solid var(--border-default);
    border-radius: var(--radius-full);
    padding: 1px 8px;
    color: var(--text-secondary);
  }
  .weekly-news a.weekly-prov { color: var(--text-accent); text-decoration: none; }
