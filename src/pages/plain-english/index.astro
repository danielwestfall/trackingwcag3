---
import PlainEnglishLayout from "@/layouts/PlainEnglishLayout.astro";
import fs from "fs";
import path from "path";

// Load compiled catalog
const catalogPath = path.join(process.cwd(), "public", "data", "wcag3-catalog.json");
let catalog: any[] = [];
if (fs.existsSync(catalogPath)) {
  catalog = JSON.parse(fs.readFileSync(catalogPath, "utf8"));
}

const totalCount = catalog.length;
const matureCount = catalog.filter((item) => item.status === "mature" || item.status === "refining").length;
const customAnnotatedCount = catalog.filter((item) => item.annotation && !item.annotation.plainEnglish?.summary?.endsWith("...")).length;

// Type counts, read from the catalog rather than written into the prose below.
// The site previously hardcoded 219 provisions in five places and went stale.
const typeCounts: Record<string, number> = {};
for (const item of catalog) typeCounts[item.type] = (typeCounts[item.type] || 0) + 1;
const typeBreakdown = Object.entries(typeCounts)
  .sort((a, b) => b[1] - a[1])
  .map(([t, n]) => `${n} ${t}`)
  .join(', ');
const refiningOrBetter = catalog.filter((i) => i.status === 'refining' || i.status === 'mature').length;

const GROUP_NAMES: Record<string, string> = {
  'animation-and-movement': '🎬 Animation & Movement',
  'consistency-across-views': '🔄 Consistency Across Views',
  'error-handling': '⚠️ Error Handling',
  'help-and-feedback': '❓ Help & Feedback',
  'images-and-media': '🖼️ Images & Media',
  'input-operation': '⌨️ Input & Operation',
  'interactive-components': '🎛️ Interactive Components',
  'layout': '📐 Layout & Structure',
  'policy-and-protection': '🛡️ Policy & Protection',
  'process-and-task-completion': '📋 Process & Task Completion',
  'text-and-wording': '📝 Text & Wording',
  'user-control': '⚙️ User Control & Settings'
};

const groupedCategories: { slug: string; name: string; items: any[] }[] = [];
const groupMap: Record<string, any[]> = {};

catalog.forEach((item) => {
  const gSlug = item.groupSlug || 'general';
  if (!groupMap[gSlug]) groupMap[gSlug] = [];
  groupMap[gSlug].push(item);
});

Object.keys(groupMap).sort().forEach((gSlug) => {
  groupedCategories.push({
    slug: gSlug,
    name: GROUP_NAMES[gSlug] || gSlug.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()),
    items: groupMap[gSlug]
  });
});

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (path: string) => `${base}${path.startsWith('/') ? path : '/' + path}`;
---

<PlainEnglishLayout title="WCAG 3 Plain English Explorer" activeTab="wcag3">
  <!-- Quick Nav TOC Floating Toggle & Drawer -->
  <button id="toc-toggle-btn" class="toc-toggle-btn" aria-expanded="false" aria-controls="toc-drawer" aria-label="Toggle Quick Navigation Table of Contents">
    <span class="toc-btn-icon" aria-hidden="true">📋</span>
    <span class="toc-btn-text">Quick Nav (TOC)</span>
    <span id="toc-count-badge" class="toc-count-badge">{totalCount}</span>
  </button>

  <aside id="toc-drawer" class="toc-drawer" aria-label="Table of Contents Quick Navigation" hidden>
    <div class="toc-header">
      <div class="toc-title-group">
        <h2>📋 Table of Contents</h2>
        <span class="toc-subtitle">Jump to any of the {totalCount} provisions</span>
      </div>
      <button id="toc-close-btn" class="toc-close-btn" aria-label="Close Table of Contents">&times;</button>
    </div>

    <div class="toc-search-box">
      <input type="text" id="toc-search-input" placeholder={`Filter ${totalCount} items...`} aria-label="Filter Table of Contents items" />
    </div>

    <div class="toc-categories-list">
      {groupedCategories.map((group) => (
        <details class="toc-category-details" open data-cat-block={group.slug}>
          <summary class="toc-category-summary">
            <span class="cat-name">{group.name}</span>
            <span class="cat-count-badge" data-cat-slug={group.slug}>{group.items.length}</span>
          </summary>
          <ul class="toc-items-list">
            {group.items.map((item) => (
              <li data-toc-item-slug={item.slug}>
                <a href={`#provision-${item.slug}`} class="toc-item-link" data-slug={item.slug}>
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </div>
  </aside>

  <!-- Hero Dashboard Banner -->
  <section class="dashboard-banner">
    <div class="banner-content">
      <div class="banner-title-group">
        <div class="banner-badge">
          <span class="sparkle">✨</span>
          <span>Draft Standards Intelligence</span>
        </div>
        <h1>WCAG 3 Plain English Explorer</h1>
        <p>A plain-English educational view of the W3C WCAG 3 draft standards with release estimations, testing guides, and WCAG 2.2 comparison mappings.</p>
      </div>
      
      <div class="stats-grid">
        <div class="stat-card">
          <span class="stat-value">{totalCount}</span>
          <span class="stat-label">W3C Provisions</span>
        </div>
        <div class="stat-card stat-mature">
          <span class="stat-value highlight-mature">{matureCount}</span>
          <span class="stat-label">Refining / Mature</span>
        </div>
        <div class="stat-card stat-annotated">
          <span class="stat-value highlight-annotated">{customAnnotatedCount}</span>
          <span class="stat-label">Plain English Guides</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Conformance model: reporting tiers (replaced the old Bronze/Silver/Gold rating framing) -->
  <section class="rating-model-banner">
    <div class="rating-header">
      <div class="rating-title-group">
        <div class="rating-title-row">
          <span class="rating-icon" aria-hidden="true">⚖️</span>
          <h2>How WCAG 3 Conformance Works: One Bar, Six Reporting Tiers</h2>
        </div>
        <p>The Sep 2026 draft moved leveling off conformance and onto reporting. There is no A/AA/AAA successor — you either meet all core requirements or you do not.</p>
      </div>
    </div>

    <div class="rating-qa-box">
      <div class="qa-icon" aria-hidden="true">💡</div>
      <div class="qa-text">
        <strong>Are Bronze, Silver and Gold the conformance levels?</strong>
        <p><strong>Not any more.</strong> In this draft they are reporting tiers that sit <em>above</em> conformance. Conformance is tier 3 — all core requirements met. Tiers 1–2 describe progress toward it; tiers 4–6 describe achievement beyond it. The working group is also weighing a competing proposal that would score progress and then award Bronze/Silver/Gold, and has asked for public comment on which to keep, so treat the table below as the current direction rather than a settled outcome.</p>
      </div>
    </div>

    <div class="rating-tiers-grid">
      <div class="tier-card tier-bronze">
        <div class="tier-top">
          <div class="tier-badge">🛡️ Tiers 1–2</div>
          <span class="tier-score-target">Progress toward conformance</span>
        </div>
        <h3>Avoid Physical Harm, then Foundational Access</h3>
        <div class="tier-progress-bar">
          <div class="tier-progress-fill fill-bronze"></div>
        </div>
        <ul class="tier-features">
          <li><strong>Tier 1:</strong> Physical harm and risk requirements are met.</li>
          <li><strong>Tier 2:</strong> …plus barrier requirements — things that stop someone proceeding.</li>
          <li><strong>Role:</strong> Reportable milestones on the way to conformance, not conformance itself.</li>
        </ul>
      </div>

      <div class="tier-card tier-silver">
        <div class="tier-top">
          <div class="tier-badge">✅ Tier 3</div>
          <span class="tier-score-target">This is conformance</span>
        </div>
        <h3>Conformance</h3>
        <div class="tier-progress-bar">
          <div class="tier-progress-fill fill-silver"></div>
        </div>
        <ul class="tier-features">
          <li><strong>Requirement:</strong> …plus friction requirements — all core requirements are met.</li>
          <li><strong>Evaluation:</strong> Methods used must be accessibility supported, and the accessibility support set must be stated in any claim.</li>
          <li><strong>Role:</strong> The single conformance bar. Claims are optional; content can conform without one.</li>
        </ul>
      </div>

      <div class="tier-card tier-gold">
        <div class="tier-top">
          <div class="tier-badge">🏅 Tiers 4–6</div>
          <span class="tier-score-target">Beyond conformance</span>
        </div>
        <h3>Bronze, Silver, Gold</h3>
        <div class="tier-progress-bar">
          <div class="tier-progress-fill fill-gold"></div>
        </div>
        <ul class="tier-features">
          <li><strong>Bronze / Silver:</strong> …plus a to-be-decided number of supplemental requirements and assertions about content.</li>
          <li><strong>Gold:</strong> …plus assertions about the organization itself.</li>
          <li><strong>Role:</strong> Not required to conform, but the substance a regulator or procurement process is most likely to ask for.</li>
        </ul>
      </div>
    </div>

    <p class="rating-tier-caveat">
      Tier placement is driven by tagging each core requirement as <em>physical harm</em>, <em>barrier</em> or <em>friction</em>.
      <strong>No provision in the draft carries such a tag yet</strong>, so no one — including this site — can currently tell you which tier a given provision falls into.
      <a href={link("/plain-english/conformance/")}>See the full conformance breakdown and readiness checklist &rarr;</a>
    </p>


    <!-- Accordion: Current W3C Status on Base Requirements -->
    <details class="w3c-status-accordion">
      <summary class="accordion-summary">
        <span class="summary-icon" aria-hidden="true">🔍</span>
        <span class="summary-title">Are the WCAG 3 base requirements finalized yet? (Current W3C Working Group Status)</span>
        <span class="accordion-chevron" aria-hidden="true">&darr;</span>
      </summary>
      <div class="accordion-body">
        <p class="accordion-lead"><strong>Short Answer: No, they are still actively in progress by the W3C AGWG.</strong></p>
        
        <div class="status-table-container">
          <table class="w3c-status-table">
            <thead>
              <tr>
                <th scope="col">Component</th>
                <th scope="col">W3C Development Status</th>
                <th scope="col">Details</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Mandatory "Core" List</strong></td>
                <td><span class="status-badge badge-wip">🛠️ In Progress</span></td>
                <td>Of {totalCount} provisions: {typeBreakdown}. {refiningOrBetter === 0 ? "Nothing has reached" : `${refiningOrBetter} have reached`} <em>refining</em> maturity{refiningOrBetter === 0 ? "" : " or better"}.</td>
              </tr>
              <tr>
                <td><strong>Tier Tagging</strong></td>
                <td><span class="status-badge badge-wip">🛠️ In Progress</span></td>
                <td>Core requirements must be tagged <em>physical harm</em>, <em>barrier</em> or <em>friction</em> to place them in reporting tiers. Zero of 245 provisions carry a tag so far.</td>
              </tr>
              <tr>
                <td><strong>Policy Guidance</strong></td>
                <td><span class="status-badge badge-wip">🛠️ In Progress</span></td>
                <td>AG WG plans separate informative advice for policymakers on using reporting tiers in regulation. Not yet written.</td>
              </tr>
              <tr>
                <td><strong>Structural Framework</strong></td>
                <td><span class="status-badge badge-done">✅ Drafted</span></td>
                <td>Agreed 3-tier hierarchy: <em>Guideline &rarr; Outcome &rarr; Method (Testable Rules)</em>.</td>
              </tr>
              <tr>
                <td><strong>{totalCount} Draft Provisions</strong></td>
                <td><span class="status-badge badge-done">✅ Drafted</span></td>
                <td>The {totalCount} provisions in this app are synced from W3C's active draft repository. None have reached <em>refining</em> or <em>mature</em> status yet.</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="w3c-notice-box">
          <strong>⚠️ Official W3C Recommendation Notice:</strong>
          <p>WCAG 3.0 is an exploratory W3C Working Draft. Organizations must continue to use <strong>WCAG 2.2</strong> as the official standard for legal compliance while monitoring WCAG 3.0 for future roadmap planning.</p>
        </div>
      </div>
    </details>
  </section>

  <!-- Controls & Filters -->
  <section class="controls-section" aria-label="Filters and Search Controls">
    <div class="search-box">
      <span class="search-icon" aria-hidden="true">🔍</span>
      <input type="text" id="search-input" placeholder="Search WCAG 3 provisions by keyword, topic, or code... (Press '/' to focus)" aria-label="Search provisions" />
      <span class="search-key-badge"><kbd>/</kbd></span>
    </div>

    <div class="filter-bar">
      <div class="filter-group">
        <span class="filter-label">Requirement Type:</span>
        <div class="type-pills" id="type-pills" role="radiogroup" aria-label="Filter by requirement type">
          <button type="button" class="type-pill active" data-type="all" role="radio" aria-checked="true">All ({totalCount})</button>
          <button type="button" class="type-pill" data-type="foundational" role="radio" aria-checked="false">Foundational ({typeCounts['foundational'] || 114})</button>
          <button type="button" class="type-pill" data-type="supplemental" role="radio" aria-checked="false">Supplemental ({typeCounts['supplemental'] || 86})</button>
          <button type="button" class="type-pill" data-type="assertion" role="radio" aria-checked="false">Assertion ({typeCounts['assertion'] || 36})</button>
        </div>
      </div>

      <div class="filter-group select-filters">
        <label for="category-filter" class="sr-only">Filter by Category</label>
        <select id="category-filter" class="filter-select" aria-label="Filter by Functional Category">
          <option value="all">All Categories ({groupedCategories.length})</option>
          {groupedCategories.map((g) => (
            <option value={g.slug}>{g.name} ({g.items.length})</option>
          ))}
        </select>

        <label for="status-filter" class="sr-only">Filter by Status</label>
        <select id="status-filter" class="filter-select" aria-label="Filter by W3C Status">
          <option value="all">All W3C Statuses</option>
          <option value="mature">Mature</option>
          <option value="refining">Refining</option>
          <option value="developing">Developing</option>
          <option value="exploratory">Exploratory</option>
        </select>

      </div>
    </div>
  </section>

  <!-- Provisions Grid -->
  <section class="provisions-section">
    <div class="grid-header">
      <h2 id="result-count">Showing {totalCount} Provisions</h2>
    </div>

    <div class="provisions-grid" id="provisions-grid">
      {catalog.map((item) => {
        const ann = item.annotation;
        const status = item.status || "exploratory";
        const groupSlug = item.groupSlug || "general";
        
        return (
          <article 
            id={`provision-${item.slug}`}
            class="provision-card" 
            data-slug={item.slug}
            data-group={groupSlug}
            data-type={(item.type || "").toLowerCase()}
            data-title={item.title.toLowerCase()}
            data-body={item.rawBody.toLowerCase()}
            data-status={status}
            data-summary={ann?.plainEnglish?.summary?.toLowerCase() || ""}
          >
            <div class="card-top">
              <div class="badge-group">
                <span class={`status-badge status-${status}`}>{status}</span>
                <span class="type-badge">{item.type || "Provision"}</span>
                <span class="group-tag">{GROUP_NAMES[groupSlug] || groupSlug}</span>
              </div>
              {item.derived?.sources?.provision && (
                <a
                  href={`https://github.com/w3c/wcag3/blob/main/${item.derived.sources.provision}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="card-w3c-link"
                  title="Review upstream source markdown on official W3C GitHub"
                  aria-label={`Review upstream W3C source for ${item.title}`}
                >
                  W3C Source ↗
                </a>
              )}
            </div>

            <h3 class="card-title">
              <a href={link(`/plain-english/provision/${item.slug}/`)}>{item.title}</a>
            </h3>

            <p class="plain-english-text">{ann?.plainEnglish?.summary}</p>

            {ann?.plainEnglish?.whyItMatters && (
              <div class="why-matters-box">
                <span class="why-matters-label">💡 Why It Matters:</span>
                <p class="why-matters-text">{ann.plainEnglish.whyItMatters}</p>
              </div>
            )}

            <div class="card-footer">
              <div class="wcag22-links">
                {item.wcag22Inbound?.direct?.length > 0 ? (
                  <span>Predecessors: <strong>{item.wcag22Inbound.direct.join(", ")}</strong></span>
                ) : item.wcag22Inbound?.viaGuideline?.length > 0 ? (
                  <span>Guideline: <strong>{item.wcag22Inbound.viaGuideline.join(", ")}</strong></span>
                ) : (
                  <span>New in WCAG 3</span>
                )}
              </div>
              <a href={link(`/plain-english/provision/${item.slug}/`)} class="read-more-btn">
                Full Guide & Tests &rarr;
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</PlainEnglishLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('search-input');
    const typePills = document.querySelectorAll('.type-pill');
    const categoryFilter = document.getElementById('category-filter');
    const statusFilter = document.getElementById('status-filter');
    const cards = document.querySelectorAll('.provision-card');
    const resultCount = document.getElementById('result-count');

    let activeType = 'all';

    // Parse URL params (?q=... and ?type=...)
    const urlParams = new URLSearchParams(window.location.search);
    const initialQuery = urlParams.get('q');
    const initialType = urlParams.get('type');

    if (initialQuery && searchInput) {
      searchInput.value = initialQuery;
    }

    if (initialType) {
      typePills.forEach(pill => {
        if (pill.getAttribute('data-type') === initialType) {
          typePills.forEach(p => {
            p.classList.remove('active');
            p.setAttribute('aria-checked', 'false');
          });
          pill.classList.add('active');
          pill.setAttribute('aria-checked', 'true');
          activeType = initialType;
        }
      });
    }

    // Type Pills Click
    typePills.forEach(pill => {
      pill.addEventListener('click', () => {
        typePills.forEach(p => {
          p.classList.remove('active');
          p.setAttribute('aria-checked', 'false');
        });
        pill.classList.add('active');
        pill.setAttribute('aria-checked', 'true');
        activeType = pill.getAttribute('data-type');
        filterCards();
      });
    });

    // Keyboard shortcut '/' to search
    window.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput && document.activeElement !== tocSearchInput) {
        e.preventDefault();
        searchInput.focus();
        searchInput.select();
      }
      if (e.key === 'Escape') {
        toggleToc(false);
      }
    });

    function filterCards() {
      const query = searchInput.value.toLowerCase().trim();
      const selectedCategory = categoryFilter ? categoryFilter.value : 'all';
      const selectedStatus = statusFilter.value;

      let visible = 0;

      cards.forEach(card => {
        const title = card.getAttribute('data-title') || '';
        const body = card.getAttribute('data-body') || '';
        const summary = card.getAttribute('data-summary') || '';
        const group = card.getAttribute('data-group') || '';
        const status = card.getAttribute('data-status') || '';
        const type = card.getAttribute('data-type') || '';

        const matchesQuery = !query || title.includes(query) || body.includes(query) || summary.includes(query);
        const matchesCategory = selectedCategory === 'all' || group === selectedCategory;
        const matchesStatus = selectedStatus === 'all' || status === selectedStatus;
        const matchesType = activeType === 'all' || type === activeType;

        if (matchesQuery && matchesCategory && matchesStatus && matchesType) {
          card.style.display = 'flex';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      resultCount.textContent = `Showing ${visible} of ${cards.length} Provisions`;
      updateTocVisibility();
    }

    // TOC Elements
    const tocToggleBtn = document.getElementById('toc-toggle-btn');
    const tocCloseBtn = document.getElementById('toc-close-btn');
    const tocDrawer = document.getElementById('toc-drawer');
    const tocSearchInput = document.getElementById('toc-search-input');
    const tocCountBadge = document.getElementById('toc-count-badge');
    const tocItemLinks = document.querySelectorAll('.toc-item-link');

    function toggleToc(show) {
      const isVisible = show !== undefined ? show : tocDrawer.hasAttribute('hidden');
      if (isVisible) {
        tocDrawer.removeAttribute('hidden');
        tocToggleBtn.setAttribute('aria-expanded', 'true');
        if (tocSearchInput) tocSearchInput.focus();
      } else {
        tocDrawer.setAttribute('hidden', '');
        tocToggleBtn.setAttribute('aria-expanded', 'false');
      }
    }

    if (tocToggleBtn) tocToggleBtn.addEventListener('click', () => toggleToc());
    if (tocCloseBtn) tocCloseBtn.addEventListener('click', () => toggleToc(false));

    // Jump Link Smooth Scroll & Pulse Highlight
    tocItemLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        const slug = link.getAttribute('data-slug');
        const targetCard = document.getElementById(`provision-${slug}`);
        if (targetCard) {
          e.preventDefault();
          targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
          targetCard.classList.add('pulse-highlight');
          setTimeout(() => targetCard.classList.remove('pulse-highlight'), 2000);
          if (window.innerWidth < 768) {
            toggleToc(false);
          }
        }
      });
    });

    // Filter TOC Items with main search & TOC inner search
    function updateTocVisibility() {
      const innerQuery = tocSearchInput ? tocSearchInput.value.toLowerCase().trim() : '';
      let visibleTocCount = 0;

      document.querySelectorAll('[data-cat-block]').forEach(catBlock => {
        let catVisible = 0;
        catBlock.querySelectorAll('[data-toc-item-slug]').forEach(itemLi => {
          const slug = itemLi.getAttribute('data-toc-item-slug');
          const card = document.getElementById(`provision-${slug}`);
          const linkText = itemLi.textContent.toLowerCase();
          
          const cardIsVisible = card && card.style.display !== 'none';
          const matchesInnerSearch = !innerQuery || linkText.includes(innerQuery);

          if (cardIsVisible && matchesInnerSearch) {
            itemLi.style.display = 'block';
            catVisible++;
            visibleTocCount++;
          } else {
            itemLi.style.display = 'none';
          }
        });

        const countBadge = catBlock.querySelector('.cat-count-badge');
        if (countBadge) countBadge.textContent = catVisible;
        catBlock.style.display = catVisible > 0 ? 'block' : 'none';
      });

      if (tocCountBadge) tocCountBadge.textContent = visibleTocCount;
    }

    if (tocSearchInput) tocSearchInput.addEventListener('input', updateTocVisibility);

    searchInput.addEventListener('input', filterCards);
    if (categoryFilter) categoryFilter.addEventListener('change', filterCards);
    statusFilter.addEventListener('change', filterCards);

    // Initial trigger
    filterCards();
  });
</script>

<style>
  /* Dashboard Banner */
  .dashboard-banner {
    background: linear-gradient(135deg, rgba(19, 29, 49, 0.9) 0%, rgba(11, 17, 32, 0.95) 100%);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    padding: 32px 36px;
    margin-bottom: 28px;
    box-shadow: var(--shadow-sm);
  }

  .banner-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }

  .banner-badge {
    /* 200% text scale: let this badge wrap its own label instead of
       widening the page. Same component exists on several pages. */
    flex-wrap: wrap;
    max-width: 100%;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(56, 189, 248, 0.12);
    color: var(--accent-blue);
    border: 1px solid rgba(56, 189, 248, 0.28);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    margin-bottom: 12px;
  }

  /* The title block is a flex item, so it defaults to min-width: auto and
     refuses to shrink below its longest line. At 200% text scale that line is
     wider than a phone viewport and the page scrolls sideways. Letting it
     shrink lets the heading wrap instead. */
  .banner-title-group {
    min-width: 0;
  }

  .banner-title-group h1,
  .banner-title-group h2 {
    font-size: 1.9rem;
    font-weight: 800;
    margin-bottom: 8px;
    color: var(--text-pure);
    letter-spacing: -0.025em;
  }

  .banner-title-group p {
    color: var(--text-secondary);
    max-width: 620px;
    font-size: 0.98rem;
    line-height: 1.6;
  }

  .stats-grid {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .stat-card {
    background: rgba(7, 11, 20, 0.65);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: 14px 18px;
    text-align: center;
    min-width: 125px;
    transition: var(--transition-fast);
  }
  .stat-card:hover {
    border-color: var(--border-active);
    transform: translateY(-2px);
  }

  .stat-value {
    display: block;
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--text-pure);
    font-family: var(--font-mono);
    line-height: 1.2;
    margin-bottom: 2px;
  }
  .highlight-mature { color: var(--accent-emerald); }
  .highlight-high { color: var(--accent-blue); }
  .highlight-annotated { color: var(--accent-purple); }

  .stat-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Rating Model Breakdown Styling */
  .rating-model-banner {
    background: linear-gradient(135deg, rgba(19, 29, 49, 0.75) 0%, rgba(11, 17, 32, 0.9) 100%);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    padding: 28px 32px;
    margin-bottom: 28px;
  }

  /* A flex child of a wrapping row still needs permission to shrink. */
  .rating-title-row  h2,
  .rating-title-row  h3 { min-width: 0; }

  .rating-title-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 4px;
    /* Flex row with a non-shrinkable text child: at 200% text scale the row
       cannot shrink and pushes the page sideways. Let it wrap. */
    flex-wrap: wrap;
  }

  .rating-icon {
    font-size: 1.5rem;
  }

  .rating-header  h2,
  .rating-header  h3 {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-pure);
    letter-spacing: -0.015em;
  }

  .rating-header p {
    color: var(--text-secondary);
    font-size: 0.92rem;
    margin-bottom: 18px;
  }

  .rating-qa-box {
    /* Wrap rather than force the page sideways at 200% text scale. */
    flex-wrap: wrap;
    display: flex;
    gap: 14px;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.22);
    border-radius: var(--radius-md);
    padding: 16px 20px;
    margin-bottom: 22px;
  }
  .qa-icon { font-size: 1.4rem; flex-shrink: 0; }
  /* Flex item: min-width: auto would refuse to shrink below its longest
     line, which at 200% text scale exceeds a phone viewport. */
  .qa-text { min-width: 0; }

  .qa-text strong {
    display: block;
    color: var(--accent-blue);
    font-size: 0.96rem;
    margin-bottom: 4px;
  }
  .qa-text p {
    color: var(--text-secondary);
    font-size: 0.88rem;
    margin: 0;
    line-height: 1.55;
  }

  .rating-tier-caveat {
    margin: 1.25rem 0 0;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border-default);
    border-radius: 10px;
    background: var(--surface-subtle);
    color: var(--text-secondary);
    line-height: 1.65;
    font-size: 0.94rem;
  }

  .rating-tier-caveat strong {
    color: var(--text-primary);
  }

  .rating-tier-caveat a {
    color: var(--border-active);
    font-weight: 600;
  }

  .rating-tiers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 18px;
  }

  .tier-card {
    background: rgba(7, 11, 20, 0.75);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: 22px;
    position: relative;
    transition: var(--transition-normal);
  }
  .tier-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-active);
  }

  .tier-bronze { border-top: 4px solid var(--tier-bronze); }
  .tier-silver { border-top: 4px solid var(--tier-silver); }
  .tier-gold { border-top: 4px solid var(--tier-gold); }

  .tier-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .tier-badge {
    font-size: 1.05rem;
    font-weight: 800;
  }
  .tier-bronze .tier-badge { color: var(--tier-bronze); }
  .tier-silver .tier-badge { color: var(--tier-silver); }
  .tier-gold .tier-badge { color: var(--tier-gold); }

  .tier-score-target {
    font-size: 0.72rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  .tier-progress-bar {
    height: 6px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 9999px;
    margin-bottom: 14px;
    overflow: hidden;
  }

  .tier-progress-fill {
    height: 100%;
    border-radius: 9999px;
  }
  .fill-bronze { width: 65%; background: var(--tier-bronze); }
  .fill-silver { width: 85%; background: var(--tier-silver); }
  .fill-gold { width: 100%; background: var(--tier-gold); }

  .tier-card  h3,
  .tier-card  h4 {
    font-size: 1.02rem;
    font-weight: 700;
    color: var(--text-pure);
    margin-bottom: 12px;
  }

  .tier-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
  .tier-features strong { color: var(--text-primary); }

  /* W3C Status Accordion Styling */
  .w3c-status-accordion {
    margin-top: 22px;
    background: rgba(7, 11, 20, 0.65);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .accordion-summary {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    cursor: pointer;
    font-size: 0.94rem;
    font-weight: 700;
    color: var(--accent-purple);
    user-select: none;
    background: rgba(192, 132, 252, 0.06);
    transition: var(--transition-fast);
  }
  .accordion-summary:hover {
    background: rgba(192, 132, 252, 0.12);
  }
  .accordion-summary::-webkit-details-marker { display: none; }
  
  .summary-icon { font-size: 1.1rem; }
  .summary-title { flex: 1; }
  .accordion-chevron {
    font-size: 1rem;
    color: var(--text-muted);
    transition: transform 0.2s ease;
  }
  details[open] .accordion-chevron {
    transform: rotate(180deg);
  }

  .accordion-body {
    padding: 20px;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .accordion-lead {
    font-size: 0.95rem;
    margin-bottom: 12px;
    color: var(--text-primary);
  }

  .status-table-container {
    overflow-x: auto;
    margin: 16px 0;
  }

  .w3c-status-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
  }
  .w3c-status-table th, .w3c-status-table td {
    padding: 10px 14px;
    border: 1px solid var(--border-default);
    text-align: left;
  }
  .w3c-status-table th {
    background: rgba(19, 29, 49, 0.9);
    color: var(--text-pure);
    font-weight: 700;
  }
  /* --text-pure is near-black in light mode, so this near-black header was
     dark-on-dark at 1.42:1. Give light mode a light header instead. */
  :global(html[data-theme="light"]) .w3c-status-table th {
    background: #e2e8f0;
    color: var(--text-primary);
  }

  .status-badge {
    display: inline-block;
    padding: 3px 9px;
    border-radius: var(--radius-sm);
    font-size: 0.72rem;
    font-weight: 700;
  }
  .badge-wip {
    background: rgba(251, 191, 36, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(251, 191, 36, 0.3);
  }
  .badge-done {
    background: rgba(52, 211, 153, 0.15);
    color: #34d399;
    border: 1px solid rgba(52, 211, 153, 0.3);
  }

  .w3c-notice-box {
    margin-top: 16px;
    background: rgba(244, 63, 94, 0.08);
    border: 1px solid rgba(244, 63, 94, 0.25);
    border-radius: var(--radius-md);
    padding: 14px 18px;
  }
  .w3c-notice-box strong {
    color: #fb7185;
  }
  :global(html[data-theme="light"]) .w3c-notice-box strong {
    color: var(--accent-rose);
    display: block;
    margin-bottom: 4px;
  }
  .w3c-notice-box p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.86rem;
  }

  /* Controls Section */
  .controls-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 28px;
  }

  .search-box {
    position: relative;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .search-key-badge {
    position: absolute;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
  }

  .search-box input {
    width: 100%;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: 16px 50px 16px 50px;
    color: var(--text-primary);
    font-size: 1rem;
    font-family: var(--font-sans);
    transition: var(--transition-normal);
  }
  .search-box input:focus {
    border-color: var(--accent-blue);
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.25);
    outline: none;
  }

  .filter-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    /* A flex item defaults to min-width: auto, which refuses to shrink below
       its widest child — here a <select> sized by its longest option. That
       floor is what max-width: 100% on the select resolves against, so the cap
       alone does nothing until this row is allowed to shrink too. Same fix as
       .header-left in the layout. */
    min-width: 0;
  }

  .filter-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-secondary);
  }

  .type-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .type-pill {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    color: var(--text-secondary);
    padding: 7px 14px;
    border-radius: var(--radius-full);
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition-fast);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .type-pill:hover {
    border-color: var(--accent-blue);
    color: var(--text-primary);
  }
  .type-pill.active {
    background: var(--accent-blue);
    color: var(--on-accent);
    border-color: var(--accent-blue);
    font-weight: 700;
    box-shadow: 0 2px 8px rgba(56, 189, 248, 0.35);
  }

  .select-filters {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .filter-select {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    color: var(--text-primary);
    padding: 9px 14px;
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    cursor: pointer;
    font-family: var(--font-sans);
    transition: var(--transition-fast);
    /* A select is sized by its widest option, and nothing here caps it, so a
       long option label can push it past the viewport — the same "can't shrink
       below its content" failure as the grid floors, in a form control. Caught
       at 320px under WCAG 1.4.12 text-spacing, which widens every option. */
    max-width: 100%;
    min-width: 0;
  }
  .filter-select:focus {
    border-color: var(--accent-blue);
    outline: none;
  }

  /* Grid */
  .provisions-section {
    margin-top: 12px;
  }

  .grid-header {
    margin-bottom: 18px;
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  .provisions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(360px, 100%), 1fr));
    gap: 22px;
  }

  .provision-card {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .provision-card:hover {
    border-color: var(--accent-blue);
    transform: translateY(-3px);
    box-shadow: 0 14px 28px -10px rgba(0, 0, 0, 0.6), 0 0 20px rgba(56, 189, 248, 0.12);
  }

  .card-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 14px;
  }

  .badge-group {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    align-items: center;
  }

  .status-badge {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 4px;
  }
  .status-mature { background: rgba(52, 211, 153, 0.15); color: #34d399; border: 1px solid rgba(52, 211, 153, 0.3); }
  .status-refining { background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); }
  .status-developing { background: rgba(251, 191, 36, 0.15); color: #fbbf24; border: 1px solid rgba(251, 191, 36, 0.3); }
  .status-exploratory { background: rgba(244, 63, 94, 0.15); color: #fb7185; border: 1px solid rgba(244, 63, 94, 0.3); }

  .delta-badge {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
  }
  .delta-morestrict { background: rgba(192, 132, 252, 0.15); color: #c084fc; border: 1px solid rgba(192, 132, 252, 0.3); }
  .delta-equivalent { background: rgba(148, 163, 184, 0.15); color: #94a3b8; border: 1px solid rgba(148, 163, 184, 0.3); }
  .delta-newbroaderscope { background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); }

  .group-tag {
    font-size: 0.68rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    padding: 3px 7px;
    border-radius: 4px;
  }

  .estimation-pill {
    font-size: 0.72rem;
    background: rgba(7, 11, 20, 0.7);
    padding: 3px 8px;
    border-radius: 6px;
    border: 1px solid var(--border-subtle);
    /* Keeping "Medium (70-89%)" on one line is a nicety; at 200% text scale it
       is what pushes the card past the viewport. Let it wrap when it must. */
    max-width: 100%;
  }
  .est-label { color: var(--text-muted); margin-right: 4px; }
  .est-value { color: var(--accent-blue); font-weight: 700; }

  .card-title {
    font-size: 1.18rem;
    font-weight: 700;
    margin-bottom: 10px;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .card-title a {
    color: var(--text-pure);
    text-decoration: none;
    transition: var(--transition-fast);
  }
  .card-title a:hover {
    color: var(--accent-blue);
  }

  .plain-english-text {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.55;
    margin-bottom: 16px;
  }

  .type-badge {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 4px;
    background: rgba(148, 163, 184, 0.12);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
  }

  .card-w3c-link {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--accent-blue);
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.25);
    padding: 3px 8px;
    border-radius: 4px;
    text-decoration: none;
    transition: var(--transition-fast);
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }
  .card-w3c-link:hover {
    background: rgba(56, 189, 248, 0.2);
    border-color: var(--accent-blue);
    color: var(--text-pure);
  }

  .why-matters-box {
    background: rgba(7, 11, 20, 0.6);
    border-left: 3px solid var(--accent-purple);
    padding: 10px 14px;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin-bottom: 16px;
    font-size: 0.84rem;
  }
  :global(html[data-theme="light"]) .why-matters-box {
    background: #f8fafc;
    border-left-color: #9333ea;
  }
  .why-matters-label {
    font-weight: 700;
    color: var(--accent-purple);
    display: block;
    margin-bottom: 4px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  :global(html[data-theme="light"]) .why-matters-label {
    color: #7e22ce;
  }
  .why-matters-text {
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-subtle);
    padding-top: 14px;
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .wcag22-links strong {
    color: var(--text-secondary);
  }

  .read-more-btn {
    color: var(--accent-blue);
    text-decoration: none;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: gap 0.2s ease;
  }
  .read-more-btn:hover {
    gap: 8px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* Floating Quick Nav TOC Toggle Button */
  .toc-toggle-btn {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, var(--accent-indigo) 0%, var(--accent-blue) 100%);
    /* Both stops are light in dark mode and dark in light mode, so the label
       has to flip with them. Gradients are invisible to contrast tooling —
       this was caught by reading the CSS, not by the sweep. */
    color: var(--on-accent);
    border: none;
    border-radius: var(--radius-full);
    padding: 12px 20px;
    font-size: 0.92rem;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5), 0 0 20px rgba(56, 189, 248, 0.4);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .toc-toggle-btn:hover {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 15px 30px rgba(56, 189, 248, 0.5);
  }

  .toc-count-badge {
    /* Sits on the accent-coloured FAB. At 0.5 the white numeral measured
       3.83:1; 0.78 takes it clear of 4.5:1 in both themes. */
    background: rgba(7, 11, 20, 0.78);
    color: #ffffff;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    font-size: 0.78rem;
    font-family: var(--font-mono);
  }

  /* Quick Nav Drawer Panel */
  .toc-drawer {
    position: fixed;
    top: 80px;
    right: 24px;
    width: 400px;
    max-width: calc(100vw - 48px);
    max-height: calc(100vh - 120px);
    z-index: 101;
    background: rgba(11, 17, 32, 0.96);
    backdrop-filter: blur(20px);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.7), 0 0 30px rgba(56, 189, 248, 0.15);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    animation: drawerSlide 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .toc-drawer[hidden] {
    display: none !important;
  }

  @keyframes drawerSlide {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .toc-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-subtle);
    background: rgba(19, 29, 49, 0.85);
  }
  .toc-title-group  h2,
  .toc-title-group  h3 {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-pure);
    margin: 0;
  }
  .toc-subtitle {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .toc-close-btn {
    background: transparent;
