---
import PlainEnglishLayout from "@/layouts/PlainEnglishLayout.astro";
import fs from "fs";
import path from "path";

const removalsPath = path.join(process.cwd(), "public", "data", "wcag3-removals.json");
let removalsList: any[] = [];
if (fs.existsSync(removalsPath)) {
  removalsList = JSON.parse(fs.readFileSync(removalsPath, "utf8"));
}
---

<PlainEnglishLayout title="WCAG 2.2 vs 3 Removals & Omissions" activeTab="removals">
  <section class="dashboard-banner">
    <div class="banner-content">
      <div class="banner-title-group">
        <h2>WCAG 2.2 vs 3 Removals & Architectural Shifts</h2>
        <p>A plain-English guide to concepts allowed or present in WCAG 2.2 that are omitted, phased out, or fundamentally redesigned in WCAG 3.</p>
      </div>
      <div class="stats-grid">
        <div class="stat-card">
          <span class="stat-value">{removalsList.length}</span>
          <span class="stat-label">Tracked Shift Topics</span>
        </div>
        <div class="stat-card">
          <span class="stat-value highlight-shift">0%</span>
          <span class="stat-label">Alternate Versions in WCAG 3</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Introductory Alert -->
  <section class="intro-alert">
    <div class="alert-icon">💡</div>
    <div class="alert-body">
      <h4>Key Paradigm Shift</h4>
      <p>WCAG 3 moves away from single-page binary pass/fail checklists and exemptions like "Conforming Alternate Versions". The goal of WCAG 3 is universal primary accessibility evaluated across complete user tasks.</p>
    </div>
  </section>

  <!-- Removals List -->
  <section class="removals-section">
    <div class="removals-grid">
      {removalsList.map((item) => (
        <article class="removal-card">
          <div class="card-top">
            <span class="status-tag">{item.wcag3Status}</span>
            <div class="likelihood-pill">
              <span class="pill-label">Likelihood in Final WCAG 3:</span>
              <span class="pill-val">{item.inclusionLikelihood}</span>
            </div>
          </div>

          <h3 class="card-title">{item.title}</h3>

          <div class="comparison-block">
            <div class="wcag22-box">
              <span class="box-label">Allowed in WCAG 2.2:</span>
              <p>{item.wcag22Concept}</p>
            </div>
            <div class="wcag3-box">
              <span class="box-label">WCAG 3 Plain English Reality:</span>
              <p>{item.plainEnglishSummary}</p>
            </div>
          </div>

          <div class="debate-card">
            <h4>W3C Working Group Debate & Consensus</h4>
            <p>{item.workingGroupDebate}</p>
            {item.debateLinks && item.debateLinks.length > 0 && (
              <div class="debate-links-subgroup">
                <span class="subgroup-title">💬 GitHub Issues & Working Group Discussion Threads:</span>
                <ul class="debate-links-list">
                  {item.debateLinks.map((dLink: any) => (
                    <li>
                      <a href={dLink.url} target="_blank" rel="noopener noreferrer" class="debate-link-item">
                        <span class="d-icon">💬</span>
                        <span>{dLink.title}</span>
                        <span class="ext-sm">&nearr;</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>

          <div class="persona-impact-section">
            <h4>Role Impact</h4>
            <div class="persona-impact-grid">
              <div class="impact-item designer">
                <strong>🎨 Designer:</strong> {item.personaImpact.designer}
              </div>
              <div class="impact-item developer">
                <strong>💻 Developer:</strong> {item.personaImpact.developer}
              </div>
              <div class="impact-item qa">
                <strong>🧪 QA / Tester:</strong> {item.personaImpact.qa}
              </div>
              <div class="impact-item pm">
                <strong>📋 Product Manager:</strong> {item.personaImpact.productManager}
              </div>
            </div>
          </div>

          {item.supportingLinks && item.supportingLinks.length > 0 && (
            <div class="supporting-links-section">
              <h4>🔗 Supporting W3C Specifications & Documentation</h4>
              <div class="links-list">
                {item.supportingLinks.map((link: any) => (
                  <a href={link.url} target="_blank" rel="noopener noreferrer" class="support-link-card">
                    <span class="link-icon">📄</span>
                    <span class="link-title">{link.title}</span>
                    <span class="ext-icon">&nearr;</span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </article>
      ))}
    </div>
  </section>
</PlainEnglishLayout>

<style>
  .dashboard-banner {
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.9) 0%, rgba(15, 23, 42, 0.95) 100%);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 32px;
    margin-bottom: 24px;
  }

  .banner-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }

  .banner-title-group h2 {
    font-size: 1.8rem;
    font-weight: 800;
    margin-bottom: 8px;
    background: linear-gradient(90deg, #f8fafc, #c084fc);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .banner-title-group p {
    color: var(--text-secondary);
    max-width: 650px;
  }

  .stats-grid {
    display: flex;
    gap: 16px;
  }

  .stat-card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 16px 20px;
    text-align: center;
  }

  .stat-value {
    display: block;
    font-size: 1.8rem;
    font-weight: 800;
  }
  .highlight-shift { color: #c084fc; }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
  }

  .intro-alert {
    background: rgba(192, 132, 252, 0.08);
    border: 1px solid rgba(192, 132, 252, 0.3);
    border-radius: var(--radius-md);
    padding: 20px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
    margin-bottom: 32px;
  }

  .alert-icon { font-size: 1.5rem; }

  .alert-body h4 {
    color: #c084fc;
    font-weight: 700;
    margin-bottom: 4px;
  }
  .alert-body p {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .removals-grid {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .removal-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 32px;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .status-tag {
    background: rgba(192, 132, 252, 0.2);
    color: #c084fc;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 4px 12px;
    border-radius: 20px;
  }

  .likelihood-pill {
    background: rgba(15, 23, 42, 0.7);
    padding: 4px 12px;
    border-radius: 6px;
    font-size: 0.8rem;
    border: 1px solid var(--border-color);
  }
  .pill-label { color: var(--text-muted); margin-right: 6px; }
  .pill-val { color: #f43f5e; font-weight: 700; }

  .card-title {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 20px;
    color: var(--text-primary);
  }

  .comparison-block {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
    margin-bottom: 24px;
  }

  .wcag22-box {
    background: rgba(15, 23, 42, 0.6);
    border-left: 4px solid #38bdf8;
    padding: 16px;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }
  .wcag22-box .box-label { color: #38bdf8; font-weight: 700; display: block; margin-bottom: 4px; }

  .wcag3-box {
    background: rgba(15, 23, 42, 0.6);
    border-left: 4px solid #c084fc;
    padding: 16px;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }
  .wcag3-box .box-label { color: #c084fc; font-weight: 700; display: block; margin-bottom: 4px; }

  .comparison-block p {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .debate-card {
    background: rgba(15, 23, 42, 0.5);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 16px 20px;
    margin-bottom: 24px;
  }
  .debate-card h4 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--accent-blue);
    margin-bottom: 6px;
  }
  .debate-card p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 12px;
  }

  .debate-links-subgroup {
    border-top: 1px dashed rgba(255, 255, 255, 0.1);
    padding-top: 12px;
    margin-top: 8px;
  }
  .subgroup-title {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-purple);
    display: block;
    margin-bottom: 8px;
  }
  .debate-links-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .debate-link-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent-blue);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    transition: transform 0.2s ease;
  }
  .debate-link-item:hover {
    text-decoration: underline;
    transform: translateX(3px);
  }
  .d-icon { font-size: 0.85rem; }
  .ext-sm { font-size: 0.8rem; color: var(--text-muted); }

  .persona-impact-section h4 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--text-primary);
  }

  .persona-impact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
  }

  .impact-item {
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 12px;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }
  .impact-item strong { display: block; margin-bottom: 2px; }
  .designer strong { color: #f472b6; }
  .developer strong { color: #38bdf8; }
  .qa strong { color: #34d399; }
  .pm strong { color: #fbbf24; }

  .supporting-links-section {
    margin-top: 24px;
    border-top: 1px solid var(--border-color);
    padding-top: 20px;
  }
  .supporting-links-section h4 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--accent-blue);
  }

  .links-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .support-link-card {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 12px 16px;
    color: var(--text-primary);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }
  .support-link-card:hover {
    border-color: var(--accent-blue);
    background: rgba(56, 189, 248, 0.05);
    color: var(--accent-blue);
    transform: translateX(4px);
  }

  .link-icon { font-size: 1rem; }
  .link-title { flex: 1; }
  .ext-icon { color: var(--accent-blue); font-weight: 700; }
</style>
