---
import PlainEnglishLayout from "@/layouts/PlainEnglishLayout.astro";
import fs from "fs";
import path from "path";

export async function getStaticPaths() {
  const catalogPath = path.join(process.cwd(), "public", "data", "wcag3-catalog.json");
  if (!fs.existsSync(catalogPath)) return [];
  const catalog = JSON.parse(fs.readFileSync(catalogPath, "utf8"));
  return catalog.map((item: any) => ({
    params: { id: item.slug },
    props: { item },
  }));
}

interface Props {
  item: any;
}

const { item } = Astro.props as Props;
const ann = item?.annotation || {};
const likelihood = ann?.statusSummary?.inclusionLikelihood || "Under Discussion";
const delta = ann?.wcag22Comparison?.strictnessDelta || "Equivalent";
const status = item?.status || "exploratory";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (path: string) => `${base}${path.startsWith('/') ? path : '/' + path}`;
---

<PlainEnglishLayout title={`${item.title} - WCAG 3 Plain English`} activeTab="wcag3">
  <!-- Back Button & Header -->
  <div class="detail-header">
    <a href={link("/plain-english/")} class="back-link">&larr; Back to WCAG 3 Explorer</a>
    
    <div class="header-badges">
      <span class={`status-badge status-${status}`}>{status}</span>
      <span class={`delta-badge delta-${delta.toLowerCase().replace(/[^a-z]/g, '')}`}>{delta}</span>
      <span class="type-badge">{item.type}</span>
    </div>

    <h1 class="page-title">{item.title}</h1>
    <p class="meta-subtitle">
      Group: <strong>{item.groupSlug}</strong> &bull; Guideline: <strong>{item.guidelineSlug}</strong>
    </p>

    <!-- Final Release Likelihood Banner -->
    <div class="likelihood-banner">
      <div class="likelihood-info">
        <span class="banner-label">W3C Final Release Estimation:</span>
        <span class="banner-value">{likelihood}</span>
      </div>
      <p class="banner-desc">{ann?.statusSummary?.workingGroupDebate}</p>
    </div>
  </div>

  <!-- Tabbed Interface -->
  <section class="tabs-container">
    <div class="tab-list" role="tablist" aria-label="Provision details">
      <button role="tab" aria-selected="true" aria-controls="panel-plain" id="tab-plain" class="tab-btn active">
        💬 Plain English & Persona Tips
      </button>
      <button role="tab" aria-selected="false" aria-controls="panel-test" id="tab-test" class="tab-btn">
        🧪 Testing Guide & Code
      </button>
      <button role="tab" aria-selected="false" aria-controls="panel-estimation" id="tab-estimation" class="tab-btn">
        📊 Discussion & Release Estimation
      </button>
      <button role="tab" aria-selected="false" aria-controls="panel-wcag22" id="tab-wcag22" class="tab-btn">
        ⚖️ WCAG 2.2 Comparison
      </button>
      <button role="tab" aria-selected="false" aria-controls="panel-w3c" id="tab-w3c" class="tab-btn">
        📜 W3C Official Text
      </button>
    </div>

    <!-- Panel 1: Plain English -->
    <div id="panel-plain" role="tabpanel" aria-labelledby="tab-plain" class="tab-panel active">
      <div class="panel-section">
        <h3>Summary in Plain English</h3>
        <p class="summary-lead">{ann?.plainEnglish?.summary}</p>
      </div>

      <div class="panel-grid-2">
        <div class="info-card">
          <h4>Why It Matters</h4>
          <p>{ann?.plainEnglish?.whyItMatters}</p>
        </div>
        <div class="info-card">
          <h4>Real-World Example</h4>
          <p>{ann?.plainEnglish?.realWorldExample}</p>
        </div>
      </div>

      <div class="panel-section">
        <h3>Role-Based Actionable Advice</h3>
        <div class="persona-cards-grid">
          <div class="persona-card designer">
            <span class="persona-header">🎨 Designer</span>
            <p>{ann?.personaBreakdown?.designer}</p>
          </div>
          <div class="persona-card developer">
            <span class="persona-header">💻 Developer</span>
            <p>{ann?.personaBreakdown?.developer}</p>
          </div>
          <div class="persona-card qa">
            <span class="persona-header">🧪 QA / Tester</span>
            <p>{ann?.personaBreakdown?.qa}</p>
          </div>
          <div class="persona-card pm">
            <span class="persona-header">📋 Product Manager</span>
            <p>{ann?.personaBreakdown?.productManager}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Panel 2: Testing Guide -->
    <div id="panel-test" role="tabpanel" aria-labelledby="tab-test" class="tab-panel hidden">
      <div class="panel-section">
        <h3>Testing & Verification Procedures</h3>
        <div class="testing-grid">
          <div class="test-card">
            <h4>🤖 Automated Testing</h4>
            <p>{ann?.testingGuide?.automated}</p>
          </div>
          <div class="test-card">
            <h4>⌨️ Keyboard Testing</h4>
            <p>{ann?.testingGuide?.manualKeyboard}</p>
          </div>
          <div class="test-card">
            <h4>🔊 Screen Reader Verification</h4>
            <p>{ann?.testingGuide?.screenReader}</p>
          </div>
        </div>
      </div>

      <div class="panel-section">
        <h3>Code Patterns: Good vs Bad</h3>
        <div class="code-comparison">
          <div class="code-box good">
            <span class="code-header">✅ Good Implementation</span>
            <pre><code>{ann?.testingGuide?.codeSnippetGood}</code></pre>
          </div>
          <div class="code-box bad">
            <span class="code-header">❌ Bad Implementation</span>
            <pre><code>{ann?.testingGuide?.codeSnippetBad}</code></pre>
          </div>
        </div>
      </div>
    </div>

    <!-- Panel 3: Discussion & Release Estimation -->
    <div id="panel-estimation" role="tabpanel" aria-labelledby="tab-estimation" class="tab-panel hidden">
      <div class="panel-section">
        <h3>W3C Working Group Discussion Summary</h3>
        <div class="discussion-box">
          <div class="metric-row">
            <span class="metric-label">Estimated Release Likelihood:</span>
            <span class="metric-val">{ann?.statusSummary?.inclusionLikelihood}</span>
          </div>
          <div class="metric-row">
            <span class="metric-label">W3C Maturity Status:</span>
            <span class="metric-val">{item.status}</span>
          </div>
          <div class="metric-row">
            <span class="metric-label">Issue Label / W3C Track:</span>
            <span class="metric-val">{item.issueLabel || 'Standard W3C Track'}</span>
          </div>
        </div>

        <div class="info-card">
          <h4>Debate & Discussion Rationale</h4>
          <p>{ann?.statusSummary?.workingGroupDebate}</p>
        </div>

        <div class="info-card">
          <h4>Key Implementation Challenges</h4>
          <p>{ann?.statusSummary?.keyChallenges}</p>
        </div>
      </div>
    </div>

    <!-- Panel 4: WCAG 2.2 Comparison -->
    <div id="panel-wcag22" role="tabpanel" aria-labelledby="tab-wcag22" class="tab-panel hidden">
      <div class="panel-section">
        <h3>WCAG 2.2 Delta & Comparison</h3>
        <div class="delta-summary-box">
          <div class="delta-header">
            <span class="delta-title">Strictness Delta:</span>
            <span class={`delta-badge delta-${delta.toLowerCase().replace(/[^a-z]/g, '')}`}>{delta}</span>
          </div>
          <p class="delta-desc">{ann?.wcag22Comparison?.deltaExplanation}</p>
        </div>

        <div class="panel-section">
          <h4>Matching WCAG 2.2 Success Criteria</h4>
          {ann?.wcag22Comparison?.matchingCriteria?.length > 0 ? (
            <ul class="matching-list">
              {ann.wcag22Comparison.matchingCriteria.map((scStr: string) => (
                <li>
                  <a href="/plain-english/wcag22/ " class="sc-link">{scStr}</a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-muted">This provision introduces a brand new outcome framework in WCAG 3 without a direct 1:1 predecessor in WCAG 2.2.</p>
          )}
        </div>
      </div>
    </div>

    <!-- Panel 5: W3C Official Text -->
    <div id="panel-w3c" role="tabpanel" aria-labelledby="tab-w3c" class="tab-panel hidden">
      <div class="panel-section">
        <h3>W3C Raw Source Text</h3>
        <div class="raw-body-box">
          <pre>{item.rawBody}</pre>
        </div>
      </div>
    </div>
  </section>
</PlainEnglishLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.tab-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        panels.forEach(p => p.classList.add('hidden'));

        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const targetPanelId = tab.getAttribute('aria-controls');
        const targetPanel = document.getElementById(targetPanelId);
        if (targetPanel) {
          targetPanel.classList.remove('hidden');
        }
      });
    });
  });
</script>

<style>
  .detail-header {
    margin-bottom: 32px;
  }

  .back-link {
    display: inline-block;
    color: var(--accent-blue);
    text-decoration: none;
    font-weight: 600;
    margin-bottom: 16px;
  }
  .back-link:hover {
    text-decoration: underline;
  }

  .header-badges {
    display: flex;
    gap: 8px;
    margin-bottom: 12px;
  }

  .status-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 6px;
  }
  .status-mature { background: rgba(52, 211, 153, 0.2); color: #34d399; }
  .status-refining { background: rgba(56, 189, 248, 0.2); color: #38bdf8; }
  .status-developing { background: rgba(251, 191, 36, 0.2); color: #fbbf24; }
  .status-exploratory { background: rgba(244, 63, 94, 0.2); color: #f43f5e; }

  .delta-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 6px;
  }
  .delta-morestrict { background: rgba(192, 132, 252, 0.2); color: #c084fc; }
  .delta-equivalent { background: rgba(148, 163, 184, 0.2); color: #94a3b8; }
  .delta-newbroaderscope { background: rgba(56, 189, 248, 0.2); color: #38bdf8; }

  .type-badge {
    font-size: 0.75rem;
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-secondary);
    padding: 4px 10px;
    border-radius: 6px;
  }

  .page-title {
    font-size: 2.2rem;
    font-weight: 800;
    margin-bottom: 8px;
  }

  .meta-subtitle {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 24px;
  }

  .likelihood-banner {
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.8) 0%, rgba(15, 23, 42, 0.9) 100%);
    border: 1px solid var(--border-color);
    border-left: 4px solid var(--accent-blue);
    border-radius: var(--radius-md);
    padding: 16px 20px;
  }
  .likelihood-info {
    font-size: 1rem;
    margin-bottom: 4px;
  }
  .banner-label { color: var(--text-secondary); font-weight: 600; margin-right: 8px; }
  .banner-value { color: var(--accent-blue); font-weight: 800; }
  .banner-desc { color: var(--text-muted); font-size: 0.88rem; }

  /* Tabs */
  .tabs-container {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .tab-list {
    display: flex;
    background: rgba(15, 23, 42, 0.8);
    border-bottom: 1px solid var(--border-color);
    overflow-x: auto;
  }

  .tab-btn {
    background: none;
    border: none;
    color: var(--text-secondary);
    padding: 16px 24px;
    font-size: 0.95rem;
    font-weight: 600;
    font-family: var(--font-sans);
    cursor: pointer;
    white-space: nowrap;
    border-bottom: 3px solid transparent;
    transition: all 0.2s ease;
  }
  .tab-btn:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.03);
  }
  .tab-btn.active {
    color: var(--accent-blue);
    border-bottom-color: var(--accent-blue);
    background: rgba(56, 189, 248, 0.05);
  }

  .tab-panel {
    padding: 32px;
  }
  .tab-panel.hidden {
    display: none;
  }

  .panel-section {
    margin-bottom: 32px;
  }
  .panel-section h3 {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 16px;
    color: var(--text-primary);
  }

  .summary-lead {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--text-primary);
    background: rgba(56, 189, 248, 0.08);
    border-left: 4px solid var(--accent-blue);
    padding: 16px 20px;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .panel-grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
  }

  .info-card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 20px;
  }
  .info-card h4 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--accent-blue);
  }
  .info-card p {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .persona-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }

  .persona-card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 16px;
  }
  .persona-header {
    font-weight: 700;
    display: block;
    margin-bottom: 6px;
    font-size: 0.95rem;
  }
  .designer .persona-header { color: #f472b6; }
  .developer .persona-header { color: #38bdf8; }
  .qa .persona-header { color: #34d399; }
  .pm .persona-header { color: #fbbf24; }

  .persona-card p {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .testing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .test-card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 20px;
  }
  .test-card h4 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--text-primary);
  }
  .test-card p {
    color: var(--text-secondary);
    font-size: 0.92rem;
  }

  .code-comparison {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
  }

  .code-box {
    border-radius: var(--radius-md);
    padding: 16px;
    background: #090d16;
    border: 1px solid var(--border-color);
  }
  .code-box.good { border-top: 3px solid #34d399; }
  .code-box.bad { border-top: 3px solid #f43f5e; }

  .code-header {
    font-weight: 700;
    display: block;
    margin-bottom: 12px;
    font-size: 0.9rem;
  }
  .good .code-header { color: #34d399; }
  .bad .code-header { color: #f43f5e; }

  pre {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-primary);
    overflow-x: auto;
    white-space: pre-wrap;
  }

  .discussion-box {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 20px;
    margin-bottom: 24px;
  }

  .metric-row {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  .metric-row:last-child { border-bottom: none; }
  .metric-label { color: var(--text-secondary); }
  .metric-val { color: var(--accent-blue); font-weight: 700; }

  .delta-summary-box {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 20px;
    margin-bottom: 24px;
  }

  .delta-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .delta-title { font-weight: 700; color: var(--text-primary); }

  .matching-list {
    list-style-type: none;
    padding: 0;
  }
  .matching-list li {
    margin: 8px 0;
  }
  .sc-link {
    color: var(--accent-blue);
    text-decoration: none;
    font-weight: 600;
  }
  .sc-link:hover { text-decoration: underline; }

  .raw-body-box pre {
    background: #090d16;
    padding: 20px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
  }

  .text-muted { color: var(--text-muted); }
</style>
