---
import PlainEnglishLayout from "@/layouts/PlainEnglishLayout.astro";
import fs from "fs";
import path from "path";

export async function getStaticPaths() {
  const catalogPath = path.join(process.cwd(), "public", "data", "wcag3-catalog.json");
  if (!fs.existsSync(catalogPath)) return [];
  const catalog = JSON.parse(fs.readFileSync(catalogPath, "utf8"));
  return catalog.map((item: any) => ({
    params: { id: item.slug },
    props: { item },
  }));
}

interface Props {
  item: any;
}

const { item } = Astro.props as Props;
const ann = item?.annotation || {};
// 242 of 245 provisions have no hand-written annotation. Theirs is generated
// and holds only the upstream title and opening sentence — see
// scripts/sync-wcag-plain-english.mjs for what this page used to be handed.
// Nothing below may substitute prose of its own when a field is absent: a
// plausible-sounding default is indistinguishable from researched analysis.
const generated = ann?.generated === true;
// Inverted from the curated WCAG 2.2 -> 3 map in sync-wcag-plain-english.mjs.
const inbound = item?.wcag22Inbound || { direct: [], viaGuideline: [], viaGroup: [] };
const coarse = [...inbound.viaGuideline, ...inbound.viaGroup];
const likelihood = ann?.statusSummary?.inclusionLikelihood;
const delta = ann?.wcag22Comparison?.strictnessDelta;
const status = item?.status || "exploratory";

// Structure pulled straight out of the W3C draft by the sync script: scope
// conditions, editors' notes, worked examples and the informative document's
// test procedure. It is the draft's own wording, so it can be shown on a
// provision nobody has annotated - as long as the page says where it came from
// and never dresses it up as this site's analysis.
const derived = item?.derived || {};
const srcUrl = (rel: string) => `https://github.com/w3c/wcag3/blob/main/${rel}`;
const hasScope = (derived.appliesWhen?.length || derived.exceptWhen?.length || derived.notes?.length);

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (path: string) => `${base}${path.startsWith('/') ? path : '/' + path}`;
---

<PlainEnglishLayout title={`${item.title} - WCAG 3 Plain English`} activeTab="wcag3">
  <!-- Back Button & Header -->
  <div class="detail-header">
    <nav aria-label="Breadcrumbs" class="breadcrumbs">
      <a href={link("/plain-english/")} class="back-link">&larr; Back to WCAG 3 Explorer</a>
      <span class="crumb-sep">/</span>
      <span class="crumb-current">{item.title}</span>
    </nav>
    
    <div class="header-badges">
      <span class={`status-badge status-${status}`}>{status}</span>
      {delta && <span class={`delta-badge delta-${delta.toLowerCase().replace(/[^a-z]/g, '')}`}>{delta}</span>}
      <span class="type-badge">{item.type || "Provision"}</span>
    </div>

    <h1 class="page-title">{item.title}</h1>
    <p class="meta-subtitle">
      Group: <strong>{item.groupSlug}</strong> &bull; Guideline: <strong>{item.guidelineSlug}</strong>
    </p>

    {likelihood && (
      <div class="likelihood-banner">
        <div class="likelihood-header">
          <span class="banner-label">W3C Final Recommendation Likelihood:</span>
          <span class="banner-value">{likelihood}</span>
        </div>
        {ann?.statusSummary?.workingGroupDebate && <p class="banner-desc">{ann.statusSummary.workingGroupDebate}</p>}
      </div>
    )}

    {generated && (
      <div class="unreviewed-banner">
        <p>
          <strong>No plain-English analysis has been written for this provision yet.</strong>
          Everything below is either the W3C draft's own wording &mdash; its
          requirement, scope, examples, editors' notes and test procedure, each
          linked to the file it came from &mdash; or the curated WCAG&nbsp;2.2 map
          read in reverse. Role-based advice and an editorial comparison of the two
          standards appear only once someone has researched and written them;
          3 of 245 provisions have so far.
        </p>
      </div>
    )}
  </div>

  <!-- Tabbed Interface -->
  <section class="tabs-container">
    <div class="tab-list" role="tablist" aria-label="Provision detailed analysis">
      <button role="tab" aria-selected="true" aria-controls="panel-plain" id="tab-plain" class="tab-btn active">
        💬 Plain English & Persona Tips
      </button>
      <button role="tab" aria-selected="false" aria-controls="panel-test" id="tab-test" class="tab-btn">
        🧪 Testing Guide & Code
      </button>
      <button role="tab" aria-selected="false" aria-controls="panel-estimation" id="tab-estimation" class="tab-btn">
        📊 Discussion & Estimation
      </button>
      <button role="tab" aria-selected="false" aria-controls="panel-wcag22" id="tab-wcag22" class="tab-btn">
        ⚖️ WCAG 2.2 Comparison
      </button>
      <button role="tab" aria-selected="false" aria-controls="panel-w3c" id="tab-w3c" class="tab-btn">
        📜 W3C Official Text
      </button>
    </div>

    <!-- Panel 1: Plain English -->
    <div id="panel-plain" role="tabpanel" aria-labelledby="tab-plain" class="tab-panel active">
      <div class="panel-section">
        <h2>Summary in Plain English</h2>
        <p class="summary-lead">{ann?.plainEnglish?.summary}</p>
      </div>

      {(ann?.plainEnglish?.whyItMatters || ann?.plainEnglish?.realWorldExample) && (
        <div class="panel-grid-2">
          {ann?.plainEnglish?.whyItMatters && (
            <div class="info-card">
              <h3>Why It Matters</h3>
              <p>{ann.plainEnglish.whyItMatters}</p>
            </div>
          )}
          {ann?.plainEnglish?.realWorldExample && (
            <div class="info-card">
              <h3>Real-World Example</h3>
              <p>{ann.plainEnglish.realWorldExample}</p>
            </div>
          )}
        </div>
      )}

      {hasScope && (
        <div class="panel-section">
          <h2>Scope: When This Applies</h2>
          <p class="derived-note">
            The draft's own conditions, quoted from
            {" "}<a href={srcUrl(derived.sources.provision)}>{derived.sources.provision}</a>.
          </p>
          <div class="panel-grid-2">
            {derived.appliesWhen?.length > 0 && (
              <div class="info-card">
                <h3>Applies when</h3>
                {derived.appliesWhen.map((html: string) => <div class="upstream-prose" set:html={html} />)}
              </div>
            )}
            {derived.exceptWhen?.length > 0 && (
              <div class="info-card">
                <h3>Except when</h3>
                {derived.exceptWhen.map((html: string) => <div class="upstream-prose" set:html={html} />)}
              </div>
            )}
          </div>
          {derived.notes?.length > 0 && (
            <div class="info-card upstream-note">
              <h3>Notes in the draft</h3>
              {derived.notes.map((html: string) => <div class="upstream-prose" set:html={html} />)}
            </div>
          )}
        </div>
      )}

      {derived.examples?.length > 0 && (
        <div class="panel-section">
          <h2>Examples from the Draft</h2>
          <p class="derived-note">
            Worked examples the W3C editors wrote into the provision itself, not
            examples invented here.
          </p>
          {derived.examples.map((html: string) => (
            <div class="info-card"><div class="upstream-prose" set:html={html} /></div>
          ))}
        </div>
      )}

      <div class="panel-section">
        <h2>Role-Based Actionable Advice</h2>
        {ann?.personaBreakdown ? (
          <div class="persona-cards-grid">
            <div class="persona-card designer">
              <span class="persona-header">🎨 Designer</span>
              <p>{ann.personaBreakdown.designer}</p>
            </div>
            <div class="persona-card developer">
              <span class="persona-header">💻 Developer</span>
              <p>{ann.personaBreakdown.developer}</p>
            </div>
            <div class="persona-card qa">
              <span class="persona-header">🧪 QA / Tester</span>
              <p>{ann.personaBreakdown.qa}</p>
            </div>
            <div class="persona-card pm">
              <span class="persona-header">📋 Product Manager</span>
              <p>{ann.personaBreakdown.productManager}</p>
            </div>
          </div>
        ) : (
          <p class="not-written">Not written yet for this provision.</p>
        )}
      </div>
    </div>

    <!-- Panel 2: Testing Guide -->
    <div id="panel-test" role="tabpanel" aria-labelledby="tab-test" class="tab-panel hidden">
      {ann?.testingGuide && (
        <>
          <div class="panel-section">
            <h2>Testing &amp; Verification Procedures</h2>
            <div class="testing-grid">
              <div class="test-card">
                <h3>🤖 Automated Testing</h3>
                <p>{ann.testingGuide.automated}</p>
              </div>
              <div class="test-card">
                <h3>⌨️ Keyboard Testing</h3>
                <p>{ann.testingGuide.manualKeyboard}</p>
              </div>
              <div class="test-card">
                <h3>🔊 Screen Reader Verification</h3>
                <p>{ann.testingGuide.screenReader}</p>
              </div>
            </div>
          </div>

          {(ann.testingGuide.codeSnippetGood || ann.testingGuide.codeSnippetBad) && (
            <div class="panel-section">
              <h2>Code Patterns: Good vs Bad</h2>
              <div class="code-comparison">
                {ann.testingGuide.codeSnippetGood && (
                  <div class="code-box good">
                    <div class="code-header">
                      <span>✅ Good Accessible Implementation</span>
                      <button type="button" class="copy-code-btn" data-code={ann.testingGuide.codeSnippetGood}>Copy</button>
                    </div>
                    <pre><code>{ann.testingGuide.codeSnippetGood}</code></pre>
                  </div>
                )}
                {ann.testingGuide.codeSnippetBad && (
                  <div class="code-box bad">
                    <div class="code-header">
                      <span>❌ Inaccessible Anti-Pattern</span>
                      <button type="button" class="copy-code-btn" data-code={ann.testingGuide.codeSnippetBad}>Copy</button>
                    </div>
                    <pre><code>{ann.testingGuide.codeSnippetBad}</code></pre>
                  </div>
                )}
              </div>
            </div>
          )}
        </>
      )}

      <>
          <div class="panel-section">
            <h2>Test Procedure from the W3C Draft</h2>
            {derived.tests ? (
              <>
                <p class="derived-note">
                  Quoted from the provision's informative document,
                  {" "}<a href={srcUrl(derived.sources.informative)}>{derived.sources.informative}</a>.
                  It is the group's own procedure, not a testing guide written here.
                </p>
                <div class="upstream-prose test-procedure" set:html={derived.tests} />
              </>
            ) : ann?.testingGuide ? (
              <p class="not-written">
                Upstream has not written a test procedure for this provision. The
                steps above were written here, not by the working group.
              </p>
            ) : (
              <p class="not-written">
                Upstream has a test heading for this provision but has not written
                the procedure yet, and no test steps have been written here.
                Generic advice would apply to almost any provision, so none is shown.
              </p>
            )}
          </div>

          {derived.methods && (
            <div class="panel-section">
              <h2>Methods Suggested Upstream</h2>
              <p class="derived-note">
                Implementation methods listed in
                {" "}<a href={srcUrl(derived.sources.informative)}>the informative document</a>.
              </p>
              <div class="upstream-prose" set:html={derived.methods} />
            </div>
          )}

          {derived.recommendedPractices && (
            <div class="panel-section">
              <h2>Recommended Practices (Upstream)</h2>
              <div class="upstream-prose" set:html={derived.recommendedPractices} />
            </div>
          )}

          {derived.intent && (
            <div class="panel-section">
              <h2>Intent (Upstream)</h2>
              <div class="upstream-prose" set:html={derived.intent} />
            </div>
          )}
      </>
    </div>

    <!-- Panel 3: Discussion & Release Estimation -->
    <div id="panel-estimation" role="tabpanel" aria-labelledby="tab-estimation" class="tab-panel hidden">
      <div class="panel-section">
        <h2>W3C Working Group Status</h2>
        <div class="discussion-box">
          {likelihood && (
            <div class="metric-row">
              <span class="metric-label">Estimated Release Likelihood:</span>
              <span class="metric-val">{likelihood}</span>
            </div>
          )}
          <div class="metric-row">
            <span class="metric-label">W3C Maturity Status:</span>
            <span class="metric-val status-val">{item.status}</span>
          </div>
          <div class="metric-row">
            <span class="metric-label">Track / Group:</span>
            <span class="metric-val">{item.groupSlug}</span>
          </div>
        </div>

        {ann?.statusSummary?.workingGroupDebate && (
          <div class="info-card">
            <h3>Working Group Debate &amp; Consensus</h3>
            <p>{ann.statusSummary.workingGroupDebate}</p>
          </div>
        )}

        {derived.editorNotes?.length > 0 ? (
          <div class="info-card editor-note">
            <h3>Open Questions Recorded in the Draft</h3>
            <p class="derived-note">
              The editors' own notes (<code>:::ednote</code>) in
              {" "}<a href={srcUrl(derived.sources.provision)}>{derived.sources.provision}</a>.
              These are the questions the group has written down as unresolved &mdash;
              not a summary of discussion written here.
            </p>
            {derived.editorNotes.map((html: string) => <div class="upstream-prose" set:html={html} />)}
          </div>
        ) : ann?.statusSummary?.workingGroupDebate ? null : (
          <p class="not-written">
            The draft records no open editors' notes on this provision, and no
            summary of working-group discussion has been written here. Recorded
            W3C threads, where they exist, are on the
            {" "}<a href={link("/plain-english/discussions/")}>Discussions</a> page.
          </p>
        )}

        {ann?.statusSummary?.keyChallenges && (
          <div class="info-card">
            <h3>Key Implementation Challenges</h3>
            <p>{ann.statusSummary.keyChallenges}</p>
          </div>
        )}
      </div>
    </div>

    <!-- Panel 4: WCAG 2.2 Comparison -->
    <div id="panel-wcag22" role="tabpanel" aria-labelledby="tab-wcag22" class="tab-panel hidden">
      {ann?.wcag22Comparison ? (
        <div class="panel-section">
          <h2>WCAG 2.2 Delta &amp; Comparison</h2>
          <div class="delta-summary-box">
            {delta && (
              <div class="delta-header">
                <span class="delta-title">Strictness Delta:</span>
                <span class={`delta-badge delta-${delta.toLowerCase().replace(/[^a-z]/g, '')}`}>{delta}</span>
              </div>
            )}
            {ann.wcag22Comparison.deltaExplanation && <p class="delta-desc">{ann.wcag22Comparison.deltaExplanation}</p>}
          </div>

          <div class="panel-section">
            <h3>Matching WCAG 2.2 Success Criteria</h3>
            {ann.wcag22Comparison.matchingCriteria?.length > 0 ? (
              <ul class="matching-list">
                {ann.wcag22Comparison.matchingCriteria.map((scStr: string) => {
                  const scNum = scStr.replace(/[^0-9.]/g, '');
                  const scSlug = scNum.replace(/\./g, '-');
                  return (
                    <li>
                      <a href={link(`/plain-english/wcag22/${scSlug}/`)} class="sc-link">
                        <span>📘</span>
                        <strong>{scStr}</strong>
                        <span class="link-arrow">&rarr;</span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            ) : (
              <div class="new-outcome-box">
                <p>✨ <strong>New WCAG 3 Outcome:</strong> This provision introduces a brand new outcome framework in WCAG 3 without a direct 1:1 predecessor in WCAG 2.2.</p>
              </div>
            )}
          </div>
        </div>
      ) : (
        <div class="panel-section">
          <h2>WCAG 2.2 Criteria That Map Here</h2>
          <p class="derived-note">
            Derived by inverting the hand-maintained WCAG&nbsp;2.2 &rarr; WCAG&nbsp;3
            map, so every criterion below was matched to this provision by a
            person. No editorial comparison of the two requirements has been
            written yet.
          </p>

          {inbound.direct.length > 0 ? (
            <ul class="matching-list">
              {inbound.direct.map((sc) => (
                <li>
                  <a href={link(`/plain-english/wcag22/${sc.num.replace(/\./g, '-')}/`)} class="sc-link">
                    <span>📘</span>
                    <strong>{sc.num} {sc.name}</strong>
                    <span class="sc-level">Level {sc.level}</span>
                    <span class="link-arrow">&rarr;</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : coarse.length > 0 ? (
            <div class="new-outcome-box">
              <p>
                <strong>Referenced at guideline level only.</strong>
                {" "}These WCAG&nbsp;2.2 criteria point at this provision's
                {inbound.viaGuideline.length > 0 ? " guideline" : " group"} rather
                than at the provision itself, so the match is broader than one-to-one:
              </p>
              <ul class="matching-list">
                {coarse.map((sc) => (
                  <li>
                    <a href={link(`/plain-english/wcag22/${sc.num.replace(/\./g, '-')}/`)} class="sc-link">
                      <span>📘</span>
                      <strong>{sc.num} {sc.name}</strong>
                      <span class="sc-level">Level {sc.level}</span>
                      <span class="link-arrow">&rarr;</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <div class="new-outcome-box">
              <p>
                ✨ <strong>No WCAG 2.2 predecessor.</strong> No criterion in the
                curated WCAG&nbsp;2.2 map points at this provision, its guideline or
                its group &mdash; it appears to be new in WCAG&nbsp;3 rather than a
                restatement of existing guidance.
              </p>
            </div>
          )}
        </div>
      )}
    </div>

    <!-- Panel 5: W3C Official Text -->
    <div id="panel-w3c" role="tabpanel" aria-labelledby="tab-w3c" class="tab-panel hidden">
      <div class="panel-section">
        <h2>W3C Raw Source Text</h2>
        <p class="derived-note">
          Verbatim from
          {" "}<a href={srcUrl(derived.sources?.provision || '')}>{derived.sources?.provision}</a>
          {derived.sources?.informative && (
            <>
              {" "}&middot; informative document:
              {" "}<a href={srcUrl(derived.sources.informative)}>{derived.sources.informative}</a>
            </>
          )}
        </p>
        <div class="raw-body-box">
          <pre>{item.rawBody}</pre>
        </div>
      </div>
    </div>
  </section>
</PlainEnglishLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.tab-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        panels.forEach(p => p.classList.add('hidden'));

        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const targetPanelId = tab.getAttribute('aria-controls');
        const targetPanel = document.getElementById(targetPanelId);
        if (targetPanel) {
          targetPanel.classList.remove('hidden');
        }
      });
    });

    // Copy code button handler
    document.querySelectorAll('.copy-code-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const code = btn.getAttribute('data-code');
        if (code) {
          try {
            await navigator.clipboard.writeText(code);
            const originalText = btn.textContent;
            btn.textContent = 'Copied!';
            btn.classList.add('copied');
            setTimeout(() => {
              btn.textContent = originalText;
              btn.classList.remove('copied');
            }, 2000);
          } catch (e) {}
        }
      });
    });
  });
</script>

<style>
  .detail-header {
    margin-bottom: 32px;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font-size: 0.88rem;
    /* A non-wrapping row whose last crumb is a full criterion title:
       the crumb defaults to min-width: auto, so at 200% text scale the row
       cannot shrink and pushes the page sideways. */
    flex-wrap: wrap;
  }

  .back-link {
    color: var(--accent-blue);
    text-decoration: none;
    font-weight: 600;
    transition: var(--transition-fast);
  }
  .back-link:hover {
    color: #7dd3fc;
  }

  .crumb-sep {
    color: var(--text-muted);
  }

  .crumb-current {
    min-width: 0;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    /* A flat 400px ceiling is wider than the viewport itself on a phone, and
       scaling text does not shrink it. Same min() pattern as the grid floors. */
    max-width: min(400px, 100%);
  }

  .header-badges {
    display: flex;
    gap: 8px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }

  .status-badge {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: var(--radius-sm);
  }
  .status-mature { background: rgba(52, 211, 153, 0.15); color: #34d399; border: 1px solid rgba(52, 211, 153, 0.3); }
  .status-refining { background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); }
  .status-developing { background: rgba(251, 191, 36, 0.15); color: #fbbf24; border: 1px solid rgba(251, 191, 36, 0.3); }
  .status-exploratory { background: rgba(244, 63, 94, 0.15); color: #fb7185; border: 1px solid rgba(244, 63, 94, 0.3); }

  .delta-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: var(--radius-sm);
  }
  .delta-morestrict { background: rgba(192, 132, 252, 0.15); color: #c084fc; border: 1px solid rgba(192, 132, 252, 0.3); }
  .delta-equivalent { background: rgba(148, 163, 184, 0.15); color: #94a3b8; border: 1px solid rgba(148, 163, 184, 0.3); }
  .delta-newbroaderscope { background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); }

  .type-badge {
    font-size: 0.72rem;
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-secondary);
    padding: 3px 9px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }

  .page-title {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    font-weight: 800;
    color: var(--text-pure);
    letter-spacing: -0.025em;
    margin-bottom: 8px;
  }

  .meta-subtitle {
    color: var(--text-secondary);
    font-size: 0.94rem;
    margin-bottom: 24px;
  }

  /* Shown on the 242 provisions with no hand-written annotation, in place of
     the generated prose that used to fill these sections. */
  .unreviewed-banner {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-left: 4px solid var(--accent-amber);
    border-radius: var(--radius-md);
    padding: 16px 20px;
  }
  .unreviewed-banner p {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0;
  }
  .unreviewed-banner strong {
    display: block;
    color: var(--text-primary);
    margin-bottom: 4px;
  }
  .derived-note {
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.6;
    margin-bottom: 14px;
  }
  .sc-level {
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 1px 6px;
  }
  .not-written {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.6;
    font-style: italic;
  }
  .not-written a {
    color: var(--accent-blue);
  }
  .derived-note a {
    color: var(--accent-blue);
    /* Source paths are long unbroken strings; without this they push the
