---
import PlainEnglishLayout from "@/layouts/PlainEnglishLayout.astro";
import fs from "fs";
import path from "path";

export async function getStaticPaths() {
  const catalogPath = path.join(process.cwd(), "public", "data", "wcag3-catalog.json");
  if (!fs.existsSync(catalogPath)) return [];
  const catalog = JSON.parse(fs.readFileSync(catalogPath, "utf8"));
  return catalog.map((item: any) => ({
    params: { id: item.slug },
    props: { item },
  }));
}

interface Props {
  item: any;
}

const { item } = Astro.props as Props;
const ann = item?.annotation || {};
const likelihood = ann?.statusSummary?.inclusionLikelihood || "Under Discussion";
const delta = ann?.wcag22Comparison?.strictnessDelta || "Equivalent";
const status = item?.status || "exploratory";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (path: string) => `${base}${path.startsWith('/') ? path : '/' + path}`;
---

<PlainEnglishLayout title={`${item.title} - WCAG 3 Plain English`} activeTab="wcag3">
  <!-- Back Button & Header -->
  <div class="detail-header">
    <nav aria-label="Breadcrumbs" class="breadcrumbs">
      <a href={link("/plain-english/")} class="back-link">&larr; Back to WCAG 3 Explorer</a>
      <span class="crumb-sep">/</span>
      <span class="crumb-current">{item.title}</span>
    </nav>
    
    <div class="header-badges">
      <span class={`status-badge status-${status}`}>{status}</span>
      <span class={`delta-badge delta-${delta.toLowerCase().replace(/[^a-z]/g, '')}`}>{delta}</span>
      <span class="type-badge">{item.type || "Provision"}</span>
    </div>

    <h1 class="page-title">{item.title}</h1>
    <p class="meta-subtitle">
      Group: <strong>{item.groupSlug}</strong> &bull; Guideline: <strong>{item.guidelineSlug}</strong>
    </p>

    <!-- Final Release Likelihood Banner -->
    <div class="likelihood-banner">
      <div class="likelihood-header">
        <span class="banner-label">W3C Final Recommendation Likelihood:</span>
        <span class="banner-value">{likelihood}</span>
      </div>
      <p class="banner-desc">{ann?.statusSummary?.workingGroupDebate || "Active W3C AGWG exploration topic."}</p>
    </div>
  </div>

  <!-- Tabbed Interface -->
  <section class="tabs-container">
    <div class="tab-list" role="tablist" aria-label="Provision detailed analysis">
      <button role="tab" aria-selected="true" aria-controls="panel-plain" id="tab-plain" class="tab-btn active">
        💬 Plain English & Persona Tips
      </button>
      <button role="tab" aria-selected="false" aria-controls="panel-test" id="tab-test" class="tab-btn">
        🧪 Testing Guide & Code
      </button>
      <button role="tab" aria-selected="false" aria-controls="panel-estimation" id="tab-estimation" class="tab-btn">
        📊 Discussion & Estimation
      </button>
      <button role="tab" aria-selected="false" aria-controls="panel-wcag22" id="tab-wcag22" class="tab-btn">
        ⚖️ WCAG 2.2 Comparison
      </button>
      <button role="tab" aria-selected="false" aria-controls="panel-w3c" id="tab-w3c" class="tab-btn">
        📜 W3C Official Text
      </button>
    </div>

    <!-- Panel 1: Plain English -->
    <div id="panel-plain" role="tabpanel" aria-labelledby="tab-plain" class="tab-panel active">
      <div class="panel-section">
        <h3>Summary in Plain English</h3>
        <p class="summary-lead">{ann?.plainEnglish?.summary}</p>
      </div>

      <div class="panel-grid-2">
        <div class="info-card">
          <h4>Why It Matters</h4>
          <p>{ann?.plainEnglish?.whyItMatters || "Ensures equitable access for users with various disabilities."}</p>
        </div>
        <div class="info-card">
          <h4>Real-World Example</h4>
          <p>{ann?.plainEnglish?.realWorldExample || "Navigating complex components without cognitive or physical barriers."}</p>
        </div>
      </div>

      <div class="panel-section">
        <h3>Role-Based Actionable Advice</h3>
        <div class="persona-cards-grid">
          <div class="persona-card designer">
            <span class="persona-header">🎨 Designer</span>
            <p>{ann?.personaBreakdown?.designer || "Design high-contrast visual cues and consistent component states."}</p>
          </div>
          <div class="persona-card developer">
            <span class="persona-header">💻 Developer</span>
            <p>{ann?.personaBreakdown?.developer || "Use semantic HTML elements and programmatic accessibility attributes."}</p>
          </div>
          <div class="persona-card qa">
            <span class="persona-header">🧪 QA / Tester</span>
            <p>{ann?.personaBreakdown?.qa || "Verify with automated rules, keyboard tab navigation, and screen readers."}</p>
          </div>
          <div class="persona-card pm">
            <span class="persona-header">📋 Product Manager</span>
            <p>{ann?.personaBreakdown?.productManager || "Incorporate accessible acceptance criteria in sprint user stories."}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Panel 2: Testing Guide -->
    <div id="panel-test" role="tabpanel" aria-labelledby="tab-test" class="tab-panel hidden">
      <div class="panel-section">
        <h3>Testing & Verification Procedures</h3>
        <div class="testing-grid">
          <div class="test-card">
            <h4>🤖 Automated Testing</h4>
            <p>{ann?.testingGuide?.automated || "Run axe-core or Lighthouse accessibility audits in CI/CD pipeline."}</p>
          </div>
          <div class="test-card">
            <h4>⌨️ Keyboard Testing</h4>
            <p>{ann?.testingGuide?.manualKeyboard || "Tab through all interactive controls and verify focus states."}</p>
          </div>
          <div class="test-card">
            <h4>🔊 Screen Reader Verification</h4>
            <p>{ann?.testingGuide?.screenReader || "Audit with NVDA, JAWS, or VoiceOver to check verbalized announcements."}</p>
          </div>
        </div>
      </div>

      <div class="panel-section">
        <h3>Code Patterns: Good vs Bad</h3>
        <div class="code-comparison">
          <div class="code-box good">
            <div class="code-header">
              <span>✅ Good Accessible Implementation</span>
              <button type="button" class="copy-code-btn" data-code={ann?.testingGuide?.codeSnippetGood || ""}>Copy</button>
            </div>
            <pre><code>{ann?.testingGuide?.codeSnippetGood || "<!-- Accessible semantic implementation -->\n<button type=\"button\" aria-expanded=\"false\">\n  Toggle Navigation\n</button>"}</code></pre>
          </div>
          <div class="code-box bad">
            <div class="code-header">
              <span>❌ Inaccessible Anti-Pattern</span>
              <button type="button" class="copy-code-btn" data-code={ann?.testingGuide?.codeSnippetBad || ""}>Copy</button>
            </div>
            <pre><code>{ann?.testingGuide?.codeSnippetBad || "<!-- Inaccessible div button -->\n<div onclick=\"toggleNav()\">\n  Toggle Navigation\n</div>"}</code></pre>
          </div>
        </div>
      </div>
    </div>

    <!-- Panel 3: Discussion & Release Estimation -->
    <div id="panel-estimation" role="tabpanel" aria-labelledby="tab-estimation" class="tab-panel hidden">
      <div class="panel-section">
        <h3>W3C Working Group Status & Discussion</h3>
        <div class="discussion-box">
          <div class="metric-row">
            <span class="metric-label">Estimated Release Likelihood:</span>
            <span class="metric-val">{likelihood}</span>
          </div>
          <div class="metric-row">
            <span class="metric-label">W3C Maturity Status:</span>
            <span class="metric-val status-val">{item.status}</span>
          </div>
          <div class="metric-row">
            <span class="metric-label">Track / Group:</span>
            <span class="metric-val">{item.groupSlug}</span>
          </div>
        </div>

        <div class="info-card">
          <h4>Working Group Debate & Consensus</h4>
          <p>{ann?.statusSummary?.workingGroupDebate || "Currently under active review by the W3C Accessibility Guidelines Working Group."}</p>
        </div>

        <div class="info-card">
          <h4>Key Implementation Challenges</h4>
          <p>{ann?.statusSummary?.keyChallenges || "Balancing flexible platform capabilities with standardized scoring formulas."}</p>
        </div>
      </div>
    </div>

    <!-- Panel 4: WCAG 2.2 Comparison -->
    <div id="panel-wcag22" role="tabpanel" aria-labelledby="tab-wcag22" class="tab-panel hidden">
      <div class="panel-section">
        <h3>WCAG 2.2 Delta & Comparison</h3>
        <div class="delta-summary-box">
          <div class="delta-header">
            <span class="delta-title">Strictness Delta:</span>
            <span class={`delta-badge delta-${delta.toLowerCase().replace(/[^a-z]/g, '')}`}>{delta}</span>
          </div>
          <p class="delta-desc">{ann?.wcag22Comparison?.deltaExplanation || "Evolution from WCAG 2.2 binary rule."}</p>
        </div>

        <div class="panel-section">
          <h4>Matching WCAG 2.2 Success Criteria</h4>
          {ann?.wcag22Comparison?.matchingCriteria?.length > 0 ? (
            <ul class="matching-list">
              {ann.wcag22Comparison.matchingCriteria.map((scStr: string) => {
                const scNum = scStr.replace(/[^0-9.]/g, '');
                const scSlug = scNum.replace(/\./g, '-');
                return (
                  <li>
                    <a href={link(`/plain-english/wcag22/${scSlug}/`)} class="sc-link">
                      <span>📘</span>
                      <strong>{scStr}</strong>
                      <span class="link-arrow">&rarr;</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          ) : (
            <div class="new-outcome-box">
              <p>✨ <strong>New WCAG 3 Outcome:</strong> This provision introduces a brand new outcome framework in WCAG 3 without a direct 1:1 predecessor in WCAG 2.2.</p>
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Panel 5: W3C Official Text -->
    <div id="panel-w3c" role="tabpanel" aria-labelledby="tab-w3c" class="tab-panel hidden">
      <div class="panel-section">
        <h3>W3C Raw Source Text</h3>
        <div class="raw-body-box">
          <pre>{item.rawBody}</pre>
        </div>
      </div>
    </div>
  </section>
</PlainEnglishLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.tab-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        panels.forEach(p => p.classList.add('hidden'));

        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const targetPanelId = tab.getAttribute('aria-controls');
        const targetPanel = document.getElementById(targetPanelId);
        if (targetPanel) {
          targetPanel.classList.remove('hidden');
        }
      });
    });

    // Copy code button handler
    document.querySelectorAll('.copy-code-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const code = btn.getAttribute('data-code');
        if (code) {
          try {
            await navigator.clipboard.writeText(code);
            const originalText = btn.textContent;
            btn.textContent = 'Copied!';
            btn.classList.add('copied');
            setTimeout(() => {
              btn.textContent = originalText;
              btn.classList.remove('copied');
            }, 2000);
          } catch (e) {}
        }
      });
    });
  });
</script>

<style>
  .detail-header {
    margin-bottom: 32px;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font-size: 0.88rem;
  }

  .back-link {
    color: var(--accent-blue);
    text-decoration: none;
    font-weight: 600;
    transition: var(--transition-fast);
  }
  .back-link:hover {
    color: #7dd3fc;
  }

  .crumb-sep {
    color: var(--text-muted);
  }

  .crumb-current {
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 400px;
  }

  .header-badges {
    display: flex;
    gap: 8px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }

  .status-badge {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: var(--radius-sm);
  }
  .status-mature { background: rgba(52, 211, 153, 0.15); color: #34d399; border: 1px solid rgba(52, 211, 153, 0.3); }
  .status-refining { background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); }
  .status-developing { background: rgba(251, 191, 36, 0.15); color: #fbbf24; border: 1px solid rgba(251, 191, 36, 0.3); }
  .status-exploratory { background: rgba(244, 63, 94, 0.15); color: #f43f5e; border: 1px solid rgba(244, 63, 94, 0.3); }

  .delta-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: var(--radius-sm);
  }
  .delta-morestrict { background: rgba(192, 132, 252, 0.15); color: #c084fc; border: 1px solid rgba(192, 132, 252, 0.3); }
  .delta-equivalent { background: rgba(148, 163, 184, 0.15); color: #94a3b8; border: 1px solid rgba(148, 163, 184, 0.3); }
  .delta-newbroaderscope { background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); }

  .type-badge {
    font-size: 0.72rem;
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-secondary);
    padding: 3px 9px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }

  .page-title {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    font-weight: 800;
    color: var(--text-pure);
    letter-spacing: -0.025em;
    margin-bottom: 8px;
  }

  .meta-subtitle {
    color: var(--text-secondary);
    font-size: 0.94rem;
    margin-bottom: 24px;
  }

  .likelihood-banner {
    background: linear-gradient(135deg, rgba(19, 29, 49, 0.85) 0%, rgba(11, 17, 32, 0.95) 100%);
    border: 1px solid var(--border-default);
    border-left: 4px solid var(--accent-blue);
    border-radius: var(--radius-md);
    padding: 18px 24px;
    box-shadow: var(--shadow-sm);
  }
  .likelihood-header {
    font-size: 1rem;
    margin-bottom: 6px;
  }
  .banner-label { color: var(--text-secondary); font-weight: 600; margin-right: 8px; }
  .banner-value { color: var(--accent-blue); font-weight: 800; }
  .banner-desc { color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; }

  /* Tabs */
  .tabs-container {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .tab-list {
    display: flex;
    background: rgba(7, 11, 20, 0.8);
    border-bottom: 1px solid var(--border-subtle);
    overflow-x: auto;
  }

  .tab-btn {
    background: none;
    border: none;
    color: var(--text-secondary);
    padding: 16px 22px;
    font-size: 0.92rem;
    font-weight: 600;
    font-family: var(--font-sans);
    cursor: pointer;
    white-space: nowrap;
    border-bottom: 3px solid transparent;
    transition: var(--transition-fast);
  }
  .tab-btn:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.03);
  }
  .tab-btn.active {
    color: var(--accent-blue);
    border-bottom-color: var(--accent-blue);
    background: rgba(56, 189, 248, 0.08);
    font-weight: 700;
  }

  .tab-panel {
    padding: 32px;
  }
  .tab-panel.hidden {
    display: none;
  }

  .panel-section {
    margin-bottom: 32px;
  }
  .panel-section:last-child {
    margin-bottom: 0;
  }
  .panel-section h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 16px;
    color: var(--text-pure);
    letter-spacing: -0.015em;
  }

  .summary-lead {
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--text-primary);
    background: rgba(56, 189, 248, 0.06);
    border-left: 4px solid var(--accent-blue);
    padding: 18px 22px;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .panel-grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
  }

  .info-card {
    background: rgba(7, 11, 20, 0.65);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: 20px;
    margin-bottom: 16px;
  }
  .info-card h4 {
    font-size: 0.98rem;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--accent-blue);
  }
  .info-card p {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .persona-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }

  .persona-card {
    background: rgba(7, 11, 20, 0.65);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: 18px;
    display: flex;
    flex-direction: column;
  }
  .persona-card.designer { border-top: 3px solid var(--role-designer); }
  .persona-card.developer { border-top: 3px solid var(--role-developer); }
  .persona-card.qa { border-top: 3px solid var(--role-qa); }
  .persona-card.pm { border-top: 3px solid var(--role-pm); }

  .persona-header {
    font-weight: 700;
    display: block;
    margin-bottom: 8px;
    font-size: 0.94rem;
  }
  .designer .persona-header { color: var(--role-designer); }
  .developer .persona-header { color: var(--role-developer); }
  .qa .persona-header { color: var(--role-qa); }
  .pm .persona-header { color: var(--role-pm); }

  .persona-card p {
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .testing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
  }

  .test-card {
    background: rgba(7, 11, 20, 0.65);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: 20px;
  }
  .test-card h4 {
    font-size: 0.98rem;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--text-primary);
  }
  .test-card p {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .code-comparison {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
  }

  .code-box {
    border-radius: var(--radius-md);
    padding: 18px;
    background: #070b14;
    border: 1px solid var(--border-default);
  }
  .code-box.good { border-top: 3px solid #34d399; }
  .code-box.bad { border-top: 3px solid #f43f5e; }

  .code-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    font-weight: 700;
    font-size: 0.88rem;
  }
  .good .code-header span { color: #34d399; }
  .bad .code-header span { color: #f43f5e; }

  .copy-code-btn {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
    padding: 3px 9px;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-family: var(--font-sans);
    cursor: pointer;
    transition: var(--transition-fast);
  }
  .copy-code-btn:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.15);
  }
  .copy-code-btn.copied {
    background: #34d399;
    color: #070b14;
    font-weight: 700;
  }

  pre {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    color: var(--text-primary);
    overflow-x: auto;
    white-space: pre-wrap;
    line-height: 1.5;
  }

  .discussion-box {
    background: rgba(7, 11, 20, 0.65);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: 20px;
    margin-bottom: 24px;
  }

  .metric-row {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .metric-row:last-child { border-bottom: none; }
  .metric-label { color: var(--text-secondary); font-size: 0.9rem; }
  .metric-val { color: var(--accent-blue); font-weight: 700; font-size: 0.9rem; }
  .status-val { text-transform: capitalize; }

  .delta-summary-box {
    background: rgba(7, 11, 20, 0.65);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: 20px;
    margin-bottom: 24px;
  }

  .delta-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .delta-title { font-weight: 700; color: var(--text-primary); }
  .delta-desc { color: var(--text-secondary); font-size: 0.92rem; line-height: 1.6; }

  .matching-list {
    list-style-type: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .sc-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-primary);
    text-decoration: none;
    background: rgba(7, 11, 20, 0.65);
    border: 1px solid var(--border-default);
    padding: 10px 16px;
    border-radius: var(--radius-md);
    transition: var(--transition-fast);
    font-size: 0.9rem;
  }
  .sc-link:hover {
    border-color: var(--accent-blue);
    color: var(--accent-blue);
    transform: translateX(4px);
  }
  .link-arrow { color: var(--accent-blue); margin-left: auto; }

  .new-outcome-box {
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.25);
    padding: 14px 18px;
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .raw-body-box pre {
    background: #070b14;
    padding: 20px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-default);
  }

  @media (max-width: 768px) {
    .tab-panel {
      padding: 20px;
    }
  }

  /* Light Theme Overrides */
  :global(html[data-theme="light"]) .likelihood-banner {
    background: linear-gradient(135deg, #ffffff 0%, #f1f5f9 100%);
  }
  :global(html[data-theme="light"]) .tab-list {
    background: #f1f5f9;
