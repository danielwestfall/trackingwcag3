<script is:inline>
  (function () {
    const searchInput = document.getElementById("matrix-search");
    const clearBtn = document.getElementById("search-clear-btn");
    const levelPills = document.querySelectorAll("#level-pills .filter-pill");
    const typePills = document.querySelectorAll("#type-pills .filter-pill");
    const principleSelect = document.getElementById("principle-select");
    const visibleCount = document.getElementById("visible-count");
    const resetBtn = document.getElementById("reset-filters-btn");
    const noResults = document.getElementById("no-results");
    const emptyClearBtn = document.getElementById("btn-clear-filters-empty");
    const rows = Array.from(document.querySelectorAll(".matrix-row"));

    let activeLevel = "all";
    let activeType = "all";
    let activePrinciple = "all";
    let searchQuery = "";

    function filterRows() {
      let count = 0;
      const q = searchQuery.toLowerCase().trim();

      rows.forEach((row) => {
        const level = row.getAttribute("data-level");
        const principle = row.getAttribute("data-principle");
        const changeType = row.getAttribute("data-change-type");
        const searchBlob = row.getAttribute("data-search") || "";

        const matchesLevel = activeLevel === "all" || level === activeLevel;
        const matchesPrinciple = activePrinciple === "all" || principle === activePrinciple;
        const matchesType = activeType === "all" || changeType === activeType;
        const matchesSearch = !q || searchBlob.includes(q);

        if (matchesLevel && matchesPrinciple && matchesType && matchesSearch) {
          row.style.display = "";
          count++;
        } else {
          row.style.display = "none";
        }
      });

      if (visibleCount) visibleCount.textContent = String(count);

      const hasActiveFilters = activeLevel !== "all" || activeType !== "all" || activePrinciple !== "all" || !!q;
      if (resetBtn) resetBtn.hidden = !hasActiveFilters;
      if (clearBtn) clearBtn.hidden = !q;

      if (noResults) {
        noResults.hidden = count > 0;
      }
    }

    // Search Input
    if (searchInput) {
      searchInput.addEventListener("input", (e) => {
        searchQuery = e.target.value;
        filterRows();
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener("click", () => {
        if (searchInput) {
          searchInput.value = "";
          searchQuery = "";
          searchInput.focus();
        }
        filterRows();
      });
    }

    // Level Pills
    levelPills.forEach((pill) => {
      pill.addEventListener("click", () => {
        levelPills.forEach((p) => {
          p.classList.remove("active");
          p.setAttribute("aria-checked", "false");
        });
        pill.classList.add("active");
        pill.setAttribute("aria-checked", "true");
        activeLevel = pill.getAttribute("data-level") || "all";
        filterRows();
      });
    });

    // Type Pills
    typePills.forEach((pill) => {
      pill.addEventListener("click", () => {
        typePills.forEach((p) => {
          p.classList.remove("active");
          p.setAttribute("aria-checked", "false");
        });
        pill.classList.add("active");
        pill.setAttribute("aria-checked", "true");
        activeType = pill.getAttribute("data-type") || "all";
        filterRows();
      });
    });

    // Principle Select
    if (principleSelect) {
      principleSelect.addEventListener("change", (e) => {
        activePrinciple = e.target.value;
        filterRows();
      });
    }

    // Reset Function
    function resetAll() {
      searchQuery = "";
      activeLevel = "all";
      activeType = "all";
      activePrinciple = "all";

      if (searchInput) searchInput.value = "";
      if (principleSelect) principleSelect.value = "all";

      levelPills.forEach((p) => {
        const isAll = p.getAttribute("data-level") === "all";
        p.classList.toggle("active", isAll);
        p.setAttribute("aria-checked", isAll ? "true" : "false");
      });

      typePills.forEach((p) => {
        const isAll = p.getAttribute("data-type") === "all";
        p.classList.toggle("active", isAll);
        p.setAttribute("aria-checked", isAll ? "true" : "false");
      });

      filterRows();
    }

    if (resetBtn) resetBtn.addEventListener("click", resetAll);
    if (emptyClearBtn) emptyClearBtn.addEventListener("click", resetAll);

    // Initial check for hash on page load
    if (window.location.hash) {
      const targetId = window.location.hash.substring(1);
      const targetEl = document.getElementById(targetId);
      if (targetEl) {
        targetEl.classList.add("highlight-target");
        setTimeout(() => {
          targetEl.scrollIntoView({ behavior: "smooth", block: "center" });
        }, 150);
      }
    }
  })();
</script>
