---
import PlainEnglishLayout from "@/layouts/PlainEnglishLayout.astro";
import fs from "fs";
import path from "path";

// Hand-curated practices (public/data/wcag3-stricter.json) joined against the
// live catalog. The requirement wording, type, status and exceptions always come
// from the catalog, never from the curated file, so they follow the draft. If a
// provision disappears or stops being a core requirement, the entry is flagged
// for review rather than shown with stale wording.
const dataDir = path.join(process.cwd(), "public", "data");
const read = (f: string, fallback: any) => {
  const p = path.join(dataDir, f);
  return fs.existsSync(p) ? JSON.parse(fs.readFileSync(p, "utf8")) : fallback;
};
const curated = read("wcag3-stricter.json", { categories: [], core: [], supplemental: [], notRuledOut: [] });
const catalog: any[] = read("wcag3-catalog.json", []);
const bySlug = new Map(catalog.map((p) => [p.slug, p]));

const statePath = path.join(process.cwd(), "tracking", "state.json");
const state = fs.existsSync(statePath) ? JSON.parse(fs.readFileSync(statePath, "utf8")) : {};

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (p: string) => `${base}${p.startsWith("/") ? p : "/" + p}`;

// The draft marks glossary terms as :term[word]; show the plain word.
const plain = (s: string) => (s || "").replace(/:term\[([^\]]+)\]/g, "$1").trim();
// rawBody is the provision's whole markdown body: the normative sentence, an
// optional bullet list, then :::note / :::except-when directive blocks. Keep the
// sentence and its bullets; the directive blocks are rendered from `derived`.
function splitBody(raw: string) {
  const normative = plain(raw).split(/\n\s*:::/)[0];
  const lines = normative.split("\n").map((l) => l.trim()).filter(Boolean);
  const isBullet = (l: string) => /^[*-]\s+/.test(l);
  return {
    text: lines.filter((l) => !isBullet(l)).join(" "),
    bullets: lines.filter(isBullet).map((l) => l.replace(/^[*-]\s+/, "")),
  };
}
const TYPE_LABEL: Record<string, string> = {
  foundational: "Core requirement",
  supplemental: "Supplemental requirement",
  assertion: "Assertion",
  "recommended practice": "Recommended practice",
};

function resolve(slugs: string[], expectedType: string) {
  return slugs.map((slug) => {
    const p = bySlug.get(slug);
    if (!p) return { slug, missing: true };
    return {
      slug,
      title: p.title,
      type: p.type || "",
      typeLabel: TYPE_LABEL[p.type] || "Untyped",
      status: p.status || "exploratory",
      ...splitBody(p.rawBody),
      appliesWhen: p.derived?.appliesWhen || [],
      exceptWhen: p.derived?.exceptWhen || [],
      notes: p.derived?.notes || [],
      drifted: p.type !== expectedType,
    };
  });
}

const withProvisions = (list: any[], expectedType: string) =>
  list.map((item) => {
    const provisions = resolve(item.provisions || [], expectedType);
    const needsReview = provisions.some((p: any) => p.missing || p.drifted);
    return { ...item, provisions, needsReview };
  });

const core = withProvisions(curated.core, "foundational");
const supplemental = withProvisions(curated.supplemental, "supplemental");
const notRuledOut = curated.notRuledOut.map((item: any) => ({
  ...item,
  provisions: resolve(item.provisions || [], "foundational"),
}));

const categories = curated.categories.filter((c: any) => core.some((i: any) => i.category === c.id));
const coreProvisionCount = new Set(core.flatMap((i: any) => i.provisions.map((p: any) => p.slug))).size;
const reviewCount = [...core, ...supplemental].filter((i: any) => i.needsReview).length;
const statusesInUse = [...new Set(core.flatMap((i: any) => i.provisions.map((p: any) => p.status)))];
const noneBeyondDeveloping = statusesInUse.every((s) => s === "developing" || s === "exploratory");

// AA is the baseline most laws and policies point to, so it's the fair
// comparison with WCAG 3 core requirements. The AAA verdict separates new
// ground from AAA criteria that WCAG 3 promotes into the baseline.
const aaaResults = curated.aaaResults || {};
const AAA_ORDER = ["passes", "depends", "fails"];
const aaaCount = (r: string) => core.filter((i: any) => i.aaa?.result === r).length;
const scList = (list: any[]) => (list || []).map((sc: any) => sc.num).join(", ");
const firstTitle = (item: any) => item.provisions.filter((p: any) => !p.missing).map((p: any) => p.title).join(" · ");
---

<PlainEnglishLayout title="Passes WCAG 2.2, Fails WCAG 3" activeTab="stricter">
  <section class="st-banner">
    <div class="st-banner-text">
      <p class="st-kicker"><span aria-hidden="true">🚫</span> Passes 2.2 · Fails the 3 draft</p>
      <h1>Common practices WCAG 3 rules out</h1>
      <p>
        Practices that are not great for people with disabilities but still pass WCAG 2.2 Level AA,
        each matched to the WCAG 3 draft requirement that would no longer allow it.
      </p>
    </div>
    <dl class="st-stats">
      <div><dt>Practices</dt><dd>{core.length}</dd></div>
      <div><dt>Core requirements cited</dt><dd>{coreProvisionCount}</dd></div>
      <div><dt>Draft baseline</dt><dd class="st-mono">{state.lastTrackedCommit || "—"}</dd></div>
    </dl>
  </section>

  <section class="st-levels" aria-labelledby="st-levels-h">
    <h2 id="st-levels-h">AA is the baseline; AAA is the stretch</h2>
    <p>
      Every practice here passes WCAG 2.2 <strong>Level AA</strong>, the level most laws, policies and
      procurement rules point to. That makes AA the fair comparison with WCAG 3's
      <strong>core requirements</strong>, which every conforming site must meet. Few organizations
      target AAA, but each entry also says how the practice fares there. That shows whether WCAG 3 is
      breaking new ground or moving an existing AAA criterion into the baseline.
    </p>
    <dl class="st-aaa-key">
      {AAA_ORDER.map((r) => (
        <div class={`st-aaa-key-item st-aaa-${r}`}>
          <dt><span class={`st-verdict st-verdict-${r}`}>{aaaResults[r]?.label}</span> <span class="st-aaa-count">{aaaCount(r)}</span></dt>
          <dd>{aaaResults[r]?.meaning}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="st-caveat" aria-labelledby="st-caveat-h">
    <h2 id="st-caveat-h">Read this first</h2>
    <ul>
      <li>
        <strong>Everything quoted is still a draft.</strong>
        {noneBeyondDeveloping
          ? " Every requirement cited here is at “developing” status or earlier, so wording and exceptions can still change."
          : " Check each requirement's status badge; wording and exceptions can still change."}
        {" "}WCAG 2.2 remains the standard to conform to today.
      </li>
      <li>
        <strong>Only core requirements are in the main list.</strong> All core requirements must be met to
        conform to WCAG 3, so these are the ones that would actually rule a practice out. Stricter
        supplemental requirements are listed separately.
      </li>
      <li>
        <strong>Requirement text is pulled live from the draft.</strong> The wording, status and exceptions
        below come from the tracker's catalog
        {state.lastTrackedDate && <> (upstream commit <code>{state.lastTrackedCommit}</code>, {state.lastTrackedDate})</>}.
        The practices and the AA and AAA notes are this site's interpretation of WCAG 2.2 and its
        Understanding documents.
      </li>
    </ul>
    {reviewCount > 0 && (
      <p class="st-review-alert" role="note">
        ⚠️ {reviewCount} {reviewCount === 1 ? "entry cites" : "entries cite"} a requirement that has since been
        removed or changed type in the draft. Those entries are marked below and need review.
      </p>
    )}
  </section>

  <section class="st-glance" aria-labelledby="st-glance-h">
    <h2 id="st-glance-h">At a glance</h2>
    <div class="st-table-wrap">
      <table role="table">
        <thead role="rowgroup">
          <tr role="row">
            <th role="columnheader" scope="col">Practice</th>
            <th role="columnheader" scope="col">WCAG 2.2 AA</th>
            <th role="columnheader" scope="col">WCAG 2.2 AAA</th>
            <th role="columnheader" scope="col">WCAG 3 core requirement</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {core.map((item: any) => (
            <tr role="row">
              <th role="rowheader" scope="row"><a href={`#${item.id}`}>{item.practice}</a></th>
              <td role="cell"><span class="st-verdict st-verdict-passes">Passes</span></td>
              <td role="cell">
                <span class={`st-verdict st-verdict-${item.aaa.result}`}>{aaaResults[item.aaa.result]?.short}</span>
                {item.aaa.result !== "passes" && item.aaa.criteria.length > 0 && <span class="st-mono st-sc-inline"> {scList(item.aaa.criteria)}</span>}
              </td>
              <td role="cell">{firstTitle(item)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <nav class="st-toc" aria-label="Categories on this page">
    <ul>
      {categories.map((c: any) => (
        <li><a href={`#cat-${c.id}`}><span aria-hidden="true">{c.icon}</span> {c.label}</a></li>
      ))}
      <li><a href="#supplemental"><span aria-hidden="true">➕</span> Stricter, but not required</a></li>
      <li><a href="#not-ruled-out"><span aria-hidden="true">✅</span> Not ruled out (yet)</a></li>
    </ul>
  </nav>

  {categories.map((c: any) => (
    <section class="st-category" aria-labelledby={`cat-${c.id}`}>
      <h2 id={`cat-${c.id}`}><span aria-hidden="true">{c.icon}</span> {c.label}</h2>
      <div class="st-list">
        {core.filter((i: any) => i.category === c.id).map((item: any) => (
          <article class="st-card" id={item.id}>
            <h3>{item.practice}</h3>
            {item.example && <p class="st-example"><span>Example:</span> {item.example}</p>}

            <div class="st-compare">
              <div class="st-col st-col-22">
                <h4>WCAG 2.2 AA (baseline) <span class="st-verdict st-verdict-passes">Passes</span></h4>
                {item.aa.criteria.length > 0 && (
                  <ul class="st-sc">
                    {item.aa.criteria.map((sc: any) => (
                      <li><span class="st-mono">{sc.num}</span> {sc.name} <span class="st-level">{sc.level}</span></li>
                    ))}
                  </ul>
                )}
                <p>{item.aa.explanation}</p>

                <h4 class="st-aaa-head">WCAG 2.2 AAA <span class={`st-verdict st-verdict-${item.aaa.result}`}>{aaaResults[item.aaa.result]?.label}</span></h4>
                {item.aaa.criteria.length > 0 && (
                  <ul class="st-sc">
                    {item.aaa.criteria.map((sc: any) => (
                      <li><span class="st-mono">{sc.num}</span> {sc.name} <span class="st-level">{sc.level}</span></li>
                    ))}
                  </ul>
                )}
                <p>{item.aaa.explanation}</p>
              </div>

              <div class="st-col st-col-3">
                <h4>What the WCAG 3 draft says</h4>
                {item.provisions.map((p: any) => p.missing ? (
                  <div class="st-req st-req-missing">
                    <p><code>{p.slug}</code> is no longer in the draft. This entry needs review.</p>
                  </div>
                ) : (
                  <div class={`st-req ${p.drifted ? "st-req-drifted" : ""}`}>
                    <p class="st-req-head">
                      <a href={link(`/plain-english/provision/${p.slug}/`)}>{p.title}</a>
                      <span class={`st-badge st-badge-${p.type === "foundational" ? "core" : "other"}`}>{p.typeLabel}</span>
                      <span class="st-badge st-badge-status">{p.status}</span>
                    </p>
                    <blockquote>{p.text}{p.bullets.length > 0 && <ul>{p.bullets.map((b: string) => <li>{b}</li>)}</ul>}</blockquote>
                    {p.appliesWhen.length > 0 && (
                      <div class="st-cond"><span class="st-cond-label">Applies when</span><div class="upstream" set:html={p.appliesWhen.join("")} /></div>
                    )}
                    {p.exceptWhen.length > 0 && (
                      <div class="st-cond"><span class="st-cond-label">Except when</span><div class="upstream" set:html={p.exceptWhen.join("")} /></div>
                    )}
                    {p.notes.length > 0 && (
                      <div class="st-cond"><span class="st-cond-label">Draft note</span><div class="upstream" set:html={p.notes.join("")} /></div>
                    )}
                    {p.drifted && (
                      <p class="st-drift-note">⚠️ This is now a {p.typeLabel.toLowerCase()}, not a core requirement, so this entry needs review.</p>
                    )}
                  </div>
                ))}
              </div>
            </div>

            {item.note && (
              <p class={`st-note ${item.uncertain ? "st-note-uncertain" : ""}`}>
                <strong>{item.uncertain ? "Uncertain:" : "Note:"}</strong> {item.note}
              </p>
            )}
          </article>
        ))}
      </div>
    </section>
  ))}

  <section class="st-category" aria-labelledby="supplemental">
    <h2 id="supplemental"><span aria-hidden="true">➕</span> Stricter in WCAG 3, but not required to conform</h2>
    <p class="st-section-intro">
      These are supplemental requirements. They count toward the reporting tiers above conformance,
      but you can conform to WCAG 3 without meeting them.
    </p>
    <div class="st-list">
      {supplemental.map((item: any) => (
        <article class="st-card st-card-compact" id={item.id}>
          <h3>{item.practice}</h3>
          <p class="st-why">
            <span class="st-verdict st-verdict-passes">AA: Passes</span>
            {item.aa.criteria.map((sc: any) => <> <span class="st-mono">{sc.num}</span> {sc.name} ({sc.level}).</>)}
            {" "}{item.aa.explanation}
          </p>
          <p class="st-why">
            <span class={`st-verdict st-verdict-${item.aaa.result}`}>AAA: {aaaResults[item.aaa.result]?.short}</span>
            {item.aaa.criteria.map((sc: any) => <> <span class="st-mono">{sc.num}</span> {sc.name} ({sc.level}).</>)}
            {" "}{item.aaa.explanation}
          </p>
          {item.provisions.map((p: any) => p.missing ? (
            <p class="st-req-missing"><code>{p.slug}</code> is no longer in the draft. This entry needs review.</p>
          ) : (
            <div class="st-req">
              <p class="st-req-head">
                <a href={link(`/plain-english/provision/${p.slug}/`)}>{p.title}</a>
                <span class="st-badge st-badge-other">{p.typeLabel}</span>
                <span class="st-badge st-badge-status">{p.status}</span>
              </p>
              <blockquote>{p.text}{p.bullets.length > 0 && <ul>{p.bullets.map((b: string) => <li>{b}</li>)}</ul>}</blockquote>
              {p.exceptWhen.length > 0 && (
                <div class="st-cond"><span class="st-cond-label">Except when</span><div class="upstream" set:html={p.exceptWhen.join("")} /></div>
              )}
              {p.drifted && <p class="st-drift-note">⚠️ This is now a {p.typeLabel.toLowerCase()}. This entry needs review.</p>}
            </div>
          ))}
          {item.note && <p class="st-note"><strong>Note:</strong> {item.note}</p>}
        </article>
      ))}
    </div>
  </section>

  <section class="st-category" aria-labelledby="not-ruled-out">
    <h2 id="not-ruled-out"><span aria-hidden="true">✅</span> Practices that aren't ruled out (yet)</h2>
    <ul class="st-plain-list">
      {notRuledOut.map((item: any) => (
        <li>
          <strong>{item.practice}.</strong> {item.explanation}
          {" "}See {item.provisions.filter((p: any) => !p.missing).map((p: any, i: number, arr: any[]) => (
            <><a href={link(`/plain-english/provision/${p.slug}/`)}>{p.title}</a>{i < arr.length - 1 ? ", " : "."}</>
          ))}
        </li>
      ))}
    </ul>
  </section>

  <section class="st-sources" aria-labelledby="st-sources-h">
    <h2 id="st-sources-h">Sources</h2>
    <ul>
      <li><a href="https://w3c.github.io/wcag3/guidelines/" target="_blank" rel="noopener noreferrer">WCAG 3 Editor's Draft (W3C)</a></li>
      <li><a href="https://github.com/w3c/wcag3" target="_blank" rel="noopener noreferrer">w3c/wcag3 repository</a></li>
      <li><a href="https://www.w3.org/TR/WCAG22/" target="_blank" rel="noopener noreferrer">WCAG 2.2 Recommendation</a></li>
    </ul>
  </section>
</PlainEnglishLayout>

<style>
  .st-banner {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    justify-content: space-between;
    align-items: flex-end;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-left: 4px solid var(--accent-rose);
    border-radius: var(--radius-lg);
    padding: 28px 32px;
    margin-bottom: 24px;
  }
  .st-banner-text { min-width: 0; flex: 1 1 420px; }
  .st-kicker {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 8px;
  }
  .st-banner h1 {
    font-size: 1.9rem;
    font-weight: 800;
    color: var(--text-pure);
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }
  .st-banner-text > p:last-child {
    color: var(--text-secondary);
    max-width: 640px;
    line-height: 1.6;
    margin: 0;
  }
  .st-stats { display: flex; flex-wrap: wrap; gap: 12px; margin: 0; }
  .st-stats div {
    background: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 10px 16px;
    min-width: 110px;
  }
  .st-stats dt {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }
  .st-stats dd {
    margin: 2px 0 0;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-pure);
    font-variant-numeric: tabular-nums;
  }
  .st-stats dd.st-mono { font-size: 1.1rem; padding-top: 6px; }
  .st-mono { font-family: var(--font-mono); }

  .st-caveat {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 20px 24px;
    margin-bottom: 24px;
  }
  .st-caveat h2 { font-size: 1.05rem; margin: 0 0 10px; color: var(--text-pure); }
  .st-caveat ul { margin: 0; padding-left: 1.2em; display: grid; gap: 8px; }
  .st-caveat li { color: var(--text-secondary); line-height: 1.6; }
  .st-review-alert {
    margin: 14px 0 0;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--accent-amber);
    color: var(--text-primary);
  }

  .st-levels {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 20px 24px;
    margin-bottom: 24px;
  }
  .st-levels h2 { font-size: 1.05rem; margin: 0 0 8px; color: var(--text-pure); }
  .st-levels > p { color: var(--text-secondary); line-height: 1.6; margin: 0 0 14px; max-width: 860px; }
  .st-aaa-key { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; margin: 0; }
  .st-aaa-key-item { border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 10px 12px; }
  .st-aaa-key dt { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .st-aaa-key dd { margin: 6px 0 0; color: var(--text-secondary); font-size: 0.9rem; line-height: 1.5; }
  .st-aaa-count { font-size: 1.3rem; font-weight: 800; color: var(--text-pure); font-variant-numeric: tabular-nums; }

  /* Verdict chips: the word carries the meaning; the border color only reinforces it. */
  .st-verdict {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: none;
    border-radius: var(--radius-full);
    padding: 1px 9px;
    border: 1.5px solid var(--border-default);
    color: var(--text-primary);
    white-space: nowrap;
    vertical-align: middle;
  }
  .st-verdict-passes { border-color: var(--accent-emerald); }
  .st-verdict-depends { border-color: var(--accent-amber); border-style: dashed; }
  .st-verdict-fails { border-color: var(--accent-rose); }

  .st-glance { margin-bottom: 28px; }
  .st-glance h2 { font-size: 1.4rem; font-weight: 800; color: var(--text-pure); margin: 0 0 12px; }
  .st-table-wrap { border: 1px solid var(--border-default); border-radius: var(--radius-md); overflow: hidden; }
  .st-glance table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  .st-glance th, .st-glance td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--border-subtle); vertical-align: top; color: var(--text-secondary); }
  .st-glance thead th {
    background: var(--surface-subtle);
    color: var(--text-muted);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .st-glance tbody th { font-weight: 600; }
  .st-glance tbody th a { color: var(--text-accent); }
  .st-glance tbody tr:last-child > * { border-bottom: none; }
  .st-sc-inline { font-size: 0.8rem; color: var(--text-muted); }
  @media (max-width: 760px) {
    .st-glance thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .st-glance tr { display: block; padding: 10px 12px; border-bottom: 1px solid var(--border-subtle); }
    .st-glance tbody th, .st-glance td { display: block; padding: 2px 0; border: none; }
    .st-glance td:nth-of-type(1)::before { content: "2.2 AA: "; color: var(--text-muted); }
    .st-glance td:nth-of-type(2)::before { content: "2.2 AAA: "; color: var(--text-muted); }
    .st-glance td:nth-of-type(3)::before { content: "WCAG 3: "; color: var(--text-muted); }
  }

  .st-aaa-head { margin-top: 16px !important; padding-top: 12px; border-top: 1px dashed var(--border-subtle); }
  .st-col h4 { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; }

  .st-toc { margin-bottom: 32px; }
  .st-toc ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .st-toc a {
    display: inline-block;
    padding: 6px 14px;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-full);
    color: var(--text-primary);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .st-toc a:hover { border-color: var(--border-active); color: var(--text-accent); }

  .st-category { margin-bottom: 40px; }
  .st-category > h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-pure);
    margin: 0 0 16px;
