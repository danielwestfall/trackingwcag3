---
import { provisionTypeLabel } from "@/lib/provision-labels";
import PlainEnglishLayout from "@/layouts/PlainEnglishLayout.astro";
import QuickQuestion from "@/components/calculator/QuickQuestion.astro";
import fs from "fs";
import path from "path";

const readJSON = (rel: string, fallback: any) => {
  const p = path.join(process.cwd(), rel);
  return fs.existsSync(p) ? JSON.parse(fs.readFileSync(p, "utf8")) : fallback;
};
const catalog: any[] = readJSON("public/data/wcag3-catalog.json", []);
const quick = readJSON("public/data/wcag3-quick-check.json", { sections: [], standIns: {}, notTestableYet: [] });
const groupOrder: string[] = readJSON("guidelines/groups.json", []);
const state = readJSON("tracking/state.json", {});
const trackedCommit: string = state.lastTrackedCommit || quick.draftCommit || "";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (p: string) => `${base}${p.startsWith("/") ? p : "/" + p}`;

// W3C's group names come from the folder slugs; input-operation is written "Input / operation" upstream.
const groupTitle = (slug: string) =>
  slug === "input-operation" ? "Input / operation" : slug.replace(/-/g, " ").replace(/^./, (c) => c.toUpperCase());

// The normative sentence: the provision body up to its first directive block, with
// glossary markers removed and "to be determined" placeholders shown as such.
const normative = (p: any) =>
  (p.rawBody || "")
    .split(/\n:::/)[0]
    .replace(/:term\[([^\]]+)\]/g, "$1")
    .replace(/@@\s*\[([^\]]+)\]/g, "[$1]")
    .replace(/\[#[^\]]*\]/g, "")
    .replace(/\s+/g, " ")
    .trim();

// Recommended practices are informative ("do not need to be satisfied to conform"), so they are not scored.
const scored = catalog.filter((p) => p.type !== "recommended practice");
const publishedDate: string | null = (() => { try { return JSON.parse(fs.readFileSync(path.join(process.cwd(), "public", "data", "wcag3-published.json"), "utf8")).latest.date; } catch { return null; } })();
const publishedLabel = publishedDate ? new Date(publishedDate + "T12:00:00Z").toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }) : null;
const recommendedCount = catalog.length - scored.length;
const kind = (p: any) =>
  p.type === "foundational" ? "core" : p.type === "supplemental" ? "supplemental" : p.type === "assertion" ? "assertion" : "untyped";

const groups = groupOrder
  .map((g) => ({ slug: g, title: groupTitle(g), items: scored.filter((p) => p.groupSlug === g) }))
  .filter((g) => g.items.length);
const ungrouped = scored.filter((p) => !groupOrder.includes(p.groupSlug));
if (ungrouped.length) groups.push({ slug: "other", title: "Other", items: ungrouped });

const exploratory = new Set(catalog.filter((p) => p.status === "exploratory").map((p) => p.slug));
const counts = {
  ed: scored.length,
  wd: scored.filter((p) => p.status !== "exploratory").length,
  coreEd: scored.filter((p) => kind(p) === "core").length,
  coreWd: scored.filter((p) => kind(p) === "core" && p.status !== "exploratory").length,
};

// Compact data for the client script.
const clientData = {
  provisions: scored.map((p) => ({
    slug: p.slug,
    title: p.title,
    kind: kind(p),
    exploratory: p.status === "exploratory",
    group: groupOrder.includes(p.groupSlug) ? p.groupSlug : "other",
  })),
  groups: groups.map((g) => ({ slug: g.slug, title: g.title })),
  notTestableYet: quick.notTestableYet,
  base,
  draftCommit: trackedCommit,
};

// A section's gate question wraps the section's questions as its follow-ups.
const quickSections = (quick.sections || []).map((s: any) => ({
  ...s,
  root: s.gate ? [{ ...s.gate, naWhenNo: true, children: s.items.map((i: any) => ({ ...i, when: "yes" })) }] : s.items,
}));
---

<PlainEnglishLayout title="WCAG 3 Audit Calculator" activeTab="calculator">
  <section class="ac-banner">
    <p class="ac-kicker"><span aria-hidden="true">🧮</span> Audit calculator</p>
    <h1>WCAG 3 Audit Calculator</h1>
    <p class="ac-lead">
      Check a site against the core requirements in the WCAG 3 draft. Answer a few questions about your site for a quick
      estimate, or go through every provision in the full audit. Results follow the conformance and reporting models in the
      current draft and its Explainer.
    </p>
  </section>

  <details class="ac-model">
    <summary>How this calculator scores, and what the draft hasn't decided yet</summary>
    <div class="ac-model-body">
      <ul>
        <li>
          <strong>Conformance</strong> means every core requirement in scope is met. That is the draft's rule, and it is
          the one result here that doesn't depend on anything still undecided.
        </li>
        <li>
          <strong>Reporting tiers:</strong> the draft lists six. Tiers 1 and 2 (Avoid physical harm, Foundational access)
          depend on harm, risk, barrier and friction tags on each core requirement. No requirement has been tagged yet, so
          they can't be worked out. Tier 3 is conformance. Bronze, Silver and Gold (tiers 4 to 6) add supplemental
          requirements and assertions, in numbers the draft hasn't set.
        </li>
        <li>
          <strong>Progress score:</strong> the Explainer's alternative approach scores progress toward conformance as the
          percentage of requirements met, weighted 3 for physical harm and risk, 2 for barrier and 1 for friction and
          everything else. With no tags yet, every requirement here counts 1.
        </li>
        <li>
          <strong>Not in the draft:</strong> partial credit and pass thresholds. This calculator uses neither.
        </li>
      </ul>
      <p class="ac-model-links">
        <a href="https://w3c.github.io/wcag3/guidelines/#conformance">WCAG 3 conformance and reporting tiers ↗</a>
        <a href="https://w3c.github.io/wcag3/explainer/#alternative-approach-scoring">Explainer: alternative approach, scoring ↗</a>
        {trackedCommit && <span>Draft tracked at <code>{trackedCommit}</code></span>}
      </p>
    </div>
  </details>

  <div class="ac-scope" role="group" aria-labelledby="ac-scope-label">
    <span id="ac-scope-label" class="ac-scope-label">Which draft?</span>
    <label><input type="radio" name="ac-scope" value="wd" id="ac-scope-wd" checked /> Working Draft{publishedLabel ? ` (${publishedLabel})` : ""} <span class="ac-dim">({counts.coreWd} core, {counts.wd} scored in all)</span></label>
    <label><input type="radio" name="ac-scope" value="ed" id="ac-scope-ed" /> Editor's Draft, including exploratory <span class="ac-dim">({counts.coreEd} core, {counts.ed} scored in all)</span></label>
  </div>

  <div class="ac-tabs" role="tablist" aria-label="Calculator mode">
    <button type="button" role="tab" id="tab-quick" aria-controls="panel-quick" aria-selected="true">Quick check</button>
    <button type="button" role="tab" id="tab-full" aria-controls="panel-full" aria-selected="false" tabindex="-1">Full audit</button>
  </div>

  <!-- ============================== QUICK CHECK ============================== -->
  <section id="panel-quick" role="tabpanel" aria-labelledby="tab-quick" class="ac-panel">
    <div class="qc-layout">
      <div class="qc-main">
        <p class="ac-lead qc-intro">
          Answer yes, no or not sure, one topic at a time. Questions about things your site doesn't have are skipped, and
          follow-ups appear only when they apply. Everything stays in this browser.
        </p>
        <nav class="qc-steps" aria-label="Quick check topics">
          <ol>
            {quickSections.map((s: any, i: number) => (
              <li><button type="button" class="qc-step" data-step={i}><span class="qc-step-n">{i + 1}</span> {s.title}</button></li>
            ))}
          </ol>
        </nav>
        {quickSections.map((s: any, i: number) => (
          <section class="qc-section" aria-labelledby={`qc-h-${s.id}`} data-section={s.id} data-step={i} hidden={i > 0}>
            <p class="qc-step-of">Topic {i + 1} of {quickSections.length}</p>
            <h2 id={`qc-h-${s.id}`} tabindex="-1">{s.title}</h2>
            {s.root.map((item: any) => (
              <QuickQuestion item={item} standIns={quick.standIns || {}} exploratory={exploratory} />
            ))}
            <div class="qc-nav">
              {i > 0 && <button type="button" class="ac-btn" data-go={i - 1}>Back: {quickSections[i - 1].title}</button>}
              {i < quickSections.length - 1
                ? <button type="button" class="ac-btn ac-btn-primary" data-go={i + 1}>Next: {quickSections[i + 1].title}</button>
                : <button type="button" class="ac-btn ac-btn-primary" data-go="report">See what your answers point to</button>}
            </div>
          </section>
        ))}
      </div>

      <aside class="qc-results" aria-labelledby="qc-results-h">
        <div class="qc-results-inner">
          <h2 id="qc-results-h">Your estimate</h2>
          <p class="qc-progress"><span id="qc-answered">0</span> of <span id="qc-visible">0</span> questions answered</p>
          <div class="qc-meter" aria-hidden="true"><span id="qc-meter-fill"></span></div>
          <p class="qc-verdict" id="qc-verdict" data-state="empty">Start answering to see an estimate.</p>
          <dl class="qc-counts">
            <div><dt>Look unmet</dt><dd id="qc-n-fail">0</dd></div>
            <div><dt>Look met</dt><dd id="qc-n-pass">0</dd></div>
            <div><dt>To check</dt><dd id="qc-n-check">0</dd></div>
            <div><dt>Not applicable</dt><dd id="qc-n-na">0</dd></div>
          </dl>
          <p class="qc-small">Out of <span id="qc-n-core">0</span> core requirements in scope. <span id="qc-n-open">0</span> still need an answer.</p>
          <div class="qc-actions">
            <button type="button" class="ac-btn ac-btn-primary" id="qc-to-full">Continue in the full audit</button>
            <button type="button" class="ac-btn" id="qc-reset">Start over</button>
          </div>
          <p class="qc-small" id="qc-reset-note" role="status"></p>
        </div>
      </aside>
    </div>

    <section class="qc-report" aria-labelledby="qc-report-h">
      <h2 id="qc-report-h">What your answers point to</h2>
      <div class="qc-report-grid">
        <div>
          <h3>Core requirements that look unmet</h3>
          <ul id="qc-list-fail" class="qc-list"><li class="qc-empty">None so far.</li></ul>
        </div>
        <div>
          <h3>To check</h3>
          <ul id="qc-list-check" class="qc-list"><li class="qc-empty">None so far.</li></ul>
        </div>
        <div>
          <h3>Can't be tested yet</h3>
          <ul class="qc-list">
            {(quick.notTestableYet || []).map((n: any) => (
              <li><a href={link(`/plain-english/provision/${n.slug}/`)}>{catalog.find((p) => p.slug === n.slug)?.title || n.slug}</a><span class="qc-why">{n.reason}</span></li>
            ))}
          </ul>
        </div>
      </div>
      <p class="qc-small">
        A quick check is an estimate from your own answers, not an audit. It covers core requirements only; supplemental
        requirements and assertions, which count toward Bronze, Silver and Gold, are in the full audit.
      </p>
    </section>
  </section>

  <!-- ============================== FULL AUDIT ============================== -->
  <section id="panel-full" role="tabpanel" aria-labelledby="tab-full" class="ac-panel" hidden>
    <div class="fa-summary">
      <article class="fa-card fa-conf">
        <h2>Conformance <span class="ac-dim">(tier 3)</span></h2>
        <p class="fa-status" id="fa-conf-status" data-state="incomplete">Not evaluated</p>
        <p class="fa-detail" id="fa-conf-detail">—</p>
      </article>
      <article class="fa-card">
        <h2>Progress toward conformance</h2>
        <p class="fa-big"><span id="fa-progress">0</span>%</p>
        <div class="fa-bar" aria-hidden="true"><span id="fa-progress-fill"></span></div>
        <p class="fa-detail">Core requirements met, out of those that apply. Each counts 1 until the draft tags requirements by severity.</p>
      </article>
      <article class="fa-card">
        <h2>Beyond conformance <span class="ac-dim">(tiers 4 to 6)</span></h2>
        <dl class="fa-pairs">
          <div><dt>Supplemental requirements met</dt><dd id="fa-supp">0</dd></div>
          <div><dt>Assertions made</dt><dd id="fa-assert">0</dd></div>
        </dl>
        <p class="fa-detail" id="fa-beyond-note">These count toward Bronze, Silver and Gold once conformance is met. The draft hasn't set how many each tier needs.</p>
      </article>
      <article class="fa-card">
        <h2>Tiers 1 and 2</h2>
        <p class="fa-status" data-state="na">Can't be worked out yet</p>
        <p class="fa-detail">Avoid physical harm and Foundational access depend on harm, risk and barrier tags. No core requirement in the draft has one yet.</p>
      </article>
    </div>

    <section class="fa-groups" aria-labelledby="fa-groups-h">
      <h2 id="fa-groups-h">Core requirements by W3C group</h2>
      <ul class="fa-group-bars" id="fa-group-bars">
        {groups.map((g) => (
          <li data-group-row={g.slug}>
            <span class="fa-g-name">{g.title}</span>
            <span class="fa-g-track" aria-hidden="true"><span class="fa-g-met"></span><span class="fa-g-fail"></span></span>
            <span class="fa-g-nums"></span>
          </li>
        ))}
      </ul>
    </section>

    <div class="fa-toolbar">
      <div class="fa-search">
        <label for="fa-search">Filter provisions</label>
        <input type="search" id="fa-search" placeholder="For example contrast, keyboard, captions" autocomplete="off" />
      </div>
      <div class="fa-filter">
        <label for="fa-type">Type</label>
        <select id="fa-type">
          <option value="all">All types</option>
          <option value="core">Core requirements</option>
          <option value="supplemental">Supplemental requirements</option>
          <option value="assertion">Assertions</option>
          <option value="untyped">Untyped</option>
        </select>
      </div>
      <div class="fa-filter">
        <label for="fa-result">Result</label>
        <select id="fa-result">
          <option value="all">Any result</option>
          <option value="unset">Not evaluated</option>
          <option value="met">Met</option>
          <option value="notmet">Not met</option>
          <option value="na">Not applicable</option>
        </select>
      </div>
      <p class="fa-shown" role="status"><span id="fa-shown">0</span> shown</p>
      <div class="fa-export">
        <button type="button" class="ac-btn" id="fa-export-md">Download report (.md)</button>
        <button type="button" class="ac-btn" id="fa-export-json">Download data (.json)</button>
        <button type="button" class="ac-btn" id="fa-reset">Clear all results</button>
      </div>
    </div>

    <div class="fa-worksheet">
      {groups.map((g) => (
        <details class="fa-group" open data-group={g.slug}>
          <summary><h2>{g.title}</h2><span class="fa-group-count">{g.items.length} provisions</span></summary>
          <ul class="fa-items">
            {g.items.map((p) => {
              const k = kind(p);
              const isAssertion = k === "assertion";
              const name = `fa-${p.slug}`;
              return (
                <li class="fa-item" data-slug={p.slug} data-kind={k} data-exploratory={p.status === "exploratory" ? "true" : undefined}>
                  <div class="fa-item-head">
                    <span class={`fa-type fa-type-${k}`}>{provisionTypeLabel(p.type)}</span>
                    {p.status === "exploratory" && <span class="fa-type fa-type-exp">Exploratory</span>}
                    <h3><a href={link(`/plain-english/provision/${p.slug}/`)}>{p.title}</a></h3>
                  </div>
                  <p class="fa-text">{normative(p)}</p>
                  <fieldset class="fa-answers">
                    <legend class="ac-sr">Result for {p.title}</legend>
                    <label><input type="radio" name={name} value="unset" checked /> <span>Not evaluated</span></label>
                    <label><input type="radio" name={name} value="met" /> <span>{isAssertion ? "Made" : "Met"}</span></label>
                    <label><input type="radio" name={name} value="notmet" /> <span>{isAssertion ? "Not made" : "Not met"}</span></label>
                    <label><input type="radio" name={name} value="na" /> <span>Not applicable</span></label>
                  </fieldset>
                </li>
              );
            })}
          </ul>
        </details>
      ))}
    </div>
    {recommendedCount > 0 && (
      <p class="qc-small">{recommendedCount} recommended practice{recommendedCount === 1 ? " is" : "s are"} left out: the draft says recommended practices are informative and do not need to be satisfied to conform.</p>
    )}
  </section>

  <script type="application/json" id="ac-data" set:html={JSON.stringify(clientData)}></script>
</PlainEnglishLayout>

<style>
  .ac-banner {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-left: 4px solid var(--accent-blue);
    border-radius: var(--radius-lg);
    padding: 24px clamp(16px, 3vw, 32px);
    margin-bottom: 16px;
  }
  .ac-kicker { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); margin: 0 0 8px; }
  .ac-banner h1 { font-size: clamp(1.6rem, 1.1rem + 2vw, 2.3rem); font-weight: 800; color: var(--text-pure); letter-spacing: -0.02em; margin: 0 0 8px; }
  .ac-lead { color: var(--text-secondary); line-height: 1.65; max-width: 72ch; margin: 0; }
  .ac-dim { color: var(--text-muted); font-weight: 400; }
  .ac-sr { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  code { font-family: var(--font-mono); font-size: 0.88em; }
  /* Several blocks here set display: grid or flex, which would override the hidden attribute. */
  .ac-panel[hidden], :global(.ac-panel [hidden]) { display: none !important; }

  .ac-model { background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); margin-bottom: 16px; }
  .ac-model summary { cursor: pointer; padding: 12px 18px; font-weight: 600; color: var(--text-primary); min-height: 44px; display: flex; align-items: center; }
  .ac-model-body { padding: 0 18px 16px; }
  .ac-model-body ul { margin: 0; padding-left: 1.2em; display: grid; gap: 8px; color: var(--text-secondary); line-height: 1.6; max-width: 80ch; }
  .ac-model-links { display: flex; flex-wrap: wrap; gap: 8px 18px; margin: 12px 0 0; font-size: 0.9rem; color: var(--text-muted); }
  .ac-model-links a, .qc-list a, .fa-item h3 a { color: var(--text-accent); }

  .ac-scope { display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: center; margin: 0 0 16px; font-size: 0.92rem; color: var(--text-primary); }
  .ac-scope-label { font-weight: 700; }
  .ac-scope label, .fa-answers label { display: inline-flex; gap: 6px; align-items: center; cursor: pointer; min-height: 24px; }
  .ac-panel :global(input[type="radio"]), .ac-scope input[type="radio"] { accent-color: var(--accent-blue); width: 18px; height: 18px; margin: 0; }

  .ac-tabs { display: flex; gap: 4px; border-bottom: 2px solid var(--border-subtle); margin-bottom: 20px; }
  .ac-tabs [role="tab"] {
    font: inherit; font-weight: 700; font-size: 1rem; color: var(--text-secondary); background: none; border: 0;
    border-bottom: 3px solid transparent; margin-bottom: -2px; padding: 10px 18px; cursor: pointer; min-height: 44px;
  }
  .ac-tabs [role="tab"][aria-selected="true"] { color: var(--text-pure); border-bottom-color: var(--accent-blue); }
  .ac-tabs [role="tab"]:hover { color: var(--text-pure); }

  .ac-btn {
    font: inherit; font-size: 0.9rem; font-weight: 600; min-height: 40px; padding: 0 14px; border-radius: var(--radius-sm);
    border: 1px solid var(--border-default); background: var(--surface-card-hover); color: var(--text-primary); cursor: pointer;
  }
  .ac-btn:hover { border-color: var(--accent-blue); }
  .ac-btn-primary { background: var(--accent-blue); border-color: var(--accent-blue); color: var(--on-accent); }

  /* Quick check */
  .qc-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 320px); gap: 24px; align-items: start; }
  @media (max-width: 900px) { .qc-layout { grid-template-columns: minmax(0, 1fr); } }
  .qc-main { display: grid; gap: 18px; min-width: 0; }
  .qc-intro { margin-bottom: 2px; }
  .qc-section { background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: 18px clamp(14px, 2.5vw, 24px); display: grid; gap: 12px; min-width: 0; }
  .qc-section h2 { font-size: 1.15rem; font-weight: 800; color: var(--text-pure); margin: 0; }
  .qc-section h2:focus { outline: none; }
  .qc-step-of { margin: 0; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); }
  .qc-steps ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .qc-step {
    font: inherit; font-size: 0.82rem; min-height: 32px; padding: 0 10px 0 4px; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--border-subtle); background: var(--surface-card); color: var(--text-secondary); display: inline-flex; gap: 6px; align-items: center;
  }
  .qc-step-n { display: inline-grid; place-items: center; min-width: 24px; height: 24px; border-radius: 999px; background: var(--surface-subtle); font-weight: 700; font-variant-numeric: tabular-nums; }
  .qc-step[data-done="true"] .qc-step-n { background: var(--accent-emerald); color: var(--surface-card); }
  .qc-step[aria-current="step"] { border-color: var(--accent-blue); color: var(--text-pure); font-weight: 700; }
  .qc-nav { display: flex; flex-wrap: wrap; gap: 8px; justify-content: space-between; border-top: 1px solid var(--border-subtle); padding-top: 12px; }
  .qc-nav .ac-btn-primary { margin-left: auto; }
  :global(.qc-q) { display: grid; gap: 10px; min-width: 0; }
  :global(.qc-fieldset) { border: 0; margin: 0; padding: 0; min-width: 0; }
  :global(.qc-legend) { font-weight: 600; color: var(--text-primary); line-height: 1.5; padding: 0; margin-bottom: 4px; }
  :global(.qc-help) { color: var(--text-muted); font-size: 0.88rem; line-height: 1.5; margin: 0 0 6px; max-width: 72ch; }
  :global(.qc-standin) { border-left: 3px solid var(--accent-amber); padding-left: 10px; }
  :global(.qc-answers) { display: flex; flex-wrap: wrap; gap: 6px 18px; }
  :global(.qc-answer) { padding: 4px 0; color: var(--text-primary); display: inline-flex; gap: 6px; align-items: center; cursor: pointer; min-height: 24px; }
  :global(.qc-q[hidden]) { display: none; }
  :global(.qc-tag) { font-size: 0.78rem; color: var(--text-muted); margin: 6px 0 0; }
  :global(.qc-children) { border-left: 2px solid var(--border-subtle); padding-left: clamp(12px, 2vw, 18px); margin-left: 4px; display: grid; gap: 14px; }
  :global(.qc-children:not(:has(> .qc-q:not([hidden])))) { display: none; }

  .qc-results { position: sticky; top: var(--ac-sticky-top, 12px); min-width: 0; }
  @media (max-width: 900px) { .qc-results { position: static; } }
  .qc-results-inner { background: var(--surface-card); border: 1px solid var(--border-default); border-radius: var(--radius-lg); padding: 18px; display: grid; gap: 10px; }
  .qc-results h2 { font-size: 1.1rem; font-weight: 800; color: var(--text-pure); margin: 0; }
  .qc-progress, .qc-small { color: var(--text-muted); font-size: 0.85rem; margin: 0; line-height: 1.5; }
  .qc-meter, .fa-bar { height: 8px; border-radius: 999px; background: var(--surface-subtle); border: 1px solid var(--border-subtle); overflow: hidden; }
  .qc-meter span, .fa-bar span { display: block; height: 100%; width: 0; background: var(--accent-blue); transition: width 0.2s; }
  .qc-verdict { margin: 0; font-weight: 700; line-height: 1.45; color: var(--text-pure); padding: 10px 12px; border-radius: var(--radius-sm); border: 1px solid var(--border-subtle); }
  .qc-verdict[data-state="fail"], .fa-status[data-state="fail"] { border-color: var(--accent-rose); }
  .qc-verdict[data-state="pass"], .fa-status[data-state="pass"] { border-color: var(--accent-emerald); }
  .qc-counts { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin: 0; }
  .qc-counts div { border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 8px 10px; }
  .qc-counts dt { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted); }
  .qc-counts dd { margin: 2px 0 0; font-size: 1.4rem; font-weight: 800; color: var(--text-pure); font-variant-numeric: tabular-nums; }
  .qc-actions { display: flex; flex-wrap: wrap; gap: 8px; }

  .qc-report { margin-top: 24px; background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: 18px clamp(14px, 2.5vw, 24px); display: grid; gap: 14px; }
  .qc-report h2 { font-size: 1.2rem; font-weight: 800; color: var(--text-pure); margin: 0; }
  .qc-report h3 { font-size: 0.95rem; font-weight: 700; color: var(--text-pure); margin: 0 0 8px; }
  .qc-report-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 18px; }
  .qc-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .qc-list li { display: grid; gap: 2px; line-height: 1.45; }
  .qc-why, .qc-empty { color: var(--text-muted); font-size: 0.85rem; }

  /* Full audit */
  .fa-summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr)); gap: 12px; margin-bottom: 20px; }
  .fa-card { background: var(--surface-card); border: 1px solid var(--border-default); border-radius: var(--radius-lg); padding: 16px; display: grid; gap: 8px; align-content: start; min-width: 0; }
  .fa-card h2 { font-size: 1rem; font-weight: 800; color: var(--text-pure); margin: 0; }
  .fa-status { margin: 0; font-weight: 700; color: var(--text-pure); padding: 8px 10px; border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); }
  .fa-big { margin: 0; font-size: 2rem; font-weight: 800; color: var(--text-pure); font-variant-numeric: tabular-nums; }
  .fa-detail { margin: 0; color: var(--text-muted); font-size: 0.86rem; line-height: 1.5; }
  .fa-pairs { margin: 0; display: grid; gap: 6px; }
  .fa-pairs div { display: flex; justify-content: space-between; gap: 10px; color: var(--text-secondary); font-size: 0.9rem; }
  .fa-pairs dd { margin: 0; font-weight: 800; color: var(--text-pure); font-variant-numeric: tabular-nums; }

  .fa-groups { background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); padding: 16px clamp(14px, 2.5vw, 22px); margin-bottom: 20px; }
  .fa-groups h2 { font-size: 1rem; font-weight: 800; color: var(--text-pure); margin: 0 0 12px; }
  .fa-group-bars { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .fa-group-bars li { display: grid; grid-template-columns: minmax(0, 13rem) minmax(80px, 1fr) auto; gap: 10px; align-items: center; font-size: 0.88rem; color: var(--text-secondary); }
  @media (max-width: 560px) { .fa-group-bars li { grid-template-columns: minmax(0, 1fr) auto; } .fa-g-track { grid-column: 1 / -1; grid-row: 2; } }
  .fa-group-bars li[hidden] { display: none; }
  .fa-g-track { display: flex; height: 10px; border-radius: 999px; background: var(--surface-subtle); border: 1px solid var(--border-subtle); overflow: hidden; }
  .fa-g-met { background: var(--accent-emerald); }
  .fa-g-fail { background: var(--accent-rose); }
  .fa-g-nums { font-variant-numeric: tabular-nums; color: var(--text-muted); white-space: nowrap; }

  .fa-toolbar { display: flex; flex-wrap: wrap; gap: 12px 16px; align-items: flex-end; margin-bottom: 14px; }
  .fa-search, .fa-filter { display: grid; gap: 4px; min-width: 0; }
  .fa-search { flex: 1 1 240px; }
  .fa-toolbar label { font-size: 0.82rem; font-weight: 600; color: var(--text-primary); }
  .fa-toolbar input, .fa-toolbar select {
    font: inherit; font-size: 0.92rem; min-height: 40px; padding: 0 10px; border-radius: var(--radius-sm);
    border: 1px solid var(--border-default); background: var(--surface-base); color: var(--text-primary); width: 100%;
  }
  .fa-shown { margin: 0 0 10px; color: var(--text-muted); font-size: 0.85rem; }
  .fa-export { display: flex; flex-wrap: wrap; gap: 8px; }

  .fa-worksheet { display: grid; gap: 12px; }
  .fa-group { background: var(--surface-card); border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); }
  .fa-group > summary { cursor: pointer; display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; padding: 14px 18px; min-height: 44px; }
  .fa-group > summary h2 { display: inline; font-size: 1.1rem; font-weight: 800; color: var(--text-pure); margin: 0; }
  .fa-group-count { color: var(--text-muted); font-size: 0.85rem; }
  .fa-items { list-style: none; margin: 0; padding: 0 18px 8px; }
  .fa-item { border-top: 1px solid var(--border-subtle); padding: 14px 0; display: grid; gap: 8px; min-width: 0; }
  .fa-item-head { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: baseline; }
  .fa-item h3 { font-size: 1rem; font-weight: 700; margin: 0; flex: 1 1 14rem; min-width: 0; }
  .fa-type { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; padding: 3px 7px; border-radius: 4px; border: 1px solid var(--border-default); color: var(--text-secondary); white-space: nowrap; }
  .fa-type-core { color: var(--accent-rose); border-color: currentColor; }
  .fa-type-exp { color: var(--accent-amber); border-color: currentColor; }
  .fa-text { margin: 0; color: var(--text-secondary); line-height: 1.55; font-size: 0.93rem; max-width: 85ch; }
  .fa-answers { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 0.9rem; color: var(--text-primary); }
  .fa-item[data-result="notmet"] { box-shadow: inset 3px 0 0 var(--accent-rose); padding-left: 12px; }
  .fa-item[data-result="met"] { box-shadow: inset 3px 0 0 var(--accent-emerald); padding-left: 12px; }
  @media (prefers-reduced-motion: reduce) { .qc-meter span, .fa-bar span { transition: none; } }
</style>

<script>
  type Answer = "yes" | "no" | "unsure";
  type Result = "unset" | "met" | "notmet" | "na";
  const data = JSON.parse(document.getElementById("ac-data")!.textContent || "{}");
  const provisions: { slug: string; title: string; kind: string; exploratory: boolean; group: string }[] = data.provisions;
  const bySlug = new Map(provisions.map((p) => [p.slug, p]));
  const notYet = new Set<string>((data.notTestableYet || []).map((n: any) => n.slug));
  const KEY = "wcag3_audit_v2";

  let store: { scope: "wd" | "ed"; tab: "quick" | "full"; quick: Record<string, Answer>; full: Record<string, Result> } = {
    scope: "wd", tab: "quick", quick: {}, full: {},
  };
  try { store = Object.assign(store, JSON.parse(localStorage.getItem(KEY) || "{}")); } catch {}
  try { localStorage.removeItem("wcag3_audit_state_v1"); } catch {}
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify(store)); } catch {} };
  const inScope = (p: { exploratory: boolean }) => store.scope === "ed" || !p.exploratory;
  const provLink = (slug: string) => `${data.base}/plain-english/provision/${slug}/`;
  const $ = (id: string) => document.getElementById(id) as HTMLElement;

  // ---------------- Tabs ----------------
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  function selectTab(which: "quick" | "full", focus = false) {
    tabs.forEach((t) => {
      const on = t.id === "tab-" + which;
      t.setAttribute("aria-selected", String(on));
      t.tabIndex = on ? 0 : -1;
      $(t.getAttribute("aria-controls")!).hidden = !on;
      if (on && focus) t.focus();
    });
    store.tab = which;
    save();
  }
  tabs.forEach((t, i) => {
    t.addEventListener("click", () => selectTab(t.id === "tab-quick" ? "quick" : "full"));
    t.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowRight" && e.key !== "ArrowLeft" && e.key !== "Home" && e.key !== "End") return;
      e.preventDefault();
      const n = e.key === "Home" ? 0 : e.key === "End" ? tabs.length - 1 : (i + (e.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
      selectTab(tabs[n].id === "tab-quick" ? "quick" : "full", true);
    });
  });

  // ---------------- Scope ----------------
  document.querySelectorAll<HTMLInputElement>('input[name="ac-scope"]').forEach((r) => {
    r.checked = r.value === store.scope;
    r.addEventListener("change", () => { store.scope = r.value as "wd" | "ed"; save(); updateQuick(); updateFull(); });
  });

  // ---------------- Quick check ----------------
  const qNodes = [...document.querySelectorAll<HTMLElement>(".qc-q")];
  const answerOf = (q: HTMLElement) => store.quick[q.dataset.qid!] as Answer | undefined;
  const childrenOf = (q: HTMLElement) => [...(q.querySelector(":scope > .qc-children")?.children || [])] as HTMLElement[];
  const descendantProvisions = (q: HTMLElement) =>
    [q, ...q.querySelectorAll<HTMLElement>(".qc-q")].flatMap((n) => (n.dataset.provisions || "").split(" ").filter(Boolean));

  qNodes.forEach((q) => {
    const a = answerOf(q);
    q.querySelectorAll<HTMLInputElement>(`:scope > fieldset input[type="radio"]`).forEach((r) => {
      r.checked = r.value === a;
      r.addEventListener("change", () => { store.quick[q.dataset.qid!] = r.value as Answer; save(); updateQuick(); });
    });
  });

  // Show a question when its parent's answer opens it, hide questions whose
  // requirements are all exploratory when the Working Draft is selected.
  function refreshVisibility() {
    const visit = (q: HTMLElement, shown: boolean) => {
      const scopeHidden = q.dataset.allExploratory === "true" && store.scope === "wd";
      q.hidden = !shown || scopeHidden;
      const a = answerOf(q);
      childrenOf(q).forEach((c) => {
        const opens = a === c.dataset.when || (c.dataset.when === "yes" && a === "unsure");
        visit(c, !q.hidden && opens);
      });
    };
    document.querySelectorAll<HTMLElement>(".qc-section").forEach((s) =>
      [...s.children].filter((c) => c.classList.contains("qc-q")).forEach((q) => visit(q as HTMLElement, true)));
  }

  function quickResults() {
    const res = new Map<string, Result | "check">();
    const naFromGate = new Set<string>();
    const answers = new Map<string, Answer[]>(); // slug -> answers from visible questions, as met/notmet votes
    for (const q of qNodes) {
      if (q.hidden) continue;
      const a = answerOf(q);
      if (q.dataset.naWhenNo === "true" && a === "no") childrenOf(q).forEach((c) => descendantProvisions(c).forEach((s) => naFromGate.add(s)));
      const slugs = (q.dataset.provisions || "").split(" ").filter(Boolean);
      for (const s of slugs) {
        if (!answers.has(s)) answers.set(s, []);
        if (a) answers.get(s)!.push(a === "unsure" ? "unsure" : a === q.dataset.meets ? "yes" : "no");
      }
    }
    for (const p of provisions) {
      if (p.kind !== "core" || !inScope(p) || notYet.has(p.slug)) continue;
      const votes = answers.get(p.slug) || [];
      if (votes.includes("no")) res.set(p.slug, "notmet");
      else if (votes.includes("unsure")) res.set(p.slug, "check");
      else if (votes.length && votes.every((v) => v === "yes")) res.set(p.slug, "met");
      else if (naFromGate.has(p.slug)) res.set(p.slug, "na");
      else res.set(p.slug, "unset");
    }
    return res;
  }

  function listInto(el: HTMLElement, slugs: string[]) {
    el.replaceChildren();
    if (!slugs.length) { const li = document.createElement("li"); li.className = "qc-empty"; li.textContent = "None so far."; el.append(li); return; }
    for (const s of slugs) {
      const p = bySlug.get(s)!;
      const li = document.createElement("li");
      const a = document.createElement("a"); a.href = provLink(s); a.textContent = p.title;
      li.append(a);
      if (p.exploratory) { const t = document.createElement("span"); t.className = "qc-why"; t.textContent = "Exploratory: not in the published Working Draft"; li.append(t); }
      el.append(li);
    }
  }

  function updateQuick() {
    refreshVisibility();
    const visible = qNodes.filter((q) => !q.hidden);
    const answered = visible.filter((q) => answerOf(q)).length;
    $("qc-answered").textContent = String(answered);
    $("qc-visible").textContent = String(visible.length);
    ($("qc-meter-fill") as HTMLElement).style.width = visible.length ? (answered / visible.length) * 100 + "%" : "0";
    const res = quickResults();
    const by = (v: string) => [...res].filter(([, r]) => r === v).map(([s]) => s);
    const fail = by("notmet"), pass = by("met"), check = by("check"), na = by("na"), open = by("unset");
    $("qc-n-fail").textContent = String(fail.length);
    $("qc-n-pass").textContent = String(pass.length);
    $("qc-n-check").textContent = String(check.length);
    $("qc-n-na").textContent = String(na.length);
    $("qc-n-open").textContent = String(open.length);
    $("qc-n-core").textContent = String(res.size + [...notYet].filter((s) => bySlug.get(s) && inScope(bySlug.get(s)!)).length);
    const v = $("qc-verdict");
    if (!answered) { v.dataset.state = "empty"; v.textContent = "Start answering to see an estimate."; }
    else if (fail.length) { v.dataset.state = "fail"; v.textContent = `Not conforming yet: ${fail.length} core requirement${fail.length === 1 ? " looks" : "s look"} unmet.`; }
    else if (open.length) { v.dataset.state = "open"; v.textContent = "No unmet core requirements so far. Keep going to finish the estimate."; }
    else if (check.length) { v.dataset.state = "open"; v.textContent = `No core requirement looks unmet, but ${check.length} need${check.length === 1 ? "s" : ""} checking.`; }
    else { v.dataset.state = "pass"; v.textContent = "No core requirement looks unmet from your answers. Confirm it with a full audit."; }
    listInto($("qc-list-fail"), fail);
    listInto($("qc-list-check"), check);
    markDone();
  }

  // ---------------- Quick check topics, one at a time ----------------
  const sections = [...document.querySelectorAll<HTMLElement>(".qc-section")];
  const stepBtns = [...document.querySelectorAll<HTMLButtonElement>(".qc-step")];
  let step = Math.min(Math.max(0, (store as any).qstep | 0), sections.length - 1);
  function showStep(i: number, focus = false) {
    step = i;
    (store as any).qstep = i;
    save();
    sections.forEach((s, n) => (s.hidden = n !== i));
    stepBtns.forEach((b, n) => (n === i ? b.setAttribute("aria-current", "step") : b.removeAttribute("aria-current")));
    if (focus) { const h = sections[i].querySelector("h2") as HTMLElement; h.focus({ preventScroll: true }); sections[i].scrollIntoView({ block: "start" }); }
  }
  function markDone() {
    sections.forEach((s, n) => {
      const vis = [...s.querySelectorAll<HTMLElement>(".qc-q")].filter((q) => !q.hidden);
      stepBtns[n].dataset.done = String(vis.length > 0 && vis.every((q) => answerOf(q)));
    });
  }
  stepBtns.forEach((b, n) => b.addEventListener("click", () => showStep(n, true)));
  document.querySelectorAll<HTMLButtonElement>("[data-go]").forEach((b) =>
    b.addEventListener("click", () => {
      if (b.dataset.go === "report") { const r = $("qc-report-h"); r.setAttribute("tabindex", "-1"); r.focus({ preventScroll: true }); r.scrollIntoView({ block: "start" }); }
      else showStep(+b.dataset.go!, true);
    }));

  $("qc-to-full").addEventListener("click", () => {
    const res = quickResults();
    for (const [slug, r] of res) {
      if (r === "met" || r === "notmet" || r === "na") store.full[slug] = r;
    }
    save();
    syncFullInputs();
    updateFull();
    selectTab("full", true);
    $("panel-full").scrollIntoView({ block: "start" });
  });
  let resetArmed = false;
  $("qc-reset").addEventListener("click", (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    if (!resetArmed) { resetArmed = true; btn.textContent = "Clear all answers?"; $("qc-reset-note").textContent = "Press again to clear every quick-check answer."; return; }
    resetArmed = false; btn.textContent = "Start over"; $("qc-reset-note").textContent = "Answers cleared.";
    store.quick = {}; save();
    qNodes.forEach((q) => q.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((r) => (r.checked = false)));
    updateQuick();
  });

  // ---------------- Full audit ----------------
  const items = [...document.querySelectorAll<HTMLElement>(".fa-item")];
  const resultOf = (slug: string): Result => store.full[slug] || "unset";
  function syncFullInputs() {
    items.forEach((it) => {
      const r = resultOf(it.dataset.slug!);
      it.dataset.result = r;
      it.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((i) => (i.checked = i.value === r));
    });
  }
  items.forEach((it) => {
    it.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((i) =>
      i.addEventListener("change", () => {
        if (i.value === "unset") delete store.full[it.dataset.slug!];
        else store.full[it.dataset.slug!] = i.value as Result;
        it.dataset.result = i.value;
        save();
        updateFull();
      }));
  });

  function fullStats() {
    const scoped = provisions.filter(inScope);
    const core = scoped.filter((p) => p.kind === "core");
    const n = (list: typeof scoped, r: Result) => list.filter((p) => resultOf(p.slug) === r).length;
    const coreMet = n(core, "met"), coreFail = n(core, "notmet"), coreNa = n(core, "na"), coreUnset = n(core, "unset");
    const applicable = core.length - coreNa;
    return {
      scoped, core, coreMet, coreFail, coreNa, coreUnset, applicable,
      progress: applicable ? Math.round((coreMet / applicable) * 100) : 0,
      supp: n(scoped.filter((p) => p.kind === "supplemental"), "met"),
      suppTotal: scoped.filter((p) => p.kind === "supplemental").length,
      asserted: n(scoped.filter((p) => p.kind === "assertion"), "met"),
      assertTotal: scoped.filter((p) => p.kind === "assertion").length,
    };
  }

  function updateFull() {
    const s = fullStats();
    const st = $("fa-conf-status");
    if (s.coreFail) { st.dataset.state = "fail"; st.textContent = `Does not conform: ${s.coreFail} core requirement${s.coreFail === 1 ? "" : "s"} not met`; }
    else if (s.coreUnset) { st.dataset.state = "incomplete"; st.textContent = `Incomplete: ${s.coreUnset} core requirement${s.coreUnset === 1 ? "" : "s"} not evaluated`; }
    else { st.dataset.state = "pass"; st.textContent = "Conforms: every core requirement in scope is met or doesn't apply"; }
    $("fa-conf-detail").textContent = `${s.coreMet} met, ${s.coreFail} not met, ${s.coreNa} not applicable, ${s.coreUnset} not evaluated, of ${s.core.length} core requirements.`;
    $("fa-progress").textContent = String(s.progress);
    ($("fa-progress-fill") as HTMLElement).style.width = s.progress + "%";
    $("fa-supp").textContent = `${s.supp} of ${s.suppTotal}`;
    $("fa-assert").textContent = `${s.asserted} of ${s.assertTotal}`;
    const conforms = !s.coreFail && !s.coreUnset;
    $("fa-beyond-note").textContent = conforms
      ? "Conformance is met, so these count toward Bronze, Silver and Gold. The draft hasn't set how many each tier needs."
      : "These start counting toward Bronze, Silver and Gold once conformance is met. The draft hasn't set how many each tier needs.";

    document.querySelectorAll<HTMLElement>("[data-group-row]").forEach((row) => {
      const g = row.dataset.groupRow;
      const core = s.core.filter((p) => p.group === g);
      const met = core.filter((p) => resultOf(p.slug) === "met").length;
      const fail = core.filter((p) => resultOf(p.slug) === "notmet").length;
      const na = core.filter((p) => resultOf(p.slug) === "na").length;
      const app = core.length - na;
      (row.querySelector(".fa-g-met") as HTMLElement).style.width = app ? (met / app) * 100 + "%" : "0";
      (row.querySelector(".fa-g-fail") as HTMLElement).style.width = app ? (fail / app) * 100 + "%" : "0";
      row.querySelector(".fa-g-nums")!.textContent = core.length ? `${met} met · ${fail} not met · ${core.length} core` : "no core requirements";
      row.hidden = !core.length;
    });
    applyFilters();
  }

  const search = $("fa-search") as HTMLInputElement, typeSel = $("fa-type") as HTMLSelectElement, resSel = $("fa-result") as HTMLSelectElement;
  function applyFilters() {
    const q = search.value.trim().toLowerCase();
    let shown = 0;
    items.forEach((it) => {
      const p = bySlug.get(it.dataset.slug!)!;
      const ok = inScope(p)
        && (typeSel.value === "all" || p.kind === typeSel.value)
        && (resSel.value === "all" || resultOf(p.slug) === resSel.value)
        && (!q || it.textContent!.toLowerCase().includes(q));
      it.hidden = !ok;
      if (ok) shown++;
    });
    document.querySelectorAll<HTMLElement>(".fa-group").forEach((g) => { g.hidden = !g.querySelector(".fa-item:not([hidden])"); });
    $("fa-shown").textContent = String(shown);
  }
  search.addEventListener("input", applyFilters);
  typeSel.addEventListener("change", applyFilters);
  resSel.addEventListener("change", applyFilters);

  function download(name: string, text: string, type: string) {
    const url = URL.createObjectURL(new Blob([text], { type }));
    const a = document.createElement("a");
    a.href = url; a.download = name; document.body.append(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  }
  const today = () => new Date().toISOString().slice(0, 10);
  const label: Record<Result, string> = { unset: "Not evaluated", met: "Met", notmet: "Not met", na: "Not applicable" };
  $("fa-export-md").addEventListener("click", () => {
    const s = fullStats();
    const scopeName = store.scope === "wd" ? "Working Draft (exploratory provisions excluded)" : "Editor's Draft (all provisions)";
    let md = `# WCAG 3 audit\n\n- Date: ${today()}\n- Scope: ${scopeName}\n- Draft tracked at: ${data.draftCommit}\n`;
    md += `- Conformance: ${$("fa-conf-status").textContent}\n- Progress toward conformance: ${s.progress}% of applicable core requirements met (all weighted 1; the draft has not tagged requirements yet)\n`;
    md += `- Supplemental requirements met: ${s.supp} of ${s.suppTotal}\n- Assertions made: ${s.asserted} of ${s.assertTotal}\n\n`;
    md += `Scored against the conformance model in the WCAG 3 draft and the scoring alternative in its Explainer. Reporting tier thresholds are not set in the draft.\n`;
    for (const g of data.groups) {
      const list = s.scoped.filter((p) => p.group === g.slug);
      if (!list.length) continue;
      md += `\n## ${g.title}\n\n| Provision | Type | Result |\n| --- | --- | --- |\n`;
      for (const p of list) md += `| ${p.title}${p.exploratory ? " (exploratory)" : ""} | ${p.kind} | ${label[resultOf(p.slug)]} |\n`;
    }
    download(`wcag3-audit-${today()}.md`, md, "text/markdown;charset=utf-8");
  });
  $("fa-export-json").addEventListener("click", () => {
    const s = fullStats();
    const out = {
      exportedAt: new Date().toISOString(), scope: store.scope, draftCommit: data.draftCommit,
      summary: { conformance: $("fa-conf-status").textContent, progressPercent: s.progress, coreMet: s.coreMet, coreNotMet: s.coreFail, coreNotApplicable: s.coreNa, coreNotEvaluated: s.coreUnset, supplementalMet: s.supp, assertionsMade: s.asserted },
      results: Object.fromEntries(s.scoped.map((p) => [p.slug, resultOf(p.slug)])),
      quickCheckAnswers: store.quick,
    };
    download(`wcag3-audit-${today()}.json`, JSON.stringify(out, null, 2), "application/json");
  });
  let faArmed = false;
  $("fa-reset").addEventListener("click", (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    if (!faArmed) { faArmed = true; btn.textContent = "Press again to clear"; setTimeout(() => { faArmed = false; btn.textContent = "Clear all results"; }, 4000); return; }
    faArmed = false; btn.textContent = "Clear all results";
    store.full = {}; save(); syncFullInputs(); updateFull();
  });

  // Keep the sticky results panel clear of the site's sticky header.
  const fitSticky = () => {
    const sp = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 12;
    document.documentElement.style.setProperty("--ac-sticky-top", sp + "px");
  };
  fitSticky();
  window.addEventListener("resize", fitSticky, { passive: true });

  // ---------------- Start ----------------
  syncFullInputs();
  showStep(step);
  updateQuick();
  updateFull();
  const fromHash = location.hash === "#full" ? "full" : location.hash === "#quick" ? "quick" : store.tab;
  selectTab(fromHash === "full" ? "full" : "quick");
</script>
