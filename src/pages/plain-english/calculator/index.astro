---
import PlainEnglishLayout from "@/layouts/PlainEnglishLayout.astro";
import fs from "fs";
import path from "path";

const catalogPath = path.join(process.cwd(), "public", "data", "wcag3-catalog.json");
let provisions: any[] = [];
if (fs.existsSync(catalogPath)) {
  provisions = JSON.parse(fs.readFileSync(catalogPath, "utf8"));
}

// Group provisions into 9 standardized Functional Categories based on guideline/group slug
const categoryMap: Record<string, { title: string; icon: string; description: string }> = {
  "text": { title: "Text & Typography", icon: "📝", description: "Font sizing, spacing, readability, and content presentation." },
  "navigation": { title: "Navigation & Wayfinding", icon: "🧭", description: "Landmarks, skip mechanisms, focus order, and page structure." },
  "media": { title: "Audio, Video & Media", icon: "🎬", description: "Captions, transcripts, audio descriptions, and media controls." },
  "interactivity": { title: "Interactivity & Forms", icon: "🔘", description: "Form validation, labels, error recovery, and interactive widgets." },
  "visual-design": { title: "Visual Design & Contrast", icon: "🎨", description: "Color contrast, non-text contrast, resize, and reflow." },
  "cognitive": { title: "Cognitive & Predictability", icon: "🧠", description: "Consistent navigation, timeouts, instructions, and cognitive load." },
  "input-operation": { title: "Input & Keyboard Operation", icon: "⌨️", description: "Keyboard access, pointer gestures, target size, and effort." },
  "user-control": { title: "Assistive Tech & User Control", icon: "🎛️", description: "Virtual cursor, user preferences, and motion toggles." },
  "structure": { title: "Structure & Semantics", icon: "🏗️", description: "Valid markup, semantic hierarchy, and accessible name calculation." },
};

function categorizeProvision(p: any): string {
  const g = (p.guidelineSlug || "").toLowerCase();
  const gr = (p.groupSlug || "").toLowerCase();
  const s = (p.slug || "").toLowerCase();

  if (g.includes("text") || gr.includes("text") || s.includes("font") || s.includes("spacing") || s.includes("readab")) return "text";
  if (g.includes("nav") || gr.includes("nav") || s.includes("focus") || s.includes("link") || s.includes("bypass")) return "navigation";
  if (g.includes("media") || gr.includes("audio") || gr.includes("video") || s.includes("caption") || s.includes("audio")) return "media";
  if (g.includes("form") || gr.includes("input") || g.includes("control") || s.includes("form") || s.includes("error") || s.includes("label")) return "interactivity";
  if (g.includes("color") || g.includes("contrast") || gr.includes("contrast") || s.includes("contrast") || s.includes("reflow") || s.includes("resize")) return "visual-design";
  if (g.includes("cognitive") || g.includes("predict") || gr.includes("harm") || s.includes("time") || s.includes("flashing") || s.includes("seizure")) return "cognitive";
  if (g.includes("keyboard") || gr.includes("keyboard") || g.includes("pointer") || gr.includes("gesture") || s.includes("pointer") || s.includes("touch")) return "input-operation";
  if (g.includes("assistive") || gr.includes("user-control") || s.includes("virtual-cursor") || s.includes("setting")) return "user-control";
  return "structure";
}

const categorizedProvisions: Record<string, any[]> = {};
Object.keys(categoryMap).forEach(cat => { categorizedProvisions[cat] = []; });

provisions.forEach(p => {
  const cat = categorizeProvision(p);
  if (categorizedProvisions[cat]) {
    categorizedProvisions[cat].push({
      ...p,
      categoryKey: cat
    });
  } else {
    categorizedProvisions["structure"].push({
      ...p,
      categoryKey: "structure"
    });
  }
});

const totalProvisionsCount = provisions.length;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (path: string) => `${base}${path.startsWith('/') ? path : '/' + path}`;
---

<PlainEnglishLayout title="WCAG 3.0 Conformance Score Calculator" activeTab="calculator">
  <!-- Banner Section -->
  <section class="calc-banner">
    <div class="banner-content">
      <div class="banner-title-group">
        <div class="banner-badge">
          <span class="calc-icon" aria-hidden="true">🧮</span>
          <span>Interactive Audit &amp; Conformance Tool</span>
        </div>
        <h1>WCAG 3.0 Conformance Score Calculator</h1>
        <p>
          Evaluate your digital product against W3C WCAG 3.0 draft provisions across all 9 functional categories.
          Calculate live points-based outcomes, identify fatal core blockers, and estimate your <strong>Bronze</strong>, <strong>Silver</strong>, or <strong>Gold</strong> conformance rating.
        </p>
      </div>

      <div class="banner-actions">
        <button id="btn-preset-typical" type="button" class="preset-btn btn-primary-action">
          <span>⚡ Simulate Typical Web App (~82%)</span>
        </button>
        <button id="btn-preset-blockers" type="button" class="preset-btn btn-secondary-action">
          <span>⚠️ Simulate Critical Blockers (~58%)</span>
        </button>
        <button id="btn-preset-gold" type="button" class="preset-btn btn-secondary-action">
          <span>🏆 Set All to Pass (100% Gold)</span>
        </button>
        <button id="btn-reset-all" type="button" class="preset-btn btn-ghost-action">
          <span>🔄 Reset All</span>
        </button>
      </div>
    </div>
  </section>

  <!-- W3C Conformance Model Specification Notice -->
  <aside class="conformance-model-notice" aria-label="W3C Conformance Specification Notice">
    <div class="notice-icon" aria-hidden="true">ℹ️</div>
    <div class="notice-text">
      <strong>Specification Context &bull; Silver Prototype vs Normative Draft:</strong>
      <p>
        This interactive audit tool models the <em>Silver Task Force's points-based scoring prototype</em>
        (Bronze 70%, Silver 80%, Gold 90%). In contrast, the current normative W3C Editors' Draft
        defines a single baseline conformance threshold evaluated across 6 reporting tiers rather than percentage scoring.
        Both models are maintained here for comparative exploration, developer education, and gap analysis.
      </p>
      <div class="notice-links">
        <a href="https://w3c.github.io/silver/prototypes/ConformancePrototype/index.html" target="_blank" rel="noopener noreferrer">
          W3C Silver Conformance Prototype ↗
        </a>
        <span class="notice-sep">&bull;</span>
        <a href="https://w3c.github.io/wcag3/guidelines/#conformance" target="_blank" rel="noopener noreferrer">
          W3C WCAG 3.0 Conformance Specification (Normative Draft) ↗
        </a>
        <span class="notice-sep">&bull;</span>
        <a href="https://w3c.github.io/wcag3/explainer/#conformance-models" target="_blank" rel="noopener noreferrer">
          W3C Explainer on Conformance Models ↗
        </a>
      </div>
    </div>
  </aside>

  <!-- Live Score & Tier Status Dashboard -->
  <section class="score-dashboard" aria-label="Conformance score summary">
    <div class="dashboard-grid">
      <!-- Main Tier Card -->
      <div class="tier-summary-card">
        <div class="tier-badge-wrap">
          <span class="tier-pill" id="tier-badge-status">Uncertified</span>
          <span class="tier-points-label" id="tier-points-detail">0 / {totalProvisionsCount} pts</span>
        </div>

        <div class="overall-gauge-wrap">
          <div class="score-circle-container">
            <svg class="score-circle-svg" viewBox="0 0 120 120" aria-hidden="true">
              <circle class="score-circle-bg" cx="60" cy="60" r="50" stroke-width="12" />
              <circle class="score-circle-fill" id="score-circle-bar" cx="60" cy="60" r="50" stroke-width="12" stroke-dasharray="314.16" stroke-dashoffset="314.16" />
            </svg>
            <div class="score-circle-text">
              <span class="score-number" id="overall-percentage-val">0%</span>
              <span class="score-caption">Overall Score</span>
            </div>
          </div>

          <div class="tier-target-milestones">
            <div class="milestone-item milestone-bronze" id="milestone-bronze">
              <div class="milestone-icon">🥉</div>
              <div class="milestone-text">
                <strong>Bronze Target (70%)</strong>
                <span>0 Blockers + 60% per category</span>
              </div>
              <span class="milestone-status" id="status-bronze-check">❌ Not Met</span>
            </div>

            <div class="milestone-item milestone-silver" id="milestone-silver">
              <div class="milestone-icon">🥈</div>
              <div class="milestone-text">
                <strong>Silver Target (80%)</strong>
                <span>Bronze Met + 75% per category</span>
              </div>
              <span class="milestone-status" id="status-silver-check">❌ Not Met</span>
            </div>

            <div class="milestone-item milestone-gold" id="milestone-gold">
              <div class="milestone-icon">🥇</div>
              <div class="milestone-text">
                <strong>Gold Target (90%)</strong>
                <span>Silver Met + 85% per category + 50% Supp.</span>
              </div>
              <span class="milestone-status" id="status-gold-check">❌ Not Met</span>
            </div>
          </div>
        </div>

        <!-- Core Blockers Warning Banner -->
        <div class="blockers-alert" id="blockers-alert-box" style="display: none;">
          <span class="alert-symbol" aria-hidden="true">🚫</span>
          <div class="alert-content">
            <strong id="blockers-title">Critical Blockers Detected (<span id="blockers-count">0</span>)</strong>
            <p id="blockers-desc">Under the Silver prototype scoring model, zero core/foundational provisions may fail to achieve Bronze, Silver, or Gold ratings.</p>
          </div>
        </div>
      </div>

      <!-- Category Health Mini-Grid -->
      <div class="category-health-card">
        <h2>Category Health Breakdown</h2>
        <p class="health-subtitle">Each category requires &ge; 60% for Bronze, &ge; 75% for Silver, &ge; 85% for Gold.</p>
        
        <div class="category-bars-grid" id="category-bars-container">
          {Object.entries(categoryMap).map(([catKey, catMeta]) => (
            <div class="cat-bar-row" data-cat-row={catKey}>
              <div class="cat-row-header">
                <span class="cat-name"><span aria-hidden="true">{catMeta.icon}</span> {catMeta.title}</span>
                <span class="cat-percent" id={`cat-pct-${catKey}`}>0%</span>
              </div>
              <div class="cat-progress-track">
                <div class="cat-progress-fill" id={`cat-fill-${catKey}`} style="width: 0%;"></div>
              </div>
            </div>
          ))}
        </div>

        <div class="export-report-toolbar">
          <button type="button" id="btn-export-markdown" class="export-btn">
            <span>📥 Export Markdown Report (.md)</span>
          </button>
          <button type="button" id="btn-export-json" class="export-btn">
            <span>💾 Export JSON Dataset</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Filter & Search Controls Bar -->
  <section class="calc-filters-bar" aria-label="Audit filters and search">
    <div class="filters-wrap">
      <!-- Search Input -->
      <div class="filter-search-box">
        <span class="fsearch-icon" aria-hidden="true">🔍</span>
        <input type="text" id="calc-search-input" placeholder="Filter provisions by keyword (e.g., contrast, keyboard, focus, aria)..." aria-label="Filter calculator provisions" />
      </div>

      <!-- Quick Filter Pills -->
      <div class="filter-pill-groups">
        <div class="filter-group-item">
          <span class="f-label">Evaluation:</span>
          <div class="f-pills">
            <button type="button" class="fpill-btn active" data-eval-filter="all">All</button>
            <button type="button" class="fpill-btn" data-eval-filter="failing">❌ Fails Only</button>
            <button type="button" class="fpill-btn" data-eval-filter="passing">✅ Passes Only</button>
            <button type="button" class="fpill-btn" data-eval-filter="partial">⚠️ Partials Only</button>
          </div>
        </div>

        <div class="filter-group-item">
          <span class="f-label">Requirement Type:</span>
          <div class="f-pills">
            <button type="button" class="fpill-btn active" data-type-filter="all">All Types</button>
            <button type="button" class="fpill-btn" data-type-filter="core">Foundational / Core Only</button>
            <button type="button" class="fpill-btn" data-type-filter="supplemental">Supplemental Only</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 9 Functional Categories Audit Worksheet -->
  <section class="worksheet-section">
    <div class="worksheet-container">
      {Object.entries(categorizedProvisions).map(([catKey, provList]) => {
        const catMeta = categoryMap[catKey] || { title: catKey, icon: "📁", description: "" };
        return (
          <details class="category-accordion" open data-category-section={catKey}>
            <summary class="cat-summary">
              <div class="cat-summary-left">
                <span class="cat-summary-icon" aria-hidden="true">{catMeta.icon}</span>
                <div class="cat-summary-text">
                  <h2>{catMeta.title}</h2>
                  <span class="cat-summary-desc">{catMeta.description}</span>
                </div>
              </div>
              <div class="cat-summary-right">
                <span class="cat-count-pill">{provList.length} Provisions</span>
                <span class="cat-score-badge" id={`accordion-badge-${catKey}`}>0% (0 / {provList.length} pts)</span>
              </div>
            </summary>

            <div class="provisions-table-wrap">
              <div class="provisions-list">
                {provList.map((p) => {
                  const isCore = (p.type || "").toLowerCase() === "foundational" || (p.type || "").toLowerCase() === "core";
                  const summaryText = p.annotation?.plainEnglish?.summary || p.rawBody || "";
                  return (
                    <article 
                      class="provision-audit-item" 
                      data-provision-slug={p.slug}
                      data-category={catKey}
                      data-type={isCore ? "core" : "supplemental"}
                    >
                      <div class="item-header">
                        <div class="item-title-group">
                          <span class={`type-tag ${isCore ? "type-core" : "type-supp"}`}>
                            {isCore ? "Core / Foundational" : "Supplemental"}
                          </span>
                          <h3>
                            <a href={link(`/plain-english/provision/${p.slug}/`)} target="_blank" title="Open detailed plain-English guide in new tab">
                              {p.title}
                              <span class="ext-icon" aria-hidden="true">&nearr;</span>
                            </a>
                          </h3>
                        </div>

                        <!-- 4-Way Radio Evaluation Buttons -->
                        <div class="scoring-btn-group" role="radiogroup" aria-label={`Evaluation for ${p.title}`}>
                          <label class="scoring-btn label-pass" title="Meets requirements completely (+1.0 pt)">
                            <input type="radio" name={`eval-${p.slug}`} value="pass" data-slug={p.slug} data-cat={catKey} data-core={isCore ? "true" : "false"} />
                            <span class="btn-indicator">✅ Pass</span>
                          </label>

                          <label class="scoring-btn label-partial" title="Minor non-blocking deviations (+0.5 pt)">
                            <input type="radio" name={`eval-${p.slug}`} value="partial" data-slug={p.slug} data-cat={catKey} data-core={isCore ? "true" : "false"} />
                            <span class="btn-indicator">⚠️ Partial</span>
                          </label>

                          <label class="scoring-btn label-fail" title="Critical or unresolved barrier (+0.0 pt)">
                            <input type="radio" name={`eval-${p.slug}`} value="fail" data-slug={p.slug} data-cat={catKey} data-core={isCore ? "true" : "false"} checked />
                            <span class="btn-indicator">❌ Fail</span>
                          </label>

                          <label class="scoring-btn label-na" title="Not applicable to this product (Exempt from denominator)">
                            <input type="radio" name={`eval-${p.slug}`} value="na" data-slug={p.slug} data-cat={catKey} data-core={isCore ? "true" : "false"} />
                            <span class="btn-indicator">⚪ N/A</span>
                          </label>
                        </div>
                      </div>

                      <p class="item-summary">{summaryText}</p>

                      {p.annotation?.plainEnglish?.whyItMatters && (
                        <div class="item-why-matters">
                          <strong>💡 Why it matters:</strong> {p.annotation.plainEnglish.whyItMatters}
                        </div>
                      )}
                    </article>
                  );
                })}
              </div>
            </div>
          </details>
        );
      })}
    </div>
  </section>

  <!-- Client-Side Evaluation Engine Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const STORAGE_KEY = 'wcag3_audit_state_v1';
      const inputs = document.querySelectorAll('.scoring-btn-group input[type="radio"]');
      const searchInput = document.getElementById('calc-search-input');
      const evalPillBtns = document.querySelectorAll('[data-eval-filter]');
      const typePillBtns = document.querySelectorAll('[data-type-filter]');
      const items = document.querySelectorAll('.provision-audit-item');

      let currentEvalFilter = 'all';
      let currentTypeFilter = 'all';
      let currentSearchQuery = '';

      // Initialize State
      function loadAuditState() {
        try {
          const saved = localStorage.getItem(STORAGE_KEY);
          if (saved) {
            const data = JSON.parse(saved);
            Object.entries(data).forEach(([slug, val]) => {
              const radio = document.querySelector(`input[name="eval-${slug}"][value="${val}"]`);
              if (radio) radio.checked = true;
            });
          }
        } catch (e) {}
        recalculateScores();
      }

      function saveAuditState() {
        const state = {};
        inputs.forEach(input => {
          if (input.checked) {
            state[input.dataset.slug] = input.value;
          }
        });
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
        } catch (e) {}
      }

      // Core Scoring Logic
      function recalculateScores() {
        let totalApplicablePoints = 0;
        let totalEarnedPoints = 0;
        let coreBlockersCount = 0;
        let supplementalPassedCount = 0;
        let totalSupplementalCount = 0;

        const categoryStats = {};

        // Initialize category accumulators
        document.querySelectorAll('[data-category-section]').forEach(sec => {
          const cat = sec.dataset.categorySection;
          categoryStats[cat] = { applicable: 0, earned: 0, count: 0 };
        });

        inputs.forEach(input => {
          if (input.checked) {
            const val = input.value;
            const cat = input.dataset.cat;
            const isCore = input.dataset.core === 'true';

            if (!categoryStats[cat]) categoryStats[cat] = { applicable: 0, earned: 0, count: 0 };
            categoryStats[cat].count++;

            if (!isCore) {
              totalSupplementalCount++;
            }

            if (val === 'na') {
              // N/A: excluded from applicable denominator
              return;
            }

            totalApplicablePoints += 1.0;
            categoryStats[cat].applicable += 1.0;

            if (val === 'pass') {
              totalEarnedPoints += 1.0;
              categoryStats[cat].earned += 1.0;
              if (!isCore) supplementalPassedCount++;
            } else if (val === 'partial') {
              totalEarnedPoints += 0.5;
              categoryStats[cat].earned += 0.5;
            } else if (val === 'fail') {
              if (isCore) {
                coreBlockersCount++;
              }
            }
          }
        });

        // Calculate Overall %
        const overallPct = totalApplicablePoints > 0 ? Math.round((totalEarnedPoints / totalApplicablePoints) * 100) : 0;

        // Check Category Minimums
        let allCategoriesMeetBronze = true; // >= 60%
        let allCategoriesMeetSilver = true; // >= 75%
        let allCategoriesMeetGold = true;   // >= 85%

        Object.entries(categoryStats).forEach(([cat, stat]) => {
          const catPct = stat.applicable > 0 ? Math.round((stat.earned / stat.applicable) * 100) : 100;
          if (catPct < 60) allCategoriesMeetBronze = false;
          if (catPct < 75) allCategoriesMeetSilver = false;
          if (catPct < 85) allCategoriesMeetGold = false;

          // Update Category Bar UI
          const pctEl = document.getElementById(`cat-pct-${cat}`);
          const fillEl = document.getElementById(`cat-fill-${cat}`);
          const badgeEl = document.getElementById(`accordion-badge-${cat}`);

          if (pctEl) pctEl.textContent = `${catPct}%`;
          if (fillEl) {
            fillEl.style.width = `${catPct}%`;
            // Same reason as the score badge: an inline hex cannot follow the
            // theme, and WCAG 1.4.11 wants 3:1 between this fill and its track.
            fillEl.classList.remove('bar-good', 'bar-ok', 'bar-low');
            fillEl.classList.add(catPct >= 75 ? 'bar-good' : (catPct >= 60 ? 'bar-ok' : 'bar-low'));
          }
          if (badgeEl) {
            badgeEl.textContent = `${catPct}% (${stat.earned} / ${stat.applicable} pts)`;
            // Inline styles outrank every stylesheet, so a hard-coded hex here
            // cannot adapt to the light theme — it measured 2.57:1. Toggle a
            // class instead and let the CSS below answer for each theme.
            badgeEl.classList.toggle('score-pass', catPct >= 60);
            badgeEl.classList.toggle('score-fail', catPct < 60);
          }
        });

        // Determine Final Conformance Tier
        const hasNoBlockers = coreBlockersCount === 0;
        const meetsBronze = hasNoBlockers && allCategoriesMeetBronze && overallPct >= 70;
        const meetsSilver = meetsBronze && allCategoriesMeetSilver && overallPct >= 80;
        const meetsGold = meetsSilver && allCategoriesMeetGold && overallPct >= 90 && (totalSupplementalCount === 0 || (supplementalPassedCount / totalSupplementalCount) >= 0.5);

        // Update Dashboard UI Elements
        const overallPctEl = document.getElementById('overall-percentage-val');
        const pointsDetailEl = document.getElementById('tier-points-detail');
        const circleBarEl = document.getElementById('score-circle-bar');
        const tierBadgeEl = document.getElementById('tier-badge-status');
        const blockersAlertEl = document.getElementById('blockers-alert-box');
        const blockersCountEl = document.getElementById('blockers-count');

        if (overallPctEl) overallPctEl.textContent = `${overallPct}%`;
        if (pointsDetailEl) pointsDetailEl.textContent = `${totalEarnedPoints.toFixed(1)} / ${totalApplicablePoints} pts`;

        // Radial Circle Progress (circumference = 314.16)
        if (circleBarEl) {
          const offset = 314.16 - (314.16 * overallPct) / 100;
          circleBarEl.style.strokeDashoffset = `${offset}`;
          circleBarEl.style.stroke = meetsGold ? '#facc15' : (meetsSilver ? '#cbd5e1' : (meetsBronze ? '#fb923c' : '#38bdf8'));
        }

        // Tier Badge Status
        if (tierBadgeEl) {
          if (meetsGold) {
            tierBadgeEl.textContent = '🥇 Gold Conforming';
            tierBadgeEl.className = 'tier-pill tier-gold';
          } else if (meetsSilver) {
            tierBadgeEl.textContent = '🥈 Silver Conforming';
            tierBadgeEl.className = 'tier-pill tier-silver';
          } else if (meetsBronze) {
            tierBadgeEl.textContent = '🥉 Bronze Conforming';
            tierBadgeEl.className = 'tier-pill tier-bronze';
          } else {
            tierBadgeEl.textContent = '❌ Uncertified (Non-Conforming)';
            tierBadgeEl.className = 'tier-pill tier-uncertified';
          }
        }

        // Milestone Checks
        const bCheck = document.getElementById('status-bronze-check');
        const sCheck = document.getElementById('status-silver-check');
        const gCheck = document.getElementById('status-gold-check');

        if (bCheck) {
          bCheck.textContent = meetsBronze ? '✅ Achieved' : (hasNoBlockers ? '⏳ In Progress' : '🚫 Blocked');
          bCheck.className = `milestone-status ${meetsBronze ? 'met' : 'unmet'}`;
        }
        if (sCheck) {
          sCheck.textContent = meetsSilver ? '✅ Achieved' : '⏳ In Progress';
          sCheck.className = `milestone-status ${meetsSilver ? 'met' : 'unmet'}`;
        }
        if (gCheck) {
          gCheck.textContent = meetsGold ? '✅ Achieved' : '⏳ In Progress';
          gCheck.className = `milestone-status ${meetsGold ? 'met' : 'unmet'}`;
        }

        // Core Blockers Alert Box
        if (blockersAlertEl && blockersCountEl) {
          if (coreBlockersCount > 0) {
            blockersAlertEl.style.display = 'flex';
            blockersCountEl.textContent = `${coreBlockersCount}`;
          } else {
            blockersAlertEl.style.display = 'none';
          }
        }
      }

      // Handle Radio Changes
      inputs.forEach(input => {
        input.addEventListener('change', () => {
          saveAuditState();
          recalculateScores();
          if (currentEvalFilter !== 'all') applyFilters();
        });
      });

      // Filter Logic
      function applyFilters() {
        items.forEach(item => {
          let matchesEval = currentEvalFilter === 'all';
          if (currentEvalFilter === 'failing') {
            const failRadio = item.querySelector('input[value="fail"]');
            matchesEval = failRadio ? failRadio.checked : false;
          } else if (currentEvalFilter === 'passing') {
            const passRadio = item.querySelector('input[value="pass"]');
            matchesEval = passRadio ? passRadio.checked : false;
          } else if (currentEvalFilter === 'partial') {
            const partialRadio = item.querySelector('input[value="partial"]');
            matchesEval = partialRadio ? partialRadio.checked : false;
          }

          let matchesType = currentTypeFilter === 'all';
          if (currentTypeFilter === 'core') matchesType = item.dataset.type === 'core';
          if (currentTypeFilter === 'supplemental') matchesType = item.dataset.type === 'supplemental';

          let matchesSearch = true;
          if (currentSearchQuery.trim()) {
            const text = item.textContent.toLowerCase();
            matchesSearch = text.includes(currentSearchQuery.toLowerCase());
          }

          if (matchesEval && matchesType && matchesSearch) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });
      }

      // Search Handler
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentSearchQuery = e.target.value;
          applyFilters();
        });
      }

      // Eval Filter Buttons
      evalPillBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          evalPillBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentEvalFilter = btn.dataset.evalFilter;
          applyFilters();
        });
      });

      // Type Filter Buttons
      typePillBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          typePillBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentTypeFilter = btn.dataset.typeFilter;
          applyFilters();
        });
      });

      // Auditor Presets
      const btnTypical = document.getElementById('btn-preset-typical');
      const btnBlockers = document.getElementById('btn-preset-blockers');
      const btnGold = document.getElementById('btn-preset-gold');
      const btnReset = document.getElementById('btn-reset-all');

      function setProvisionValue(slug, value) {
        const radio = document.querySelector(`input[name="eval-${slug}"][value="${value}"]`);
        if (radio) radio.checked = true;
      }

      if (btnTypical) {
        btnTypical.addEventListener('click', () => {
          const slugs = Array.from(new Set(Array.from(inputs).map(i => i.dataset.slug)));
          slugs.forEach((slug, idx) => {
            const firstRadio = document.querySelector(`input[name="eval-${slug}"]`);
            const isCore = firstRadio ? firstRadio.dataset.core === 'true' : false;
            if (isCore) {
              if (idx % 11 === 0) setProvisionValue(slug, 'partial');
              else if (idx % 19 === 0) setProvisionValue(slug, 'na');
              else setProvisionValue(slug, 'pass');
            } else {
              if (idx % 4 === 0) setProvisionValue(slug, 'partial');
              else if (idx % 7 === 0) setProvisionValue(slug, 'na');
              else if (idx % 9 === 0) setProvisionValue(slug, 'fail');
              else setProvisionValue(slug, 'pass');
            }
          });
          saveAuditState();
          recalculateScores();
        });
      }

      if (btnBlockers) {
        btnBlockers.addEventListener('click', () => {
          const slugs = Array.from(new Set(Array.from(inputs).map(i => i.dataset.slug)));
          slugs.forEach((slug, idx) => {
            const firstRadio = document.querySelector(`input[name="eval-${slug}"]`);
            const isCore = firstRadio ? firstRadio.dataset.core === 'true' : false;
            if (isCore && idx % 7 === 0) {
              setProvisionValue(slug, 'fail');
            } else if (idx % 5 === 0) {
              setProvisionValue(slug, 'partial');
            } else if (idx % 11 === 0) {
              setProvisionValue(slug, 'na');
            } else {
              setProvisionValue(slug, 'pass');
            }
          });
          saveAuditState();
          recalculateScores();
        });
      }

      if (btnGold) {
        btnGold.addEventListener('click', () => {
          const slugs = Array.from(new Set(Array.from(inputs).map(i => i.dataset.slug)));
          slugs.forEach(slug => setProvisionValue(slug, 'pass'));
          saveAuditState();
          recalculateScores();
        });
      }

      if (btnReset) {
        btnReset.addEventListener('click', () => {
          if (confirm('Are you sure you want to reset all evaluations to Fail (0%)?')) {
            const slugs = Array.from(new Set(Array.from(inputs).map(i => i.dataset.slug)));
            slugs.forEach(slug => setProvisionValue(slug, 'fail'));
            saveAuditState();
            recalculateScores();
          }
        });
      }

      // Export Markdown Report
      const btnExportMd = document.getElementById('btn-export-markdown');
      if (btnExportMd) {
        btnExportMd.addEventListener('click', () => {
          const timestamp = new Date().toISOString().split('T')[0];
          const overallPct = document.getElementById('overall-percentage-val')?.textContent || '0%';
          const tier = document.getElementById('tier-badge-status')?.textContent || 'Uncertified';
          const points = document.getElementById('tier-points-detail')?.textContent || '0 pts';

          let md = `# WCAG 3.0 Conformance Audit Report\n\n`;
          md += `> **Audit Date:** ${timestamp}  \n`;
          md += `> **Overall Score:** ${overallPct} (${points})  \n`;
          md += `> **Achieved Conformance Tier:** **${tier}**  \n\n`;
          md += `## Functional Category Breakdown\n\n`;
          md += `| Functional Category | Score | Status |\n`;
          md += `| :--- | :--- | :--- |\n`;

          document.querySelectorAll('.cat-bar-row').forEach(row => {
            const name = row.querySelector('.cat-name')?.textContent.trim() || '';
            const pct = row.querySelector('.cat-percent')?.textContent.trim() || '0%';
            const num = parseInt(pct, 10);
            const status = num >= 75 ? '✅ Strong' : (num >= 60 ? '⚠️ Bronze Minimum' : '❌ At Risk');
            md += `| ${name} | ${pct} | ${status} |\n`;
          });

          md += `\n## Failed Core Blockers & Action Items\n\n`;
          let failedCoreCount = 0;
          document.querySelectorAll('.provision-audit-item').forEach(item => {
            const failRadio = item.querySelector('input[value="fail"]');
            const isCore = item.dataset.type === 'core';
            if (failRadio && failRadio.checked && isCore) {
              failedCoreCount++;
              const title = item.querySelector('h3 a, h4 a')?.textContent.trim() || '';
              const summary = item.querySelector('.item-summary')?.textContent.trim() || '';
              md += `- **[Core Blocker] ${title}**: ${summary}\n`;
            }
          });

          if (failedCoreCount === 0) {
            md += `*No critical core blockers detected! Meets universal primary baseline requirement.*\n`;
          }

          md += `\n---\n*Report generated via [Plain English WCAG 3.0 Conformance Calculator](${window.location.href})*\n`;

          // Trigger File Download
          const blob = new Blob([md], { type: 'text/markdown;charset=utf-8;' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `wcag3-audit-report-${timestamp}.md`;
          a.click();
          URL.revokeObjectURL(url);
        });
      }

      // Export JSON Dataset
      const btnExportJson = document.getElementById('btn-export-json');
      if (btnExportJson) {
        btnExportJson.addEventListener('click', () => {
          const exportObj = {
            exportedAt: new Date().toISOString(),
            overallScore: document.getElementById('overall-percentage-val')?.textContent || '0%',
            tier: document.getElementById('tier-badge-status')?.textContent || 'Uncertified',
            provisions: {}
          };
          inputs.forEach(input => {
            if (input.checked) {
              exportObj.provisions[input.dataset.slug] = input.value;
            }
          });
          const blob = new Blob([JSON.stringify(exportObj, null, 2)], { type: 'application/json' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `wcag3-evaluation-dataset.json`;
          a.click();
          URL.revokeObjectURL(url);
        });
      }

      // Initial Load
      loadAuditState();
    });
  </script>
</PlainEnglishLayout>

