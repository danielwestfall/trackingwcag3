---
import PlainEnglishLayout from "@/layouts/PlainEnglishLayout.astro";
import fs from "fs";
import path from "path";

const wcag22Path = path.join(process.cwd(), "public", "data", "wcag22-catalog.json");
let wcag22List: any[] = [];
if (fs.existsSync(wcag22Path)) {
  wcag22List = JSON.parse(fs.readFileSync(wcag22Path, "utf8"));
}

const levelACount = wcag22List.filter(item => item.level === "A").length;
const levelAACount = wcag22List.filter(item => item.level === "AA").length;
const levelAAACount = wcag22List.filter(item => item.level === "AAA").length;
---

<PlainEnglishLayout title="WCAG 2.2 Plain English Reference" activeTab="wcag22">
  <section class="dashboard-banner">
    <div class="banner-content">
      <div class="banner-title-group">
        <h2>WCAG 2.2 Plain English Reference</h2>
        <p>A plain-English guide to the official W3C WCAG 2.2 standard for non-a11y professionals, with practical testing guides and direct links to WCAG 3 evolution.</p>
      </div>
      <div class="stats-grid">
        <div class="stat-card">
          <span class="stat-value">{wcag22List.length}</span>
          <span class="stat-label">Total Criteria</span>
        </div>
        <div class="stat-card">
          <span class="stat-value highlight-levela">{levelACount}</span>
          <span class="stat-label">Level A</span>
        </div>
        <div class="stat-card">
          <span class="stat-value highlight-levelaa">{levelAACount}</span>
          <span class="stat-label">Level AA</span>
        </div>
        <div class="stat-card">
          <span class="stat-value highlight-levelaaa">{levelAAACount}</span>
          <span class="stat-label">Level AAA</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Controls -->
  <section class="controls-section">
    <div class="search-box">
      <span class="search-icon">🔍</span>
      <input type="text" id="wcag22-search" placeholder="Search WCAG 2.2 criteria by number (e.g. 1.4.3, 2.4.7, 3.3.8) or keywords..." aria-label="Search WCAG 2.2 criteria" />
    </div>

    <div class="filter-bar">
      <div class="filter-group">
        <span class="filter-label">Level:</span>
        <div class="level-pills" id="level-pills">
          <button type="button" class="pill active" data-level="all">All Levels</button>
          <button type="button" class="pill" data-level="A">Level A</button>
          <button type="button" class="pill" data-level="AA">Level AA</button>
          <button type="button" class="pill" data-level="AAA">Level AAA</button>
        </div>
      </div>

      <div class="filter-group">
        <label for="principle-select" class="sr-only">Filter by Principle</label>
        <select id="principle-select" class="filter-select">
          <option value="all">All Principles</option>
          <option value="Perceivable">Perceivable</option>
          <option value="Operable">Operable</option>
          <option value="Understandable">Understandable</option>
          <option value="Robust">Robust</option>
        </select>
      </div>
    </div>
  </section>

  <!-- Grid -->
  <section class="criteria-section">
    <div class="grid-header">
      <h3 id="result-count">Showing {wcag22List.length} Success Criteria</h3>
    </div>

    <div class="criteria-grid" id="criteria-grid">
      {wcag22List.map((sc) => (
        <article 
          class="criterion-card"
          data-id={sc.id}
          data-num={sc.num}
          data-name={sc.name.toLowerCase()}
          data-level={sc.level}
          data-principle={sc.principle}
          data-summary={sc.plainEnglish.summary.toLowerCase()}
        >
          <div class="card-header">
            <div class="header-badges">
              <span class="num-badge">SC {sc.num}</span>
              <span class={`level-badge level-${sc.level}`}>Level {sc.level}</span>
              <span class="principle-badge">{sc.principle}</span>
            </div>
          </div>

          <h4 class="card-title">
            <a href={`/plain-english/wcag22/${sc.id.replace(/\./g, '-')}/`}>{sc.name}</a>
          </h4>

          <p class="summary-text">{sc.plainEnglish.summary}</p>

          <div class="example-box">
            <strong>Real-World Example:</strong>
            <p>{sc.plainEnglish.realWorldExample}</p>
          </div>

          <div class="card-footer">
            <div class="wcag3-evolution">
              <span>WCAG 3 Mapping:</span>
              <div class="provision-tags">
                {sc.wcag3Mapping.provisions.map((p: string) => (
                  <a href={`/plain-english/provision/${p}/`} class="prov-link">{p}</a>
                ))}
              </div>
            </div>
            <a href={`/plain-english/wcag22/${sc.id.replace(/\./g, '-')}/`} class="detail-link">
              Testing Guide &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</PlainEnglishLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('wcag22-search');
    const levelPills = document.querySelectorAll('#level-pills .pill');
    const principleSelect = document.getElementById('principle-select');
    const cards = document.querySelectorAll('.criterion-card');
    const resultCount = document.getElementById('result-count');

    let selectedLevel = 'all';

    levelPills.forEach(pill => {
      pill.addEventListener('click', () => {
        levelPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        selectedLevel = pill.getAttribute('data-level');
        filterCards();
      });
    });

    function filterCards() {
      const query = searchInput.value.toLowerCase().trim();
      const selectedPrinciple = principleSelect.value;

      let visible = 0;

      cards.forEach(card => {
        const num = card.getAttribute('data-num') || '';
        const name = card.getAttribute('data-name') || '';
        const summary = card.getAttribute('data-summary') || '';
        const level = card.getAttribute('data-level') || '';
        const principle = card.getAttribute('data-principle') || '';

        const matchesQuery = !query || num.includes(query) || name.includes(query) || summary.includes(query);
        const matchesLevel = selectedLevel === 'all' || level === selectedLevel;
        const matchesPrinciple = selectedPrinciple === 'all' || principle === selectedPrinciple;

        if (matchesQuery && matchesLevel && matchesPrinciple) {
          card.style.display = 'flex';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      resultCount.textContent = `Showing ${visible} Success Criteria`;
    }

    searchInput.addEventListener('input', filterCards);
    principleSelect.addEventListener('change', filterCards);
  });
</script>

<style>
  .dashboard-banner {
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.9) 0%, rgba(15, 23, 42, 0.95) 100%);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 32px;
    margin-bottom: 32px;
  }

  .banner-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }

  .banner-title-group h2 {
    font-size: 1.8rem;
    font-weight: 800;
    margin-bottom: 8px;
    background: linear-gradient(90deg, #f8fafc, #34d399);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .banner-title-group p {
    color: var(--text-secondary);
    max-width: 600px;
  }

  .stats-grid {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .stat-card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 16px 20px;
    text-align: center;
    min-width: 110px;
  }

  .stat-value {
    display: block;
    font-size: 1.8rem;
    font-weight: 800;
  }
  .highlight-levela { color: #38bdf8; }
  .highlight-levelaa { color: #34d399; }
  .highlight-levelaaa { color: #c084fc; }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
  }

  .controls-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 32px;
  }

  .search-box {
    position: relative;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 18px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
  }

  .search-box input {
    width: 100%;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 16px 16px 16px 48px;
    color: var(--text-primary);
    font-size: 1rem;
    font-family: var(--font-sans);
  }

  .filter-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .filter-group {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .level-pills {
    display: flex;
    gap: 8px;
  }

  .pill {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 8px 14px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
  }
  .pill.active {
    background: #34d399;
    color: #0f172a;
    border-color: #34d399;
  }

  .filter-select {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 10px 14px;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
  }

  .criteria-section {
    margin-top: 16px;
  }

  .grid-header {
    margin-bottom: 20px;
    color: var(--text-secondary);
  }

  .criteria-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 24px;
  }

  .criterion-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.25s ease;
  }
  .criterion-card:hover {
    border-color: #34d399;
    transform: translateY(-3px);
  }

  .card-header {
    margin-bottom: 12px;
  }

  .header-badges {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .num-badge {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent-blue);
    font-size: 0.85rem;
  }

  .level-badge {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 6px;
  }
  .level-A { background: rgba(56, 189, 248, 0.2); color: #38bdf8; }
  .level-AA { background: rgba(52, 211, 153, 0.2); color: #34d399; }
  .level-AAA { background: rgba(192, 132, 252, 0.2); color: #c084fc; }

  .principle-badge {
    font-size: 0.7rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.05);
    padding: 2px 8px;
    border-radius: 6px;
  }

  .card-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 12px;
  }
  .card-title a {
    color: var(--text-primary);
    text-decoration: none;
  }
  .card-title a:hover {
    color: #34d399;
  }

  .summary-text {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.5;
    margin-bottom: 16px;
  }

  .example-box {
    background: rgba(15, 23, 42, 0.6);
    border-left: 3px solid #34d399;
    padding: 12px;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin-bottom: 20px;
    font-size: 0.85rem;
  }
  .example-box strong {
    color: #34d399;
    display: block;
    margin-bottom: 2px;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-top: 1px solid var(--border-color);
    padding-top: 16px;
    font-size: 0.8rem;
  }

  .wcag3-evolution {
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--text-muted);
  }

  .prov-link {
    display: inline-block;
    background: rgba(56, 189, 248, 0.1);
    color: var(--accent-blue);
    padding: 2px 6px;
    border-radius: 4px;
    text-decoration: none;
    font-size: 0.75rem;
    margin-right: 4px;
    margin-top: 2px;
  }

  .detail-link {
    color: #34d399;
    text-decoration: none;
    font-weight: 700;
    white-space: nowrap;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
