---
import PlainEnglishLayout from "@/layouts/PlainEnglishLayout.astro";
import fs from "fs";
import path from "path";

export async function getStaticPaths() {
  const wcag22Path = path.join(process.cwd(), "public", "data", "wcag22-catalog.json");
  if (!fs.existsSync(wcag22Path)) return [];
  const list = JSON.parse(fs.readFileSync(wcag22Path, "utf8"));
  return list.map((item: any) => ({
    params: { id: item.id.replace(/\./g, "-") },
    props: { item },
  }));
}

interface Props {
  item: any;
}

const { item } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (path: string) => `${base}${path.startsWith('/') ? path : '/' + path}`;
---

<PlainEnglishLayout title={`SC ${item.num} ${item.name} - WCAG 2.2 Plain English`} activeTab="wcag22">
  <div class="detail-header">
    <nav aria-label="Breadcrumbs" class="breadcrumbs">
      <a href={link("/plain-english/wcag22/")} class="back-link">&larr; Back to WCAG 2.2 Reference</a>
      <span class="crumb-sep">/</span>
      <span class="crumb-current">SC {item.num} {item.name}</span>
    </nav>
    
    <div class="header-badges">
      <span class="num-badge">SC {item.num}</span>
      <span class={`level-badge level-${item.level}`}>Level {item.level}</span>
      <span class="principle-badge">{item.principle}</span>
    </div>

    <h1 class="page-title">{item.name}</h1>
    <p class="meta-subtitle">Official W3C WCAG 2.2 Standard Success Criterion &bull; Principle: <strong>{item.principle}</strong></p>
  </div>

  <!-- Tabbed Interface -->
  <section class="tabs-container">
    <div class="tab-list" role="tablist" aria-label="Criterion details">
      <button role="tab" aria-selected="true" aria-controls="panel-plain" id="tab-plain" class="tab-btn active">
        💬 Plain English & Persona Tips
      </button>
      <button role="tab" aria-selected="false" aria-controls="panel-test" id="tab-test" class="tab-btn">
        🧪 Testing Guide & Code
      </button>
      <button role="tab" aria-selected="false" aria-controls="panel-evolution" id="tab-evolution" class="tab-btn">
        ✨ Evolution in WCAG 3
      </button>
    </div>

    <!-- Panel 1: Plain English -->
    <div id="panel-plain" role="tabpanel" aria-labelledby="tab-plain" class="tab-panel active">
      <div class="panel-section">
        <h3>Plain English Explanation</h3>
        <p class="summary-lead">{item.plainEnglish?.summary}</p>
      </div>

      <div class="panel-grid-2">
        <div class="info-card">
          <h4>Why It Matters</h4>
          <p>{item.plainEnglish?.whyItMatters || "Ensures users can perceive and interact with web content equitably."}</p>
        </div>
        <div class="info-card">
          <h4>Real-World Example</h4>
          <p>{item.plainEnglish?.realWorldExample || "Clear keyboard focus indications preventing navigation disorientation."}</p>
        </div>
      </div>

      <div class="panel-section">
        <h3>Role-Based Actionable Advice</h3>
        <div class="persona-cards-grid">
          <div class="persona-card designer">
            <span class="persona-header">🎨 Designer</span>
            <p>{item.personaBreakdown?.designer || "Ensure color contrast and visual focus states are defined in design tokens."}</p>
          </div>
          <div class="persona-card developer">
            <span class="persona-header">💻 Developer</span>
            <p>{item.personaBreakdown?.developer || "Use semantic HTML elements and programmatic labels."}</p>
          </div>
          <div class="persona-card qa">
            <span class="persona-header">🧪 QA / Tester</span>
            <p>{item.personaBreakdown?.qa || "Verify with automated scanners, keyboard navigation, and screen reader announcements."}</p>
          </div>
          <div class="persona-card pm">
            <span class="persona-header">📋 Product Manager</span>
            <p>{item.personaBreakdown?.productManager || "Track conformance with regulatory legal standards."}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Panel 2: Testing Guide -->
    <div id="panel-test" role="tabpanel" aria-labelledby="tab-test" class="tab-panel hidden">
      <div class="panel-section">
        <h3>Step-by-Step Testing Procedures</h3>
        <div class="testing-grid">
          <div class="test-card">
            <h4>🤖 Automated Testing</h4>
            <p>{item.testingGuide?.automated || "Run axe-core or Lighthouse audits in your continuous integration pipeline."}</p>
          </div>
          <div class="test-card">
            <h4>⌨️ Keyboard Testing</h4>
            <p>{item.testingGuide?.manualKeyboard || "Tab sequentially through all interactive controls and verify focus states."}</p>
          </div>
          <div class="test-card">
            <h4>🔊 Screen Reader Check</h4>
            <p>{item.testingGuide?.screenReader || "Audit with NVDA, JAWS, or VoiceOver for clear accessibility tree naming."}</p>
          </div>
        </div>
      </div>

      <div class="panel-section">
        <h3>Code Patterns: Good vs Bad</h3>
        <div class="code-comparison">
          <div class="code-box good">
            <div class="code-header">
              <span>✅ Compliant Code Pattern</span>
              <button type="button" class="copy-code-btn" data-code={item.testingGuide?.codeSnippetGood || ""}>Copy</button>
            </div>
            <pre><code>{item.testingGuide?.codeSnippetGood || "<!-- Compliant semantic markup -->\n<button type=\"button\">\n  Submit\n</button>"}</code></pre>
          </div>
          <div class="code-box bad">
            <div class="code-header">
              <span>❌ Non-Compliant Pattern</span>
              <button type="button" class="copy-code-btn" data-code={item.testingGuide?.codeSnippetBad || ""}>Copy</button>
            </div>
            <pre><code>{item.testingGuide?.codeSnippetBad || "<!-- Inaccessible div button -->\n<div onclick=\"doSubmit()\">\n  Submit\n</div>"}</code></pre>
          </div>
        </div>
      </div>
    </div>

    <!-- Panel 3: Evolution in WCAG 3 -->
    <div id="panel-evolution" role="tabpanel" aria-labelledby="tab-evolution" class="tab-panel hidden">
      <div class="panel-section">
        <h3>How SC {item.num} Evolves in WCAG 3</h3>
        
        <div class="info-card evolution-box">
          <h4>Evolution Summary</h4>
          <p>{item.wcag3Mapping?.evolutionNote || "This criterion transitions from a binary page-level rule to continuous outcome scoring in WCAG 3."}</p>
        </div>

        <div class="panel-section">
          <h4>Mapped WCAG 3 Provisions / Outcomes</h4>
          <div class="provision-links-grid">
            {item.wcag3Mapping?.provisions?.length > 0 ? (
              item.wcag3Mapping.provisions.map((provSlug: string) => (
                <a href={link(`/plain-english/provision/${provSlug}/`)} class="provision-card-link">
                  <span class="link-label">WCAG 3 Provision:</span>
                  <strong class="link-slug">{provSlug}</strong>
                  <span class="link-arrow">&rarr;</span>
                </a>
              ))
            ) : (
              <p class="text-muted">Provisions mapped to this criterion are under active draft synthesis.</p>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>
</PlainEnglishLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.tab-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        panels.forEach(p => p.classList.add('hidden'));

        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const targetPanelId = tab.getAttribute('aria-controls');
        const targetPanel = document.getElementById(targetPanelId);
        if (targetPanel) {
          targetPanel.classList.remove('hidden');
        }
      });
    });

    // Copy code buttons
    document.querySelectorAll('.copy-code-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const code = btn.getAttribute('data-code');
        if (code) {
          try {
            await navigator.clipboard.writeText(code);
            const originalText = btn.textContent;
            btn.textContent = 'Copied!';
            btn.classList.add('copied');
            setTimeout(() => {
              btn.textContent = originalText;
              btn.classList.remove('copied');
            }, 2000);
          } catch (e) {}
        }
      });
    });
  });
</script>

<style>
  .detail-header {
    margin-bottom: 32px;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font-size: 0.88rem;
  }

  .back-link {
    color: var(--accent-emerald);
    text-decoration: none;
    font-weight: 600;
    transition: var(--transition-fast);
  }
  .back-link:hover { color: #6ee7b7; }

  .crumb-sep { color: var(--text-muted); }
  .crumb-current { color: var(--text-secondary); }

  .header-badges {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .num-badge {
    font-family: var(--font-mono);
    font-weight: 800;
    color: var(--accent-emerald);
    font-size: 0.92rem;
    background: rgba(52, 211, 153, 0.12);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }

  .level-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: var(--radius-sm);
  }
  .level-A { background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); }
  .level-AA { background: rgba(52, 211, 153, 0.15); color: #34d399; border: 1px solid rgba(52, 211, 153, 0.3); }
  .level-AAA { background: rgba(192, 132, 252, 0.15); color: #c084fc; border: 1px solid rgba(192, 132, 252, 0.3); }

  .principle-badge {
    font-size: 0.72rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    padding: 3px 9px;
    border-radius: var(--radius-sm);
  }

  .page-title {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    font-weight: 800;
    color: var(--text-pure);
    letter-spacing: -0.025em;
    margin-bottom: 8px;
  }

  .meta-subtitle {
    color: var(--text-secondary);
    font-size: 0.94rem;
  }

  .tabs-container {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .tab-list {
    display: flex;
    background: rgba(7, 11, 20, 0.8);
    border-bottom: 1px solid var(--border-subtle);
    overflow-x: auto;
  }

  .tab-btn {
    background: none;
    border: none;
    color: var(--text-secondary);
    padding: 16px 22px;
    font-size: 0.92rem;
    font-weight: 600;
    font-family: var(--font-sans);
    cursor: pointer;
    white-space: nowrap;
    border-bottom: 3px solid transparent;
    transition: var(--transition-fast);
  }
  .tab-btn:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.03);
  }
  .tab-btn.active {
    color: var(--accent-emerald);
    border-bottom-color: var(--accent-emerald);
    background: rgba(52, 211, 153, 0.08);
    font-weight: 700;
  }

  .tab-panel { padding: 32px; }
  .tab-panel.hidden { display: none; }

  .panel-section { margin-bottom: 32px; }
  .panel-section:last-child { margin-bottom: 0; }
  .panel-section h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 16px;
    color: var(--text-pure);
    letter-spacing: -0.015em;
  }

  .summary-lead {
    font-size: 1.1rem;
    line-height: 1.65;
    background: rgba(52, 211, 153, 0.06);
    border-left: 4px solid var(--accent-emerald);
    padding: 18px 22px;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .panel-grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
  }

  .info-card {
    background: rgba(7, 11, 20, 0.65);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: 20px;
  }
  .info-card h4 {
    color: var(--accent-emerald);
    font-size: 0.98rem;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .info-card p {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .persona-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }

  .persona-card {
    background: rgba(7, 11, 20, 0.65);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: 18px;
    display: flex;
    flex-direction: column;
  }
  .persona-card.designer { border-top: 3px solid var(--role-designer); }
  .persona-card.developer { border-top: 3px solid var(--role-developer); }
  .persona-card.qa { border-top: 3px solid var(--role-qa); }
  .persona-card.pm { border-top: 3px solid var(--role-pm); }

  .persona-header {
    font-weight: 700;
    display: block;
    margin-bottom: 8px;
    font-size: 0.94rem;
  }
  .designer .persona-header { color: var(--role-designer); }
  .developer .persona-header { color: var(--role-developer); }
  .qa .persona-header { color: var(--role-qa); }
  .pm .persona-header { color: var(--role-pm); }

  .persona-card p {
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .testing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
  }

  .test-card {
    background: rgba(7, 11, 20, 0.65);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: 20px;
  }
  .test-card h4 { font-size: 0.98rem; font-weight: 700; margin-bottom: 8px; color: var(--text-primary); }
  .test-card p { color: var(--text-secondary); font-size: 0.9rem; line-height: 1.55; }

  .code-comparison {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
  }

  .code-box {
    border-radius: var(--radius-md);
    padding: 18px;
    background: #070b14;
    border: 1px solid var(--border-default);
  }
  .code-box.good { border-top: 3px solid #34d399; }
  .code-box.bad { border-top: 3px solid #f43f5e; }

  .code-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    font-weight: 700;
    font-size: 0.88rem;
  }
  .good .code-header span { color: #34d399; }
  .bad .code-header span { color: #f43f5e; }

  .copy-code-btn {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
    padding: 3px 9px;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-family: var(--font-sans);
    cursor: pointer;
    transition: var(--transition-fast);
  }
  .copy-code-btn:hover { color: var(--text-primary); background: rgba(255, 255, 255, 0.15); }
  .copy-code-btn.copied { background: #34d399; color: #070b14; font-weight: 700; }

  pre {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    color: var(--text-primary);
    overflow-x: auto;
    white-space: pre-wrap;
    line-height: 1.5;
  }

  .evolution-box {
    border-left: 4px solid var(--accent-blue);
    margin-bottom: 24px;
  }
  .evolution-box h4 { color: var(--accent-blue); }

  .provision-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  .provision-card-link {
    background: rgba(7, 11, 20, 0.65);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: 16px;
    text-decoration: none;
    transition: var(--transition-fast);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .provision-card-link:hover {
    border-color: var(--accent-blue);
    transform: translateY(-2px);
  }

  .link-label {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .link-slug {
    color: var(--accent-blue);
    font-size: 0.95rem;
  }
  .link-arrow { color: var(--accent-blue); margin-top: 4px; }

  .text-muted { color: var(--text-muted); }

  @media (max-width: 768px) {
    .tab-panel { padding: 20px; }
  }

  /* Light Theme Overrides */
  :global(html[data-theme="light"]) .tab-list {
    background: #f1f5f9;
    border-color: #cbd5e1;
  }
  :global(html[data-theme="light"]) .info-card,
  :global(html[data-theme="light"]) .persona-card,
  :global(html[data-theme="light"]) .test-card,
  :global(html[data-theme="light"]) .provision-card-link {
    background: #f8fafc;
    border-color: #cbd5e1;
  }
  :global(html[data-theme="light"]) .link-slug {
    color: #0369a1;
  }
</style>
