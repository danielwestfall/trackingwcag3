---
import PlainEnglishLayout from "@/layouts/PlainEnglishLayout.astro";
import fs from "fs";
import path from "path";

export async function getStaticPaths() {
  const wcag22Path = path.join(process.cwd(), "public", "data", "wcag22-catalog.json");
  if (!fs.existsSync(wcag22Path)) return [];
  const list = JSON.parse(fs.readFileSync(wcag22Path, "utf8"));
  return list.map((item: any) => ({
    params: { id: item.id.replace(/\./g, "-") },
    props: { item },
  }));
}

interface Props {
  item: any;
}

const { item } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (path: string) => `${base}${path.startsWith('/') ? path : '/' + path}`;
---

<PlainEnglishLayout title={`SC ${item.num} ${item.name} - WCAG 2.2 Plain English`} activeTab="wcag22">
  <div class="detail-header">
    <a href={link("/plain-english/wcag22/")} class="back-link">&larr; Back to WCAG 2.2 Reference</a>
    
    <div class="header-badges">
      <span class="num-badge">SC {item.num}</span>
      <span class={`level-badge level-${item.level}`}>Level {item.level}</span>
      <span class="principle-badge">{item.principle}</span>
    </div>

    <h1 class="page-title">{item.name}</h1>
    <p class="meta-subtitle">Official W3C WCAG 2.2 Standard Success Criterion</p>
  </div>

  <!-- Tabbed Interface -->
  <section class="tabs-container">
    <div class="tab-list" role="tablist" aria-label="Criterion details">
      <button role="tab" aria-selected="true" aria-controls="panel-plain" id="tab-plain" class="tab-btn active">
        💬 Plain English & Persona Tips
      </button>
      <button role="tab" aria-selected="false" aria-controls="panel-test" id="tab-test" class="tab-btn">
        🧪 Testing Guide & Code
      </button>
      <button role="tab" aria-selected="false" aria-controls="panel-evolution" id="tab-evolution" class="tab-btn">
        ✨ Evolution in WCAG 3
      </button>
    </div>

    <!-- Panel 1: Plain English -->
    <div id="panel-plain" role="tabpanel" aria-labelledby="tab-plain" class="tab-panel active">
      <div class="panel-section">
        <h3>Plain English Explanation</h3>
        <p class="summary-lead">{item.plainEnglish.summary}</p>
      </div>

      <div class="panel-grid-2">
        <div class="info-card">
          <h4>Why It Matters</h4>
          <p>{item.plainEnglish.whyItMatters}</p>
        </div>
        <div class="info-card">
          <h4>Real-World Example</h4>
          <p>{item.plainEnglish.realWorldExample}</p>
        </div>
      </div>

      <div class="panel-section">
        <h3>Role-Based Actionable Advice</h3>
        <div class="persona-cards-grid">
          <div class="persona-card designer">
            <span class="persona-header">🎨 Designer</span>
            <p>{item.personaBreakdown.designer}</p>
          </div>
          <div class="persona-card developer">
            <span class="persona-header">💻 Developer</span>
            <p>{item.personaBreakdown.developer}</p>
          </div>
          <div class="persona-card qa">
            <span class="persona-header">🧪 QA / Tester</span>
            <p>{item.personaBreakdown.qa}</p>
          </div>
          <div class="persona-card pm">
            <span class="persona-header">📋 Product Manager</span>
            <p>{item.personaBreakdown.productManager}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Panel 2: Testing Guide -->
    <div id="panel-test" role="tabpanel" aria-labelledby="tab-test" class="tab-panel hidden">
      <div class="panel-section">
        <h3>Step-by-Step Testing Procedures</h3>
        <div class="testing-grid">
          <div class="test-card">
            <h4>🤖 Automated Testing</h4>
            <p>{item.testingGuide.automated}</p>
          </div>
          <div class="test-card">
            <h4>⌨️ Keyboard Testing</h4>
            <p>{item.testingGuide.manualKeyboard}</p>
          </div>
          <div class="test-card">
            <h4>🔊 Screen Reader Check</h4>
            <p>{item.testingGuide.screenReader}</p>
          </div>
        </div>
      </div>

      <div class="panel-section">
        <h3>Code Patterns: Good vs Bad</h3>
        <div class="code-comparison">
          <div class="code-box good">
            <span class="code-header">✅ Compliant Code Pattern</span>
            <pre><code>{item.testingGuide.codeSnippetGood}</code></pre>
          </div>
          <div class="code-box bad">
            <span class="code-header">❌ Non-Compliant Pattern</span>
            <pre><code>{item.testingGuide.codeSnippetBad}</code></pre>
          </div>
        </div>
      </div>
    </div>

    <!-- Panel 3: Evolution in WCAG 3 -->
    <div id="panel-evolution" role="tabpanel" aria-labelledby="tab-evolution" class="tab-panel hidden">
      <div class="panel-section">
        <h3>How SC {item.num} Evolves in WCAG 3</h3>
        
        <div class="info-card evolution-box">
          <h4>Evolution Summary</h4>
          <p>{item.wcag3Mapping.evolutionNote}</p>
        </div>

        <div class="panel-section">
          <h4>Mapped WCAG 3 Provisions / Outcomes</h4>
          <div class="provision-links-grid">
            {item.wcag3Mapping.provisions.map((provSlug: string) => (
              <a href={link(`/plain-english/provision/${provSlug}/`)} class="provision-card-link">
                <span class="link-label">WCAG 3 Provision:</span>
                <strong class="link-slug">{provSlug}</strong>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</PlainEnglishLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.tab-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        panels.forEach(p => p.classList.add('hidden'));

        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const targetPanelId = tab.getAttribute('aria-controls');
        const targetPanel = document.getElementById(targetPanelId);
        if (targetPanel) {
          targetPanel.classList.remove('hidden');
        }
      });
    });
  });
</script>

<style>
  .detail-header {
    margin-bottom: 32px;
  }

  .back-link {
    display: inline-block;
    color: #34d399;
    text-decoration: none;
    font-weight: 600;
    margin-bottom: 16px;
  }
  .back-link:hover { text-decoration: underline; }

  .header-badges {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-bottom: 12px;
  }

  .num-badge {
    font-family: var(--font-mono);
    font-weight: 800;
    color: #34d399;
    font-size: 1rem;
  }

  .level-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 6px;
  }
  .level-A { background: rgba(56, 189, 248, 0.2); color: #38bdf8; }
  .level-AA { background: rgba(52, 211, 153, 0.2); color: #34d399; }
  .level-AAA { background: rgba(192, 132, 252, 0.2); color: #c084fc; }

  .principle-badge {
    font-size: 0.75rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.05);
    padding: 3px 10px;
    border-radius: 6px;
  }

  .page-title {
    font-size: 2.2rem;
    font-weight: 800;
    margin-bottom: 8px;
  }

  .meta-subtitle {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .tabs-container {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .tab-list {
    display: flex;
    background: rgba(15, 23, 42, 0.8);
    border-bottom: 1px solid var(--border-color);
    overflow-x: auto;
  }

  .tab-btn {
    background: none;
    border: none;
    color: var(--text-secondary);
    padding: 16px 24px;
    font-size: 0.95rem;
    font-weight: 600;
    font-family: var(--font-sans);
    cursor: pointer;
    white-space: nowrap;
    border-bottom: 3px solid transparent;
  }
  .tab-btn.active {
    color: #34d399;
    border-bottom-color: #34d399;
    background: rgba(52, 211, 153, 0.05);
  }

  .tab-panel { padding: 32px; }
  .tab-panel.hidden { display: none; }

  .panel-section { margin-bottom: 32px; }
  .panel-section h3 {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .summary-lead {
    font-size: 1.15rem;
    line-height: 1.6;
    background: rgba(52, 211, 153, 0.08);
    border-left: 4px solid #34d399;
    padding: 16px 20px;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .panel-grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
  }

  .info-card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 20px;
  }
  .info-card h4 {
    color: #34d399;
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .info-card p {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .persona-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }

  .persona-card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 16px;
  }
  .persona-header {
    font-weight: 700;
    display: block;
    margin-bottom: 6px;
  }
  .designer .persona-header { color: #f472b6; }
  .developer .persona-header { color: #38bdf8; }
  .qa .persona-header { color: #34d399; }
  .pm .persona-header { color: #fbbf24; }

  .persona-card p {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .testing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }

  .test-card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 20px;
  }
  .test-card h4 { font-size: 1rem; font-weight: 700; margin-bottom: 8px; }
  .test-card p { color: var(--text-secondary); font-size: 0.92rem; }

  .code-comparison {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
  }

  .code-box {
    border-radius: var(--radius-md);
    padding: 16px;
    background: #090d16;
    border: 1px solid var(--border-color);
  }
  .code-box.good { border-top: 3px solid #34d399; }
  .code-box.bad { border-top: 3px solid #f43f5e; }

  .code-header { font-weight: 700; display: block; margin-bottom: 12px; }
  .good .code-header { color: #34d399; }
  .bad .code-header { color: #f43f5e; }

  pre {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-primary);
    overflow-x: auto;
    white-space: pre-wrap;
  }

  .evolution-box {
    border-left: 4px solid var(--accent-blue);
    margin-bottom: 24px;
  }
  .evolution-box h4 { color: var(--accent-blue); }

  .provision-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }

  .provision-card-link {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 16px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .provision-card-link:hover {
    border-color: var(--accent-blue);
    transform: translateY(-2px);
  }

  .link-label {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .link-slug {
    color: var(--accent-blue);
    font-size: 0.95rem;
  }
</style>
