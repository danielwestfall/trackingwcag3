---
import PlainEnglishLayout from "@/layouts/PlainEnglishLayout.astro";
import fs from "fs";
import path from "path";

// Each criterion page is built from three sources:
//  - wcag22-data/normative-text.json: the criterion's normative text and the
//    definitions it links to, extracted verbatim from the W3C source at the
//    published Recommendation tag (scripts/extract-wcag22-normative.mjs).
//  - wcag22-data/three-tier-guidance.json: the plain-English floor, what the
//    normative text does not require, the usability gap, and best practice.
//  - public/data/wcag22-catalog.json: names, levels, links and the WCAG 3 mapping.
// The page never presents an informative note, an Understanding document or a
// recommendation as part of the requirement.
export async function getStaticPaths() {
  const read = (...p: string[]) => {
    const f = path.join(process.cwd(), ...p);
    return fs.existsSync(f) ? JSON.parse(fs.readFileSync(f, "utf8")) : null;
  };
  const list = read("public", "data", "wcag22-catalog.json") || [];
  const normative = read("wcag22-data", "normative-text.json");
  const guidance = read("wcag22-data", "three-tier-guidance.json");
  const wcag3 = read("public", "data", "wcag3-catalog.json") || [];
  const normBy = new Map((normative?.criteria || []).map((c: any) => [c.num, c]));
  const guideBy = new Map((guidance?.criteria || []).map((c: any) => [c.num, c]));
  const wcag3Titles = Object.fromEntries(wcag3.map((p: any) => [p.slug, p.title]));
  return list.map((item: any) => ({
    params: { id: item.id.replace(/\./g, "-") },
    props: {
      item,
      norm: normBy.get(item.num) || null,
      tiers: guideBy.get(item.num) || null,
      recommendation: normative?.recommendation || "",
      normativeStatement: normative?.normativeStatement || "",
      wcag3Titles,
    },
  }));
}

const { item, norm, tiers, recommendation, normativeStatement, wcag3Titles } = Astro.props as any;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (p: string) => `${base}${p.startsWith("/") ? p : "/" + p}`;

// Term references become links to the definitions listed on this page; a term
// whose definition isn't listed here stays plain text.
const defIds = new Set((norm?.definitions || []).map((d: any) => d.id));
const linkTerms = (html: string) =>
  (html || "").replace(/<span class="term-ref"(?: data-dfn="([^"]*)")?>(.*?)<\/span>/g, (_m: string, id: string, text: string) =>
    id && defIds.has(id) ? `<a class="term-link" href="#${id}">${text}</a>` : text);

const name = norm?.name || item.name;
const level = norm?.obsolete ? null : (norm?.level || item.level);
const scLabel = `SC ${item.num}`;
---

<PlainEnglishLayout title={`${scLabel} ${name} - WCAG 2.2 Plain English`} activeTab="wcag22">
  <div class="detail-header">
    <nav aria-label="Breadcrumbs" class="breadcrumbs">
      <a href={link("/plain-english/wcag22/")} class="back-link">&larr; Back to WCAG 2.2 Reference</a>
      <span class="crumb-sep" aria-hidden="true">/</span>
      <span class="crumb-current">{scLabel} {name}</span>
    </nav>

    <div class="header-badges">
      <span class="num-badge">{scLabel}</span>
      {level ? <span class={`level-badge level-${level}`}>Level {level}</span> : <span class="level-badge level-obsolete">Obsolete and removed</span>}
      <span class="principle-badge">{item.principle}</span>
      {norm?.newIn22 && <span class="principle-badge">New in 2.2</span>}
    </div>

    <h1 class="page-title">{name}</h1>
    <p class="meta-subtitle">WCAG 2.2 success criterion &bull; Guideline: <strong>{norm?.guideline || item.principle}</strong></p>

    <div class="w3c-primary-links" role="group" aria-label="Official W3C sources">
      {(norm?.source || item.trUrl) && (
        <a href={norm?.source || item.trUrl} target="_blank" rel="noopener noreferrer" class="w3c-link-pill pill-normative">
          <span class="pill-icon" aria-hidden="true">📜</span>
          <span>W3C Recommendation (Normative) ↗</span>
        </a>
      )}
      {item.understandingUrl && (
        <a href={item.understandingUrl} target="_blank" rel="noopener noreferrer" class="w3c-link-pill pill-informative">
          <span class="pill-icon" aria-hidden="true">💡</span>
          <span>Understanding SC {item.num} (Informative) ↗</span>
        </a>
      )}
    </div>
  </div>

  <nav class="tier-jump" aria-label="On this page">
    <ul>
      <li><a href="#tier-1"><span class="tier-num">1</span> Baseline compliance</a></li>
      <li><a href="#tier-2"><span class="tier-num">2</span> Usability &amp; user impact</a></li>
      <li><a href="#tier-3"><span class="tier-num">3</span> Recommended best practice</a></li>
      <li><a href="#wcag3">WCAG 3</a></li>
    </ul>
  </nav>

  <!-- Tier 1: strictly normative -->
  <section class="tier tier-1" aria-labelledby="tier-1">
    <p class="tier-kicker">Tier 1 · The normative floor</p>
    <h2 id="tier-1">Baseline compliance</h2>
    <p class="tier-framing">What the normative text of WCAG 2.2 requires, and nothing more. Only a failure of this tier is a WCAG failure.</p>

    {tiers?.floor ? (
      <div class="floor-box">
        <h3>The bare minimum</h3>
        <p>{tiers.floor}</p>
      </div>
    ) : (
      <p class="missing-note">No plain-English baseline has been written for this criterion yet. The normative text below is authoritative.</p>
    )}

    {norm && norm.normative.length > 0 && (
      <div class="normative-box">
        <h3>Normative text</h3>
        <p class="source-line">Verbatim from {recommendation}. Underlined terms are defined below.</p>
        <div class="normative-text">
          {norm.normative.map((b: any) =>
            b.type === "p" ? <p set:html={linkTerms(b.html)} />
            : b.type === "dl" ? (
              <dl>
                {b.items.map((i: any) => (<><dt>{i.term}</dt><dd set:html={linkTerms(i.html)} /></>))}
              </dl>
            )
            : b.type === "ol" ? <ol>{b.items.map((i: string) => <li set:html={linkTerms(i)} />)}</ol>
            : <ul>{b.items.map((i: string) => <li set:html={linkTerms(i)} />)}</ul>
          )}
        </div>
      </div>
    )}

    {tiers?.failsExamples?.length > 0 && (
      <div class="fails-box">
        <h3>Known failures</h3>
        <p class="source-line">These fail this criterion or a related one named in the text. Log them as WCAG failures.</p>
        <ul>
          {tiers.failsExamples.map((n: string) => <li>{n}</li>)}
        </ul>
      </div>
    )}

    {tiers?.notRequired?.length > 0 && (
      <div class="not-required-box">
        <h3>Not required by the normative text</h3>
        <p class="source-line">Common claims that this criterion does not support. Don't log these as WCAG failures.</p>
        <ul>
          {tiers.notRequired.map((n: string) => <li>{n}</li>)}
        </ul>
      </div>
    )}

    {norm?.definitions?.length > 0 && (
      <details class="defs-box" open>
        <summary><h3>Definitions used ({norm.definitions.length})</h3></summary>
        <p class="source-line">Glossary definitions are normative. Their notes are informative.</p>
        <dl class="defs-list">
          {norm.definitions.map((d: any) => (
            <>
              <dt id={d.id}>{d.term}</dt>
              <dd>
                {d.definition.map((b: any) =>
                  b.type === "p" ? <p set:html={linkTerms(b.html)} />
                  : b.type === "dl" ? <dl>{b.items.map((i: any) => (<><dt>{i.term}</dt><dd set:html={linkTerms(i.html)} /></>))}</dl>
                  : <ul>{b.items.map((i: string) => <li set:html={linkTerms(i)} />)}</ul>
                )}
                {d.informativeNotes.length > 0 && (
                  <details class="def-notes">
                    <summary>Informative notes ({d.informativeNotes.length})</summary>
                    {d.informativeNotes.map((n: string) => <p set:html={linkTerms(n)} />)}
                  </details>
                )}
              </dd>
            </>
          ))}
        </dl>
      </details>
    )}

    {norm?.informativeNotes?.length > 0 && (
      <div class="informative-box">
        <h3>Notes in the criterion <span class="nn-badge">Informative</span></h3>
        <p class="source-line">WCAG 2.2 lists notes among its informative material, which "does not create requirements that impact a conformance claim." They help interpret the criterion but are not part of the floor.</p>
        {norm.informativeNotes.map((n: string) => <p class="note-text" set:html={linkTerms(n)} />)}
      </div>
    )}
  </section>

  <!-- Tier 2: user impact -->
  <section class="tier tier-2" aria-labelledby="tier-2">
    <p class="tier-kicker">Tier 2 · The gap</p>
    <h2 id="tier-2">Usability &amp; user impact</h2>
    <p class="tier-framing">Where content can meet this criterion and still make things harder for people with disabilities. These are not failures of {scLabel}, so raise them as usability defects. Known failures, including failures of related criteria, are listed in Tier 1.</p>
    {tiers?.gap ? <p class="tier-body">{tiers.gap}</p> : <p class="missing-note">Not written yet.</p>}
  </section>

  <!-- Tier 3: golden path -->
  <section class="tier tier-3" aria-labelledby="tier-3">
    <p class="tier-kicker">Tier 3 · The golden path</p>
    <h2 id="tier-3">Recommended best practice</h2>
    <p class="tier-framing">The pattern that meets the floor, closes the gap, and avoids audit disputes. A recommendation, not a requirement.</p>
    {tiers?.bestPractice ? <p class="tier-body">{tiers.bestPractice}</p> : <p class="missing-note">Not written yet.</p>}
    {item.understandingUrl && (
      <p class="tier-more">
        W3C's <a href={item.understandingUrl} target="_blank" rel="noopener noreferrer">Understanding document and techniques for {scLabel} ↗</a> are informative:
        sufficient techniques show ways to pass, and documented failures show common ways to fail, but neither changes what the criterion requires.
      </p>
    )}
  </section>

  <!-- WCAG 3 -->
  <section class="tier tier-wcag3" aria-labelledby="wcag3">
    <h2 id="wcag3">How {scLabel} maps to the WCAG 3 draft</h2>
    <p class="tier-framing">From this site's reviewed map to the WCAG 3 editor's draft. It's an interpretation: W3C has not published a mapping.</p>
    {item.wcag3Mapping?.note && <p class="tier-body">{item.wcag3Mapping.note}</p>}
    {item.wcag3Mapping?.provisions?.length > 0 ? (
      <>
        <h3 class="map-subhead">Successor provisions</h3>
        <div class="provision-links-grid">
          {item.wcag3Mapping.provisions.map((slug: string) => (
            <a href={link(`/plain-english/provision/${slug}/`)} class="provision-card-link">
              <span class="link-label">WCAG 3 draft provision</span>
              <strong class="link-slug">{wcag3Titles[slug] || slug}</strong>
              <span class="link-arrow" aria-hidden="true">&rarr;</span>
            </a>
          ))}
        </div>
      </>
    ) : (
      !item.wcag3Mapping?.note && <p class="missing-note">No successor provision in the current draft.</p>
    )}
    {item.wcag3Mapping?.related?.length > 0 && (
      <>
        <h3 class="map-subhead">Related, not a successor</h3>
        <div class="provision-links-grid">
          {item.wcag3Mapping.related.map((slug: string) => (
            <a href={link(`/plain-english/provision/${slug}/`)} class="provision-card-link">
              <span class="link-label">Related draft provision</span>
              <strong class="link-slug">{wcag3Titles[slug] || slug}</strong>
              <span class="link-arrow" aria-hidden="true">&rarr;</span>
            </a>
          ))}
        </div>
      </>
    )}
  </section>

  <p class="normative-footnote">{normativeStatement && <>From WCAG 2.2, section 5.1: “{normativeStatement}”</>}</p>
</PlainEnglishLayout>

<style>
  .detail-header {
    margin-bottom: 32px;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font-size: 0.88rem;
    /* A non-wrapping row whose last crumb is a full criterion title:
       the crumb defaults to min-width: auto, so at 200% text scale the row
       cannot shrink and pushes the page sideways. */
    flex-wrap: wrap;
  }

  .back-link {
    color: var(--accent-emerald);
    text-decoration: none;
    font-weight: 600;
    transition: var(--transition-fast);
  }
  .back-link:hover { color: #6ee7b7; }

  .crumb-sep { color: var(--text-muted); }
  .crumb-current { min-width: 0; color: var(--text-secondary); }

  .header-badges {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .num-badge {
    font-family: var(--font-mono);
    font-weight: 800;
    color: var(--accent-emerald);
    font-size: 0.92rem;
    background: rgba(52, 211, 153, 0.12);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }

  .level-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: var(--radius-sm);
  }
  .level-A { background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); }
  .level-AA { background: rgba(52, 211, 153, 0.15); color: #34d399; border: 1px solid rgba(52, 211, 153, 0.3); }
  .level-AAA { background: rgba(192, 132, 252, 0.15); color: #c084fc; border: 1px solid rgba(192, 132, 252, 0.3); }

  .principle-badge {
    font-size: 0.72rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    padding: 3px 9px;
    border-radius: var(--radius-sm);
  }

  .page-title {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    font-weight: 800;
    color: var(--text-pure);
    letter-spacing: -0.025em;
    margin-bottom: 8px;
  }

  .meta-subtitle {
    color: var(--text-secondary);
    font-size: 0.94rem;
  }

  .w3c-primary-links {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 14px;
  }

  .w3c-link-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: var(--transition-fast);
    max-width: 100%;
    flex-wrap: wrap;
    min-width: 0;
  }

  .pill-normative {
    background: rgba(52, 211, 153, 0.12);
    color: var(--accent-emerald);
    border: 1px solid rgba(52, 211, 153, 0.3);
  }
  .pill-normative:hover {
    background: rgba(52, 211, 153, 0.22);
    border-color: var(--accent-emerald);
    color: #a7f3d0;
  }

  .pill-informative {
    background: rgba(56, 189, 248, 0.12);
    color: var(--accent-blue);
    border: 1px solid rgba(56, 189, 248, 0.3);
  }
  .pill-informative:hover {
    background: rgba(56, 189, 248, 0.22);
    border-color: var(--accent-blue);
    color: #bae6fd;
  }

  :global(html[data-theme="light"]) .pill-normative {
    background: rgba(16, 185, 129, 0.1);
    color: #047857;
    border-color: rgba(16, 185, 129, 0.35);
  }
  :global(html[data-theme="light"]) .pill-normative:hover {
    background: rgba(16, 185, 129, 0.2);
    color: #065f46;
  }

  :global(html[data-theme="light"]) .pill-informative {
    background: rgba(2, 132, 199, 0.1);
    color: #0369a1;
    border-color: rgba(2, 132, 199, 0.35);
  }
  :global(html[data-theme="light"]) .pill-informative:hover {
    background: rgba(2, 132, 199, 0.2);
    color: #075985;
  }

  .evolution-box {
    border-left: 4px solid var(--accent-blue);
    margin-bottom: 24px;
  }
  .evolution-box h3,
  .evolution-box h4 { color: var(--accent-blue); }

  .provision-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: 16px;
  }

  .provision-card-link {
    background: rgba(7, 11, 20, 0.65);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: 16px;
    text-decoration: none;
    transition: var(--transition-fast);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .provision-card-link:hover {
    border-color: var(--accent-blue);
    transform: translateY(-2px);
  }

  .link-label {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .link-slug {
    color: var(--accent-blue);
    font-size: 0.95rem;
  }
  .link-arrow { color: var(--accent-blue); margin-top: 4px; }

  .text-muted { color: var(--text-muted); }

  .level-obsolete { background: var(--surface-subtle); color: var(--text-muted); border: 1px solid var(--border-default); }

  .tier-jump { margin: 0 0 24px; }
  .tier-jump ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tier-jump a {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 14px; border: 1px solid var(--border-default); border-radius: var(--radius-full);
    color: var(--text-primary); text-decoration: none; font-size: 0.9rem;
  }
  .tier-jump a:hover { border-color: var(--border-active); color: var(--text-accent); }
  .tier-num {
    display: inline-grid; place-items: center; width: 1.4em; height: 1.4em; border-radius: 50%;
    border: 1.5px solid currentColor; font-size: 0.78rem; font-weight: 800;
  }

  .tier {
    min-width: 0;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-left-width: 4px;
    border-radius: var(--radius-lg);
    padding: 26px 28px;
    margin-bottom: 22px;
  }
  .tier-1 { border-left-color: var(--accent-emerald); }
  .tier-2 { border-left-color: var(--accent-amber); }
  .tier-3 { border-left-color: var(--accent-blue); }
  .tier-wcag3 { border-left-color: var(--accent-purple); }
  .tier > h2 { font-size: 1.45rem; font-weight: 800; color: var(--text-pure); margin: 0 0 6px; scroll-margin-top: 16px; }
  .tier-kicker {
    font-size: 0.74rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--text-muted); margin: 0 0 4px;
  }
  .tier-framing { color: var(--text-secondary); font-style: italic; line-height: 1.55; margin: 0 0 18px; max-width: 760px; }
  .tier-body { color: var(--text-primary); line-height: 1.65; font-size: 1.02rem; margin: 0; max-width: 820px; }
  .tier-more { color: var(--text-secondary); line-height: 1.6; margin: 14px 0 0; font-size: 0.94rem; max-width: 820px; }
  .map-subhead { font-size: 1rem; font-weight: 700; color: var(--text-pure); margin: 16px 0 8px; }
  .tier-more a, .tier a.term-link { color: var(--text-accent); }

  .tier-1 h3 { font-size: 1.02rem; font-weight: 700; color: var(--text-pure); margin: 0 0 8px; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .floor-box, .normative-box, .fails-box, .not-required-box, .defs-box, .informative-box {
    border: 1px solid var(--border-subtle); border-radius: var(--radius-md);
    padding: 16px 18px; margin-top: 14px; background: var(--surface-subtle);
  }
  .floor-box p { color: var(--text-primary); font-size: 1.05rem; line-height: 1.65; margin: 0; }
  .source-line { color: var(--text-muted); font-size: 0.86rem; margin: -2px 0 10px; line-height: 1.5; }

  .normative-text { border-left: 3px solid var(--accent-emerald); padding-left: 14px; color: var(--text-primary); line-height: 1.65; }
  .normative-text p { margin: 0 0 8px; }
  .normative-text dl { margin: 6px 0 0; }
  .normative-text dt { font-weight: 700; margin-top: 8px; color: var(--text-pure); }
  .normative-text dd { margin: 2px 0 0 0; }
  .normative-text ul, .normative-text ol { margin: 4px 0 8px; padding-left: 1.3em; }
  a.term-link { text-decoration: underline; text-decoration-style: dotted; text-underline-offset: 3px; }

  .fails-box { border-color: var(--accent-rose) !important; border-left-width: 3px !important; }
  .fails-box ul { margin: 0; padding-left: 1.2em; display: grid; gap: 6px; }
  .fails-box li { color: var(--text-primary); line-height: 1.55; }
  .not-required-box ul { margin: 0; padding-left: 1.2em; display: grid; gap: 6px; }
  .not-required-box li { color: var(--text-primary); line-height: 1.55; }

  .defs-box > summary { cursor: pointer; list-style-position: outside; }
  .defs-box > summary h3 { display: inline-flex; margin: 0; }
  .defs-list { margin: 8px 0 0; }
  .defs-list > dt { font-weight: 700; color: var(--text-pure); margin-top: 12px; scroll-margin-top: 16px; }
  .defs-list > dt:target { outline: 2px solid var(--border-active); outline-offset: 3px; border-radius: 4px; }
  .defs-list > dd { margin: 4px 0 0; color: var(--text-secondary); line-height: 1.6; }
  .defs-list > dd p { margin: 0 0 6px; }
  .defs-list > dd ul { margin: 4px 0; padding-left: 1.2em; }
  .def-notes { margin-top: 6px; font-size: 0.9rem; }
  .def-notes summary { cursor: pointer; color: var(--text-muted); }
  .def-notes p { color: var(--text-muted); margin: 6px 0 0; }

  .informative-box { border-style: dashed; }
  .nn-badge {
    font-size: 0.7rem; font-weight: 700; border: 1px dashed var(--border-default);
    border-radius: var(--radius-full); padding: 1px 8px; color: var(--text-muted);
    text-transform: uppercase; letter-spacing: 0.05em;
  }
  .note-text { color: var(--text-secondary); line-height: 1.6; margin: 0 0 8px; }
  .missing-note { color: var(--text-muted); font-style: italic; margin: 0; }

  .normative-footnote { color: var(--text-muted); font-size: 0.85rem; line-height: 1.55; margin: 8px 0 0; max-width: 900px; }

  @media (max-width: 760px) {
    .tier { padding: 20px 16px; }
    .floor-box, .normative-box, .not-required-box, .defs-box, .informative-box { padding: 14px 12px; }
  }
</style>
