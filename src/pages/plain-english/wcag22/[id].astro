---
import PlainEnglishLayout from "@/layouts/PlainEnglishLayout.astro";
import fs from "fs";
import path from "path";

export async function getStaticPaths() {
  const wcag22Path = path.join(process.cwd(), "public", "data", "wcag22-catalog.json");
  if (!fs.existsSync(wcag22Path)) return [];
  const list = JSON.parse(fs.readFileSync(wcag22Path, "utf8"));
  return list.map((item: any) => ({
    params: { id: item.id.replace(/\./g, "-") },
    props: { item },
  }));
}

interface Props {
  item: any;
}

const { item } = Astro.props as Props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (path: string) => `${base}${path.startsWith('/') ? path : '/' + path}`;
---

<PlainEnglishLayout title={`SC ${item.num} ${item.name} - WCAG 2.2 Plain English`} activeTab="wcag22">
  <div class="detail-header">
    <nav aria-label="Breadcrumbs" class="breadcrumbs">
      <a href={link("/plain-english/wcag22/")} class="back-link">&larr; Back to WCAG 2.2 Reference</a>
      <span class="crumb-sep">/</span>
      <span class="crumb-current">SC {item.num} {item.name}</span>
    </nav>
    
    <div class="header-badges">
      <span class="num-badge">SC {item.num}</span>
      <span class={`level-badge level-${item.level}`}>Level {item.level}</span>
      <span class="principle-badge">{item.principle}</span>
    </div>

    <h1 class="page-title">{item.name}</h1>
    <p class="meta-subtitle">Official W3C WCAG 2.2 Standard Success Criterion &bull; Principle: <strong>{item.principle}</strong></p>

    <div class="w3c-primary-links" aria-label="Official W3C Sources">
      {item.trUrl && (
        <a href={item.trUrl} target="_blank" rel="noopener noreferrer" class="w3c-link-pill pill-normative" title="Review normative criterion definition in W3C WCAG 2.2 Recommendation">
          <span class="pill-icon" aria-hidden="true">📜</span>
          <span>W3C Recommendation (Normative) ↗</span>
        </a>
      )}
      {item.understandingUrl && (
        <a href={item.understandingUrl} target="_blank" rel="noopener noreferrer" class="w3c-link-pill pill-informative" title="Read official W3C Understanding document, intent, and techniques">
          <span class="pill-icon" aria-hidden="true">💡</span>
          <span>Understanding SC {item.num} (W3C WAI) ↗</span>
        </a>
      )}
    </div>
  </div>

  <!-- Tabbed Interface -->
  <section class="tabs-container">
    <div class="tab-list" role="tablist" aria-label="Criterion details">
      <button role="tab" aria-selected="true" aria-controls="panel-plain" id="tab-plain" class="tab-btn active">
        💬 Plain English & Guidance
      </button>
      <button role="tab" aria-selected="false" aria-controls="panel-test" id="tab-test" class="tab-btn">
        🧪 Testing Guide & Code
      </button>
      <button role="tab" aria-selected="false" aria-controls="panel-evolution" id="tab-evolution" class="tab-btn">
        ✨ Evolution in WCAG 3
      </button>
    </div>

    <!-- Panel 1: Plain English -->
    <div id="panel-plain" role="tabpanel" aria-labelledby="tab-plain" class="tab-panel active">
      <div class="panel-section">
        <h2>Plain English Explanation</h2>
        <p class="summary-lead">{item.plainEnglish?.summary}</p>
      </div>

      <div class="panel-grid-2">
        <div class="info-card">
          <h3>Why It Matters</h3>
          <p>{item.plainEnglish?.whyItMatters || "Ensures users can perceive and interact with web content equitably."}</p>
        </div>
        <div class="info-card">
          <h3>Real-World Example</h3>
          <p>{item.plainEnglish?.realWorldExample || "Clear keyboard focus indications preventing navigation disorientation."}</p>
        </div>
      </div>

      {item.personaBreakdown && (
        <div class="panel-section">
          <h2>Role-Based Implementation Advice</h2>
          <div class="persona-cards-grid">
            {item.personaBreakdown.designer && (
              <div class="persona-card designer">
                <span class="persona-header">🎨 Designer</span>
                <p>{item.personaBreakdown.designer}</p>
              </div>
            )}
            {item.personaBreakdown.developer && (
              <div class="persona-card developer">
                <span class="persona-header">💻 Developer</span>
                <p>{item.personaBreakdown.developer}</p>
              </div>
            )}
            {item.personaBreakdown.qa && (
              <div class="persona-card qa">
                <span class="persona-header">🧪 QA / Tester</span>
                <p>{item.personaBreakdown.qa}</p>
              </div>
            )}
            {item.personaBreakdown.productManager && (
              <div class="persona-card pm">
                <span class="persona-header">📋 Product Manager</span>
                <p>{item.personaBreakdown.productManager}</p>
              </div>
            )}
          </div>
        </div>
      )}
    </div>

    <!-- Panel 2: Testing Guide -->
    <div id="panel-test" role="tabpanel" aria-labelledby="tab-test" class="tab-panel hidden">
      {item.testingGuide && (
        <>
          <div class="panel-section">
            <h2>Step-by-Step Testing Procedures</h2>
            <div class="testing-grid">
              {item.testingGuide.automated && (
                <div class="test-card">
                  <h3>🤖 Automated Testing</h3>
                  <p>{item.testingGuide.automated}</p>
                </div>
              )}
              {item.testingGuide.manualKeyboard && (
                <div class="test-card">
                  <h3>⌨️ Keyboard Testing</h3>
                  <p>{item.testingGuide.manualKeyboard}</p>
                </div>
              )}
              {item.testingGuide.screenReader && (
                <div class="test-card">
                  <h3>🔊 Screen Reader Check</h3>
                  <p>{item.testingGuide.screenReader}</p>
                </div>
              )}
            </div>
          </div>

          {(item.testingGuide.codeSnippetGood || item.testingGuide.codeSnippetBad) && (
            <div class="panel-section">
              <h2>Code Patterns: Good vs Bad</h2>
              <div class="code-comparison">
                {item.testingGuide.codeSnippetGood && (
                  <div class="code-box good">
                    <div class="code-header">
                      <span>✅ Compliant Code Pattern</span>
                      <button type="button" class="copy-code-btn" data-code={item.testingGuide.codeSnippetGood}>Copy</button>
                    </div>
                    <pre><code>{item.testingGuide.codeSnippetGood}</code></pre>
                  </div>
                )}
                {item.testingGuide.codeSnippetBad && (
                  <div class="code-box bad">
                    <div class="code-header">
                      <span>❌ Non-Compliant Pattern</span>
                      <button type="button" class="copy-code-btn" data-code={item.testingGuide.codeSnippetBad}>Copy</button>
                    </div>
                    <pre><code>{item.testingGuide.codeSnippetBad}</code></pre>
                  </div>
                )}
              </div>
            </div>
          )}
        </>
      )}

      <div class="panel-section">
        <h2>Official W3C Techniques &amp; Failures</h2>
        <p>
          Authoritative testing techniques, test rules, and documented failures for Success Criterion {item.num} are maintained normatively by W3C WAI:
        </p>
        <p>
          <a href={item.understandingUrl} target="_blank" rel="noopener noreferrer" class="w3c-link-pill pill-informative">
            <span>Read Understanding SC {item.num} &amp; Techniques on W3C WAI ↗</span>
          </a>
        </p>
      </div>
    </div>

    <!-- Panel 3: Evolution in WCAG 3 -->
    <div id="panel-evolution" role="tabpanel" aria-labelledby="tab-evolution" class="tab-panel hidden">
      <div class="panel-section">
        <h2>How SC {item.num} Evolves in WCAG 3</h2>
        
        <div class="info-card evolution-box">
          <h3>Evolution Summary</h3>
          <p>{item.wcag3Mapping?.evolutionNote || "This criterion transitions from a binary page-level rule to continuous outcome scoring in WCAG 3."}</p>
        </div>

        <div class="panel-section">
          <h3>Mapped WCAG 3 Provisions / Outcomes</h3>
          <div class="provision-links-grid">
            {item.wcag3Mapping?.provisions?.length > 0 ? (
              item.wcag3Mapping.provisions.map((provSlug: string) => (
                <a href={link(`/plain-english/provision/${provSlug}/`)} class="provision-card-link">
                  <span class="link-label">WCAG 3 Provision:</span>
                  <strong class="link-slug">{provSlug}</strong>
                  <span class="link-arrow">&rarr;</span>
                </a>
              ))
            ) : (
              <p class="text-muted">Provisions mapped to this criterion are under active draft synthesis.</p>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>
</PlainEnglishLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.tab-btn');
    const panels = document.querySelectorAll('.tab-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        panels.forEach(p => p.classList.add('hidden'));

        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const targetPanelId = tab.getAttribute('aria-controls');
        const targetPanel = document.getElementById(targetPanelId);
        if (targetPanel) {
          targetPanel.classList.remove('hidden');
        }
      });
    });

    // Copy code buttons
    document.querySelectorAll('.copy-code-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const code = btn.getAttribute('data-code');
        if (code) {
          try {
            await navigator.clipboard.writeText(code);
            const originalText = btn.textContent;
            btn.textContent = 'Copied!';
            btn.classList.add('copied');
            setTimeout(() => {
              btn.textContent = originalText;
              btn.classList.remove('copied');
            }, 2000);
          } catch (e) {}
        }
      });
    });
  });
</script>

<style>
  .detail-header {
    margin-bottom: 32px;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    font-size: 0.88rem;
    /* A non-wrapping row whose last crumb is a full criterion title:
       the crumb defaults to min-width: auto, so at 200% text scale the row
       cannot shrink and pushes the page sideways. */
    flex-wrap: wrap;
  }

  .back-link {
    color: var(--accent-emerald);
    text-decoration: none;
    font-weight: 600;
    transition: var(--transition-fast);
  }
  .back-link:hover { color: #6ee7b7; }

  .crumb-sep { color: var(--text-muted); }
  .crumb-current { min-width: 0; color: var(--text-secondary); }

  .header-badges {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .num-badge {
    font-family: var(--font-mono);
    font-weight: 800;
    color: var(--accent-emerald);
    font-size: 0.92rem;
    background: rgba(52, 211, 153, 0.12);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
  }

  .level-badge {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: var(--radius-sm);
  }
  .level-A { background: rgba(56, 189, 248, 0.15); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.3); }
  .level-AA { background: rgba(52, 211, 153, 0.15); color: #34d399; border: 1px solid rgba(52, 211, 153, 0.3); }
  .level-AAA { background: rgba(192, 132, 252, 0.15); color: #c084fc; border: 1px solid rgba(192, 132, 252, 0.3); }

  .principle-badge {
    font-size: 0.72rem;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    padding: 3px 9px;
    border-radius: var(--radius-sm);
  }

  .page-title {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    font-weight: 800;
    color: var(--text-pure);
    letter-spacing: -0.025em;
    margin-bottom: 8px;
  }

  .meta-subtitle {
    color: var(--text-secondary);
    font-size: 0.94rem;
  }

  .w3c-primary-links {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 14px;
  }

  .w3c-link-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: var(--transition-fast);
    max-width: 100%;
    flex-wrap: wrap;
    min-width: 0;
  }

  .pill-normative {
    background: rgba(52, 211, 153, 0.12);
    color: var(--accent-emerald);
    border: 1px solid rgba(52, 211, 153, 0.3);
  }
  .pill-normative:hover {
    background: rgba(52, 211, 153, 0.22);
    border-color: var(--accent-emerald);
    color: #a7f3d0;
  }

  .pill-informative {
    background: rgba(56, 189, 248, 0.12);
    color: var(--accent-blue);
    border: 1px solid rgba(56, 189, 248, 0.3);
  }
  .pill-informative:hover {
    background: rgba(56, 189, 248, 0.22);
    border-color: var(--accent-blue);
    color: #bae6fd;
  }

  :global(html[data-theme="light"]) .pill-normative {
    background: rgba(16, 185, 129, 0.1);
    color: #047857;
    border-color: rgba(16, 185, 129, 0.35);
  }
  :global(html[data-theme="light"]) .pill-normative:hover {
    background: rgba(16, 185, 129, 0.2);
    color: #065f46;
  }

  :global(html[data-theme="light"]) .pill-informative {
    background: rgba(2, 132, 199, 0.1);
    color: #0369a1;
    border-color: rgba(2, 132, 199, 0.35);
  }
  :global(html[data-theme="light"]) .pill-informative:hover {
    background: rgba(2, 132, 199, 0.2);
    color: #075985;
  }

  .tabs-container {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  .tab-list {
    display: flex;
    background: rgba(7, 11, 20, 0.8);
    border-bottom: 1px solid var(--border-subtle);
    overflow-x: auto;
  }

  .tab-btn {
    background: none;
    border: none;
    color: var(--text-secondary);
    padding: 16px 22px;
    font-size: 0.92rem;
    font-weight: 600;
    font-family: var(--font-sans);
    cursor: pointer;
    white-space: nowrap;
    border-bottom: 3px solid transparent;
    transition: var(--transition-fast);
  }
  .tab-btn:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.03);
  }
  .tab-btn.active {
    color: var(--accent-emerald);
    border-bottom-color: var(--accent-emerald);
    background: rgba(52, 211, 153, 0.08);
    font-weight: 700;
  }

  .tab-panel { padding: 32px; }
  .tab-panel.hidden { display: none; }

  .panel-section { margin-bottom: 32px; }
  .panel-section:last-child { margin-bottom: 0; }
  .panel-section h2,
  .panel-section h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 16px;
    color: var(--text-pure);
    letter-spacing: -0.015em;
  }

  .summary-lead {
    font-size: 1.1rem;
    line-height: 1.65;
    background: rgba(52, 211, 153, 0.06);
    border-left: 4px solid var(--accent-emerald);
    padding: 18px 22px;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .panel-grid-2 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 20px;
    margin-bottom: 32px;
  }

  .info-card {
    background: rgba(7, 11, 20, 0.65);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: 20px;
  }
  .info-card h3,
  .info-card h4 {
    color: var(--accent-emerald);
    font-size: 0.98rem;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .info-card p {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .persona-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr));
    gap: 16px;
  }

  .persona-card {
    background: rgba(7, 11, 20, 0.65);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: 18px;
    display: flex;
    flex-direction: column;
  }
  .persona-card.designer { border-top: 3px solid var(--role-designer); }
  .persona-card.developer { border-top: 3px solid var(--role-developer); }
  .persona-card.qa { border-top: 3px solid var(--role-qa); }
  .persona-card.pm { border-top: 3px solid var(--role-pm); }

  .persona-header {
    font-weight: 700;
    display: block;
    margin-bottom: 8px;
    font-size: 0.94rem;
  }
  .designer .persona-header { color: var(--role-designer); }
  .developer .persona-header { color: var(--role-developer); }
  .qa .persona-header { color: var(--role-qa); }
  .pm .persona-header { color: var(--role-pm); }

  .persona-card p {
    color: var(--text-secondary);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .testing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 18px;
  }

  .test-card {
    background: rgba(7, 11, 20, 0.65);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: 20px;
  }
  .test-card h3,
  .test-card h3, .test-card h4 { font-size: 0.98rem; font-weight: 700; margin-bottom: 8px; color: var(--text-primary); }
  .test-card p { color: var(--text-secondary); font-size: 0.9rem; line-height: 1.55; }

  .code-comparison {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 20px;
  }

  .code-box {
    border-radius: var(--radius-md);
    padding: 18px;
    /* Theme-aware: the hard-coded dark surface left the code text at 1.13:1 in
       the light theme, hidden behind a closed tab where no sweep could see it. */
    background: var(--code-surface);
    color: var(--code-text);
    border: 1px solid var(--code-border);
  }
  .code-box.good { border-top: 3px solid var(--code-ok); }
  .code-box.bad { border-top: 3px solid var(--code-bad); }

  .code-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    font-weight: 700;
    font-size: 0.88rem;
  }
  .good .code-header span { color: var(--code-ok); }
  .bad .code-header span { color: var(--code-bad); }

  .copy-code-btn {
    /* Neutral tint rather than a white wash, so the button reads on both the
       dark and the light code surface. */
    background: rgba(127, 127, 127, 0.16);
    color: var(--code-text);
    border: 1px solid var(--code-border);
    padding: 3px 9px;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-family: var(--font-sans);
    cursor: pointer;
    transition: var(--transition-fast);
  }
  .copy-code-btn:hover { color: var(--code-text); background: rgba(127, 127, 127, 0.28); }
  .copy-code-btn.copied { background: #34d399; color: #070b14; font-weight: 700; }

  pre {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    color: var(--text-primary);
    overflow-x: auto;
    white-space: pre-wrap;
    line-height: 1.5;
  }

  .evolution-box {
    border-left: 4px solid var(--accent-blue);
    margin-bottom: 24px;
  }
  .evolution-box h3,
  .evolution-box h4 { color: var(--accent-blue); }

  .provision-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: 16px;
  }

  .provision-card-link {
    background: rgba(7, 11, 20, 0.65);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: 16px;
    text-decoration: none;
    transition: var(--transition-fast);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .provision-card-link:hover {
    border-color: var(--accent-blue);
    transform: translateY(-2px);
  }

  .link-label {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .link-slug {
    color: var(--accent-blue);
    font-size: 0.95rem;
  }
  .link-arrow { color: var(--accent-blue); margin-top: 4px; }

  .text-muted { color: var(--text-muted); }

  @media (max-width: 768px) {
    .tab-panel { padding: 20px; }
  }

  /* Light Theme Overrides */
  :global(html[data-theme="light"]) .tab-list {
    background: #f1f5f9;
    border-color: #cbd5e1;
  }
  :global(html[data-theme="light"]) .info-card,
  :global(html[data-theme="light"]) .persona-card,
  :global(html[data-theme="light"]) .test-card,
  :global(html[data-theme="light"]) .provision-card-link {
    background: #f8fafc;
    border-color: #cbd5e1;
  }
  :global(html[data-theme="light"]) .link-slug {
    color: #0369a1;
  }
</style>
