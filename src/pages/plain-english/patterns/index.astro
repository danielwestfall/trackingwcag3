                          <button type="submit" value="cancel" autofocus class="demo-btn">Cancel (Autofocus)</button>
                          <button type="submit" value="discard" class="demo-btn btn-danger">Discard</button>
                        </div>
                      </form>
                    </dialog>
                    <span class="slider-hint">Native &lt;dialog&gt; traps focus, Esc cancels, autofocus targets safe button</span>
                  </div>
                )}

                {pattern.id === "feed" && (
                  <div class="semantic-feed-demo">
                    <section aria-label="W3C Accessibility Updates" class="sem-feed-stream">
                      <article class="sem-feed-article">
                        <h4>WCAG 2.2 Recommendation</h4>
                        <time datetime="2023-10-05">Oct 5, 2023</time>
                        <p>Standardized accessible authentication, focus appearance, and dragging.</p>
                      </article>
                      <article class="sem-feed-article">
                        <h4>WCAG 3 Working Draft</h4>
                        <time datetime="2024-04-18">Apr 18, 2024</time>
                        <p>Evaluating holistic accessibility outcomes and disability equity.</p>
                      </article>
                    </section>
                    <span class="slider-hint">Clean semantic HTML without complex feed roving focus JS</span>
                  </div>
                )}

                {pattern.id === "slider-multithumb" && (
                  <div class="semantic-multislider-demo">
                    <fieldset class="sem-multirange-fieldset">
                      <legend>Budget Range ($)</legend>
                      <div class="sem-range-row">
                        <label for="sem-range-min">Min:</label>
                        <input type="range" id="sem-range-min" min="0" max="50" value="25" />
                        <output for="sem-range-min" id="sem-range-min-out">$25</output>
                      </div>
                      <div class="sem-range-row">
                        <label for="sem-range-max">Max:</label>
                        <input type="range" id="sem-range-max" min="50" max="100" value="75" />
                        <output for="sem-range-max" id="sem-range-max-out">$75</output>
                      </div>
                    </fieldset>
                    <span class="slider-hint">Paired native &lt;input type="range"&gt; controls; full form and touch support</span>
                  </div>
                )}

                {pattern.id === "treegrid" && (
                  <div class="semantic-treegrid-demo">
                    <table class="sem-data-table sem-tree-table">
                      <thead>
                        <tr>
                          <th scope="col">Name</th>
                          <th scope="col">Size</th>
                          <th scope="col">Kind</th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr class="tree-row-parent">
                          <th scope="row">📂 src/</th>
                          <td>--</td>
                          <td>Folder</td>
                        </tr>
                        <tr class="tree-row-child">
                          <td>&emsp;📄 index.astro</td>
                          <td>124 KB</td>
                          <td>Astro Template</td>
                        </tr>
                        <tr class="tree-row-child">
                          <td>&emsp;📄 patterns.ts</td>
                          <td>152 KB</td>
                          <td>TypeScript</td>
                        </tr>
                      </tbody>
                    </table>
                    <span class="slider-hint">HTML lacks native treegrid; ARIA treegrid is required for 2D roving keys</span>
                  </div>
                )}

                {pattern.id === "windowsplitter" && (
                  <div class="semantic-splitter-demo">
                    <div class="sem-resizable-container">
                      <div class="sem-resize-box">
                        <div class="pane-tag">Resizable Box (CSS resize: horizontal)</div>
                        <p class="pane-text">Drag bottom-right handle or use arrow keys if focused.</p>
                      </div>
                    </div>
                    <span class="slider-hint">Native CSS resize property requires 0 JavaScript to resize</span>
                  </div>
                )}
              </div>

              <!-- Live AT State Inspector Bar -->
              <div class="at-inspector-bar">
                <span class="at-badge">Live AT State:</span>
                <code class="at-code" id={`at-state-sem-${pattern.id}`}>Loading state...</code>
              </div>
            </div>
          </div>
        </div>

        <!-- Implementation Blueprint & Effort Breakdown -->
        <div class="blueprint-section" aria-label="Implementation requirements and effort comparison">
          <h3 class="blueprint-section-title">🛠️ Implementation Blueprint: What's Required to Make It Work</h3>
          <div class="blueprint-grid">
            <!-- ARIA Blueprint Card -->
            <div class="blueprint-card blueprint-aria">
              <div class="bp-header">
                <span class="bp-title">🟣 W3C APG ARIA Pattern</span>
                <span class={`effort-pill effort-${pattern.ariaEffort.rating.toLowerCase()}`}>
                  {pattern.ariaEffort.rating} Effort ({pattern.ariaEffort.linesOfCode})
                </span>
              </div>
              <p class="effort-summary">{pattern.ariaEffort.summary}</p>
              
              <div class="bp-block">
                <h4>Wiring &amp; Implementation Requirements:</h4>
                <ul class="bp-list">
                  {pattern.ariaRequirements.map((req) => (
                    <li>{req}</li>
                  ))}
                </ul>
              </div>

              <div class="bp-block">
                <h4>Keyboard Functionality:</h4>
                <ul class="bp-list">
                  {pattern.ariaKeyboardAndAt.keyboard.map((k) => (
                    <li>{k}</li>
                  ))}
                </ul>
              </div>

              <div class="bp-block">
                <h4>Screen Reader (AT) Announcement:</h4>
                <div class="at-speech-bubble">
                  <span class="bubble-speaker">🗣️ Screen Reader:</span>
                  <p>{pattern.ariaKeyboardAndAt.screenReader}</p>
                </div>
              </div>
            </div>

            <!-- Semantic HTML Blueprint Card -->
            <div class="blueprint-card blueprint-semantic">
              <div class="bp-header">
                <span class="bp-title">🟢 Semantic HTML Equivalent</span>
                <span class="effort-pill effort-minimal">
                  {pattern.semanticEffort.rating} ({pattern.semanticEffort.linesOfCode})
                </span>
              </div>
              <p class="effort-summary">{pattern.semanticEffort.summary}</p>

              <div class="bp-block">
                <h4>Wiring &amp; Implementation Requirements:</h4>
                <ul class="bp-list">
                  {pattern.semanticRequirements.map((req) => (
                    <li>{req}</li>
                  ))}
                </ul>
              </div>

              <div class="bp-block">
                <h4>Keyboard Functionality:</h4>
                <ul class="bp-list">
                  {pattern.semanticKeyboardAndAt.keyboard.map((k) => (
                    <li>{k}</li>
                  ))}
                </ul>
              </div>

              <div class="bp-block">
                <h4>Screen Reader (AT) Announcement:</h4>
                <div class="at-speech-bubble bubble-semantic">
                  <span class="bubble-speaker">🗣️ Screen Reader:</span>
                  <p>{pattern.semanticKeyboardAndAt.screenReader}</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Real-World Limitations of Semantic HTML -->
        <div class="limitations-banner" aria-label="Limitations of Semantic HTML">
          <div class="limitations-header">
            <span class="lim-icon" aria-hidden="true">⚠️</span>
            <h4>Real-World Limitations of Native Semantic HTML ({pattern.name}):</h4>
          </div>
          <ul class="limitations-list">
            {pattern.semanticLimitations.map((lim) => (
              <li>{lim}</li>
            ))}
          </ul>
        </div>

        <!-- Code & Visual CSS Customization Inspector Tabs -->
        <div class="inspector-section">
          <details class="inspector-details">
            <summary class="inspector-summary">
              <span class="summary-arrow" aria-hidden="true">▶</span>
              <span>🎨 Inspect CSS Customization Recipes, Code &amp; Specifications</span>
            </summary>
            
            <div class="inspector-body">
              <div class="inspector-tabs" role="tablist" aria-label={`Code and specs for ${pattern.name}`}>
                <button role="tab" aria-selected="true" class="insp-tab active" data-tab="css-recipe" id={`tab-css-${pattern.id}`}>
                  🎨 CSS Customization
                </button>
                <button role="tab" aria-selected="false" class="insp-tab" data-tab="sem-code" id={`tab-sem-${pattern.id}`}>
                  Semantic HTML5 Code
                </button>
                <button role="tab" aria-selected="false" class="insp-tab" data-tab="apg-code" id={`tab-apg-${pattern.id}`}>
                  W3C APG (ARIA) Code
                </button>
                <button role="tab" aria-selected="false" class="insp-tab" data-tab="keyboard" id={`tab-kbd-${pattern.id}`}>
                  Keyboard Support Matrix
                </button>
                <button role="tab" aria-selected="false" class="insp-tab" data-tab="compliance" id={`tab-wcag-${pattern.id}`}>
                  WCAG Mapping
                </button>
              </div>

              <!-- Tab Panel 1: CSS Customization -->
              <div class="insp-panel active" data-panel="css-recipe">
                <div class="css-recipes-grid">
                  <div class="css-recipe-col">
                    <div class="code-block-header">
                      <span>Modern CSS for Semantic HTML ({pattern.semanticElement})</span>
                      <button type="button" class="copy-code-btn" data-copy-target={`code-css-sem-${pattern.id}`}>Copy CSS</button>
                    </div>
                    <pre class="code-display" id={`code-css-sem-${pattern.id}`}><code>{pattern.cssCustomization.semanticRecipe}</code></pre>
                  </div>
                  <div class="css-recipe-col">
                    <div class="code-block-header">
                      <span>State Attribute CSS for ARIA</span>
                      <button type="button" class="copy-code-btn" data-copy-target={`code-css-aria-${pattern.id}`}>Copy CSS</button>
                    </div>
                    <pre class="code-display" id={`code-css-aria-${pattern.id}`}><code>{pattern.cssCustomization.ariaRecipe}</code></pre>
                  </div>
                </div>
                <div class="css-tips-box">
                  <strong>💡 Pro Styling Tips:</strong>
                  <ul>
                    {pattern.cssCustomization.tips.map((tip) => (
                      <li>{tip}</li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- Tab Panel 2: Semantic HTML5 Code -->
              <div class="insp-panel" data-panel="sem-code" hidden>
                <div class="code-block-header">
                  <span>Modern Semantic HTML5 Markup</span>
                  <button type="button" class="copy-code-btn" data-copy-target={`code-sem-${pattern.id}`}>Copy Code</button>
                </div>
                <pre class="code-display" id={`code-sem-${pattern.id}`}><code>{pattern.semanticCode.html}{pattern.semanticCode.js ? `\n\n// --- Optional JavaScript ---\n${pattern.semanticCode.js}` : ''}{pattern.semanticCode.notes ? `\n\n/* Note:\n${pattern.semanticCode.notes}\n*/` : ''}</code></pre>
              </div>

              <!-- Tab Panel 3: APG Code -->
              <div class="insp-panel" data-panel="apg-code" hidden>
                <div class="code-block-header">
                  <span>W3C APG ARIA Pattern Markup &amp; JavaScript</span>
                  <button type="button" class="copy-code-btn" data-copy-target={`code-apg-${pattern.id}`}>Copy Code</button>
                </div>
                <pre class="code-display" id={`code-apg-${pattern.id}`}><code>{pattern.apgCode.html}{pattern.apgCode.js ? `\n\n// --- JavaScript Implementation ---\n${pattern.apgCode.js}` : ''}</code></pre>
              </div>

              <!-- Tab Panel 4: Keyboard Support Matrix -->
              <div class="insp-panel" data-panel="keyboard" hidden>
                <table class="kbd-matrix-table">
                  <thead>
                    <tr>
                      <th scope="col">Key / Trigger</th>
                      <th scope="col">W3C APG ARIA Behavior</th>
                      <th scope="col">Semantic HTML5 Behavior</th>
                    </tr>
                  </thead>
                  <tbody>
                    {pattern.keyboardMatrix.map((k) => (
                      <tr>
                        <th scope="row"><kbd class="key-cap">{k.key}</kbd></th>
                        <td>{k.apgAction}</td>
                        <td>{k.semanticAction}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <!-- Tab Panel 5: WCAG Mapping -->
              <div class="insp-panel" data-panel="compliance" hidden>
                <div class="wcag-mapping-content">
                  <div class="mapping-group">
                    <h4>WCAG 2.2 Success Criteria:</h4>
                    <div class="criteria-badge-list">
                      {pattern.wcagCriteria.map((c) => (
                        <a href={link(`/plain-english/wcag22/#sc-${c.num.replace(/\./g, '-')}`)} class="sc-badge">
                          <span class="sc-num">{c.num}</span>
                          <span class="sc-name">{c.name}</span>
                          <span class="sc-level">Level {c.level}</span>
                        </a>
                      ))}
                    </div>
                  </div>
                  <div class="mapping-group">
                    <h4>WCAG 3.0 Outcomes:</h4>
                    <div class="outcome-tag-list">
                      {pattern.wcag3Outcomes.map((o) => (
                        <span class="outcome-tag">🎯 {o}</span>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </details>
        </div>
      </article>
    ))}
  </main>
</PlainEnglishLayout>

<style>
  /* ==========================================================================
     Patterns Explorer Styles (Cyber-Clarity Design System)
     ========================================================================== */

  [hidden] {
    display: none !important;
  }

  .dashboard-banner {
    background: linear-gradient(135deg, rgba(20, 19, 22, 0.95), rgba(28, 27, 31, 0.95));
    border-bottom: 1px solid var(--border-subtle);
    padding: 40px 24px 32px;
  }
  :root[data-theme="light"] .dashboard-banner {
    background: linear-gradient(135deg, #f8fafc, #edf2f7);
    border-bottom: 1px solid var(--border-default);
  }

  .banner-content {
    max-width: 1360px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
    flex-wrap: wrap;
  }

  .banner-title-group {
    flex: 1;
    min-width: 320px;
  }

  .banner-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: var(--accent-blue);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 6px 12px;
    border-radius: 999px;
    margin-bottom: 14px;
  }

  .banner-title-group h1 {
    font-size: 2.3rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 12px;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .banner-title-group p {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 720px;
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    min-width: 300px;
  }
  @media (min-width: 900px) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat-card {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow: var(--shadow-sm);
  }

  .stat-value {
    font-size: 1.9rem;
    font-weight: 800;
    font-family: var(--font-mono);
    line-height: 1.1;
    margin-bottom: 4px;
    color: var(--text-primary);
  }

  .stat-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .highlight-native { color: #34d399; }
  .highlight-hybrid { color: #fbbf24; }
  .highlight-aria { color: #a855f7; }

  /* First Rule of ARIA Banner */
  .first-rule-banner {
    max-width: 1360px;
    margin: 28px auto 0;
    padding: 24px;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-left: 6px solid #34d399;
    border-radius: var(--radius-lg);
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }
  .first-rule-icon {
    font-size: 2.2rem;
    line-height: 1;
    flex-shrink: 0;
  }
  .first-rule-content {
    flex: 1;
  }
  .first-rule-content h2 {
    font-size: 1.25rem;
    font-weight: 800;
    margin-bottom: 8px;
    color: var(--text-primary);
  }
  .first-rule-content blockquote {
    font-size: 1.02rem;
    font-style: italic;
    color: var(--text-primary);
    border-left: 3px solid var(--accent-blue);
    padding-left: 14px;
    margin: 8px 0 16px;
    line-height: 1.5;
  }
  .first-rule-content cite {
    display: block;
    font-size: 0.8rem;
    font-style: normal;
    color: var(--text-muted);
    margin-top: 4px;
  }
  .rule-verdict-chips {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 12px;
    margin-top: 14px;
  }
  .verdict-chip {
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    font-size: 0.82rem;
    line-height: 1.45;
    background: var(--surface-elevated);
    border: 1px solid var(--border-subtle);
  }
  .verdict-chip strong {
    display: inline-block;
    margin-right: 4px;
  }
  .chip-native { border-left: 4px solid #34d399; }
  .chip-hybrid { border-left: 4px solid #fbbf24; }
  .chip-aria { border-left: 4px solid #a855f7; }

  /* Controls Section */
  .controls-section {
    max-width: 1360px;
    margin: 24px auto 0;
    padding: 0 24px;
  }

  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: 0 16px;
    transition: var(--transition-normal);
  }
  .search-box:focus-within {
    border-color: var(--accent-blue);
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.25);
  }
  .search-icon {
    font-size: 1.1rem;
    margin-right: 12px;
    color: var(--text-muted);
  }
  .search-box input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-size: 0.95rem;
    padding: 14px 0;
    outline: none;
    font-family: inherit;
  }
  .search-box input::placeholder {
    color: var(--text-muted);
    opacity: 1;
  }
  .search-clear-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 1rem;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 4px;
  }
  .search-clear-btn:hover {
    color: var(--text-primary);
  }

  /* Filter Toolbar */
  .filter-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 16px;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    padding: 14px 20px;
    border-radius: var(--radius-md);
    align-items: center;
  }
  .filter-group {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .filter-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .filter-pills {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .filter-pill {
    background: var(--surface-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 999px;
    cursor: pointer;
    transition: var(--transition-fast);
  }
  .filter-pill:hover {
    color: var(--text-primary);
    border-color: var(--border-default);
  }
  .filter-pill.active {
    background: var(--accent-blue);
    color: var(--on-accent);
    border-color: var(--accent-blue);
  }
  .filter-pill.pill-native.active {
    background: #047857;
    border-color: #047857;
    color: #fff;
  }
  .filter-pill.pill-hybrid.active {
    background: #b45309;
    border-color: #b45309;
    color: #fff;
  }
  .filter-pill.pill-aria.active {
    background: #7c3aed;
    border-color: #7c3aed;
    color: #fff;
  }

  .results-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
    padding: 0 4px;
    font-size: 0.85rem;
    color: var(--text-muted);
    flex-wrap: wrap;
    gap: 8px;
  }
  .keyboard-hint kbd {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  /* Patterns Grid */
  .patterns-grid {
    max-width: 1360px;
    margin: 24px auto 60px;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* Individual Pattern Card */
  .pattern-card {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 28px;
    box-shadow: var(--shadow-md);
    transition: var(--transition-normal);
  }
  .pattern-card:hover {
    border-color: var(--border-default);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 18px;
    flex-wrap: wrap;
  }
  .pattern-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }
  .category-tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--surface-elevated);
    color: var(--text-muted);
    padding: 4px 10px;
    border-radius: 4px;
  }
  .verdict-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .verdict-native-preferred {
    background: rgba(52, 211, 153, 0.15);
    color: #34d399;
    border: 1px solid rgba(52, 211, 153, 0.3);
  }
  .verdict-hybrid-enhancement {
    background: rgba(251, 191, 36, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(251, 191, 36, 0.3);
  }
  .verdict-aria-required {
    background: rgba(168, 85, 247, 0.15);
    color: #c084fc;
    border: 1px solid rgba(168, 85, 247, 0.3);
  }

  .pattern-title {
    font-size: 1.7rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .pattern-title a {
    color: var(--text-primary);
    text-decoration: none;
  }
  .pattern-title a:hover {
    color: var(--accent-blue);
    text-decoration: underline;
  }

  .apg-spec-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-blue);
    text-decoration: none;
    background: var(--surface-elevated);
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }
  .apg-spec-link:hover {
    border-color: var(--accent-blue);
  }

  /* Summary & Rationale */
  .pattern-summary {
    margin: 18px 0;
  }
  .summary-text {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 12px;
  }
  .rationale-callout {
    background: var(--surface-base);
    border-left: 4px solid var(--accent-blue);
    padding: 12px 16px;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }
  .callout-label {
    display: block;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 2px;
  }

  .semantic-strip {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    font-size: 0.85rem;
  }
  .strip-label {
    font-weight: 600;
    color: var(--text-muted);
  }
  .semantic-code-badge {
    background: rgba(52, 211, 153, 0.12);
    border: 1px solid rgba(52, 211, 153, 0.3);
    color: #34d399;
    padding: 4px 10px;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
  }

  /* Sandbox Toolbar */
  .sandbox-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
    padding: 6px 12px;
    background: var(--surface-elevated);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }
  .sandbox-title {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .sandbox-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    color: var(--text-primary);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 4px;
    cursor: pointer;
    transition: var(--transition-fast);
  }
  .sandbox-toggle-btn:hover {
    border-color: var(--accent-blue);
  }

  /* Playground Split View */
  .playground-wrapper {
    margin-bottom: 24px;
    transition: filter 0.2s ease;
  }
  .playground-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 860px) {
    .playground-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .demo-pane {
    background: var(--surface-base);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
  }
  .demo-apg {
    border: 1px solid rgba(168, 85, 247, 0.3);
  }
  .demo-semantic {
    border: 1px solid rgba(52, 211, 153, 0.3);
  }

  .pane-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 16px;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface-elevated);
  }
  .pane-badge {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .badge-apg { color: #c084fc; }
  .badge-semantic { color: #34d399; }
  .pane-sub {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .pane-content {
    padding: 20px;
    min-height: 180px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  /* Raw Default Toggle Mode */
  .raw-browser-default .demo-pane {
    border: 2px dashed var(--border-default) !important;
    background: var(--surface-base) !important;
  }
  .raw-browser-default button,
  .raw-browser-default details,
  .raw-browser-default input,
  .raw-browser-default select,
  .raw-browser-default meter {
    all: revert !important;
  }

  /* AT Live Readout Bar */
  .at-inspector-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: var(--code-surface);
    border-top: 1px solid var(--border-subtle);
    font-size: 0.75rem;
    font-family: var(--font-mono);
  }
  .at-badge {
    color: var(--text-muted);
    font-weight: 700;
  }
  .at-code {
    color: var(--text-accent);
    word-break: break-all;
  }

  /* Blueprint Requirements Section */
  .blueprint-section {
    margin: 24px 0 16px;
    border-top: 1px solid var(--border-subtle);
    padding-top: 20px;
  }
  .blueprint-section-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 14px;
  }
  .blueprint-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 860px) {
    .blueprint-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .blueprint-card {
    background: var(--surface-base);
    border-radius: var(--radius-md);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .blueprint-aria {
    border-top: 4px solid #a855f7;
    border-left: 1px solid var(--border-subtle);
    border-right: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }
  .blueprint-semantic {
    border-top: 4px solid #34d399;
    border-left: 1px solid var(--border-subtle);
    border-right: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }
  .bp-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }
  .bp-title {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-primary);
  }
  .effort-pill {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 999px;
  }
  .effort-high, .effort-extreme {
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }
  .effort-medium {
    background: rgba(251, 191, 36, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(251, 191, 36, 0.3);
  }
  .effort-minimal, .effort-low {
    background: rgba(52, 211, 153, 0.15);
    color: #34d399;
    border: 1px solid rgba(52, 211, 153, 0.3);
  }
  .effort-summary {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .bp-block h4 {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    margin-bottom: 8px;
  }
  .bp-list {
    margin-left: 18px;
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .at-speech-bubble {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-left: 4px solid #a855f7;
    border-radius: var(--radius-sm);
    padding: 10px 14px;
    font-size: 0.82rem;
    color: var(--text-primary);
  }
  .bubble-semantic {
    border-left-color: #34d399;
  }
  .bubble-speaker {
    display: block;
    font-weight: 700;
    font-size: 0.72rem;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 4px;
  }

  /* Limitations Callout */
  .limitations-banner {
    margin: 16px 0 20px;
    background: rgba(251, 191, 36, 0.08);
    border: 1px solid rgba(251, 191, 36, 0.25);
    border-left: 5px solid #fbbf24;
    border-radius: var(--radius-sm);
    padding: 14px 18px;
  }
  .limitations-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }
  .lim-icon { font-size: 1.1rem; }
  .limitations-header h4 {
    font-size: 0.88rem;
    font-weight: 800;
    color: #fde68a;
  }
  :root[data-theme="light"] .limitations-header h4 {
    color: #92400e;
  }
  .limitations-list {
    margin-left: 20px;
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* Interactive Demo Widgets General */
  .demo-btn {
    background: var(--surface-elevated);
    color: var(--text-primary);
    border: 1px solid var(--border-default);
    padding: 10px 18px;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.88rem;
    cursor: pointer;
    transition: var(--transition-fast);
  }
  .demo-btn:hover {
    background: var(--surface-card-hover);
    border-color: var(--accent-blue);
  }
  .demo-btn.btn-primary {
    background: var(--accent-blue);
    color: var(--on-accent);
    border-color: var(--accent-blue);
  }
  .demo-btn.btn-success {
    background: #047857;
    color: #fff;
    border-color: #047857;
  }
  .demo-btn.btn-danger {
    background: #dc2626;
    color: #fff;
    border-color: #dc2626;
  }
  .demo-btn-sm {
    background: var(--surface-elevated);
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
  }
  .demo-btn-sm:hover {
    border-color: var(--accent-blue);
  }

  .slider-hint {
    display: block;
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-top: 10px;
  }
  .event-counter {
    margin-top: 8px;
    font-size: 0.82rem;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  /* Accordion Demo */
  .apg-accordion-widget,
  .semantic-accordion-widget {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }
  .apg-acc-btn {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    background: var(--surface-elevated);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.88rem;
    cursor: pointer;
  }
  .apg-acc-btn:hover {
    border-color: #a855f7;
  }
  .acc-arrow {
    transition: transform 0.2s ease;
    font-size: 0.75rem;
  }
  .apg-acc-btn[aria-expanded="true"] .acc-arrow {
    transform: rotate(180deg);
  }
  .apg-acc-panel {
    padding: 12px 14px;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-top: none;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    font-size: 0.85rem;
  }
  .sem-details {
    background: var(--surface-elevated);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .sem-details summary {
    padding: 10px 14px;
    font-weight: 600;
    font-size: 0.88rem;
    cursor: pointer;
    color: var(--text-primary);
    list-style: disclosure-closed;
  }
  .sem-details[open] summary {
    list-style: disclosure-open;
    border-bottom: 1px solid var(--border-subtle);
  }
  .details-body {
    padding: 12px 14px;
    background: var(--surface-card);
    font-size: 0.85rem;
  }

  /* Modal Dialog Demo */
  .apg-modal-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
  }
  .apg-modal-overlay[hidden] {
    display: none !important;
  }
  .apg-modal-window {
    background: var(--surface-card);
    border: 2px solid #a855f7;
    border-radius: var(--radius-lg);
    padding: 24px;
    max-width: 440px;
    width: 90%;
    box-shadow: var(--shadow-lg);
  }
  .semantic-modal-dialog {
    background: var(--surface-card);
    color: var(--text-primary);
    border: 2px solid #34d399;
    border-radius: var(--radius-lg);
    padding: 24px;
    max-width: 440px;
    box-shadow: var(--shadow-lg);
  }
  .semantic-modal-dialog::backdrop {
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
  }
  .modal-actions {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
    margin-top: 18px;
  }

  /* Switch Demo */
  .apg-switch-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }
  .switch-track {
    width: 44px;
    height: 24px;
    background: var(--surface-elevated);
    border: 1px solid var(--border-default);
    border-radius: 999px;
    position: relative;
    transition: background-color 0.2s ease;
  }
  .switch-thumb {
    width: 18px;
    height: 18px;
    background: #fff;
    border-radius: 50%;
    position: absolute;
    top: 2px;
    left: 2px;
    transition: transform 0.2s ease;
  }
  .apg-switch-btn[aria-checked="true"] .switch-track {
    background: #a855f7;
    border-color: #a855f7;
  }
  .apg-switch-btn[aria-checked="true"] .switch-thumb {
    transform: translateX(20px);
  }

  .sem-switch-label {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 600;
  }
  .sem-switch-input {
    width: 44px;
    height: 24px;
    appearance: none;
    -webkit-appearance: none;
    background: var(--surface-elevated);
    border: 1px solid var(--border-default);
    border-radius: 999px;
    position: relative;
    cursor: pointer;
    outline: none;
    transition: 0.2s;
  }
  .sem-switch-input::before {
    content: '';
    position: absolute;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    top: 2px;
    left: 2px;
    background: #fff;
    transition: transform 0.2s;
  }
  .sem-switch-input:checked {
    background: #047857;
    border-color: #047857;
  }
  .sem-switch-input:checked::before {
    transform: translateX(20px);
  }

  /* Slider Demo */
  .apg-slider-rail {
    position: relative;
    height: 8px;
    background: var(--surface-elevated);
    border-radius: 4px;
    margin: 18px 0;
    border: 1px solid var(--border-default);
  }
  .apg-slider-handle {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 22px;
    height: 22px;
    background: #a855f7;
    border: 2px solid #fff;
    border-radius: 50%;
    cursor: grab;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
  }
  .apg-slider-handle:focus-visible {
    outline: 3px solid var(--accent-blue);
    outline-offset: 3px;
  }
  .sem-range-input {
    width: 100%;
    margin: 16px 0;
    accent-color: #047857;
  }

  /* Meter Demo */
  .meter-info {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    font-size: 0.88rem;
  }
  .apg-meter-rail {
    height: 14px;
    background: var(--surface-elevated);
    border-radius: 999px;
    overflow: hidden;
    border: 1px solid var(--border-default);
  }
  .apg-meter-fill {
    height: 100%;
    background: linear-gradient(90deg, #38bdf8, #a855f7);
    transition: width 0.2s ease;
  }
  .sem-meter-el {
    width: 100%;
    height: 18px;
  }
  .demo-mini-actions {
    display: flex;
    gap: 8px;
    margin-top: 10px;
  }

  /* Spinbutton Demo */
  .apg-spinner-box {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    background: var(--surface-card);
    margin-top: 6px;
    overflow: hidden;
  }
  .apg-spin-display {
    padding: 8px 16px;
    font-size: 1.1rem;
    font-weight: 700;
    font-family: var(--font-mono);
    min-width: 44px;
    text-align: center;
    outline: none;
  }
  .apg-spin-display:focus-visible {
    background: rgba(168, 85, 247, 0.15);
  }
  .spinner-btns {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--border-default);
  }
  .spin-btn {
    background: var(--surface-elevated);
    border: none;
    color: var(--text-primary);
    padding: 2px 8px;
    font-size: 0.6rem;
    cursor: pointer;
  }
  .spin-btn:hover {
    background: var(--surface-card-hover);
  }
  .sem-number-input {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    color: var(--text-primary);
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 1rem;
    margin-top: 6px;
    width: 80px;
