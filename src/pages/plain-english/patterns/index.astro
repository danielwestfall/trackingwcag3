  .popover-nav a:hover,
  .btn-danger-link:hover {
    background: rgba(52, 211, 153, 0.15);
  }
  .btn-danger-link { color: #f87171; }

  /* Tooltip Demo */
  .apg-tooltip-popup {
    background: var(--surface-elevated);
    border: 1px solid var(--border-default);
    color: var(--text-primary);
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 0.78rem;
    margin-top: 8px;
    display: inline-block;
    box-shadow: var(--shadow-sm);
  }

  /* Landmarks Wireframe */
  .apg-landmarks-demo,
  .semantic-landmarks-demo {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    text-align: center;
  }
  .wireframe-box {
    padding: 8px;
