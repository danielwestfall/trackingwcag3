  .code-block-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--surface-elevated);
    padding: 8px 14px;
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    border: 1px solid var(--code-border);
    border-bottom: none;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
  }
  .copy-code-btn {
    background: transparent;
    border: 1px solid var(--border-default);
    color: var(--text-primary);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 4px;
    cursor: pointer;
  }
  .copy-code-btn:hover {
    border-color: var(--accent-blue);
  }
  .code-display {
    background: var(--code-surface);
    color: var(--code-text);
    padding: 16px;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
    border: 1px solid var(--code-border);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.5;
    overflow-x: auto;
  }

  /* Keyboard Support Matrix Table */
  .kbd-matrix-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
  }
  .kbd-matrix-table th,
  .kbd-matrix-table td {
    padding: 10px 12px;
    border: 1px solid var(--border-subtle);
    text-align: left;
  }
  .kbd-matrix-table th {
    background: var(--surface-elevated);
    font-weight: 700;
  }
  .key-cap {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
