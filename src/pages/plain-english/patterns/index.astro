        msThumbMin.style.left = `${minVal}%`;
        msThumbMin.setAttribute('aria-valuenow', String(minVal));
        msThumbMin.setAttribute('aria-valuemax', String(maxVal));
      }
      if (msThumbMax) {
        msThumbMax.style.left = `${maxVal}%`;
        msThumbMax.setAttribute('aria-valuenow', String(maxVal));
        msThumbMax.setAttribute('aria-valuemin', String(minVal));
      }
      if (msMinVal) msMinVal.textContent = String(minVal);
      if (msMaxVal) msMaxVal.textContent = String(maxVal);
      if (msFill) {
        msFill.style.left = `${minVal}%`;
        msFill.style.width = `${maxVal - minVal}%`;
      }
      updateAtState('slider-multithumb', 'apg', `role="slider" multi-thumb: $${minVal} - $${maxVal}`);
    }

    msThumbMin?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowUp') minVal = Math.min(maxVal - 5, minVal + 5);
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') minVal = Math.max(0, minVal - 5);
      else if (e.key === 'Home') minVal = 0;
      else if (e.key === 'End') minVal = maxVal - 5;
      else return;
      e.preventDefault();
      renderMultiSlider();
    });

    msThumbMax?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowUp') maxVal = Math.min(100, maxVal + 5);
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') maxVal = Math.max(minVal + 5, maxVal - 5);
      else if (e.key === 'Home') maxVal = minVal + 5;
      else if (e.key === 'End') maxVal = 100;
      else return;
      e.preventDefault();
      renderMultiSlider();
    });

    const semRangeMin = document.getElementById('sem-range-min');
    const semRangeMax = document.getElementById('sem-range-max');
    const semRangeMinOut = document.getElementById('sem-range-min-out');
    const semRangeMaxOut = document.getElementById('sem-range-max-out');

    semRangeMin?.addEventListener('input', (e) => {
      if (semRangeMinOut) semRangeMinOut.textContent = `$${e.target.value}`;
      updateAtState('slider-multithumb', 'sem', `<input type="range"> min: $${e.target.value}, max: $${semRangeMax?.value || 75}`);
    });
    semRangeMax?.addEventListener('input', (e) => {
      if (semRangeMaxOut) semRangeMaxOut.textContent = `$${e.target.value}`;
      updateAtState('slider-multithumb', 'sem', `<input type="range"> min: $${semRangeMin?.value || 25}, max: $${e.target.value}`);
    });

    // 6.20 Treegrid
    const tgWidget = document.getElementById('apg-treegrid-widget');
    const tgRows = Array.from(document.querySelectorAll('#apg-treegrid-widget .tg-row'));
    const tgToggleSrc = document.querySelector('.tg-branch .tg-toggle');
    const tgChildRows = document.querySelectorAll('.tg-child-src');

    function toggleTreegridBranch() {
      const branch = document.querySelector('.tg-branch');
      const isExpanded = branch?.getAttribute('aria-expanded') === 'true';
      branch?.setAttribute('aria-expanded', String(!isExpanded));
      if (tgToggleSrc) tgToggleSrc.textContent = isExpanded ? '▸' : '▾';
      tgChildRows.forEach((r) => r.hidden = isExpanded);
      updateAtState('treegrid', 'apg', `role="treegrid" | row "src/" ${!isExpanded ? 'expanded' : 'collapsed'}`);
    }

    tgToggleSrc?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleTreegridBranch();
    });

    tgRows.forEach((row, idx) => {
      row.addEventListener('click', () => {
        focusTgRow(idx);
      });
      row.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          const visibleRows = tgRows.filter((r) => !r.hidden);
          const curr = visibleRows.indexOf(row);
          if (curr + 1 < visibleRows.length) focusTgRow(tgRows.indexOf(visibleRows[curr + 1]));
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          const visibleRows = tgRows.filter((r) => !r.hidden);
          const curr = visibleRows.indexOf(row);
          if (curr - 1 >= 0) focusTgRow(tgRows.indexOf(visibleRows[curr - 1]));
        } else if (e.key === 'ArrowRight') {
          if (row.classList.contains('tg-branch') && row.getAttribute('aria-expanded') === 'false') {
            e.preventDefault();
            toggleTreegridBranch();
          }
        } else if (e.key === 'ArrowLeft') {
          if (row.classList.contains('tg-branch') && row.getAttribute('aria-expanded') === 'true') {
            e.preventDefault();
            toggleTreegridBranch();
          }
        }
      });
    });

    function focusTgRow(targetIdx) {
      tgRows.forEach((r, i) => r.setAttribute('tabindex', i === targetIdx ? '0' : '-1'));
      const target = tgRows[targetIdx];
      if (target) {
        target.focus();
        const name = target.querySelector('.tg-cell-name')?.textContent?.trim() || '';
        updateAtState('treegrid', 'apg', `role="treegrid" | row: "${name}"`);
      }
    }

    // 6.21 Window Splitter
    const splitHandle = document.getElementById('apg-splitter-handle');
    const paneLeft = document.getElementById('apg-pane-left');
    const paneRight = document.getElementById('apg-pane-right');
    let splitPct = 50;

    function renderSplitter() {
      if (paneLeft) paneLeft.style.width = `${splitPct}%`;
      if (paneRight) paneRight.style.width = `${100 - splitPct}%`;
      if (splitHandle) splitHandle.setAttribute('aria-valuenow', String(splitPct));
      updateAtState('windowsplitter', 'apg', `role="separator" | width: ${splitPct}% / ${100 - splitPct}%`);
    }

    splitHandle?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') splitPct = Math.max(15, splitPct - 5);
      else if (e.key === 'ArrowRight' || e.key === 'ArrowUp') splitPct = Math.min(85, splitPct + 5);
      else if (e.key === 'Home') splitPct = 15;
      else if (e.key === 'End') splitPct = 85;
      else return;
      e.preventDefault();
      renderSplitter();
    });
  });
</script>
