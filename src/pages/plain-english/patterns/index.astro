    border-bottom: 1px solid var(--border-default);
  }

  /* Breadcrumb Demo */
  .apg-breadcrumbs ol,
  .sem-breadcrumbs ol {
    display: flex;
    gap: 6px;
    list-style: none;
    font-size: 0.82rem;
    flex-wrap: wrap;
  }
  .apg-breadcrumbs li+li::before,
  .sem-breadcrumbs li+li::before {
    content: '/';
    color: var(--text-muted);
    margin-right: 6px;
  }
  .apg-breadcrumbs a,
  .sem-breadcrumbs a {
    color: var(--accent-blue);
    text-decoration: none;
  }
  .apg-breadcrumbs a[aria-current="page"],
  .sem-breadcrumbs span[aria-current="page"] {
    color: var(--text-primary);
    font-weight: 700;
  }

  /* Alert Live Region Demo */
  .live-alert-container,
  .live-status-container {
    margin-top: 10px;
    padding: 8px 12px;
