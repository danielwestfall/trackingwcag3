  }
  .apg-tabpanel {
    padding: 14px;
    font-size: 0.85rem;
    background: var(--surface-card);
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
  }
  .spec-status-alert {
    display: flex;
    gap: 12px;
    background: rgba(251, 191, 36, 0.12);
    border: 1px solid rgba(251, 191, 36, 0.3);
    padding: 12px;
    border-radius: var(--radius-sm);
    font-size: 0.82rem;
  }

  /* Table Demo */
  .apg-aria-table,
  .sem-data-table {
    width: 100%;
    font-size: 0.82rem;
    border-collapse: collapse;
  }
  .table-row,
  .sem-data-table tr {
    display: flex;
    border-bottom: 1px solid var(--border-subtle);
  }
  .sem-data-table {
    display: table;
  }
  .sem-data-table tr {
