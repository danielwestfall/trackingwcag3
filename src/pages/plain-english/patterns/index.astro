                    <span class="slider-hint">CSS Scroll Snap: touch swipe + keyboard arrow scrolling</span>
                  </div>
                )}

                {pattern.id === "alert" && (
                  <div class="semantic-alert-demo">
                    <button type="button" class="demo-btn btn-success" id="btn-trigger-sem-output">
                      Update Semantic &lt;output&gt;
                    </button>
                    <output id="sem-output-box" class="live-status-container" for="btn-trigger-sem-output">
                      Status: Idle
                    </output>
                    <span class="slider-hint">&lt;output&gt; maps natively to role="status" &amp; aria-live="polite"</span>
                  </div>
                )}

                {pattern.id === "toolbar" && (
                  <div class="semantic-toolbar-demo">
                    <fieldset class="sem-toolbar-fieldset">
                      <legend class="sr-only">Editor Tools</legend>
