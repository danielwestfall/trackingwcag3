<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Filtering & Search
    const searchInput = document.getElementById('pattern-search');
    const searchClear = document.getElementById('search-clear-btn');
    const categoryPills = document.querySelectorAll('#category-pills .filter-pill');
    const verdictPills = document.querySelectorAll('#verdict-pills .filter-pill');
    const cards = document.querySelectorAll('.pattern-card');
    const visibleCountEl = document.getElementById('visible-count');

    let currentCategory = 'All';
    let currentVerdict = 'all';
    let searchQuery = '';

    function filterCards() {
      let count = 0;
      cards.forEach((card) => {
        const name = card.getAttribute('data-name') || '';
        const category = card.getAttribute('data-category') || '';
        const verdict = card.getAttribute('data-verdict') || '';
        const semantic = card.getAttribute('data-semantic') || '';

        const matchesCat = currentCategory === 'All' || category === currentCategory;
        const matchesVerdict = currentVerdict === 'all' || verdict === currentVerdict;
        const matchesSearch = !searchQuery || name.includes(searchQuery) || semantic.includes(searchQuery) || category.toLowerCase().includes(searchQuery);

        if (matchesCat && matchesVerdict && matchesSearch) {
          card.style.display = '';
          count++;
        } else {
          card.style.display = 'none';
        }
      });
      if (visibleCountEl) visibleCountEl.textContent = String(count);
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.trim().toLowerCase();
        if (searchClear) searchClear.hidden = !searchQuery;
        filterCards();
      });
    }

    if (searchClear) {
      searchClear.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        searchClear.hidden = true;
        filterCards();
      });
    }

    categoryPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        categoryPills.forEach((p) => {
          p.classList.remove('active');
          p.setAttribute('aria-checked', 'false');
        });
        pill.classList.add('active');
        pill.setAttribute('aria-checked', 'true');
        currentCategory = pill.getAttribute('data-category') || 'All';
        filterCards();
      });
    });

    verdictPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        verdictPills.forEach((p) => {
          p.classList.remove('active');
          p.setAttribute('aria-checked', 'false');
        });
        pill.classList.add('active');
        pill.setAttribute('aria-checked', 'true');
        currentVerdict = pill.getAttribute('data-verdict') || 'all';
        filterCards();
      });
    });

    // Keyboard shortcut '/' to focus search
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '')) {
        e.preventDefault();
        if (searchInput) {
          searchInput.focus();
          searchInput.select();
        }
      }
    });

    // 2. Sandbox Visual Mode Toggle (Styled vs Raw Browser Default)
    document.querySelectorAll('.sandbox-toggle-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target-pane');
        const pane = targetId ? document.getElementById(targetId) : null;
        if (pane) {
          pane.classList.toggle('raw-browser-default');
          const isRaw = pane.classList.contains('raw-browser-default');
          const textEl = btn.querySelector('.toggle-text');
          if (textEl) {
            textEl.textContent = isRaw ? 'Restore Custom Styled UI' : 'Toggle Styled vs Raw Default';
          }
        }
      });
    });

    // 3. Live AT State Readout Updates
    function updateAtState(patternId, role, stateText) {
      const el = document.getElementById(`at-state-${role}-${patternId}`);
      if (el) el.textContent = stateText;
    }

    // Initialize initial state readouts for cards
    document.querySelectorAll('.pattern-card').forEach((card) => {
      const id = card.getAttribute('data-id');
      if (!id) return;

      if (id === 'accordion') {
        updateAtState('accordion', 'apg', 'button: "Personal Details" | aria-expanded: "true" | region: visible');
        updateAtState('accordion', 'sem', '<details name="demo-semantic-acc" open> | state: expanded');
      } else if (id === 'dialog-modal') {
        updateAtState('dialog-modal', 'apg', 'role="dialog" | aria-modal="true" | hidden: true');
        updateAtState('dialog-modal', 'sem', '<dialog> closed | ready for showModal()');
      } else if (id === 'switch') {
        updateAtState('switch', 'apg', 'role="switch" | aria-checked="false"');
        updateAtState('switch', 'sem', '<input type="checkbox" role="switch"> | checked: false');
      } else if (id === 'slider') {
        updateAtState('slider', 'apg', 'role="slider" | aria-valuenow="50" | min: 0, max: 100');
        updateAtState('slider', 'sem', '<input type="range"> | value: 50 | min: 0, max: 100');
      } else if (id === 'meter') {
        updateAtState('meter', 'apg', 'role="meter" | aria-valuenow="72"');
        updateAtState('meter', 'sem', '<meter value="72" optimum="25"> (high status)');
      } else if (id === 'spinbutton') {
        updateAtState('spinbutton', 'apg', 'role="spinbutton" | aria-valuenow="3"');
        updateAtState('spinbutton', 'sem', '<input type="number" value="3">');
      } else if (id === 'radio') {
        updateAtState('radio', 'apg', 'role="radio" (1 of 3) | aria-checked="true"');
        updateAtState('radio', 'sem', '<input type="radio" checked> in <fieldset>');
      } else if (id === 'checkbox') {
        updateAtState('checkbox', 'apg', 'role="checkbox" | aria-checked="mixed"');
        updateAtState('checkbox', 'sem', '<input type="checkbox"> | indeterminate: true');
      } else if (id === 'button') {
        updateAtState('button', 'apg', '<div role="button" tabindex="0"> | clicks: 0');
        updateAtState('button', 'sem', '<button type="button"> | native click handler');
      } else if (id === 'link') {
        updateAtState('link', 'apg', '<span role="link" tabindex="0">');
        updateAtState('link', 'sem', '<a href="..."> (native link role & context menu)');
      } else if (id === 'breadcrumb') {
        updateAtState('breadcrumb', 'apg', '<nav aria-label="APG Breadcrumbs"> | aria-current="page"');
        updateAtState('breadcrumb', 'sem', '<nav aria-label="Semantic Breadcrumbs"> | <span aria-current="page">');
      } else if (id === 'combobox') {
        updateAtState('combobox', 'apg', 'role="combobox" | aria-expanded="false" | listbox hidden');
        updateAtState('combobox', 'sem', '<input list="framework-list"> + <datalist>');
      } else if (id === 'menu-button') {
        updateAtState('menu-button', 'apg', 'button aria-haspopup="menu" | aria-expanded="false"');
        updateAtState('menu-button', 'sem', 'button popovertarget | <div popover>');
      } else if (id === 'tooltip') {
        updateAtState('tooltip', 'apg', 'button aria-describedby="apg-tt-box" | tooltip hidden');
        updateAtState('tooltip', 'sem', 'button title="..." (native OS tooltip)');
      } else if (id === 'tabs') {
        updateAtState('tabs', 'apg', 'role="tablist" | active tab: "Automated" (1 of 3)');
        updateAtState('tabs', 'sem', 'Spec Notice: No native <tabs> element exists');
      } else if (id === 'table') {
        updateAtState('table', 'apg', '<div role="table"> | role="row" | role="cell"');
        updateAtState('table', 'sem', '<table> with <thead>, <tbody>, <th scope="col">');
      } else if (id === 'alert') {
        updateAtState('alert', 'apg', 'role="alert" (aria-live="assertive") | ready');
        updateAtState('alert', 'sem', '<output> (native role="status", aria-live="polite")');
      } else if (id === 'toolbar') {
        updateAtState('toolbar', 'apg', 'role="toolbar" | single Tab stop, roving arrows');
        updateAtState('toolbar', 'sem', '<fieldset> with individual Tab stops');
      } else if (id === 'grid') {
        updateAtState('grid', 'apg', 'role="grid" | active: ISS-101 (Row 1, Col 1)');
        updateAtState('grid', 'sem', '<table> with native <th>, <td> and <input>');
      } else if (id === 'listbox') {
        updateAtState('listbox', 'apg', 'role="listbox" | selected: "WCAG 2.1 Level AA"');
        updateAtState('listbox', 'sem', '<select size="4"> | selected: "WCAG 2.1 Level AA"');
      } else if (id === 'menubar') {
        updateAtState('menubar', 'apg', 'role="menubar" | active: File ▾ (closed)');
        updateAtState('menubar', 'sem', '<nav aria-label="Main Site Navigation"> with <a> links');
      } else if (id === 'alertdialog') {
        updateAtState('alertdialog', 'apg', 'role="alertdialog" | closed');
        updateAtState('alertdialog', 'sem', '<dialog> closed | ready for showModal()');
      } else if (id === 'feed') {
        updateAtState('feed', 'apg', 'role="feed" | active article 1 of 2');
        updateAtState('feed', 'sem', '<section> with <article> items (native semantic stream)');
      } else if (id === 'slider-multithumb') {
        updateAtState('slider-multithumb', 'apg', 'role="slider" (multi-thumb) | min: $25, max: $75');
        updateAtState('slider-multithumb', 'sem', '<input type="range"> (dual) | min: $25, max: $75');
      } else if (id === 'treegrid') {
        updateAtState('treegrid', 'apg', 'role="treegrid" | active row: "src/" (level 1, expanded)');
        updateAtState('treegrid', 'sem', '<table> with hierarchical indentation | No native treegrid element');
      } else if (id === 'windowsplitter') {
        updateAtState('windowsplitter', 'apg', 'role="separator" | aria-valuenow="50%"');
        updateAtState('windowsplitter', 'sem', 'CSS resize: horizontal | native browser dragging');
      }
    });

    // 4. Inspector Tabs Switching
    document.querySelectorAll('.inspector-tabs').forEach((tablist) => {
      const tabs = tablist.querySelectorAll('.insp-tab');
      const container = tablist.closest('.inspector-body');
      if (!container) return;
      const panels = container.querySelectorAll('.insp-panel');

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          tabs.forEach((t) => {
            t.classList.remove('active');
            t.setAttribute('aria-selected', 'false');
          });
          panels.forEach((p) => {
            p.classList.remove('active');
            p.hidden = true;
          });

          tab.classList.add('active');
          tab.setAttribute('aria-selected', 'true');
          const target = tab.getAttribute('data-tab');
          const panel = container.querySelector(`[data-panel="${target}"]`);
          if (panel) {
            panel.classList.add('active');
            panel.hidden = false;
          }
        });
      });
    });

    // 5. One-Click Copy Code
    document.querySelectorAll('.copy-code-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const targetId = btn.getAttribute('data-copy-target');
        const codeEl = targetId ? document.getElementById(targetId) : null;
        if (codeEl) {
          await navigator.clipboard.writeText(codeEl.textContent || '');
          const orig = btn.textContent;
          btn.textContent = 'Copied! ✓';
          setTimeout(() => { btn.textContent = orig; }, 1800);
        }
      });
    });

    // 6. Interactive APG & Semantic Live Demos Handlers
    // 6.1 Accordion Demo
    const apgAccBtns = document.querySelectorAll('.apg-acc-btn');
    apgAccBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
