  /* Inspector Tabs Section */
  .inspector-section {
    margin-top: 20px;
    border-top: 1px solid var(--border-subtle);
    padding-top: 14px;
  }
  .inspector-summary {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    user-select: none;
  }
  .inspector-summary:hover {
    color: var(--text-primary);
  }
  .summary-arrow {
    font-size: 0.7rem;
    transition: transform 0.2s;
  }
  .inspector-details[open] .summary-arrow {
    transform: rotate(90deg);
  }
  .inspector-body {
    margin-top: 14px;
  }

  .inspector-tabs {
    display: flex;
    gap: 4px;
    border-bottom: 1px solid var(--border-default);
    flex-wrap: wrap;
  }
  .insp-tab {
    background: transparent;
