    grid-template-columns: 1fr 2fr;
    gap: 4px;
  }

  /* Tabs Demo */
  .apg-tablist {
    display: flex;
    border-bottom: 1px solid var(--border-default);
  }
  .apg-tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.85rem;
    padding: 8px 14px;
    cursor: pointer;
