        const isMatch = i === targetIdx;
        opt.setAttribute('aria-selected', String(isMatch));
        opt.classList.toggle('selected', isMatch);
      });
      const selectedName = apgOptions[targetIdx]?.querySelector('span:last-child')?.textContent || '';
      updateAtState('listbox', 'apg', `role="listbox" | selected: "${selectedName}"`);
    }

    apgOptions.forEach((opt, idx) => {
      opt.addEventListener('click', () => {
        selectListboxOption(idx);
        apgListbox?.focus();
      });
    });

    apgListbox?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectListboxOption((activeLbIdx + 1) % apgOptions.length);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectListboxOption((activeLbIdx - 1 + apgOptions.length) % apgOptions.length);
      } else if (e.key === 'Home') {
        e.preventDefault();
        selectListboxOption(0);
      } else if (e.key === 'End') {
        e.preventDefault();
        selectListboxOption(apgOptions.length - 1);
      }
    });

    const semSelect = document.getElementById('sem-native-select');
    semSelect?.addEventListener('change', () => {
      const selectedText = semSelect.options[semSelect.selectedIndex]?.text || '';
      updateAtState('listbox', 'sem', `<select size="4"> | selected: "${selectedText}"`);
    });

    // 6.16 Menubar (with Roving Tabindex)
    const menubarItems = Array.from(document.querySelectorAll('#apg-menubar-widget .apg-menubar-item'));
    function focusMenubarItem(targetIdx) {
      menubarItems.forEach((b, i) => b.setAttribute('tabindex', i === targetIdx ? '0' : '-1'));
      menubarItems[targetIdx]?.focus();
    }
    menubarItems.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        menubarItems.forEach((b, i) => b.setAttribute('tabindex', i === idx ? '0' : '-1'));
        toggleMenubarDropdown(btn);
      });
      btn.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          const next = (idx + 1) % menubarItems.length;
          focusMenubarItem(next);
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          const prev = (idx - 1 + menubarItems.length) % menubarItems.length;
          focusMenubarItem(prev);
        } else if (e.key === 'ArrowDown' || e.key === 'Enter') {
          e.preventDefault();
          openMenubarDropdown(btn);
        }
      });
    });

    function toggleMenubarDropdown(btn) {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) closeAllMenubars();
      else openMenubarDropdown(btn);
    }

    function openMenubarDropdown(btn) {
      closeAllMenubars();
      const wrap = btn.closest('.menubar-item-wrap');
      const dropdown = wrap?.querySelector('.apg-menubar-dropdown');
      if (dropdown) {
        btn.setAttribute('aria-expanded', 'true');
        dropdown.hidden = false;
        const firstItem = dropdown.querySelector('[role="menuitem"]');
        firstItem?.focus();
        updateAtState('menubar', 'apg', `role="menubar" | ${btn.textContent?.trim()} open`);
      }
    }

    function closeAllMenubars() {
      document.querySelectorAll('#apg-menubar-widget .apg-menubar-item').forEach((b) => b.setAttribute('aria-expanded', 'false'));
      document.querySelectorAll('#apg-menubar-widget .apg-menubar-dropdown').forEach((d) => d.hidden = true);
    }

    document.querySelectorAll('#apg-menubar-widget .apg-menubar-dropdown').forEach((dropdown) => {
      const items = Array.from(dropdown.querySelectorAll('li[role="menuitem"]'));
      items.forEach((item, idx) => {
        item.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            e.preventDefault();
            const wrap = item.closest('.menubar-item-wrap');
            const btn = wrap?.querySelector('.apg-menubar-item');
            closeAllMenubars();
            btn?.focus();
            updateAtState('menubar', 'apg', 'role="menubar" | dropdown closed');
          } else if (e.key === 'ArrowDown') {
            e.preventDefault();
            items[(idx + 1) % items.length]?.focus();
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            items[(idx - 1 + items.length) % items.length]?.focus();
          }
        });
        item.addEventListener('click', () => {
          closeAllMenubars();
          updateAtState('menubar', 'apg', `role="menubar" | executed: "${item.textContent?.trim()}"`);
        });
      });
    });

    // 6.17 Alert Dialog
    const btnOpenApgAdlg = document.getElementById('btn-open-apg-alertdialog');
    const apgAdlgOverlay = document.getElementById('apg-alertdialog-overlay');
    const apgAdlgCancel = document.getElementById('apg-adlg-cancel');
    const apgAdlgDiscard = document.getElementById('apg-adlg-discard');

    if (btnOpenApgAdlg && apgAdlgOverlay) {
      btnOpenApgAdlg.addEventListener('click', () => {
        apgAdlgOverlay.hidden = false;
        apgAdlgCancel?.focus();
        updateAtState('alertdialog', 'apg', 'role="alertdialog" OPEN | focus on Cancel (safe default)');
      });
      const closeAdlg = () => {
        apgAdlgOverlay.hidden = true;
        btnOpenApgAdlg.focus();
        updateAtState('alertdialog', 'apg', 'role="alertdialog" closed | focus restored');
      };
      apgAdlgCancel?.addEventListener('click', closeAdlg);
      apgAdlgDiscard?.addEventListener('click', closeAdlg);
      document.addEventListener('keydown', (e) => {
        if (apgAdlgOverlay.hidden) return;
        if (e.key === 'Escape') {
          e.preventDefault();
          closeAdlg();
        } else if (e.key === 'Tab') {
          const focusable = Array.from(apgAdlgOverlay.querySelectorAll('button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'));
          if (focusable.length > 0) {
            const first = focusable[0];
            const last = focusable[focusable.length - 1];
            if (e.shiftKey && document.activeElement === first) {
              e.preventDefault();
              last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
              e.preventDefault();
              first.focus();
            } else if (!apgAdlgOverlay.contains(document.activeElement)) {
              e.preventDefault();
              first.focus();
            }
          }
        }
      });
    }

    const btnOpenSemAdlg = document.getElementById('btn-open-sem-alertdialog');
    const semAdlg = document.getElementById('native-alertdialog-el');
    if (btnOpenSemAdlg && semAdlg && typeof semAdlg.showModal === 'function') {
      btnOpenSemAdlg.addEventListener('click', () => {
        semAdlg.showModal();
        const cancelBtn = document.getElementById('sem-adlg-cancel');
        cancelBtn?.focus();
        updateAtState('alertdialog', 'sem', '<dialog>.showModal() | autofocus on Cancel');
      });
      semAdlg.addEventListener('close', () => {
        btnOpenSemAdlg.focus();
        updateAtState('alertdialog', 'sem', `<dialog> closed | action: "${semAdlg.returnValue}"`);
      });
      semAdlg.addEventListener('keydown', (e) => {
        if (e.key === 'Tab') {
          const btns = Array.from(semAdlg.querySelectorAll('button'));
          if (btns.length > 0) {
            const first = btns[0];
            const last = btns[btns.length - 1];
            if (e.shiftKey && document.activeElement === first) {
              e.preventDefault();
              last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          }
        }
      });
    }

    // 6.18 Feed
    const feedWidget = document.getElementById('apg-feed-widget');
    const btnFeedAdd = document.getElementById('btn-feed-add');
    let feedCount = 2;

    feedWidget?.addEventListener('keydown', (e) => {
      const articles = Array.from(feedWidget.querySelectorAll('.feed-article'));
      const activeIdx = articles.indexOf(document.activeElement);
      if (activeIdx === -1) return;

      if (e.key === 'PageDown' || e.key === 'ArrowDown') {
        if (activeIdx + 1 < articles.length) {
          e.preventDefault();
          articles.forEach((a, i) => a.setAttribute('tabindex', i === activeIdx + 1 ? '0' : '-1'));
          articles[activeIdx + 1]?.focus();
          updateAtState('feed', 'apg', `role="feed" | focused article ${activeIdx + 2} of ${articles.length}`);
        }
      } else if (e.key === 'PageUp' || e.key === 'ArrowUp') {
        if (activeIdx - 1 >= 0) {
          e.preventDefault();
          articles.forEach((a, i) => a.setAttribute('tabindex', i === activeIdx - 1 ? '0' : '-1'));
          articles[activeIdx - 1]?.focus();
          updateAtState('feed', 'apg', `role="feed" | focused article ${activeIdx} of ${articles.length}`);
        }
      }
    });

    btnFeedAdd?.addEventListener('click', () => {
      feedCount++;
      const newArticle = document.createElement('article');
      newArticle.setAttribute('role', 'article');
      newArticle.setAttribute('tabindex', '-1');
      newArticle.setAttribute('aria-posinset', String(feedCount));
      newArticle.setAttribute('aria-setsize', String(feedCount));
      newArticle.className = 'feed-article';
      newArticle.innerHTML = `<h3>W3C Advisory Board Update #${feedCount}</h3><time datetime="${new Date().toISOString().slice(0,10)}">Just now</time><p>Dynamic conformance guidelines updated with live testing feed.</p>`;
      feedWidget?.appendChild(newArticle);
      updateAtState('feed', 'apg', `role="feed" | article #${feedCount} appended dynamically`);
    });

    // 6.19 Slider Multi-Thumb
    const msThumbMin = document.getElementById('apg-ms-thumb-min');
    const msThumbMax = document.getElementById('apg-ms-thumb-max');
    const msMinVal = document.getElementById('apg-ms-min-val');
    const msMaxVal = document.getElementById('apg-ms-max-val');
    const msFill = document.getElementById('apg-multi-fill');

    let minVal = 25;
    let maxVal = 75;

    function renderMultiSlider() {
      if (msThumbMin) {
        msThumbMin.style.left = `${minVal}%`;
        msThumbMin.setAttribute('aria-valuenow', String(minVal));
        msThumbMin.setAttribute('aria-valuemax', String(maxVal));
      }
      if (msThumbMax) {
        msThumbMax.style.left = `${maxVal}%`;
        msThumbMax.setAttribute('aria-valuenow', String(maxVal));
        msThumbMax.setAttribute('aria-valuemin', String(minVal));
      }
      if (msMinVal) msMinVal.textContent = String(minVal);
      if (msMaxVal) msMaxVal.textContent = String(maxVal);
      if (msFill) {
        msFill.style.left = `${minVal}%`;
        msFill.style.width = `${maxVal - minVal}%`;
      }
      updateAtState('slider-multithumb', 'apg', `role="slider" multi-thumb: $${minVal} - $${maxVal}`);
    }

    msThumbMin?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowUp') minVal = Math.min(maxVal - 5, minVal + 5);
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') minVal = Math.max(0, minVal - 5);
      else if (e.key === 'Home') minVal = 0;
      else if (e.key === 'End') minVal = maxVal - 5;
      else return;
      e.preventDefault();
      renderMultiSlider();
    });

    msThumbMax?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowUp') maxVal = Math.min(100, maxVal + 5);
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') maxVal = Math.max(minVal + 5, maxVal - 5);
      else if (e.key === 'Home') maxVal = minVal + 5;
      else if (e.key === 'End') maxVal = 100;
      else return;
      e.preventDefault();
      renderMultiSlider();
    });

    const semRangeMin = document.getElementById('sem-range-min');
    const semRangeMax = document.getElementById('sem-range-max');
    const semRangeMinOut = document.getElementById('sem-range-min-out');
    const semRangeMaxOut = document.getElementById('sem-range-max-out');

    semRangeMin?.addEventListener('input', (e) => {
      if (semRangeMinOut) semRangeMinOut.textContent = `$${e.target.value}`;
      updateAtState('slider-multithumb', 'sem', `<input type="range"> min: $${e.target.value}, max: $${semRangeMax?.value || 75}`);
    });
    semRangeMax?.addEventListener('input', (e) => {
      if (semRangeMaxOut) semRangeMaxOut.textContent = `$${e.target.value}`;
      updateAtState('slider-multithumb', 'sem', `<input type="range"> min: $${semRangeMin?.value || 25}, max: $${e.target.value}`);
    });

    // 6.20 Treegrid
    const tgWidget = document.getElementById('apg-treegrid-widget');
    const tgRows = Array.from(document.querySelectorAll('#apg-treegrid-widget .tg-row'));
    const tgToggleSrc = document.querySelector('.tg-branch .tg-toggle');
    const tgChildRows = document.querySelectorAll('.tg-child-src');

    function toggleTreegridBranch() {
      const branch = document.querySelector('.tg-branch');
      const isExpanded = branch?.getAttribute('aria-expanded') === 'true';
      branch?.setAttribute('aria-expanded', String(!isExpanded));
      if (tgToggleSrc) tgToggleSrc.textContent = isExpanded ? '▸' : '▾';
      tgChildRows.forEach((r) => r.hidden = isExpanded);
      updateAtState('treegrid', 'apg', `role="treegrid" | row "src/" ${!isExpanded ? 'expanded' : 'collapsed'}`);
    }

    tgToggleSrc?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleTreegridBranch();
    });

    tgRows.forEach((row, idx) => {
      row.addEventListener('click', () => {
        focusTgRow(idx);
      });
      row.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          const visibleRows = tgRows.filter((r) => !r.hidden);
          const curr = visibleRows.indexOf(row);
          if (curr + 1 < visibleRows.length) focusTgRow(tgRows.indexOf(visibleRows[curr + 1]));
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          const visibleRows = tgRows.filter((r) => !r.hidden);
          const curr = visibleRows.indexOf(row);
          if (curr - 1 >= 0) focusTgRow(tgRows.indexOf(visibleRows[curr - 1]));
        } else if (e.key === 'ArrowRight') {
          if (row.classList.contains('tg-branch') && row.getAttribute('aria-expanded') === 'false') {
            e.preventDefault();
            toggleTreegridBranch();
          }
        } else if (e.key === 'ArrowLeft') {
          if (row.classList.contains('tg-branch') && row.getAttribute('aria-expanded') === 'true') {
            e.preventDefault();
            toggleTreegridBranch();
          }
        }
      });
    });

    function focusTgRow(targetIdx) {
      tgRows.forEach((r, i) => r.setAttribute('tabindex', i === targetIdx ? '0' : '-1'));
      const target = tgRows[targetIdx];
      if (target) {
        target.focus();
        const name = target.querySelector('.tg-cell-name')?.textContent?.trim() || '';
        updateAtState('treegrid', 'apg', `role="treegrid" | row: "${name}"`);
      }
    }

    // 6.21 Window Splitter
    const splitHandle = document.getElementById('apg-splitter-handle');
    const paneLeft = document.getElementById('apg-pane-left');
    const paneRight = document.getElementById('apg-pane-right');
    let splitPct = 50;

    function renderSplitter() {
      if (paneLeft) paneLeft.style.width = `${splitPct}%`;
      if (paneRight) paneRight.style.width = `${100 - splitPct}%`;
      if (splitHandle) splitHandle.setAttribute('aria-valuenow', String(splitPct));
      updateAtState('windowsplitter', 'apg', `role="separator" | width: ${splitPct}% / ${100 - splitPct}%`);
    }

    splitHandle?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') splitPct = Math.max(15, splitPct - 5);
      else if (e.key === 'ArrowRight' || e.key === 'ArrowUp') splitPct = Math.min(85, splitPct + 5);
      else if (e.key === 'Home') splitPct = 15;
      else if (e.key === 'End') splitPct = 85;
      else return;
      e.preventDefault();
      renderSplitter();
    });
  });
</script>
