                        <tr>
                          <th scope="col">ID</th>
                          <th scope="col">Criterion</th>
                          <th scope="col">Severity</th>
                          <th scope="col">Status</th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr>
                          <th scope="row">ISS-101</th>
                          <td>1.4.3 Contrast</td>
                          <td><span class="sem-badge sem-badge-high">High</span></td>
                          <td><input type="text" value="Open" aria-label="Status for ISS-101" class="sem-cell-input" /></td>
                        </tr>
                        <tr>
                          <th scope="row">ISS-102</th>
                          <td>2.1.1 Keyboard</td>
                          <td><span class="sem-badge sem-badge-crit">Critical</span></td>
                          <td><input type="text" value="In Review" aria-label="Status for ISS-102" class="sem-cell-input" /></td>
                        </tr>
                      </tbody>
                    </table>
                    <span class="slider-hint">Standard Tab jumps between inputs; screen readers use native table keys</span>
                  </div>
                )}

                {pattern.id === "listbox" && (
                  <div class="semantic-listbox-demo">
                    <label for="sem-native-select">WCAG Conformance Target:</label>
                    <select id="sem-native-select" size="4" class="sem-native-listbox">
                      <option value="2.1-aa" selected>WCAG 2.1 Level AA</option>
                      <option value="2.2-aa">WCAG 2.2 Level AA (Current Standard)</option>
                      <option value="2.2-aaa">WCAG 2.2 Level AAA</option>
                      <option value="3.0-bronze">WCAG 3.0 Bronze Draft</option>
                    </select>
                    <span class="slider-hint">Native &lt;select size="4"&gt; provides zero-JS listbox with typeahead</span>
                  </div>
                )}

                {pattern.id === "menubar" && (
                  <div class="semantic-menubar-demo">
                    <nav aria-label="Main Site Navigation" class="sem-nav-bar">
                      <ul class="sem-nav-list">
                        <li class="sem-nav-item">
                          <a href="#pattern-menubar" class="sem-nav-link" aria-current="page">Dashboard</a>
                        </li>
                        <li class="sem-nav-item">
                          <a href="#pattern-menubar" class="sem-nav-link">Reports</a>
                        </li>
                        <li class="sem-nav-item">
                          <a href="#pattern-menubar" class="sem-nav-link">Settings</a>
                        </li>
                        <li class="sem-nav-item">
                          <a href="#pattern-menubar" class="sem-nav-link">Docs</a>
                        </li>
                      </ul>
                    </nav>
                    <span class="slider-hint">W3C APG advice: Websites should use &lt;nav&gt; + links, not ARIA menubar</span>
                  </div>
                )}

                {pattern.id === "alertdialog" && (
                  <div class="semantic-alertdialog-demo">
                    <button type="button" class="demo-btn btn-success" id="btn-open-sem-alertdialog">
                      Open Native &lt;dialog&gt; Alert Prompt
                    </button>
                    <dialog id="native-alertdialog-el" class="semantic-modal-dialog">
                      <form method="dialog" class="dialog-form">
                        <div class="adlg-header">
                          <span class="adlg-icon" aria-hidden="true">⚠️</span>
                          <h3>Discard Unsaved Changes? (Native)</h3>
                        </div>
