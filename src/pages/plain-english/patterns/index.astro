    border: 1px solid var(--border-default);
    padding: 24px;
    border-radius: var(--radius-sm);
    text-align: center;
    font-weight: 600;
    font-size: 0.9rem;
  }

  /* Toolbar Demo */
  .apg-toolbar-widget,
  .sem-toolbar-fieldset {
    display: inline-flex;
    gap: 4px;
    background: var(--surface-elevated);
    padding: 4px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-default);
  }
  .apg-toolbar-widget button,
  .sem-toolbar-fieldset button {
    background: transparent;
    border: none;
    color: var(--text-primary);
    padding: 6px 12px;
    border-radius: 4px;
    cursor: pointer;
  }
  .apg-toolbar-widget button:focus,
  .sem-toolbar-fieldset button:focus {
    background: rgba(168, 85, 247, 0.25);
    outline: 2px solid var(--accent-blue);
  }

  /* Grid Demo */
  .apg-data-grid {
    width: 100%;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--surface-card);
