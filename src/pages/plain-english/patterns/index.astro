          if ((idx + 1) % colsCount !== 0) targetIdx = idx + 1;
        } else if (e.key === 'ArrowLeft') {
          if (idx % colsCount !== 0) targetIdx = idx - 1;
        } else if (e.key === 'ArrowDown') {
          if (idx + colsCount < apgGridCells.length) targetIdx = idx + colsCount;
        } else if (e.key === 'ArrowUp') {
