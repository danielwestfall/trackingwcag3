  .sem-native-listbox {
    width: 100%;
    margin-top: 8px;
    padding: 6px;
    font-size: 0.85rem;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
  }

  /* Menubar Demo */
  .apg-menubar-widget {
    display: flex;
    gap: 6px;
    background: var(--surface-elevated);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
