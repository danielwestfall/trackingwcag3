  /* Radio Group Demo */
  .apg-radiogroup {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .apg-radio-opt {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-size: 0.88rem;
  }
  .apg-radio-opt:hover {
    background: var(--surface-elevated);
  }
  .apg-radio-opt:focus-visible {
    outline: 2px solid #a855f7;
  }
  .radio-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid var(--border-default);
    position: relative;
  }
  .apg-radio-opt[aria-checked="true"] .radio-dot {
    border-color: #a855f7;
  }
  .apg-radio-opt[aria-checked="true"] .radio-dot::after {
    content: '';
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    background: #a855f7;
  }
  .sem-fieldset {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .sem-fieldset legend {
    padding: 0 6px;
    font-weight: 600;
    font-size: 0.85rem;
  }
  .sem-radio-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    cursor: pointer;
  }

  /* Tri-State Checkbox Demo */
  .apg-check-item {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    font-size: 0.9rem;
    padding: 6px;
  }
  .custom-chk-box {
    width: 18px;
    height: 18px;
    border: 2px solid #a855f7;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.85rem;
    color: #fff;
    background: var(--surface-elevated);
  }
  .apg-check-item[aria-checked="true"] .custom-chk-box {
    background: #7c3aed;
  }
  .apg-check-item[aria-checked="true"] .check-icon::before {
    content: '✓';
  }
  .apg-check-item[aria-checked="mixed"] .custom-chk-box {
    background: #7c3aed;
  }
  .sem-check-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    cursor: pointer;
    margin-bottom: 8px;
  }

  /* Combobox Demo */
  .apg-combobox-wrap {
    position: relative;
    margin-top: 6px;
  }
  .apg-combobox-wrap input {
    width: 100%;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    color: var(--text-primary);
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    font-size: 0.88rem;
  }
  .apg-cb-list {
    position: absolute;
    top: 100%;
    left: 0; right: 0;
    background: var(--surface-elevated);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-sm);
    list-style: none;
    z-index: 100;
