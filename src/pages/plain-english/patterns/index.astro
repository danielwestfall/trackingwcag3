    color: var(--text-muted);
  }
  .grid-cell {
    flex: 1;
    padding: 8px 10px;
    font-size: 0.82rem;
    outline: none;
    border-right: 1px solid var(--border-subtle);
    color: var(--text-primary);
    display: flex;
    align-items: center;
  }
  .grid-cell:last-child {
    border-right: none;
  }
  .grid-cell:focus {
    outline: 2px solid var(--accent-blue);
    outline-offset: -2px;
    background: rgba(56, 189, 248, 0.12);
  }
  .cell-badge,
  .sem-badge {
