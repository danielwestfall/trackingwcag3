  /* WCAG Mapping Badges */
  .wcag-mapping-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .mapping-group h4 {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-muted);
    margin-bottom: 8px;
