---
import PlainEnglishLayout from "@/layouts/PlainEnglishLayout.astro";
import { APG_PATTERNS, type Pattern } from "@/lib/patterns";
import PatternHeroAndFilters from "@/components/patterns/PatternHeroAndFilters.astro";
import PatternPlayground from "@/components/patterns/PatternPlayground.astro";
import PatternBlueprint from "@/components/patterns/PatternBlueprint.astro";
import PatternInspector from "@/components/patterns/PatternInspector.astro";

const totalPatterns = APG_PATTERNS.length;
const nativeCount = APG_PATTERNS.filter(p => p.firstRuleVerdict === "native-preferred").length;
const hybridCount = APG_PATTERNS.filter(p => p.firstRuleVerdict === "hybrid-enhancement").length;
const ariaCount = APG_PATTERNS.filter(p => p.firstRuleVerdict === "aria-required").length;

const categories = [
  "All",
  "Inputs & Controls",
  "Dialogs & Overlays",
  "Navigation",
  "Structure & Layout",
  "Application Widgets"
];
---

<PlainEnglishLayout title="APG Patterns vs. Semantic HTML Demos" activeTab="patterns">
  <PatternHeroAndFilters
    totalPatterns={totalPatterns}
    nativeCount={nativeCount}
    hybridCount={hybridCount}
    ariaCount={ariaCount}
    categories={categories}
  />

  <!-- Pattern Cards Gallery -->
  <section class="patterns-grid" id="patterns-container" aria-label="Interactive Pattern Demos">
    {APG_PATTERNS.map((pattern: Pattern) => (
      <article
        class="pattern-card"
        id={`pattern-${pattern.id}`}
        data-id={pattern.id}
        data-name={pattern.name.toLowerCase()}
        data-category={pattern.category}
        data-verdict={pattern.firstRuleVerdict}
        data-semantic={pattern.semanticElement.toLowerCase()}
      >
        <!-- Card Header -->
        <header class="card-header">
          <div class="header-main">
            <div class="pattern-meta">
              <span class="category-tag">{pattern.category}</span>
              <span class={`verdict-badge verdict-${pattern.firstRuleVerdict}`}>
                {pattern.verdictLabel}
              </span>
            </div>
            <h2 class="pattern-title">
              <a href={`#pattern-${pattern.id}`}>{pattern.name}</a>
            </h2>
          </div>
          <div class="header-links">
            <a href={pattern.apgUrl} target="_blank" rel="noopener noreferrer" class="apg-spec-link" title="View official W3C APG Specification">
              <span>W3C APG Spec</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </header>

        <!-- Summary & First Rule Rationale -->
        <div class="pattern-summary">
          <p class="summary-text">{pattern.summary}</p>
          <div class="rationale-callout">
            <span class="callout-label">First Rule Analysis:</span>
            <p>{pattern.firstRuleExplanation}</p>
          </div>
        </div>

        <!-- Semantic Element Badge Strip -->
        <div class="semantic-strip">
          <span class="strip-label">Semantic Target:</span>
          <code class="semantic-code-badge">{pattern.semanticElement}</code>
        </div>

        <!-- Interactive Playground -->
        <PatternPlayground pattern={pattern} />

        <PatternBlueprint pattern={pattern} />
        <PatternInspector pattern={pattern} />
      </article>
    ))}
  </section>
</PlainEnglishLayout>

<style>
  /* ==========================================================================
     Patterns Explorer Styles (Cyber-Clarity Design System)
     ========================================================================== */

  [hidden] {
    display: none !important;
  }

  /* Patterns Grid */
  .patterns-grid {
    max-width: 1360px;
    margin: 24px auto 60px;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* Individual Pattern Card */
  .pattern-card {
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 28px;
    box-shadow: var(--shadow-md);
    transition: var(--transition-normal);
    min-width: 0;
    max-width: 100%;
    overflow-x: clip;
    overflow-wrap: anywhere;
  }
  .pattern-card:hover {
    border-color: var(--border-default);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 18px;
    flex-wrap: wrap;
    min-width: 0;
  }
  .header-main {
    min-width: 0;
    max-width: 100%;
  }
  .pattern-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }
  .category-tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--surface-elevated);
    color: var(--text-muted);
    padding: 4px 10px;
    border-radius: 4px;
  }
  .verdict-badge {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 999px;
  }
  .verdict-native-preferred {
    background: rgba(52, 211, 153, 0.15);
    color: #34d399;
    border: 1px solid rgba(52, 211, 153, 0.3);
  }
  .verdict-hybrid-enhancement {
    background: rgba(251, 191, 36, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(251, 191, 36, 0.3);
  }
  .verdict-aria-required {
    background: rgba(168, 85, 247, 0.15);
    color: #c084fc;
    border: 1px solid rgba(168, 85, 247, 0.3);
  }

  .pattern-title {
    font-size: 1.7rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }
  .pattern-title a {
    color: var(--text-primary);
    text-decoration: none;
  }
  .pattern-title a:hover {
    color: var(--accent-blue);
    text-decoration: underline;
  }

  .apg-spec-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent-blue);
    text-decoration: none;
    background: var(--surface-elevated);
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }
  .apg-spec-link:hover {
    border-color: var(--accent-blue);
  }

  /* Summary & Rationale */
  .pattern-summary {
    margin: 18px 0;
  }
  .summary-text {
    font-size: 0.98rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 12px;
  }
  .rationale-callout {
    background: var(--surface-base);
    border-left: 4px solid var(--accent-blue);
    padding: 12px 16px;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }
  .callout-label {
    display: block;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 2px;
  }

  .semantic-strip {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 16px;
    font-size: 0.85rem;
  }
  .strip-label {
    font-weight: 600;
    color: var(--text-muted);
  }
  .semantic-code-badge {
    background: rgba(52, 211, 153, 0.12);
    border: 1px solid rgba(52, 211, 153, 0.3);
    color: #34d399;
    padding: 4px 10px;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
  }

  /* Light Mode WCAG Contrast & Design Token Adaptations */
  :root[data-theme="light"] .verdict-native-preferred {
    background: #d1fae5;
    color: #065f46;
    border-color: rgba(4, 120, 87, 0.35);
  }
  :root[data-theme="light"] .verdict-hybrid-enhancement {
    background: #fef3c7;
    color: #92400e;
    border-color: rgba(146, 64, 14, 0.35);
  }
  :root[data-theme="light"] .verdict-aria-required {
    background: #f3e8ff;
    color: var(--accent-purple);
    border-color: rgba(109, 40, 217, 0.35);
  }

  :root[data-theme="light"] .semantic-code-badge {
    background: #d1fae5;
    color: var(--accent-emerald);
    border-color: rgba(4, 120, 87, 0.35);
  }

  /* 320px / 400% Zoom Reflow & Responsive Compact Rules */
  @media (max-width: 600px) {
    .patterns-grid {
      padding: 0 8px;
    }
    .pattern-card {
      padding: 16px 12px;
    }
  }

  /* Windows Contrast Themes (Forced Colors Mode) */
  @media (forced-colors: active) {
    .verdict-badge {
      border: 1px solid ButtonText;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Filtering & Search
    const searchInput = document.getElementById('pattern-search');
    const searchClear = document.getElementById('search-clear-btn');
    const categoryPills = document.querySelectorAll('#category-pills .filter-pill');
    const verdictPills = document.querySelectorAll('#verdict-pills .filter-pill');
    const cards = document.querySelectorAll('.pattern-card');
    const visibleCountEl = document.getElementById('visible-count');

    let currentCategory = 'All';
    let currentVerdict = 'all';
    let searchQuery = '';

    function filterCards() {
      let count = 0;
      cards.forEach((card) => {
        const name = card.getAttribute('data-name') || '';
        const category = card.getAttribute('data-category') || '';
        const verdict = card.getAttribute('data-verdict') || '';
        const semantic = card.getAttribute('data-semantic') || '';

        const matchesCat = currentCategory === 'All' || category === currentCategory;
        const matchesVerdict = currentVerdict === 'all' || verdict === currentVerdict;
        const matchesSearch = !searchQuery || name.includes(searchQuery) || semantic.includes(searchQuery) || category.toLowerCase().includes(searchQuery);

        if (matchesCat && matchesVerdict && matchesSearch) {
          card.style.display = '';
          count++;
        } else {
          card.style.display = 'none';
        }
      });
      if (visibleCountEl) visibleCountEl.textContent = String(count);
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.trim().toLowerCase();
        if (searchClear) searchClear.hidden = !searchQuery;
        filterCards();
      });
    }

    if (searchClear) {
      searchClear.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        searchClear.hidden = true;
        filterCards();
      });
    }

    const categoryPillsArr = Array.from(categoryPills);
    function activateCategoryPill(pill, focusIt = false) {
      categoryPillsArr.forEach((p) => {
        const isMatch = p === pill;
        p.classList.toggle('active', isMatch);
        p.setAttribute('aria-checked', String(isMatch));
        p.setAttribute('tabindex', isMatch ? '0' : '-1');
      });
      currentCategory = pill.getAttribute('data-category') || 'All';
      if (focusIt) pill.focus();
      filterCards();
    }
    categoryPillsArr.forEach((pill, idx) => {
      pill.addEventListener('click', () => activateCategoryPill(pill, false));
      pill.addEventListener('keydown', (e) => {
        let next = idx;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (idx + 1) % categoryPillsArr.length;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (idx - 1 + categoryPillsArr.length) % categoryPillsArr.length;
        if (next !== idx) {
          e.preventDefault();
          activateCategoryPill(categoryPillsArr[next], true);
        }
      });
    });

    const verdictPillsArr = Array.from(verdictPills);
    function activateVerdictPill(pill, focusIt = false) {
      verdictPillsArr.forEach((p) => {
        const isMatch = p === pill;
        p.classList.toggle('active', isMatch);
        p.setAttribute('aria-checked', String(isMatch));
        p.setAttribute('tabindex', isMatch ? '0' : '-1');
      });
      currentVerdict = pill.getAttribute('data-verdict') || 'all';
      if (focusIt) pill.focus();
      filterCards();
    }
    verdictPillsArr.forEach((pill, idx) => {
      pill.addEventListener('click', () => activateVerdictPill(pill, false));
      pill.addEventListener('keydown', (e) => {
        let next = idx;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (idx + 1) % verdictPillsArr.length;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (idx - 1 + verdictPillsArr.length) % verdictPillsArr.length;
        if (next !== idx) {
          e.preventDefault();
          activateVerdictPill(verdictPillsArr[next], true);
        }
      });
    });

    // Keyboard shortcut Ctrl/Cmd+K to focus pattern search (avoids bare '/' per WCAG 2.1.4)
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && !e.altKey && (e.key === 'k' || e.key === 'K')) {
        if (searchInput && document.activeElement !== searchInput) {
          e.preventDefault();
          searchInput.focus();
          searchInput.select();
        }
      }
    });

    // 2. Sandbox Visual Mode Toggle (Styled vs Raw Browser Default)
    document.querySelectorAll('.sandbox-toggle-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target-pane');
        const pane = targetId ? document.getElementById(targetId) : null;
        if (pane) {
          pane.classList.toggle('raw-browser-default');
          const isRaw = pane.classList.contains('raw-browser-default');
          const textEl = btn.querySelector('.toggle-text');
          if (textEl) {
            textEl.textContent = isRaw ? 'Restore Custom Styled UI' : 'Toggle Styled vs Raw Default';
          }
        }
      });
    });

    // 3. Live AT State Readout Updates
    function updateAtState(patternId, role, stateText) {
      const el = document.getElementById(`at-state-${role}-${patternId}`);
      if (el) el.textContent = stateText;
    }

    // Initialize initial state readouts for cards
    document.querySelectorAll('.pattern-card').forEach((card) => {
      const id = card.getAttribute('data-id');
      if (!id) return;

      if (id === 'accordion') {
        updateAtState('accordion', 'apg', 'button: "Personal Details" | aria-expanded: "true" | region: visible');
        updateAtState('accordion', 'sem', '<details name="demo-semantic-acc" open> | state: expanded');
      } else if (id === 'dialog-modal') {
        updateAtState('dialog-modal', 'apg', 'role="dialog" | aria-modal="true" | hidden: true');
        updateAtState('dialog-modal', 'sem', '<dialog> closed | ready for showModal()');
      } else if (id === 'switch') {
        updateAtState('switch', 'apg', 'role="switch" | aria-checked="false"');
        updateAtState('switch', 'sem', '<input type="checkbox" role="switch"> | checked: false');
      } else if (id === 'slider') {
        updateAtState('slider', 'apg', 'role="slider" | aria-valuenow="50" | min: 0, max: 100');
        updateAtState('slider', 'sem', '<input type="range"> | value: 50 | min: 0, max: 100');
      } else if (id === 'meter') {
        updateAtState('meter', 'apg', 'role="meter" | aria-valuenow="72"');
        updateAtState('meter', 'sem', '<meter value="72" optimum="25"> (high status)');
      } else if (id === 'spinbutton') {
        updateAtState('spinbutton', 'apg', 'role="spinbutton" | aria-valuenow="3"');
        updateAtState('spinbutton', 'sem', '<input type="number" value="3">');
      } else if (id === 'radio') {
        updateAtState('radio', 'apg', 'role="radio" (1 of 3) | aria-checked="true"');
        updateAtState('radio', 'sem', '<input type="radio" checked> in <fieldset>');
      } else if (id === 'checkbox') {
        updateAtState('checkbox', 'apg', 'role="checkbox" | aria-checked="mixed"');
        updateAtState('checkbox', 'sem', '<input type="checkbox"> | indeterminate: true');
      } else if (id === 'button') {
        updateAtState('button', 'apg', '<div role="button" tabindex="0"> | clicks: 0');
        updateAtState('button', 'sem', '<button type="button"> | native click handler');
      } else if (id === 'link') {
        updateAtState('link', 'apg', '<span role="link" tabindex="0">');
        updateAtState('link', 'sem', '<a href="..."> (native link role & context menu)');
      } else if (id === 'breadcrumb') {
        updateAtState('breadcrumb', 'apg', '<nav aria-label="APG Breadcrumbs"> | aria-current="page"');
        updateAtState('breadcrumb', 'sem', '<nav aria-label="Semantic Breadcrumbs"> | <span aria-current="page">');
      } else if (id === 'combobox') {
        updateAtState('combobox', 'apg', 'role="combobox" | aria-expanded="false" | listbox hidden');
        updateAtState('combobox', 'sem', '<input list="framework-list"> + <datalist>');
      } else if (id === 'menu-button') {
        updateAtState('menu-button', 'apg', 'button aria-haspopup="menu" | aria-expanded="false"');
        updateAtState('menu-button', 'sem', 'button popovertarget | <div popover>');
      } else if (id === 'tooltip') {
        updateAtState('tooltip', 'apg', 'button aria-describedby="apg-tt-box" | tooltip hidden');
        updateAtState('tooltip', 'sem', 'button title="..." (native OS tooltip)');
      } else if (id === 'tabs') {
        updateAtState('tabs', 'apg', 'role="tablist" | active tab: "Automated" (1 of 3)');
        updateAtState('tabs', 'sem', 'Spec Notice: No native <tabs> element exists');
      } else if (id === 'table') {
        updateAtState('table', 'apg', '<div role="table"> | role="row" | role="cell"');
        updateAtState('table', 'sem', '<table> with <thead>, <tbody>, <th scope="col">');
      } else if (id === 'alert') {
        updateAtState('alert', 'apg', 'role="alert" (aria-live="assertive") | ready');
        updateAtState('alert', 'sem', '<output> (native role="status", aria-live="polite")');
      } else if (id === 'toolbar') {
        updateAtState('toolbar', 'apg', 'role="toolbar" | single Tab stop, roving arrows');
        updateAtState('toolbar', 'sem', '<fieldset> with individual Tab stops');
      } else if (id === 'grid') {
        updateAtState('grid', 'apg', 'role="grid" | active: ISS-101 (Row 1, Col 1)');
        updateAtState('grid', 'sem', '<table> with native <th>, <td> and <input>');
      } else if (id === 'listbox') {
        updateAtState('listbox', 'apg', 'role="listbox" | selected: "WCAG 2.1 Level AA"');
        updateAtState('listbox', 'sem', '<select size="4"> | selected: "WCAG 2.1 Level AA"');
      } else if (id === 'menubar') {
        updateAtState('menubar', 'apg', 'role="menubar" | active: File ▾ (closed)');
        updateAtState('menubar', 'sem', '<nav aria-label="Main Site Navigation"> with <a> links');
      } else if (id === 'alertdialog') {
        updateAtState('alertdialog', 'apg', 'role="alertdialog" | closed');
        updateAtState('alertdialog', 'sem', '<dialog> closed | ready for showModal()');
      } else if (id === 'feed') {
        updateAtState('feed', 'apg', 'role="feed" | active article 1 of 2');
        updateAtState('feed', 'sem', '<section> with <article> items (native semantic stream)');
      } else if (id === 'slider-multithumb') {
        updateAtState('slider-multithumb', 'apg', 'role="slider" (multi-thumb) | min: $25, max: $75');
        updateAtState('slider-multithumb', 'sem', '<input type="range"> (dual) | min: $25, max: $75');
      } else if (id === 'treegrid') {
        updateAtState('treegrid', 'apg', 'role="treegrid" | active row: "src/" (level 1, expanded)');
        updateAtState('treegrid', 'sem', '<table> with hierarchical indentation | No native treegrid element');
      } else if (id === 'windowsplitter') {
        updateAtState('windowsplitter', 'apg', 'role="separator" | aria-valuenow="50%"');
        updateAtState('windowsplitter', 'sem', 'CSS resize: horizontal | native browser dragging');
      }
    });

    // 4. Inspector Tabs Switching (with Roving Tabindex)
    document.querySelectorAll('.inspector-tabs').forEach((tablist) => {
      const tabs = Array.from(tablist.querySelectorAll('.insp-tab'));
      const container = tablist.closest('.inspector-body');
      if (!container) return;
      const panels = container.querySelectorAll('.insp-panel');

      function activateInspTab(tab, focusIt = false) {
        tabs.forEach((t) => {
          const isMatch = t === tab;
          t.classList.toggle('active', isMatch);
          t.setAttribute('aria-selected', String(isMatch));
          t.setAttribute('tabindex', isMatch ? '0' : '-1');
        });
        panels.forEach((p) => {
          p.classList.remove('active');
          p.hidden = true;
        });

        const target = tab.getAttribute('data-tab');
        const panel = container.querySelector(`[data-panel="${target}"]`);
        if (panel) {
          panel.classList.add('active');
          panel.hidden = false;
        }
        if (focusIt) tab.focus();
      }

      tabs.forEach((tab, idx) => {
        tab.addEventListener('click', () => activateInspTab(tab, false));
        tab.addEventListener('keydown', (e) => {
          let next = idx;
          if (e.key === 'ArrowRight') next = (idx + 1) % tabs.length;
          else if (e.key === 'ArrowLeft') next = (idx - 1 + tabs.length) % tabs.length;
          if (next !== idx) {
            e.preventDefault();
            activateInspTab(tabs[next], true);
          }
        });
      });
    });

    // 5. One-Click Copy Code
    document.querySelectorAll('.copy-code-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const targetId = btn.getAttribute('data-copy-target');
        const codeEl = targetId ? document.getElementById(targetId) : null;
        if (codeEl) {
          await navigator.clipboard.writeText(codeEl.textContent || '');
          const orig = btn.textContent;
          btn.textContent = 'Copied! ✓';
          setTimeout(() => { btn.textContent = orig; }, 1800);
        }
      });
    });

    // 6. Interactive APG & Semantic Live Demos Handlers
    // 6.1 Accordion Demo
    const apgAccBtns = document.querySelectorAll('.apg-acc-btn');
    apgAccBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        const panelId = btn.getAttribute('aria-controls');
        const panel = panelId ? document.getElementById(panelId) : null;
        if (panel) panel.hidden = expanded;
        updateAtState('accordion', 'apg', `button aria-expanded: "${!expanded}" | panel: ${!expanded ? 'visible' : 'hidden'}`);
      });
    });

    document.querySelectorAll('.sem-details').forEach((det) => {
      det.addEventListener('toggle', () => {
        updateAtState('accordion', 'sem', `<details open: ${det.open}> | state: ${det.open ? 'expanded' : 'collapsed'}`);
      });
    });

    // 6.2 Modal Dialogs
    const btnOpenApg = document.getElementById('btn-open-apg-dialog');
    const apgOverlay = document.getElementById('apg-modal-overlay');
    const apgDlgCancel = document.getElementById('apg-dlg-cancel');
    const apgDlgDelete = document.getElementById('apg-dlg-delete');

    if (btnOpenApg && apgOverlay) {
      btnOpenApg.addEventListener('click', () => {
        apgOverlay.hidden = false;
        apgDlgCancel?.focus();
        updateAtState('dialog-modal', 'apg', 'role="dialog" | aria-modal="true" | OPEN & FOCUS TRAPPED');
      });
      const closeApg = () => {
        apgOverlay.hidden = true;
        btnOpenApg.focus();
        updateAtState('dialog-modal', 'apg', 'role="dialog" closed | focus restored to opener');
      };
      apgDlgCancel?.addEventListener('click', closeApg);
      apgDlgDelete?.addEventListener('click', closeApg);
      document.addEventListener('keydown', (e) => {
        if (apgOverlay.hidden) return;
        if (e.key === 'Escape') {
          e.preventDefault();
          closeApg();
        } else if (e.key === 'Tab') {
          const focusable = Array.from(apgOverlay.querySelectorAll('button:not([disabled]), [href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'));
          if (focusable.length > 0) {
            const first = focusable[0];
            const last = focusable[focusable.length - 1];
            if (e.shiftKey && document.activeElement === first) {
              e.preventDefault();
              last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
              e.preventDefault();
              first.focus();
