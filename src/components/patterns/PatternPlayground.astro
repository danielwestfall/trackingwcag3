---
import type { Pattern } from "@/lib/patterns";

interface Props {
  pattern: Pattern;
}

const { pattern } = Astro.props;
---

<!-- Sandbox Toolbar -->
<div class="sandbox-toolbar">
  <span class="sandbox-title">⚡ Interactive Sandbox &amp; Live AT Inspector</span>
  <button type="button" class="sandbox-toggle-btn" data-target-pane={`playground-${pattern.id}`}>
    <span class="toggle-icon">🎨</span>
    <span class="toggle-text">Toggle Styled vs Raw Default</span>
  </button>
</div>

<!-- Side-by-Side Interactive Playground -->
<div class="playground-wrapper" id={`playground-${pattern.id}`}>
  <div class="playground-grid">
    <!-- Left: W3C APG ARIA Pattern Demo -->
    <div class="demo-pane demo-apg" aria-label={`W3C APG ARIA ${pattern.name} Demo`}>
      <div class="pane-header">
        <span class="pane-badge badge-apg">🟣 W3C APG (ARIA)</span>
        <span class="pane-sub">Role, states &amp; keyboard JS</span>
      </div>
      <div class="pane-content" data-demo-role="apg" data-pattern-id={pattern.id}>
        <!-- Interactive APG Demos -->
        {pattern.id === "accordion" && (
          <div class="apg-accordion-widget" id="demo-apg-accordion">
            <div class="acc-item">
              <h3>
                <button type="button" class="apg-acc-btn" aria-expanded="true" aria-controls="demo-apg-panel-1" id="demo-apg-btn-1">
                  <span>Personal Details</span>
                  <span class="acc-arrow" aria-hidden="true">▼</span>
                </button>
              </h3>
              <div id="demo-apg-panel-1" role="region" aria-labelledby="demo-apg-btn-1" class="apg-acc-panel">
                <p>Name: Alex Rivera</p>
                <p>Email: alex@example.com</p>
              </div>
            </div>
            <div class="acc-item">
              <h3>
                <button type="button" class="apg-acc-btn" aria-expanded="false" aria-controls="demo-apg-panel-2" id="demo-apg-btn-2">
                  <span>Billing Information</span>
                  <span class="acc-arrow" aria-hidden="true">▼</span>
                </button>
              </h3>
              <div id="demo-apg-panel-2" role="region" aria-labelledby="demo-apg-btn-2" class="apg-acc-panel" hidden>
                <p>Payment: Invoiced Net 30</p>
                <p>Billing Address: 100 Main St</p>
              </div>
            </div>
          </div>
        )}

        {pattern.id === "dialog-modal" && (
          <div class="apg-dialog-demo">
            <button type="button" class="demo-btn btn-open-apg-modal" id="btn-open-apg-dialog">
              Open APG Modal Dialog
            </button>
            <!-- Simulated Modal in container -->
            <div id="apg-modal-overlay" class="apg-modal-overlay" hidden>
              <div role="dialog" aria-modal="true" aria-labelledby="apg-dlg-title" class="apg-modal-window">
                <h3 id="apg-dlg-title">Confirm Deletion</h3>
                <p>Are you sure you want to permanently delete this item?</p>
                <div class="modal-actions">
                  <button type="button" class="demo-btn btn-danger" id="apg-dlg-delete">Delete</button>
                  <button type="button" class="demo-btn" id="apg-dlg-cancel">Cancel (Esc)</button>
                </div>
              </div>
            </div>
          </div>
        )}

        {pattern.id === "switch" && (
          <div class="apg-switch-demo">
            <button type="button" role="switch" aria-checked="false" class="apg-switch-btn" id="apg-switch-widget">
              <span class="switch-label">High Contrast Mode</span>
              <span class="switch-track" aria-hidden="true">
                <span class="switch-thumb"></span>
              </span>
            </button>
          </div>
        )}

        {pattern.id === "slider" && (
          <div class="apg-slider-demo">
            <label id="apg-slider-lbl">Volume Level: <strong class="slider-readout" id="apg-slider-val">50</strong>%</label>
            <div class="apg-slider-rail" id="apg-slider-track">
              <div
                role="slider"
                tabindex="0"
                aria-labelledby="apg-slider-lbl"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="50"
                id="apg-slider-handle"
                class="apg-slider-handle"
                style="left: 50%;"
              ></div>
            </div>
            <span class="slider-hint">Use ← → Arrow keys or Home/End</span>
          </div>
        )}

        {pattern.id === "meter" && (
          <div class="apg-meter-demo">
            <div class="meter-info">
              <span id="apg-meter-lbl">Storage Usage:</span>
              <strong id="apg-meter-val">72%</strong>
            </div>
            <div role="meter" aria-labelledby="apg-meter-lbl" aria-valuenow="72" aria-valuemin="0" aria-valuemax="100" class="apg-meter-rail">
              <div class="apg-meter-fill" id="apg-meter-bar" style="width: 72%;"></div>
            </div>
            <div class="demo-mini-actions">
              <button type="button" class="demo-btn-sm" id="btn-apg-meter-dec">-10%</button>
              <button type="button" class="demo-btn-sm" id="btn-apg-meter-inc">+10%</button>
            </div>
          </div>
        )}

        {pattern.id === "spinbutton" && (
          <div class="apg-spinbutton-demo">
            <label id="apg-spin-lbl">Quantity (1-10):</label>
            <div class="apg-spinner-box">
              <div role="spinbutton" tabindex="0" aria-labelledby="apg-spin-lbl" aria-valuenow="3" aria-valuemin="1" aria-valuemax="10" class="apg-spin-display" id="apg-spin-val">
                3
              </div>
              <div class="spinner-btns">
                <button type="button" class="spin-btn" id="apg-spin-up" aria-label="Increase quantity">▲</button>
                <button type="button" class="spin-btn" id="apg-spin-down" aria-label="Decrease quantity">▼</button>
              </div>
            </div>
          </div>
        )}

        {pattern.id === "radio" && (
          <div class="apg-radiogroup-demo">
            <div role="radiogroup" aria-labelledby="apg-rg-lbl" class="apg-radiogroup">
              <span id="apg-rg-lbl" class="group-title">Shipping Speed:</span>
              <div role="radio" tabindex="0" aria-checked="true" class="apg-radio-opt" data-val="standard">
                <span class="radio-dot" aria-hidden="true"></span>
                <span>Standard (3-5 days)</span>
              </div>
              <div role="radio" tabindex="-1" aria-checked="false" class="apg-radio-opt" data-val="express">
                <span class="radio-dot" aria-hidden="true"></span>
                <span>Express (1-2 days)</span>
              </div>
              <div role="radio" tabindex="-1" aria-checked="false" class="apg-radio-opt" data-val="overnight">
                <span class="radio-dot" aria-hidden="true"></span>
                <span>Next Day Overnight</span>
              </div>
            </div>
            <span class="slider-hint">Navigate with ↑ ↓ or ← → keys</span>
          </div>
        )}

        {pattern.id === "checkbox" && (
          <div class="apg-checkbox-demo">
            <div role="checkbox" tabindex="0" aria-checked="mixed" class="apg-check-item" id="apg-tri-check">
              <span class="custom-chk-box" aria-hidden="true">
                <span class="check-icon">−</span>
              </span>
              <span>All Organization Permissions (Mixed)</span>
            </div>
            <span class="slider-hint">Press Space to toggle checked / unchecked / mixed</span>
          </div>
        )}

        {pattern.id === "button" && (
          <div class="apg-button-demo">
            <div role="button" tabindex="0" class="apg-fake-btn" id="apg-fake-button">
              Custom &lt;div role="button"&gt;
            </div>
            <div class="event-counter" id="apg-btn-status">Activated: 0 times</div>
            <span class="slider-hint">Requires manual Space &amp; Enter keydown JS</span>
          </div>
        )}

        {pattern.id === "link" && (
          <div class="apg-link-demo">
            <span role="link" tabindex="0" class="apg-fake-link" id="apg-fake-link">
              Custom &lt;span role="link"&gt;
            </span>
            <div class="event-counter" id="apg-link-status">Click / Enter to simulate navigate</div>
            <span class="slider-hint">Lacks right-click, middle-click, and SEO crawling</span>
          </div>
        )}

        {pattern.id === "breadcrumb" && (
          <div class="apg-breadcrumb-demo">
            <nav aria-label="APG Breadcrumbs" class="apg-breadcrumbs">
              <ol>
                <li><a href="#pattern-breadcrumb">Dashboard</a></li>
                <li><a href="#pattern-breadcrumb">Reports</a></li>
                <li><a href="#pattern-breadcrumb" aria-current="page">WCAG Audit</a></li>
              </ol>
            </nav>
          </div>
        )}

        {pattern.id === "combobox" && (
          <div class="apg-combobox-demo">
            <label id="apg-cb-lbl">Select Framework:</label>
            <div class="apg-combobox-wrap">
              <input
                type="text"
                role="combobox"
                aria-autocomplete="list"
                aria-expanded="false"
                aria-controls="apg-cb-options"
                id="apg-cb-input"
                placeholder="Type to filter..."
                autocomplete="off"
              />
              <ul role="listbox" id="apg-cb-options" class="apg-cb-list" hidden>
                <li role="option" id="cb-opt-1" tabindex="-1">Astro</li>
                <li role="option" id="cb-opt-2" tabindex="-1">React</li>
                <li role="option" id="cb-opt-3" tabindex="-1">Vue</li>
                <li role="option" id="cb-opt-4" tabindex="-1">Svelte</li>
              </ul>
            </div>
          </div>
        )}

        {pattern.id === "menu-button" && (
          <div class="apg-menubtn-demo">
            <button type="button" aria-haspopup="menu" aria-expanded="false" id="apg-menu-trigger" class="demo-btn">
              Application Menu ▼
            </button>
            <ul role="menu" id="apg-menu-list" class="apg-menu-popup" hidden aria-labelledby="apg-menu-trigger">
              <li role="menuitem" tabindex="-1">📄 Export Audit (PDF)</li>
              <li role="menuitem" tabindex="-1">📋 Copy JSON Results</li>
              <li role="menuitem" tabindex="-1" class="menu-danger">🗑️ Clear Findings</li>
            </ul>
          </div>
        )}

        {pattern.id === "tooltip" && (
          <div class="apg-tooltip-demo">
            <button type="button" aria-describedby="apg-tt-box" id="apg-tt-btn" class="demo-btn">
              Hover or Focus for ARIA Tooltip
            </button>
            <div role="tooltip" id="apg-tt-box" class="apg-tooltip-popup" hidden>
              Accessible contextual hint via aria-describedby
            </div>
          </div>
        )}

        {pattern.id === "landmarks" && (
          <div class="apg-landmarks-demo">
            <div class="wireframe-box role-banner">role="banner"</div>
            <div class="wireframe-row">
              <div class="wireframe-box role-nav">role="navigation"</div>
              <div class="wireframe-box role-main">role="main"</div>
            </div>
            <div class="wireframe-box role-footer">role="contentinfo"</div>
          </div>
        )}

        {pattern.id === "tabs" && (
          <div class="apg-tabs-demo" id="demo-apg-tabs">
            <div role="tablist" aria-label="Testing Methods" class="apg-tablist">
              <button role="tab" aria-selected="true" aria-controls="apg-tpanel-1" id="apg-tab-1" tabindex="0" class="apg-tab active">
                Automated
              </button>
              <button role="tab" aria-selected="false" aria-controls="apg-tpanel-2" id="apg-tab-2" tabindex="-1" class="apg-tab">
                Keyboard
              </button>
              <button role="tab" aria-selected="false" aria-controls="apg-tpanel-3" id="apg-tab-3" tabindex="-1" class="apg-tab">
                Screen Reader
              </button>
            </div>
            <div role="tabpanel" id="apg-tpanel-1" aria-labelledby="apg-tab-1" tabindex="0" class="apg-tabpanel">
              <p>Run axe-core and Lighthouse against static DOM nodes.</p>
            </div>
            <div role="tabpanel" id="apg-tpanel-2" aria-labelledby="apg-tab-2" tabindex="0" class="apg-tabpanel" hidden>
              <p>Verify Tab, Shift+Tab, and roving arrow key focus visibility.</p>
            </div>
            <div role="tabpanel" id="apg-tpanel-3" aria-labelledby="apg-tab-3" tabindex="0" class="apg-tabpanel" hidden>
              <p>Audit with NVDA, JAWS, or VoiceOver for virtual reading order.</p>
            </div>
          </div>
        )}

        {pattern.id === "table" && (
          <div class="apg-table-demo">
            <div role="table" aria-label="WCAG Tiers" class="apg-aria-table">
              <div role="rowgroup" class="table-header-group">
                <div role="row" class="table-row">
                  <div role="columnheader" class="table-cell th-cell">WCAG 3 Tier</div>
                  <div role="columnheader" class="table-cell th-cell">Requirement</div>
                </div>
              </div>
              <div role="rowgroup">
                <div role="row" class="table-row">
                  <div role="cell" class="table-cell">Bronze</div>
                  <div role="cell" class="table-cell">Core Conformance</div>
                </div>
                <div role="row" class="table-row">
                  <div role="cell" class="table-cell">Silver</div>
                  <div role="cell" class="table-cell">Exceeds Minimum</div>
                </div>
              </div>
            </div>
          </div>
        )}

        {pattern.id === "disclosure" && (
          <div class="apg-disclosure-demo">
            <button type="button" aria-expanded="false" aria-controls="apg-disc-box" id="apg-disc-btn" class="demo-btn">
              Show Details (ARIA Disclosure)
            </button>
            <div id="apg-disc-box" class="disclosure-content" hidden>
              <p>Disclosed content revealed via aria-expanded and hidden attribute.</p>
            </div>
          </div>
        )}

        {pattern.id === "treeview" && (
          <div class="apg-tree-demo">
            <ul role="tree" aria-label="Component Directory" class="apg-treeview" id="apg-tree-demo">
              <li role="treeitem" aria-expanded="true" tabindex="0" class="tree-node">
                <span>📂 src/</span>
                <ul role="group">
                  <li role="treeitem" tabindex="-1" class="tree-leaf">📄 index.astro</li>
                  <li role="treeitem" tabindex="-1" class="tree-leaf">📄 layout.astro</li>
                </ul>
              </li>
            </ul>
          </div>
        )}

        {pattern.id === "carousel" && (
          <div class="apg-carousel-demo">
            <div role="region" aria-roledescription="carousel" aria-label="Featured News" class="apg-carousel-box">
              <div class="carousel-slide-view">
                <div role="group" aria-roledescription="slide" aria-label="1 of 3" class="apg-slide" id="apg-slide-active">
                  Slide 1: WCAG 3 Draft Released
                </div>
              </div>
              <div class="carousel-toolbar">
                <button type="button" class="demo-btn-sm" id="apg-carousel-prev" aria-label="‹ Prev - Previous slide">‹ Prev</button>
                <button type="button" class="demo-btn-sm" id="apg-carousel-pause">⏸ Pause</button>
                <button type="button" class="demo-btn-sm" id="apg-carousel-next" aria-label="Next › - Next slide">Next ›</button>
              </div>
            </div>
          </div>
        )}

        {pattern.id === "alert" && (
          <div class="apg-alert-demo">
            <button type="button" class="demo-btn btn-danger" id="btn-trigger-apg-alert">
              Trigger role="alert"
            </button>
            <div id="apg-alert-box" role="alert" class="live-alert-container"></div>
          </div>
        )}

        {pattern.id === "toolbar" && (
          <div class="apg-toolbar-demo">
            <div role="toolbar" aria-label="Editor Tools" class="apg-toolbar-widget" id="apg-toolbar-demo">
              <button type="button" tabindex="0" aria-label="Bold"><strong>B</strong></button>
              <button type="button" tabindex="-1" aria-label="Italic"><em>I</em></button>
              <button type="button" tabindex="-1" aria-label="Underline"><u>U</u></button>
            </div>
            <span class="slider-hint">Single Tab stop; use ← → arrow keys</span>
          </div>
        )}

        {pattern.id === "grid" && (
          <div class="apg-grid-demo">
            <div role="grid" aria-label="WCAG Issue Tracker" class="apg-data-grid" id="apg-data-grid-demo">
              <div role="rowgroup" class="grid-head">
                <div role="row" class="grid-row head-row">
                  <span role="columnheader" class="grid-cell th-cell">ID</span>
                  <span role="columnheader" class="grid-cell th-cell">Criterion</span>
                  <span role="columnheader" class="grid-cell th-cell">Severity</span>
                  <span role="columnheader" class="grid-cell th-cell">Status</span>
                </div>
              </div>
              <div role="rowgroup" class="grid-body">
                <div role="row" class="grid-row">
                  <span role="gridcell" tabindex="0" class="grid-cell">ISS-101</span>
                  <span role="gridcell" tabindex="-1" class="grid-cell">1.4.3 Contrast</span>
                  <span role="gridcell" tabindex="-1" class="grid-cell cell-badge badge-high">High</span>
                  <span role="gridcell" tabindex="-1" class="grid-cell cell-editable" contenteditable="plaintext-only">Open</span>
                </div>
                <div role="row" class="grid-row">
                  <span role="gridcell" tabindex="-1" class="grid-cell">ISS-102</span>
                  <span role="gridcell" tabindex="-1" class="grid-cell">2.1.1 Keyboard</span>
                  <span role="gridcell" tabindex="-1" class="grid-cell cell-badge badge-crit">Critical</span>
                  <span role="gridcell" tabindex="-1" class="grid-cell cell-editable" contenteditable="plaintext-only">In Review</span>
                </div>
                <div role="row" class="grid-row">
                  <span role="gridcell" tabindex="-1" class="grid-cell">ISS-103</span>
                  <span role="gridcell" tabindex="-1" class="grid-cell">4.1.2 Name/Role</span>
                  <span role="gridcell" tabindex="-1" class="grid-cell cell-badge badge-med">Medium</span>
                  <span role="gridcell" tabindex="-1" class="grid-cell cell-editable" contenteditable="plaintext-only">Resolved</span>
                </div>
              </div>
            </div>
            <span class="slider-hint">Use ↑ ↓ ← → arrow keys to navigate 2D cells; click/edit Status</span>
          </div>
        )}

        {pattern.id === "listbox" && (
          <div class="apg-listbox-demo">
            <label id="apg-lb-label">WCAG Conformance Target:</label>
            <ul role="listbox" aria-labelledby="apg-lb-label" tabindex="0" class="apg-listbox-widget" id="apg-listbox-widget">
              <li role="option" id="lb-opt-1" aria-selected="true" class="lb-option selected">
                <span class="lb-check" aria-hidden="true">✓</span>
                <span>WCAG 2.1 Level AA</span>
              </li>
              <li role="option" id="lb-opt-2" aria-selected="false" class="lb-option">
                <span class="lb-check" aria-hidden="true">✓</span>
                <span>WCAG 2.2 Level AA (Current Standard)</span>
              </li>
              <li role="option" id="lb-opt-3" aria-selected="false" class="lb-option">
                <span class="lb-check" aria-hidden="true">✓</span>
                <span>WCAG 2.2 Level AAA</span>
              </li>
              <li role="option" id="lb-opt-4" aria-selected="false" class="lb-option">
                <span class="lb-check" aria-hidden="true">✓</span>
                <span>WCAG 3.0 Bronze Draft</span>
              </li>
            </ul>
            <span class="slider-hint">Navigate with ↑ ↓ arrow keys; Space to select</span>
          </div>
        )}

        {pattern.id === "menubar" && (
          <div class="apg-menubar-demo">
            <div role="menubar" aria-label="Editor Menubar" class="apg-menubar-widget" id="apg-menubar-widget">
              <div class="menubar-item-wrap">
                <button type="button" role="menuitem" aria-haspopup="true" aria-expanded="false" tabindex="0" class="apg-menubar-item" id="apg-menuitem-file">
                  File ▾
                </button>
                <ul role="menu" id="apg-file-menu" class="apg-menubar-dropdown" aria-labelledby="apg-menuitem-file" hidden>
                  <li role="menuitem" tabindex="-1">New Audit</li>
                  <li role="menuitem" tabindex="-1">Open Report...</li>
                  <li role="menuitem" tabindex="-1">Export PDF</li>
                </ul>
              </div>
              <div class="menubar-item-wrap">
                <button type="button" role="menuitem" aria-haspopup="true" aria-expanded="false" tabindex="-1" class="apg-menubar-item" id="apg-menuitem-edit">
                  Edit ▾
                </button>
                <ul role="menu" id="apg-edit-menu" class="apg-menubar-dropdown" aria-labelledby="apg-menuitem-edit" hidden>
                  <li role="menuitem" tabindex="-1">Undo</li>
                  <li role="menuitem" tabindex="-1">Redo</li>
                  <li role="menuitem" tabindex="-1">Preferences</li>
                </ul>
              </div>
              <div class="menubar-item-wrap">
                <button type="button" role="menuitem" tabindex="-1" class="apg-menubar-item">
                  Help
                </button>
              </div>
            </div>
            <span class="slider-hint">Use ← → between menus; ↓ opens dropdown; Esc closes</span>
          </div>
        )}

        {pattern.id === "alertdialog" && (
          <div class="apg-alertdialog-demo">
            <button type="button" class="demo-btn btn-danger" id="btn-open-apg-alertdialog">
              Trigger Alert Dialog (APG)
            </button>
            <div id="apg-alertdialog-overlay" class="apg-modal-overlay" hidden>
              <div
                role="alertdialog"
                aria-modal="true"
                aria-labelledby="apg-adlg-title"
                aria-describedby="apg-adlg-desc"
                class="apg-modal-window apg-alertdialog-window"
              >
                <div class="adlg-header">
                  <span class="adlg-icon" aria-hidden="true">⚠️</span>
                  <h3 id="apg-adlg-title">Discard Unsaved Changes?</h3>
                </div>
                <p id="apg-adlg-desc">
                  You have 3 unsaved WCAG rule overrides. Leaving this view will permanently discard your work.
                </p>
                <div class="modal-actions">
                  <button type="button" class="demo-btn" id="apg-adlg-cancel">Cancel (Keep Editing)</button>
                  <button type="button" class="demo-btn btn-danger" id="apg-adlg-discard">Discard Changes</button>
                </div>
              </div>
            </div>
            <span class="slider-hint">Focus placed on least destructive "Cancel" button; Esc closes</span>
          </div>
        )}

        {pattern.id === "feed" && (
          <div class="apg-feed-demo">
            <div role="feed" aria-label="W3C Accessibility News Feed" class="apg-feed-widget" id="apg-feed-widget" aria-busy="false">
              <article role="article" tabindex="0" aria-posinset="1" aria-setsize="3" class="feed-article" aria-labelledby="feed-h-1">
                <h3 id="feed-h-1">WCAG 2.2 Reaches REC Status</h3>
                <time datetime="2023-10-05">Oct 5, 2023</time>
                <p>Focus appearance, dragging movements, and accessible authentication are now formal recommendations.</p>
              </article>
              <article role="article" tabindex="-1" aria-posinset="2" aria-setsize="3" class="feed-article" aria-labelledby="feed-h-2">
                <h3 id="feed-h-2">WCAG 3 Working Draft Updated</h3>
                <time datetime="2024-04-18">Apr 18, 2024</time>
                <p>Explorations into scoring models, task-based outcomes, and equity metrics continue.</p>
              </article>
            </div>
            <div class="feed-controls">
              <button type="button" class="demo-btn-sm" id="btn-feed-add">Add Update to Feed</button>
              <span class="slider-hint">Use Page Up / Page Down to jump between articles</span>
            </div>
          </div>
        )}

        {pattern.id === "slider-multithumb" && (
