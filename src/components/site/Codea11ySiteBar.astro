                  ></path>
                  <path
                    class="logo-red"
                    style="stroke-width:1.854;stroke-dasharray:none;stroke-opacity:1;fill-opacity:1"
                    d="m 87.072129,121.95413 -15.070225,0.084 c -3.031286,0.017 -5.877498,1.21638 -8.014329,3.37718 -2.136831,2.1608 -3.30448,5.0203 -3.287571,8.0515 0.01691,3.03138 1.216215,5.87768 3.377016,8.01451 2.160885,2.13691 5.020386,3.30456 8.051757,3.28748 l 15.070057,-0.084 c 3.031287,-0.017 5.877669,-1.21622 8.0145,-3.37702 2.136832,-2.1608 3.304398,-5.02038 3.287405,-8.05168 -0.01698,-3.03129 -1.21622,-5.87766 -3.377019,-8.0145 -2.160801,-2.13682 -5.020132,-3.30431 -8.051591,-3.28749 z m 0.09527,17.07932 -7.53507,0.0421 -7.535069,0.0419 c -3.150723,0.0177 -5.728401,-2.53143 -5.745976,-5.68223 -0.0176,-3.15063 2.531427,-5.72823 5.682145,-5.74588 l 15.070143,-0.0841 c 3.150719,-0.0175 5.728312,2.53151 5.745972,5.68222 0.01764,3.15089 -2.531262,5.7284 -5.682145,5.7459 z"
                  ></path>
                  <g
                    class="logo-orange"
                    style="stroke-width:0.512326;stroke-dasharray:none;stroke-opacity:1;fill-opacity:1"
                    transform="matrix(3.6187955,0,0,3.6187955,30.416506,115.35624)"
                  >
                    <path
                      d="M 5.900404,10.015618 5.576408,13.103049 C 5.5186786,13.653166 5.026617,14.052252 4.4773577,13.994432 3.9280984,13.936613 3.5296348,13.443782 3.5873642,12.893665 L 4.3098044,6.009371 H 1 C 0.44771525,6.009371 0,5.5609565 0,5.0078091 0,4.4546618 0.44771525,4.0062473 1,4.0062473 h 10 c 0.552285,0 1,0.4484145 1,1.0015618 0,0.5531474 -0.447715,1.0015619 -1,1.0015619 H 7.6901956 l 0.7224402,6.884294 C 8.4703652,13.443782 8.0719016,13.936613 7.5226423,13.994432 6.973383,14.052252 6.4813214,13.653166 6.423592,13.103049 L 6.099596,10.015618 Z M 6,4.0062473 c -1.1045695,0 -2,-0.896829 -2,-2.0031236 C 4,0.89682901 4.8954305,0 6,0 7.1045695,0 8,0.89682901 8,2.0031237 8,3.1094183 7.1045695,4.0062473 6,4.0062473 Z"
                      style="stroke-width:0.512326;stroke-dasharray:none;stroke-opacity:1;fill-opacity:1"
                    ></path>
                  </g>
                </g>
                <text
                  xml:space="preserve"
                  style="font-size:26.1897px;line-height:1.25;font-family:VT323;-inkscape-font-specification:VT323;letter-spacing:0px;stroke-width:0.30691"
                  fill="currentColor"
                  x="71.983971"
                  y="163.30981"
                >
                  <tspan
                    style="font-style:normal;font-variant:normal;font-weight:normal;font-stretch:normal;font-size:26.1897px;font-family:'Cal Sans';-inkscape-font-specification:'Cal Sans';stroke-width:0.30691"
                    fill="currentColor"
                    x="71.983971"
                    y="163.30981">codea11y.dev</tspan
                  >
                </text>
              </g>
            </g>
          </svg>
  </a>

  <nav class="c11y-nav" aria-label="codea11y.dev">
    <button type="button" class="c11y-nav-toggle" aria-expanded="false" aria-controls="c11y-nav-list" hidden>
      <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z"/></svg>
      <span>Menu</span>
    </button>
    <ul id="c11y-nav-list" class="c11y-nav-list">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </nav>

  <!-- Reading & accessibility panel (shared with codea11y.dev): text size,
       spacing, fonts, Auto/Light/Dark and contrast themes, reading aids,
       read aloud. Alt+Shift+A opens it. -->
  <div id="reading-options" class="reading-options"></div>
</div>

<style is:global>
  .c11y-bar {
    max-width: 1360px;
    margin: 0 auto 12px;
    padding: 0 24px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px 24px;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
    font-family: var(--font-family-primary);
  }
  .c11y-logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--md-sys-color-on-surface);
    text-decoration: none;
  }
  .c11y-logo .logo-svg { height: 36px; width: auto; }
  .c11y-logo .logo-svg text,
  .c11y-logo .logo-svg tspan { fill: currentColor; }
  .c11y-logo .logo-blue { fill: #03047e; stroke: #000; stroke-width: 1.854; }
  .c11y-logo .logo-red { fill: #a70011; stroke: #000; stroke-width: 1.854; }
  .c11y-logo .logo-orange,
  .c11y-logo .logo-orange path { fill: #fd793f; stroke: #000; }
  .c11y-logo .logo-orange path { stroke-width: 0.512326; }
  :root[data-theme="dark"] .c11y-logo .logo-blue { fill: #4d4fff; stroke: #4d4fff; }
  :root[data-theme="dark"] .c11y-logo .logo-red { fill: #ff4d66; stroke: #ff4d66; }
  :root[data-theme="dark"] .c11y-logo .logo-orange,
  :root[data-theme="dark"] .c11y-logo .logo-orange path { fill: #ff9966; stroke: #ff9966; }

  .c11y-nav { position: relative; }
  .c11y-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
  }
  .c11y-nav-list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 999px;
    font-family: var(--font-family-display);
    font-size: 1.05rem;
    color: var(--md-sys-color-on-surface);
    text-decoration: none;
  }
  .c11y-nav-list a:hover {
    color: var(--md-sys-color-primary);
    background: var(--md-sys-color-surface-container-high);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .c11y-nav-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 14px;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--md-sys-color-on-surface);
    background: var(--md-sys-color-surface-container-high);
    border: 1px solid var(--md-sys-color-outline);
    border-radius: 999px;
    cursor: pointer;
  }
  .c11y-nav-toggle[hidden] { display: none; }

  /* Under 720px the four links fold behind a Menu button (the script only
     un-hides the button, so without JS the links simply stay visible). */
  @media (max-width: 720px) {
    .c11y-bar { padding-left: 16px; padding-right: 16px; gap: 8px; }
    .c11y-logo { margin-right: auto; }
    .c11y-logo .logo-svg { height: 30px; }
    .c11y-nav.has-toggle .c11y-nav-list {
      display: none;
      position: absolute;
      top: calc(100% + 6px);
      left: 0;
      z-index: 1100;
      min-width: 12rem;
      flex-direction: column;
      padding: 8px;
      background: var(--md-sys-color-surface-container-low);
      border: 1px solid var(--md-sys-color-outline);
      border-radius: 12px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    }
    .c11y-nav.has-toggle.is-open .c11y-nav-list { display: flex; }
    .c11y-nav.has-toggle .c11y-nav-list a { width: 100%; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>(".c11y-nav");
  const toggle = nav?.querySelector<HTMLButtonElement>(".c11y-nav-toggle");
  if (nav && toggle) {
    const mq = window.matchMedia("(max-width: 720px)");
    const setOpen = (open: boolean) => {
      nav.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };
    const sync = () => {
      toggle.hidden = !mq.matches;
      nav.classList.toggle("has-toggle", mq.matches);
      if (!mq.matches) setOpen(false);
    };
    mq.addEventListener("change", sync);
    sync();
    toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
    nav.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && nav.classList.contains("is-open")) {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener("click", (e) => {
      if (!nav.contains(e.target as Node)) setOpen(false);
    });
    nav.addEventListener("focusout", (e) => {
      if (!nav.contains(e.relatedTarget as Node)) setOpen(false);
    });
  }
</script>
