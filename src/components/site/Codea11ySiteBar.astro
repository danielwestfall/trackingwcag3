---
// codea11y.dev site bar — the same top row as codea11y.dev's own header, so
// Tracking WCAG reads as part of the portfolio site. The logo, links and the
// reading panel mount match danielwestfall.github.io/src/components/Header.astro.
// Colours come from codea11y-tokens.css (shared with codea11y.dev).
const SITE = "https://codea11y.dev";
const links = [
  { label: "Home", href: `${SITE}/` },
  { label: "Blog", href: `${SITE}/blog` },
  { label: "Projects", href: `${SITE}/projects` },
  { label: "About", href: `${SITE}/about` },
];
---

<div class="c11y-bar">
  <a href={`${SITE}/`} class="c11y-logo">
    <span class="sr-only">codea11y.dev home</span>
    <svg
            height="40"
            preserveAspectRatio="xMinYMin meet"
            viewBox="0 0 219.28917 54.354222"
                    aria-hidden="true" focusable="false"
            class="logo-svg"
          >
            <g transform="translate(-4.830636,-114.42924)">
              <g>
                <g>
                  <path
                    class="logo-blue"
                    style="stroke-width:1.854;stroke-dasharray:none;stroke-opacity:1;fill-opacity:1"
