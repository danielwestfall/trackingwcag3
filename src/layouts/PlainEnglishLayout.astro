    <!-- Global Theme Switch Controller Script -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const switchBtn = document.getElementById('theme-toggle-btn');
        const switchText = document.getElementById('theme-switch-status');

        function updateSwitchUI(theme) {
          if (!switchBtn) return;
          const isLight = theme === 'light';
          switchBtn.setAttribute('aria-checked', isLight ? 'true' : 'false');
          if (switchText) switchText.textContent = isLight ? 'Light' : 'Dark';
          switchBtn.setAttribute('title', isLight ? 'Switch to Dark mode (Shortcut: T)' : 'Switch to Light mode (Shortcut: T)');
        }

        function setTheme(theme) {
          document.documentElement.setAttribute('data-theme', theme);
          if (theme === 'light') {
            document.documentElement.classList.add('light-theme');
          } else {
            document.documentElement.classList.remove('light-theme');
          }
          try {
            localStorage.setItem('wcag_hub_theme', theme);
          } catch (e) {}
          updateSwitchUI(theme);
        }

        function toggleTheme() {
          const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
          const newTheme = currentTheme === 'light' ? 'dark' : 'light';
          setTheme(newTheme);
        }

        if (switchBtn) {
          switchBtn.addEventListener('click', toggleTheme);
          const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
          updateSwitchUI(currentTheme);
        }

        // Global Shortcut 'T'
        window.addEventListener('keydown', (e) => {
          if ((e.key === 't' || e.key === 'T') && 
              document.activeElement.tagName !== 'INPUT' && 
              document.activeElement.tagName !== 'TEXTAREA' &&
              document.activeElement.tagName !== 'SELECT') {
            e.preventDefault();
            toggleTheme();
          }
        });

        /* ----------------------------------------------------------------
           Text size. Scaling the root font-size is what WCAG 1.4.4 Resize
           Text actually describes, and because the site sizes type in rem it
           carries through every page — headers, nav and content together,
           rather than only the article body. The choice is stored so it
           survives navigation; without that it resets on every click and is
           not worth having.
           ---------------------------------------------------------------- */
        const scaleButtons = Array.prototype.slice.call(document.querySelectorAll('.scale-btn'));

        function currentScale() {
          const attr = document.documentElement.getAttribute('data-text-scale');
          return attr || '100';
        }

        function paintScaleButtons(scale) {
          scaleButtons.forEach((btn) => {
            btn.setAttribute('aria-pressed', btn.dataset.scale === scale ? 'true' : 'false');
          });
        }

        function setScale(scale) {
          if (scale === '100') {
            document.documentElement.style.fontSize = '';
            document.documentElement.removeAttribute('data-text-scale');
          } else {
            document.documentElement.style.fontSize = scale + '%';
            document.documentElement.setAttribute('data-text-scale', scale);
          }
          try {
            localStorage.setItem('wcag_hub_textscale', scale);
          } catch (e) {}
          paintScaleButtons(scale);
        }

        scaleButtons.forEach((btn) => {
          btn.addEventListener('click', () => setScale(btn.dataset.scale));
        });
        paintScaleButtons(currentScale());

        /* ----------------------------------------------------------------
           Global Search Combobox Controller
           ---------------------------------------------------------------- */
        const searchInput = document.getElementById('global-search-input');
        const searchWrap = document.getElementById('global-search-wrap');
        const searchDropdown = document.getElementById('global-search-dropdown');

        if (searchInput && searchDropdown && searchWrap) {
          let searchIndex = null;
          let selectedIndex = -1;
          let isFetching = false;
          const basePrefix = document.documentElement.getAttribute('data-base') || '';

          async function ensureSearchIndex() {
            if (searchIndex || isFetching) return;
            isFetching = true;
            try {
              const res = await fetch(`${basePrefix}/data/search-index.json`);
              if (res.ok) {
                searchIndex = await res.json();
              }
            } catch (err) {
              console.error('Failed to load search index:', err);
            } finally {
              isFetching = false;
            }
          }

          searchInput.addEventListener('focus', ensureSearchIndex);

          function escapeHtml(str) {
            return String(str)
              .replace(/&/g, '&amp;')
              .replace(/</g, '&lt;')
              .replace(/>/g, '&gt;')
              .replace(/"/g, '&quot;');
          }

          function highlight(text, query) {
            if (!query || !text) return escapeHtml(text || '');
            const safeText = String(text);
            const idx = safeText.toLowerCase().indexOf(query.toLowerCase());
            if (idx === -1) return escapeHtml(safeText);
            const before = escapeHtml(safeText.substring(0, idx));
            const match = escapeHtml(safeText.substring(idx, idx + query.length));
            const after = escapeHtml(safeText.substring(idx + query.length));
            return `${before}<mark>${match}</mark>${after}`;
          }

          function renderSearchResults(query) {
            if (!searchIndex) return;
            const q = query.trim().toLowerCase();
            if (!q) {
              searchDropdown.hidden = true;
              searchInput.setAttribute('aria-expanded', 'false');
              selectedIndex = -1;
              return;
            }

            const scored = [];
            for (const item of searchIndex) {
              let score = 0;
              const titleLower = item.title.toLowerCase();
              const idLower = (item.id || '').toLowerCase();
              const kwLower = item.keywords || '';

              if (idLower === q) score += 100;
              else if (idLower.startsWith(q)) score += 80;
              else if (titleLower.startsWith(q)) score += 60;
              else if (titleLower.includes(q)) score += 40;
              else if (kwLower.includes(q)) score += 20;

              if (score > 0) {
                scored.push({ item, score });
              }
            }

            scored.sort((a, b) => b.score - a.score);

            if (scored.length === 0) {
              searchDropdown.innerHTML = `
                <div class="search-no-results">
                  No criteria or provisions matching "<strong>${escapeHtml(query)}</strong>"
                </div>
              `;
              searchDropdown.hidden = false;
              searchInput.setAttribute('aria-expanded', 'true');
              selectedIndex = -1;
              return;
            }

            const wcag22Matches = scored.filter(s => s.item.type === 'wcag22').slice(0, 5);
            const wcag3Matches = scored.filter(s => s.item.type === 'wcag3').slice(0, 5);

            let html = '';
            let itemCounter = 0;

            if (wcag22Matches.length > 0) {
              html += `<div class="search-group-header">📘 WCAG 2.2 Standards (${wcag22Matches.length})</div>`;
              for (const m of wcag22Matches) {
                const it = m.item;
                const targetUrl = `${basePrefix}${it.url}`;
                html += `
                  <a href="${targetUrl}" class="search-result-item" role="option" id="search-opt-${itemCounter}" data-index="${itemCounter}" data-url="${targetUrl}">
                    <div class="search-item-top">
                      <span class="search-item-title">${highlight(it.title, q)}</span>
                      <span class="search-item-badge badge-wcag22">${escapeHtml(it.badge)}</span>
                    </div>
                    <div class="search-item-summary">${escapeHtml(it.summary)}</div>
                  </a>
                `;
                itemCounter++;
              }
            }

            if (wcag3Matches.length > 0) {
              html += `<div class="search-group-header">✨ WCAG 3.0 Draft Provisions (${wcag3Matches.length})</div>`;
              for (const m of wcag3Matches) {
                const it = m.item;
                const targetUrl = `${basePrefix}${it.url}`;
                html += `
                  <a href="${targetUrl}" class="search-result-item" role="option" id="search-opt-${itemCounter}" data-index="${itemCounter}" data-url="${targetUrl}">
                    <div class="search-item-top">
                      <span class="search-item-title">${highlight(it.title, q)}</span>
                      <span class="search-item-badge badge-wcag3">${escapeHtml(it.badge)}</span>
                    </div>
                    <div class="search-item-summary">${escapeHtml(it.summary)}</div>
                  </a>
                `;
                itemCounter++;
              }
            }

            html += `
              <div class="search-dropdown-footer">
                <a href="${basePrefix}/plain-english/?q=${encodeURIComponent(query)}">
                  View all results for "${escapeHtml(query)}" in Explorer &rarr;
                </a>
              </div>
            `;

            searchDropdown.innerHTML = html;
            searchDropdown.hidden = false;
            searchInput.setAttribute('aria-expanded', 'true');
            selectedIndex = -1;
          }

          searchInput.addEventListener('input', async () => {
            if (!searchIndex) await ensureSearchIndex();
            renderSearchResults(searchInput.value);
          });

          searchInput.addEventListener('keydown', (e) => {
            if (searchDropdown.hidden) return;
            const items = searchDropdown.querySelectorAll('.search-result-item');
            if (!items.length) return;

            if (e.key === 'ArrowDown') {
              e.preventDefault();
              selectedIndex = (selectedIndex + 1) % items.length;
              updateSelection(items);
            } else if (e.key === 'ArrowUp') {
              e.preventDefault();
              selectedIndex = (selectedIndex - 1 + items.length) % items.length;
              updateSelection(items);
            } else if (e.key === 'Enter') {
              if (selectedIndex >= 0 && items[selectedIndex]) {
                e.preventDefault();
                window.location.href = items[selectedIndex].getAttribute('data-url');
              }
            } else if (e.key === 'Escape') {
              searchDropdown.hidden = true;
              searchInput.setAttribute('aria-expanded', 'false');
              selectedIndex = -1;
            }
          });

          function updateSelection(items) {
            items.forEach((item, idx) => {
              if (idx === selectedIndex) {
                item.classList.add('is-selected');
                item.setAttribute('aria-selected', 'true');
                item.scrollIntoView({ block: 'nearest' });
                searchInput.setAttribute('aria-activedescendant', item.id);
              } else {
                item.classList.remove('is-selected');
                item.removeAttribute('aria-selected');
              }
            });
          }

          document.addEventListener('click', (e) => {
            if (!searchWrap.contains(e.target)) {
              searchDropdown.hidden = true;
              searchInput.setAttribute('aria-expanded', 'false');
              selectedIndex = -1;
            }
          });
        }
      });
    </script>
  </body>
</html>
