---
interface Props {
  title: string;
  activeTab?: "wcag3" | "wcag22" | "removals";
}

const { title, activeTab = "wcag3" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const link = (path: string) => `${base}${path.startsWith('/') ? path : '/' + path}`;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Plain English WCAG Hub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <header class="hub-header">
      <div class="header-container">
        <div class="brand">
          <span class="brand-badge">a11y teacher edition</span>
          <h1 class="brand-title"><a href={link("/plain-english/")}>Plain English Accessibility Hub</a></h1>
          <p class="brand-subtitle">Translating W3C Standards for Designers, Developers, QA & Product teams</p>
        </div>

        <nav class="hub-nav" aria-label="Standard Version Selection">
          <a href={link("/plain-english/")} class={`nav-tab ${activeTab === "wcag3" ? "active" : ""}`}>
            <span class="tab-icon">✨</span>
            <span class="tab-text">WCAG 3 Explorer</span>
            <span class="status-pill status-draft">W3C Draft</span>
          </a>
          <a href={link("/plain-english/wcag22/")} class={`nav-tab ${activeTab === "wcag22" ? "active" : ""}`}>
            <span class="tab-icon">📘</span>
            <span class="tab-text">WCAG 2.2 Reference</span>
            <span class="status-pill status-standard">Current Standard</span>
          </a>
          <a href={link("/plain-english/removals/")} class={`nav-tab ${activeTab === "removals" ? "active" : ""}`}>
            <span class="tab-icon">🔄</span>
            <span class="tab-text">Removals & Shifts</span>
            <span class="status-pill status-removed">2.2 vs 3</span>
          </a>
        </nav>
      </div>

      {activeTab === "wcag3" && (
        <div class="working-draft-banner">
          <span class="draft-badge">⚠️ W3C Working Draft Notice</span>
          <p>WCAG 3.0 is an active W3C Working Draft in development by the AGWG. Proposed outcomes, scoring models, and assertions represent current design directions subject to ongoing revision. See <a href="https://www.w3.org/TR/wcag-3.0/" target="_blank" rel="noopener noreferrer">official W3C WCAG 3.0 Draft</a>.</p>
        </div>
      )}
    </header>

    <main id="main-content" class="hub-main" tabindex="-1">
      <slot />
    </main>

    <footer class="hub-footer">
      <div class="footer-container">
        <div class="footer-disclaimer">
          <strong>⚖️ Educational Guidance Disclaimer:</strong>
          <p>This site provides plain-English analysis and educational summaries of W3C accessibility specifications and working drafts. It does not constitute formal legal advice. Consult qualified accessibility counsel and regional statutory regulations for legal compliance requirements.</p>
        </div>
        <p class="footer-copy">Decoupled Updatable Plain English Layer &copy; 2026. Built on W3C WCAG source repositories.</p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg-main: #0f172a;
    --bg-card: #1e293b;
    --bg-card-hover: #334155;
    --border-color: #334155;
    --text-primary: #f8fafc;
    --text-secondary: #94a3b8;
    --text-muted: #64748b;
    --accent-blue: #38bdf8;
    --accent-indigo: #818cf8;
    --accent-purple: #c084fc;
    --status-mature: #34d399;
    --status-developing: #fbbf24;
    --status-exploratory: #f43f5e;
    --radius-lg: 16px;
    --radius-md: 10px;
    --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
    --font-mono: 'JetBrains Mono', monospace;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    background-color: var(--bg-main);
    color: var(--text-primary);
    font-family: var(--font-sans);
    line-height: 1.6;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .skip-link {
    position: absolute;
    top: -100px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent-blue);
    color: #0f172a;
    padding: 12px 24px;
    font-weight: 700;
    border-radius: var(--radius-md);
    z-index: 1000;
    transition: top 0.2s ease;
  }
  .skip-link:focus {
    top: 16px;
  }

  .hub-header {
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-color);
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 20px 0;
  }

  .header-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .brand-badge {
    display: inline-block;
    background: rgba(56, 189, 248, 0.15);
    color: var(--accent-blue);
    border: 1px solid rgba(56, 189, 248, 0.3);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 2px 10px;
    border-radius: 20px;
    margin-bottom: 6px;
  }

  .brand-title {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .brand-title a {
    color: var(--text-primary);
    text-decoration: none;
  }
  .brand-title a:hover {
    color: var(--accent-blue);
  }

  .brand-subtitle {
    color: var(--text-secondary);
    font-size: 0.875rem;
  }

  .hub-nav {
    display: flex;
    gap: 12px;
    background: rgba(30, 41, 59, 0.8);
    padding: 6px;
    border-radius: 14px;
    border: 1px solid var(--border-color);
  }

  .nav-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 10px;
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }

  .nav-tab:hover {
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.05);
  }

  .nav-tab.active {
    background: var(--accent-blue);
    color: #0f172a;
  }
  .nav-tab.active .status-pill {
    background: rgba(15, 23, 42, 0.2);
    color: #0f172a;
  }

  .status-pill {
    font-size: 0.7rem;
    padding: 2px 6px;
    border-radius: 6px;
    font-weight: 700;
  }
  .status-draft {
    background: rgba(251, 191, 36, 0.2);
    color: #fbbf24;
  }
  .status-standard {
    background: rgba(52, 211, 153, 0.2);
    color: #34d399;
  }
  .status-removed {
    background: rgba(192, 132, 252, 0.2);
    color: #c084fc;
  }

  .working-draft-banner {
    display: flex;
    align-items: center;
    gap: 14px;
    background: rgba(251, 191, 36, 0.08);
    border: 1px solid rgba(251, 191, 36, 0.3);
    border-radius: var(--radius-md);
    padding: 10px 18px;
    margin: 16px 24px 0 24px;
    font-size: 0.85rem;
  }
  .draft-badge {
    background: #fbbf24;
    color: #0f172a;
    font-weight: 800;
    font-size: 0.75rem;
    padding: 2px 8px;
    border-radius: 4px;
    white-space: nowrap;
  }
  .working-draft-banner p {
    color: var(--text-secondary);
    margin: 0;
  }
  .working-draft-banner a {
    color: #fbbf24;
    text-decoration: underline;
  }

  .footer-disclaimer {
    max-width: 900px;
    margin: 0 auto 16px auto;
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 14px 20px;
    text-align: left;
  }
  .footer-disclaimer strong {
    color: var(--accent-blue);
    display: block;
    margin-bottom: 4px;
    font-size: 0.88rem;
  }
  .footer-disclaimer p {
    color: var(--text-secondary);
    font-size: 0.82rem;
    line-height: 1.5;
    margin: 0;
  }
  .footer-copy {
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  :focus-visible {
    outline: 3px solid var(--accent-blue);
    outline-offset: 3px;
  }
</style>
