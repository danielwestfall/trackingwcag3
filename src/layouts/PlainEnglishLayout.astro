          </nav>

          <!-- Modern Tactile Switch Toggle (Right) -->
          <button 
            id="theme-toggle-btn" 
            class="theme-toggle-switch" 
            type="button" 
            role="switch" 
            aria-checked="false" 
            aria-label="Toggle light or dark color mode"
            title="Toggle Light / Dark mode (Keyboard shortcut: 'T')"
